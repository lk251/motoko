        self.conv.setdefault("context_items", []).append(context_item_from_dossier(dossier))
        save_conversation(self.conv)

    def study_from_body(self, body: str) -> None:
        print(study_query(self.conv, body))

    def capture_text(self, func) -> str:
        class Capture:
            def __init__(self) -> None:
                self.parts: list[str] = []

            def write(self, text: str) -> int:
                self.parts.append(text)
                return len(text)

            def flush(self) -> None:
                return None

            def getvalue(self) -> str:
                return "".join(self.parts)

        buf = Capture()
        old_stdout = sys.stdout
        try:
            sys.stdout = buf
            func()
        finally:
            sys.stdout = old_stdout
        return buf.getvalue().strip() or "(no output)"

    def run_blocking_command(self, label: str, func) -> None:
        if self.generating:
            self.append("system", "Finish or wait for the current answer before running this blocking command.")
            return
        self.restore_for_blocking()
        try:
            print()
            print(style(label, "turquoise", "bold"))
            func()
            print(style("Done. Returning to Motoko TUI.", "green"))
        except SystemExit as exc:
            print(style(str(exc), "red"))
        finally:
            self.reenter_after_blocking()
        self.messages = self.seed_messages(self.conv)
        self.dirty = True

    def restore_for_blocking(self) -> None:
        if self.old_termios is not None:
            termios.tcsetattr(self.stdin_fd, termios.TCSADRAIN, self.old_termios)
        self.write("\033[?7h\033[?25h\033[0m\033[2J\033[H")

    def reenter_after_blocking(self) -> None:
        tty.setcbreak(self.stdin_fd)
        self.write("\033[?25l\033[?7l")

    def start_generation(self, user_text: str) -> None:
        maybe_set_title(self.conv, user_text)
        topic = maybe_attach_relevant_existing_topic(self.conv, user_text)
        if topic:
            self.append("system", f"auto-attached topic dossier: {topic.get('id')} ({topic.get('name', '')})")
        dossier = maybe_attach_relevant_existing_dossier(self.conv, user_text)
        if dossier:
            self.append("system", f"auto-attached memory dossier: {dossier.get('id')} ({dossier.get('name', '')})")
        self.conv.setdefault("messages", []).append({"role": "user", "content": user_text})
        self.append("user", user_text)
        self.answer_entry = self.append("assistant", "")
        self.status = "Motoko is thinking; you can type the next prompt below"
        self.generating = True
        self.cancel_event = threading.Event()
        messages, sources = build_messages(self.conv, user_text)
        cancel_event = self.cancel_event

        def worker() -> None:
            try:
                def on_token(token: str) -> None:
                    if cancel_event.is_set():
                        raise RuntimeError("__motoko_stopped__")
                    self.put_event(("token", token))

                reply = call_model_with_callback(
                    messages,
                    temperature=0.7,
                    on_token=on_token,
                )
                self.put_event(("done", reply, sources))
            except RuntimeError as exc:
                if str(exc) == "__motoko_stopped__":
                    self.put_event(("stopped",))
                else:
                    self.put_event(("error", f"{type(exc).__name__}: {exc}"))
            except SystemExit as exc:
                self.put_event(("error", str(exc)))
            except Exception as exc:  # Defensive: preserve terminal session.
                self.put_event(("error", f"{type(exc).__name__}: {exc}"))

        threading.Thread(target=worker, daemon=True).start()

    def put_event(self, event: tuple) -> None:
        with self.events_lock:
            self.events.append(event)

    def drain_events(self) -> None:
        changed = False
        while True:
            with self.events_lock:
                if not self.events:
                    break
                event = self.events.popleft()
            kind = event[0]
            if kind == "token":
                if self.answer_entry is not None:
                    self.answer_entry["content"] += event[1]
                    changed = True
            elif kind == "done":
                reply, sources = event[1], event[2]
                self.conv["last_sources"] = sources
                self.conv["messages"].append({"role": "assistant", "content": reply})
                save_conversation(self.conv)
                self.generating = False
                self.answer_entry = None
                self.status = "ready"
                changed = True
                if self.pending_prompts:
                    next_prompt = self.pending_prompts.popleft()
                    self.start_generation(next_prompt)
                else:
                    self.start_maintenance()
            elif kind == "stopped":
                partial = ""
                if self.answer_entry is not None:
                    partial = self.answer_entry.get("content", "")
                    if partial:
                        self.answer_entry["content"] = partial.rstrip() + "\n\n[stopped]"
                if partial:
                    self.conv["messages"].append(
                        {"role": "assistant", "content": partial.rstrip() + "\n\n[stopped]"}
                    )
                save_conversation(self.conv)
                self.generating = False
                self.answer_entry = None
                self.status = "answer stopped"
                changed = True
            elif kind == "error":
                self.generating = False
                self.answer_entry = None
                self.append("error", event[1])
                self.status = "ready"
                changed = True
            elif kind == "maintenance_done":
                self.maintaining = False
                notes = event[1]
                self.status = "ready"
                self.maintenance_status = ""
                if notes:
                    self.messages = self.seed_messages(self.conv)
                    self.append("system", "; ".join(notes))
                changed = True
            elif kind == "maintenance_error":
                self.maintaining = False
                self.maintenance_status = ""
                self.status = "ready"
                self.append("system", f"memory maintenance failed: {event[1]}")
                changed = True
            elif kind == "maintenance_phase":
                self.maintenance_status = event[1]
                self.maintenance_phase_started = time.monotonic()
                self.status = event[1]
                changed = True
            elif kind == "study_phase":
                self.study_running = True
                self.study_status = event[1]
                self.study_phase_started = time.monotonic()
                changed = True
            elif kind == "study_done":
                self.study_running = False
                notes = event[1]
                self.study_last_note = "; ".join(notes) if notes else "catalog fresh"
                self.study_status = "study: idle"
                changed = True
            elif kind == "study_error":
                self.study_running = False
                self.study_status = "study: idle"
                self.study_last_note = f"study failed: {event[1]}"
                changed = True
        if changed:
            self.dirty = True

    def start_study_loop(self) -> None:
        if not env_flag("MOTOKO_BACKGROUND_STUDY", True):
            self.study_status = "study: off"
            return
        interval = env_seconds("MOTOKO_BACKGROUND_STUDY_INTERVAL", BACKGROUND_STUDY_INTERVAL_SECONDS)
        idle_grace = env_seconds("MOTOKO_BACKGROUND_STUDY_IDLE_GRACE", BACKGROUND_STUDY_IDLE_GRACE_SECONDS)

        def worker() -> None:
            next_run = time.monotonic() + 1
            while self.running:
                time.sleep(1)
                now_ts = time.monotonic()
                if now_ts < next_run:
                    continue
                if self.generating or self.maintaining or self.pending_prompts:
                    next_run = now_ts + min(5, interval)
                    continue
                if now_ts - self.last_input_at < idle_grace:
                    next_run = now_ts + 1
                    continue
                next_run = now_ts + interval
                self.put_event(("study_phase", "study: scanning"))
                try:
                    notes = background_study_step(
                        self.conv,
                        phase_callback=lambda phase: self.put_event(("study_phase", phase)),
                    )
                except Exception as exc:  # Background study must not break chat.
                    self.put_event(("study_error", f"{type(exc).__name__}: {exc}"))
                else:
                    self.put_event(("study_done", notes))

        threading.Thread(target=worker, daemon=True).start()

    def start_maintenance(self, *, resumed: bool = False) -> None:
        if self.maintaining or self.generating:
            return
        self.maintaining = True
        self.maintenance_status = "memory: checking"
        self.maintenance_phase_started = time.monotonic()
        self.status = self.maintenance_status
        state = begin_maintenance_state(self.conv, resumed=resumed)

        def worker() -> None:
            try:
                def on_phase(phase: str) -> None:
                    self.put_event(("maintenance_phase", phase))

                notes = auto_maintain_conversation(
                    self.conv,
                    phase_callback=on_phase,
                    state=state,
                )
                clear_maintenance_state(state.get("job_id"))
                self.put_event(("maintenance_done", notes))
            except Exception as exc:  # Keep hidden maintenance from breaking chat.
                update_maintenance_state(
                    state,
                    "memory: failed",
                    status="failed",
                    error=f"{type(exc).__name__}: {exc}",
                )
                self.put_event(("maintenance_error", f"{type(exc).__name__}: {exc}"))

        threading.Thread(target=worker, daemon=True).start()

    def compact_command_menu(self) -> str:
        lines = ["Chat commands:"]
        for command, description in SLASH_COMMANDS:
            lines.append(f"  {command:<24} {description}")
        return "\n".join(lines)

    def dropdown_options(self) -> list[dict]:
        text = self.input_buffer[: self.cursor]
        stripped = text.lstrip()
        if not stripped.startswith("/"):
            return []
        words = stripped.split()
        if " " not in stripped:
            prefix = stripped or "/"
            options = []
            for command, description in SLASH_COMMANDS:
                value = slash_command_value(command)
                if value.startswith(prefix) or command.startswith(prefix):
                    options.append({"kind": "command", "value": value, "label": command, "description": description})
            return options
        first = words[0] if words else ""
        current = words[-1] if words and not stripped.endswith(" ") else ""
        if first == "/resume" and len(words) <= 2:
            return [
                {"kind": "conversation", "value": row.get("id", ""), "label": conversation_label(row), "description": ""}
                for row in list_conversations()
                if not current or item_matches_selector(row, current)
            ][:20]
        if first == "/memory" and len(words) <= 2:
            options = []
            for command, description in SLASH_COMMANDS:
                if not command.startswith("/memory "):
                    continue
                value = slash_command_value(command)
                suffix = value.split(maxsplit=1)[1] if " " in value else value
                if not current or suffix.startswith(current) or value.startswith(stripped):
                    options.append({"kind": "command", "value": value, "label": command, "description": description})
            return options
        if first in {"/attach-index", "/topic", "/deepen"} and len(words) <= 2:
            return [
                {"kind": "index", "value": row.get("id", ""), "label": index_label(row), "description": row.get("root", "")}
                for row in list_indexes()
                if not current or item_matches_selector(row, current)
            ][:20]
        if first in {"/attach-topic", "/topic-show"} and len(words) <= 2:
            return [
                {"kind": "topic", "value": row.get("id", ""), "label": topic_label(row), "description": row.get("query", "")}
                for row in list_topics()
                if not current or item_matches_selector(row, current)
            ][:20]
        if first in {"/attach-dossier", "/dossier-show"} and len(words) <= 2:
            return [
                {"kind": "dossier", "value": row.get("id", ""), "label": dossier_label(row), "description": row.get("query", "")}
                for row in list_dossiers()
                if not current or item_matches_selector(row, current)
            ][:20]
        return []

    def apply_dropdown(self, option: dict) -> None:
        kind = option["kind"]
        value = option["value"]
        if kind == "command":
            if value in SIMPLE_SLASH_COMMANDS:
                self.input_buffer = ""
                self.cursor = 0
                self.submit_text(value)
                return
            self.input_buffer = value + " "
            self.cursor = len(self.input_buffer)
            self.dropdown_index = 0
            self.dirty = True
            return
        first = self.input_buffer.lstrip().split()[0] if self.input_buffer.lstrip().split() else ""
        if kind == "conversation":
            self.input_buffer = f"/resume {value}"
            self.cursor = len(self.input_buffer)
            self.submit_text(self.input_buffer)
            self.input_buffer = ""
            self.cursor = 0
            return
        if kind == "index":
            if first in {"/topic", "/deepen"}:
                self.input_buffer = f"/topic {value} "
                if first == "/deepen":
                    self.input_buffer = f"/deepen {value} "
                self.cursor = len(self.input_buffer)
            else:
                self.input_buffer = f"{first} {value}"
                self.cursor = len(self.input_buffer)
                self.submit_text(self.input_buffer)
                self.input_buffer = ""
                self.cursor = 0
            self.dropdown_index = 0
            self.dirty = True
            return
        if kind == "topic":
            if first == "/topic-show":
                self.input_buffer = f"/topic-show {value}"
            else:
                self.input_buffer = f"/attach-topic {value}"
            self.cursor = len(self.input_buffer)
            self.submit_text(self.input_buffer)
            self.input_buffer = ""
            self.cursor = 0
        if kind == "dossier":
            if first == "/dossier-show":
                self.input_buffer = f"/dossier-show {value}"
            else:
                self.input_buffer = f"/attach-dossier {value}"
            self.cursor = len(self.input_buffer)
            self.submit_text(self.input_buffer)
            self.input_buffer = ""
            self.cursor = 0

    def render(self, *, force: bool = False) -> None:
        self.drain_events()
        size = self.terminal_size()
        width, height = size.columns, size.lines
        width = max(40, width)
        height = max(12, height)
        options = self.dropdown_options()
        if options:
            self.dropdown_index = min(self.dropdown_index, len(options) - 1)
        else:
            self.dropdown_index = 0
        input_lines, cursor_row_offset, cursor_col = self.input_display(width)
        dropdown_lines = self.dropdown_display(width, options)
        display_status = "ready" if self.maintaining and not self.generating else self.status
        title = (
            f" {style('Motoko', 'purple', 'bold')}  "
            f"{style(self.conv.get('title', 'Untitled'), 'turquoise', 'bold')}  "
            f"{style(model_badge(), 'dim')}  "
            f"{style(display_status, 'turquoise')}"
        )
        spinner = self.tui_spinner_frames[self.tui_spinner_index % len(self.tui_spinner_frames)] if self.tui_spinner_frames else ""
        if self.generating:
            title += f"  {spinner} answering".rstrip()
        if self.maintaining:
            elapsed = int(time.monotonic() - self.maintenance_phase_started)
            title += f"  {spinner} {(self.maintenance_status or self.status)} {elapsed}s".rstrip()
        if self.pending_prompts:
            title += f"  queued:{len(self.pending_prompts)}"
        if self.study_running:
            elapsed = int(time.monotonic() - self.study_phase_started)
            title += f"  {spinner} {self.study_status} {elapsed}s".rstrip()
        elif self.study_last_note:
            title += f"  {style(self.study_last_note, 'dim')}"
        title_lines = wrap_display_line(title, width)
        if len(title_lines) > 3:
            title_lines = title_lines[:3]
            plain = strip_ansi(title_lines[-1])
            title_lines[-1] = plain[: max(0, width - 1)].rstrip() + "…"
        title_height = len(title_lines)
        reserve = title_height + len(dropdown_lines) + 1 + len(input_lines)
        body_height = max(3, height - reserve)
        body_lines = self.body_display(width)
        max_scroll = max(0, len(body_lines) - body_height)
        self.scroll = min(self.scroll, max_scroll)
        if self.scroll:
            start = max(0, len(body_lines) - body_height - self.scroll)
            visible = body_lines[start : start + body_height]
        else:
            visible = body_lines[-body_height:]

        rows = []
        rows.extend(title_lines)
        rows.extend(visible)
        while len(rows) < title_height + body_height:
            rows.append("")
        rows.extend(dropdown_lines)
        rows.append(style("─" * width, "dim"))
        rows.extend(input_lines)
        screen = "\033[H" + "\n".join(f"{row}\033[K" for row in rows[:height])
        screen += "\033[J"
        input_start_row = title_height + body_height + len(dropdown_lines) + 2
        cursor_row = min(height, input_start_row + cursor_row_offset)
        screen += f"\033[{cursor_row};{min(width, cursor_col)}H\033[?25h"
        self.write(screen)
        if self.generating or self.maintaining or self.study_running:
            self.tui_spinner_index += 1
        self.last_render = time.monotonic()
        self.dirty = False

    def body_display(self, width: int) -> list[str]:
        lines = []
        code = False
        for entry in self.messages:
            role = entry.get("role", "?")
            content = entry.get("content", "")
            if role == "user":
                prefix = style("> ", "turquoise", "bold")
            elif role == "assistant":
                prefix = style("Motoko ", "purple", "bold")
            elif role == "queued":
                prefix = style("queued ", "yellow", "bold")
            elif role == "error":
                prefix = style("error ", "red", "bold")
            elif role == "summary":
                prefix = style("summary ", "magenta", "bold")
            else:
                prefix = style("sys ", "yellow", "bold")
            wrapped = []
            for raw_line in content.splitlines() or [""]:
                if raw_line.startswith("```"):
                    code = not code
                    wrapped.extend(wrap_display_line(style(raw_line, "magenta"), width - len(strip_ansi(prefix))))
                    continue
                if code:
                    wrapped.extend(wrap_display_line(style(raw_line, "green"), width - len(strip_ansi(prefix))))
                elif raw_line.startswith(("/", "motoko ")):
                    wrapped.extend(wrap_display_line(style(raw_line, "turquoise"), width - len(strip_ansi(prefix))))
                elif raw_line.startswith(("- ", "* ", "  /", "  motoko")):
                    wrapped.extend(wrap_display_line(style(raw_line, "dim"), width - len(strip_ansi(prefix))))
                else:
                    wrapped.extend(wrap_display_line(raw_line, width - len(strip_ansi(prefix))))
            for idx, line in enumerate(wrapped):
                lines.append((prefix if idx == 0 else " " * len(strip_ansi(prefix))) + line)
            lines.append("")
        return lines or [""]

    def dropdown_display(self, width: int, options: list[dict]) -> list[str]:
        if not options:
            return []
        max_rows = min(8, len(options))
        start = min(
            max(0, self.dropdown_index - max_rows + 1),
            max(0, len(options) - max_rows),
        )
        visible_options = options[start : start + max_rows]
        rows = []
        for offset, option in enumerate(visible_options):
            idx = start + offset
            marker = ">" if idx == self.dropdown_index else " "
            label = strip_ansi(str(option.get("label", "")))
            description = strip_ansi(str(option.get("description", "")))
            text = f" {marker} {label}"
            if description:
                remaining = max(0, width - len(strip_ansi(text)) - 3)
                text += "  " + description[:remaining]
            if idx == self.dropdown_index:
                rows.append(style(text[:width], "bold", "purple"))
            else:
                rows.append(text[:width])
        return rows

    def input_display(self, width: int) -> tuple[list[str], int, int]:
        return fixed_prompt_input_display(self.input_buffer, self.cursor, width)

    def terminal_size(self) -> os.terminal_size:
        try:
            return os.get_terminal_size(self.stdout_fd)
        except OSError:
            return shutil.get_terminal_size((80, 24))


