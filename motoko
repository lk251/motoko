def select_capability_route(
    *,
    route_id: str | None = None,
    kind: str,
    tasks: set[str],
    endpoint_path: str,
) -> dict:
    rows = local_model_routes_for_capability(kind=kind, tasks=tasks, endpoint_path=endpoint_path)
    if route_id:
        route_id = route_id.strip()
        matches = [
            row
            for row in rows
            if row.get("route") == route_id
            or str(row.get("route", "")).startswith(route_id)
            or row.get("catalog_route") == route_id
        ]
        if len(matches) != 1:
            raise SystemExit(f"{kind} route selector must match exactly one route; matched {len(matches)}")
        return matches[0]
    if not rows:
        raise SystemExit(f"No local model route advertises {kind} at {endpoint_path}.")
    return rows[0]


def capability_route_request_info(row: dict, *, default_path: str) -> dict:
    endpoint_paths = normalize_endpoint_paths(row.get("endpoint_paths"))
    request_path = default_path if default_path in endpoint_paths else (endpoint_paths[0] if endpoint_paths else default_path)
    return {
        "route": str(row.get("route") or row.get("catalog_route") or ""),
        "catalog_route": str(row.get("catalog_route") or row.get("route") or ""),
        "endpoint": str(row.get("endpoint") or ""),
        "request_path": request_path,
        "model": str(row.get("model") or ""),
        "manager_kind": str(row.get("manager_kind") or ""),
        "max_parallel": row.get("max_parallel") or 1,
        "request_policy": normalize_request_policy(row.get("request_policy")),
        "scheduling": normalize_scheduling_policy(row.get("scheduling")),
        "idle_seconds": row.get("idle_seconds"),
        "safety_policy": normalize_safety_policy(row.get("safety_policy")),
        "model_path": str(row.get("model_path") or ""),
        "download_url": str(row.get("download_url") or ""),
        "download_hash": str(row.get("download_hash") or ""),
    }


def ensure_route_model_file_available(route_info: dict, *, capability: str = "model") -> None:
    endpoint_text = str(route_info.get("endpoint") or "")
    model_path = str(route_info.get("model_path") or "")
    if not endpoint_is_unix(endpoint_text) or not model_path:
        return
    try:
        missing = not pathlib.Path(model_path).exists()
    except OSError as exc:
        detail = (
            f"{capability} route {local_model_helper_route(route_info)} declared model file "
            f"could not be checked: {model_path}: {exc}"
        )
        hint = local_model_verify_hint(route_info)
        if hint:
            detail += "\n" + hint
        raise SystemExit(detail) from exc
    if not missing:
        return
    detail = (
        f"{capability} route {local_model_helper_route(route_info)} declared model file "
        f"is missing: {model_path}"
    )
    hint = local_model_verify_hint(route_info)
    if hint:
        detail += "\n" + hint
    raise SystemExit(detail)


