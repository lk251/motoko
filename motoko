def index_progress_percent(progress: dict) -> int | None:
    if progress.get("status") == "completed":
        return 100
    total = int(progress.get("estimated_model_calls", 0) or 0)
    done = int(progress.get("completed_model_calls", 0) or 0)
    if total <= 0:
        return None
    return min(99, max(0, int((done / total) * 100)))


def update_index_progress_estimates(progress: dict) -> None:
    started = progress.get("_started_monotonic")
    if started is not None:
        progress["elapsed_seconds"] = int(time.monotonic() - started)
    done = int(progress.get("completed_model_calls", 0) or 0)
    total = int(progress.get("estimated_model_calls", 0) or 0)
    current_started = progress.get("_current_model_started_monotonic")
    current_elapsed = 0
    if current_started is not None:
        current_elapsed = max(0, int(time.monotonic() - current_started))
        progress["current_model_elapsed_seconds"] = current_elapsed
    else:
        progress.pop("current_model_elapsed_seconds", None)
    in_flight = 1 if current_started is not None else 0
    remaining_after_current = max(0, total - done - in_flight)
    completed_seconds = float(progress.get("completed_model_seconds", 0.0) or 0.0)
    if completed_seconds > 0 and done > 0:
        avg_call_seconds = completed_seconds / done
        progress["eta_basis"] = "completed model-call timing"
    elif started is not None and done > 0:
        avg_call_seconds = max(1.0, float(progress.get("elapsed_seconds", 0) or 0) / done)
        progress["eta_basis"] = "elapsed per completed model call"
    else:
        avg_call_seconds = 0.0
        progress["eta_basis"] = "waiting for completed model calls"
    if avg_call_seconds > 0 and (remaining_after_current > 0 or in_flight):
        current_remaining = 0.0
        if in_flight:
            # The active request may be a long file/corpus reduction. Once it
            # exceeds the current average, keep a small reserve instead of
            # pretending the call is certainly about to finish.
            current_remaining = max(avg_call_seconds * 0.25, avg_call_seconds - current_elapsed)
        progress["eta_seconds"] = int(current_remaining + avg_call_seconds * remaining_after_current)
        progress["average_model_call_seconds"] = round(avg_call_seconds, 2)
    else:
        progress["eta_seconds"] = None
        progress.pop("average_model_call_seconds", None)
    progress["percent"] = index_progress_percent(progress)


def index_progress_reserve_model_calls(
    progress: dict | None,
    key: str,
    expected_calls: int,
    *,
    preplanned_calls: int = 1,
    callback=None,
) -> None:
    if progress is None:
        return
    expected_calls = max(1, int(expected_calls or 1))
    preplanned_calls = max(0, int(preplanned_calls or 0))
    reserve_key = f"{key}:{preplanned_calls}"
    reserves = progress.setdefault("_model_call_reserves", {})
    previous = int(reserves.get(reserve_key, preplanned_calls) or preplanned_calls)
    if expected_calls <= previous:
        return
    progress["estimated_model_calls"] = int(progress.get("estimated_model_calls", 0) or 0) + (expected_calls - previous)
    reserves[reserve_key] = expected_calls
    emit_index_progress(progress, callback)


def emit_index_progress(progress: dict, callback=None) -> None:
    progress["updated"] = now()
    update_index_progress_estimates(progress)
    write_index_progress(progress)
    if callback is not None:
        callback(public_progress_state(progress))


def begin_index_progress(
    index_id: str,
    root: pathlib.Path,
    pattern: str | None,
    name: str | None,
    candidates: list[pathlib.Path],
    callback=None,
    *,
    initial_elapsed_seconds: int = 0,
) -> dict:
    initial_elapsed_seconds = max(0, int(initial_elapsed_seconds or 0))
    chunk_estimates = {str(path): estimate_file_chunks(path) for path in candidates}
    estimated_chunks = sum(chunk_estimates.values())
    file_summary_estimates = {
        path: estimate_summary_calls_for_block_count(chunks)
        for path, chunks in chunk_estimates.items()
    }
    progress = {
        "id": index_id,
        "kind": "index",
        "status": "running",
        "phase": "starting",
        "root": str(root),
        "glob": pattern or AUTO_INDEX_GLOB,
        "name": name or root.name or str(root),
        "started": now(),
        "updated": now(),
        "elapsed_seconds": initial_elapsed_seconds,
        "eta_seconds": None,
        "percent": 0,
        "total_files": len(candidates),
        "completed_files": 0,
        "current_file": "",
        "current_file_index": 0,
        "current_file_estimated_chunks": 0,
        "estimated_chunks": estimated_chunks,
        "completed_chunks": 0,
        "current_chunk": 0,
        "estimated_file_summary_calls": sum(file_summary_estimates.values()),
        "estimated_model_calls": estimated_chunks + sum(file_summary_estimates.values()) + estimate_corpus_summary_calls(len(candidates)),
        "completed_model_calls": 0,
        "last_model_label": "",
        "_started_monotonic": time.monotonic() - initial_elapsed_seconds,
        "_chunk_estimates": chunk_estimates,
        "_file_summary_estimates": file_summary_estimates,
    }
    emit_index_progress(progress, callback)
    return progress


def index_progress_begin_file(progress: dict | None, path: pathlib.Path, ordinal: int, callback=None) -> None:
    if progress is None:
