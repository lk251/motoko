    max_model_calls: int = 6,
    max_tool_calls: int = 6,
    max_minutes: int = 30,
    save: bool = False,
) -> str:
    try:
        if model_readonly and model_confirmed:
            raise GoalLoopValidationError("--model-readonly and --model-confirmed are mutually exclusive")
        planner = None
        if model_readonly:
            planner = GOAL_LOOP_PLANNER_MODEL_READONLY
        elif model_confirmed:
            planner = GOAL_LOOP_PLANNER_MODEL_CONFIRMED
        record = make_goal_loop_record(
            objective,
            planner=planner,
            scope=scope or [],
            allowed_tools=allowed_tools or [],
            allowed_effects=(
                allowed_effects
                if allowed_effects is not None
                else (
                    ["read_context", "read_allowed_files", "write_motoko_state", "propose_project_changes"]
                    if model_readonly
                    else [
                        "read_context",
                        "read_allowed_files",
                        "write_motoko_state",
                        "propose_project_changes",
                        "write_allowed_project",
                    ]
                    if model_confirmed
                    else []
                )
            ),
            budgets={
                "max_steps": max_steps,
                "max_model_calls": max_model_calls,
                "max_tool_calls": max_tool_calls,
                "max_minutes": max_minutes,
