def configured_cross_home_paths() -> list[pathlib.Path]:
    rows = security_config().get("allow_cross_home_paths", [])
    paths = []
    if not isinstance(rows, list):
        return paths
    for item in rows:
        text = str(item or "").strip()
        if not text or "\x00" in text:
            continue
        paths.append(pathlib.Path(text).expanduser().resolve(strict=False))
    return paths


def require_not_cross_home(path: pathlib.Path) -> None:
    resolved = path.expanduser().resolve(strict=False)
    home = pathlib.Path.home().resolve(strict=False)
    try:
        resolved.relative_to(home)
    except ValueError:
        pass
    else:
        return
    if resolved == home:
        return
    text = resolved.as_posix()
    if not text.startswith("/home/"):
        return
    for allowed in configured_cross_home_paths():
        try:
            resolved.relative_to(allowed)
        except ValueError:
            if resolved == allowed:
                return
            continue
        else:
            return
    raise AgenticValidationError(
        "path crosses into another Unix home; configure security.allow_cross_home_paths if this realm is allowed"
    )


