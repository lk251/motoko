def is_under(path: pathlib.Path, root: pathlib.Path) -> bool:
    try:
        path.relative_to(root)
        return True
    except ValueError:
        return False


def require_allowed(path: pathlib.Path) -> None:
    resolved = path.expanduser().resolve()
    dirs = allowed_dirs()
    if not dirs:
        raise SystemExit(
            "Motoko has no allowed document directories yet; run 'motoko allow-dir DIR' first"
        )
    if any(resolved == directory or is_under(resolved, directory) for directory in dirs):
        return
    raise SystemExit(
        f"{resolved} is outside Motoko's allowed directories; run 'motoko allow-dir DIR' first"
    )


def read_text_file(path: pathlib.Path) -> str:
    require_allowed(path)
    data = path.read_bytes()
    if len(data) > MAX_CONTEXT_BYTES:
        data = data[:MAX_CONTEXT_BYTES]
    return data.decode("utf-8", errors="replace")


def is_probably_text_file(path: pathlib.Path) -> bool:
    try:
        with path.open("rb") as fh:
            sample = fh.read(TEXT_SAMPLE_BYTES)
    except OSError:
        return False
    if not sample:
        return True
    if b"\x00" in sample:
        return False
    decoded = sample.decode("utf-8", errors="replace")
    if not decoded:
        return False
    replacement_ratio = decoded.count("\ufffd") / len(decoded)
    if replacement_ratio > 0.05:
        return False
    control_chars = sum(
        1
        for char in decoded
        if ord(char) < 32 and char not in "\n\r\t\f\b"
    )
    return control_chars / len(decoded) <= 0.10


def iter_index_candidates(root: pathlib.Path, pattern: str | None) -> list[pathlib.Path]:
    if root.is_file():
        return [root] if is_probably_text_file(root) else []

    normalized = (pattern or AUTO_INDEX_GLOB).strip() or AUTO_INDEX_GLOB
    candidates = []
    for dirpath, dirnames, filenames in os.walk(root):
        dirnames[:] = [
            dirname
            for dirname in dirnames
            if dirname not in SKIP_INDEX_DIR_NAMES
        ]
        current = pathlib.Path(dirpath)
        for filename in sorted(filenames):
            candidate = current / filename
            rel = candidate.relative_to(root)
            if normalized != AUTO_INDEX_GLOB and not (
                fnmatch.fnmatch(filename, normalized)
                or fnmatch.fnmatch(str(rel), normalized)
            ):
                continue
            if is_probably_text_file(candidate):
                candidates.append(candidate)
    return sorted(candidates)


def plan_document_index(path: str, pattern: str | None = AUTO_INDEX_GLOB) -> dict:
    root = pathlib.Path(path).expanduser().resolve()
    require_allowed(root)
    if not root.exists():
        raise SystemExit(f"not found: {root}")
    candidates = iter_index_candidates(root, pattern)
    total_bytes = 0
    largest: list[tuple[int, pathlib.Path]] = []
    for candidate in candidates:
        try:
            size = candidate.stat().st_size
        except OSError:
            continue
        total_bytes += size
        largest.append((size, candidate))
    largest.sort(reverse=True)
    return {
        "root": str(root),
        "glob": pattern or AUTO_INDEX_GLOB,
        "files": len(candidates),
        "bytes": total_bytes,
        "largest": largest[:5],
    }


def print_index_plan(path: str, pattern: str | None = AUTO_INDEX_GLOB) -> None:
    plan = plan_document_index(path, pattern)
    print(f"root: {plan['root']}")
    print(f"glob: {plan['glob']}")
    print(f"candidate files: {plan['files']}")
    print(f"source bytes: {human_bytes(plan['bytes'])}")
    if plan["largest"]:
        print("largest files:")
        for size, candidate in plan["largest"]:
            print(f"  {human_bytes(size):>10}  {candidate}")


def context_item_from_file(path: str) -> dict:
