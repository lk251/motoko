def spinner_frames() -> list[str]:
    mode = os.environ.get("MOTOKO_SPINNER", "auto").strip().lower()
    if mode in {"0", "false", "no", "none", "off"}:
        return []
    if mode == "auto":
        return ["/", "|", "\\", "-"]
    if mode == "ascii":
        return ["/", "|", "\\", "-"]
    if mode in {"block", "blink", "square"}:
        return ["■", " "]
    if mode == "braille":
        return ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"]

    custom = os.environ.get("MOTOKO_SPINNER_CHARS", "").strip()
    if custom:
        return list(custom)

    return ["/", "|", "\\", "-"]


class ThinkingSpinner:
    def __init__(self, *, enabled: bool) -> None:
        self.frames = spinner_frames() if enabled and sys.stdout.isatty() else []
        self._stop = threading.Event()
        self._thread: threading.Thread | None = None
        self._active = False

    def start(self) -> None:
        if not self.frames:
            return
        self._active = True
        self._thread = threading.Thread(target=self._run, daemon=True)
        self._thread.start()

    def stop(self) -> None:
        if not self._active:
            return
        self._stop.set()
        if self._thread is not None:
            self._thread.join(timeout=0.4)
        self._active = False

    def _run(self) -> None:
        idx = 0
        while not self._stop.is_set():
            sys.stdout.write(self.frames[idx % len(self.frames)])
            sys.stdout.flush()
            self._stop.wait(0.12)
            sys.stdout.write("\b \b")
            sys.stdout.flush()
            idx += 1
            self._stop.wait(0.04)


