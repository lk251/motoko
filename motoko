    def dropdown_options(self) -> list[dict]:
        text = self.input_buffer[: self.cursor]
        stripped = text.lstrip()
        if not stripped.startswith("/"):
            return []
        words = stripped.split()
        if " " not in stripped:
            prefix = stripped or "/"
            options = []
            for command, description in SLASH_COMMANDS:
                value = slash_command_value(command)
                if value.startswith(prefix) or command.startswith(prefix):
                    options.append({"kind": "command", "value": value, "label": command, "description": description})
            return options
        first = words[0] if words else ""
        current = words[-1] if words and not stripped.endswith(" ") else ""
        if first == "/resume" and len(words) <= 2:
            return [
                {"kind": "conversation", "value": row.get("id", ""), "label": conversation_label(row), "description": ""}
                for row in list_conversations()
                if not current or item_matches_selector(row, current)
            ][:20]
        if first == "/memory" and len(words) <= 2:
            options = []
            for command, description in SLASH_COMMANDS:
                if not command.startswith("/memory "):
                    continue
                value = slash_command_value(command)
                suffix = value.split(maxsplit=1)[1] if " " in value else value
                if not current or suffix.startswith(current) or value.startswith(stripped):
                    options.append({"kind": "command", "value": value, "label": command, "description": description})
            return options
        if first in {"/attach-index", "/topic", "/deepen"} and len(words) <= 2:
            return [
                {"kind": "index", "value": row.get("id", ""), "label": index_label(row), "description": row.get("root", "")}
                for row in list_indexes()
                if not current or item_matches_selector(row, current)
            ][:20]
        if first in {"/attach-topic", "/topic-show"} and len(words) <= 2:
            return [
                {"kind": "topic", "value": row.get("id", ""), "label": topic_label(row), "description": row.get("query", "")}
                for row in list_topics()
                if not current or item_matches_selector(row, current)
            ][:20]
        if first in {"/attach-dossier", "/dossier-show"} and len(words) <= 2:
            return [
                {"kind": "dossier", "value": row.get("id", ""), "label": dossier_label(row), "description": row.get("query", "")}
                for row in list_dossiers()
                if not current or item_matches_selector(row, current)
            ][:20]
        return []

    def apply_dropdown(self, option: dict) -> None:
        kind = option["kind"]
        value = option["value"]
        if kind == "command":
            if value in SIMPLE_SLASH_COMMANDS:
                self.input_buffer = ""
                self.cursor = 0
                self.submit_text(value)
                return
            self.input_buffer = value + " "
            self.cursor = len(self.input_buffer)
            self.dropdown_index = 0
            self.dirty = True
            return
        first = self.input_buffer.lstrip().split()[0] if self.input_buffer.lstrip().split() else ""
        if kind == "conversation":
            self.input_buffer = f"/resume {value}"
            self.cursor = len(self.input_buffer)
            self.submit_text(self.input_buffer)
            self.input_buffer = ""
            self.cursor = 0
            return
        if kind == "index":
            if first in {"/topic", "/deepen"}:
                self.input_buffer = f"/topic {value} "
                if first == "/deepen":
                    self.input_buffer = f"/deepen {value} "
                self.cursor = len(self.input_buffer)
            else:
                self.input_buffer = f"{first} {value}"
                self.cursor = len(self.input_buffer)
                self.submit_text(self.input_buffer)
                self.input_buffer = ""
                self.cursor = 0
            self.dropdown_index = 0
            self.dirty = True
            return
        if kind == "topic":
            if first == "/topic-show":
                self.input_buffer = f"/topic-show {value}"
            else:
                self.input_buffer = f"/attach-topic {value}"
            self.cursor = len(self.input_buffer)
            self.submit_text(self.input_buffer)
            self.input_buffer = ""
            self.cursor = 0
        if kind == "dossier":
            if first == "/dossier-show":
                self.input_buffer = f"/dossier-show {value}"
            else:
                self.input_buffer = f"/attach-dossier {value}"
            self.cursor = len(self.input_buffer)
            self.submit_text(self.input_buffer)
            self.input_buffer = ""
            self.cursor = 0

    def render(self, *, force: bool = False) -> None:
        self.drain_events()
        size = self.terminal_size()
        width, height = size.columns, size.lines
        width = max(40, width)
        height = max(12, height)
        content_width = max(20, width - 1)
        options = self.dropdown_options()
        if options:
            self.dropdown_index = min(self.dropdown_index, len(options) - 1)
        else:
            self.dropdown_index = 0
        input_lines, cursor_row_offset, cursor_col = self.input_display(content_width)
        dropdown_lines = self.dropdown_display(content_width, options)
        title = (
            f" {style('Motoko', 'purple', 'bold')}  "
            f"{style(self.conv.get('title', 'Untitled'), 'turquoise', 'bold')}  "
            f"{style(model_badge(), 'dim')}"
        )
        spinner = self.tui_spinner_frames[self.tui_spinner_index % len(self.tui_spinner_frames)] if self.tui_spinner_frames else ""
        status_parts = []
        if self.generating:
            status_parts.append(style(f"{spinner} chat: answering", "turquoise"))
        elif not self.maintaining:
            status_parts.append(style(self.status, "turquoise"))
        if self.maintaining:
            elapsed = int(time.monotonic() - self.maintenance_phase_started)
            phase = self.maintenance_status or self.status
            label = "mem: proposing(model)" if phase == "memory: proposing" else f"mem: {phase}"
            status_parts.append(style(f"{spinner} {label} {human_duration(elapsed)}".rstrip(), "turquoise"))
        if self.pending_prompts:
            status_parts.append(style(f"queued:{len(self.pending_prompts)}", "yellow"))
        if self.study_running:
            elapsed = int(time.monotonic() - self.study_phase_started)
            status_parts.append(style(f"{spinner} {self.study_status_label()} {human_duration(elapsed)}".rstrip(), "turquoise"))
        elif self.study_status == "study: off":
            status_parts.append(style("bg: off", "dim"))
        elif self.study_last_note:
            status_parts.append(style(f"bg: idle ({self.study_last_note})", "dim"))
        else:
            status_parts.append(style("bg: idle", "dim"))
        if status_parts:
            title += "  " + "  ".join(status_parts)
        title_lines = wrap_display_line(title, content_width)
        max_title_lines = max(1, height - (3 + len(dropdown_lines) + 1 + len(input_lines)))
        if len(title_lines) > max_title_lines:
            title_lines = title_lines[:max_title_lines]
            plain = strip_ansi(title_lines[-1])
            title_lines[-1] = plain[: max(0, content_width - 1)].rstrip() + "…"
        title_height = len(title_lines)
        reserve = title_height + len(dropdown_lines) + 1 + len(input_lines)
        body_height = max(3, height - reserve)
        if self.overlay_lines is not None:
            body_lines = self.overlay_display(content_width)
            max_scroll = max(0, len(body_lines) - body_height)
            self.overlay_scroll = min(self.overlay_scroll, max_scroll)
            visible = body_lines[self.overlay_scroll : self.overlay_scroll + body_height]
        else:
            body_lines = self.body_display(content_width)
            max_scroll = max(0, len(body_lines) - body_height)
            self.scroll = min(self.scroll, max_scroll)
            if self.scroll:
                start = max(0, len(body_lines) - body_height - self.scroll)
                visible = body_lines[start : start + body_height]
            else:
                visible = body_lines[-body_height:]

        rows = []
        rows.extend(title_lines)
        rows.extend(visible)
        while len(rows) < title_height + body_height:
            rows.append("")
        rows.extend(dropdown_lines)
        rows.append(style("─" * content_width, "dim"))
        rows.extend(input_lines)
        screen = "\033[H" + "\n".join(f"{row}\033[K" for row in rows[:height])
        screen += "\033[J"
        input_start_row = title_height + body_height + len(dropdown_lines) + 2
        cursor_row = min(height, input_start_row + cursor_row_offset)
        screen += f"\033[{cursor_row};{min(content_width, cursor_col)}H\033[?25h"
        self.write(screen)
        if self.generating or self.maintaining or self.study_running:
            self.tui_spinner_index += 1
        self.last_render = time.monotonic()
        self.dirty = False

    def study_status_label(self) -> str:
        if self.index_progress:
            return format_index_progress_status(self.index_progress)
        phase = self.study_status
        if phase.startswith("bg-heavy:"):
            return phase
        if "profile" in phase:
            return "bg-heavy: profile(model)"
        if "index" in phase:
            return "bg-heavy: indexing(model)"
        if "catalog" in phase:
            return "bg-light: catalog(cpu)"
        if "planning" in phase:
            return "bg-light: planning(cpu)"
        if "scanning" in phase:
            return "bg-light: scanning(cpu)"
        return f"bg: {phase}"

    def body_display(self, width: int) -> list[str]:
        lines = []
        code = False
        for entry in self.messages:
            role = entry.get("role", "?")
            content = entry.get("content", "")
            if role == "user":
                prefix = style("> ", "turquoise", "bold")
            elif role == "assistant":
                prefix = style("Motoko ", "purple", "bold")
            elif role == "queued":
                prefix = style("queued ", "yellow", "bold")
            elif role == "error":
                prefix = style("error ", "red", "bold")
            elif role == "summary":
                prefix = style("summary ", "magenta", "bold")
            else:
                prefix = style("sys ", "yellow", "bold")
            wrapped = []
            for raw_line in content.splitlines() or [""]:
                if raw_line.startswith("```"):
                    code = not code
                    wrapped.extend(wrap_display_line(style(raw_line, "magenta"), width - len(strip_ansi(prefix))))
                    continue
                if code:
                    wrapped.extend(wrap_display_line(style(raw_line, "green"), width - len(strip_ansi(prefix))))
                elif raw_line.startswith(("/", "motoko ")):
                    wrapped.extend(wrap_display_line(style(raw_line, "turquoise"), width - len(strip_ansi(prefix))))
                elif raw_line.startswith(("- ", "* ", "  /", "  motoko")):
                    wrapped.extend(wrap_display_line(style(raw_line, "dim"), width - len(strip_ansi(prefix))))
                else:
                    wrapped.extend(wrap_display_line(raw_line, width - len(strip_ansi(prefix))))
            for idx, line in enumerate(wrapped):
                lines.append((prefix if idx == 0 else " " * len(strip_ansi(prefix))) + line)
            lines.append("")
        return lines or [""]

    def overlay_display(self, width: int) -> list[str]:
        rows = []
        title = self.overlay_title or "help"
        rows.extend(wrap_display_line(style(title, "purple", "bold") + style("  q/Esc closes", "dim"), width))
        rows.append("")
        for raw in self.overlay_lines or []:
            if raw.endswith(":") and not raw.startswith(" "):
                text = style(raw, "turquoise", "bold")
            elif raw.startswith("  /") or raw.startswith("  motoko"):
                command, sep, rest = raw.strip().partition("  ")
                text = "  " + style(command, "turquoise", "bold") + (sep + style(rest, "dim") if sep else "")
            else:
                text = raw
            rows.extend(wrap_display_line(text, width))
        return rows or [""]

    def dropdown_display(self, width: int, options: list[dict]) -> list[str]:
        if not options:
            return []
        max_rows = min(8, len(options))
        start = min(
            max(0, self.dropdown_index - max_rows + 1),
            max(0, len(options) - max_rows),
        )
        visible_options = options[start : start + max_rows]
        rows = []
        for offset, option in enumerate(visible_options):
            idx = start + offset
            marker = ">" if idx == self.dropdown_index else " "
            label = strip_ansi(str(option.get("label", "")))
            description = strip_ansi(str(option.get("description", "")))
            text = f" {marker} {label}"
            if description:
                remaining = max(0, width - len(strip_ansi(text)) - 3)
                text += "  " + description[:remaining]
            if idx == self.dropdown_index:
                rows.append(style(text[:width], "bold", "purple"))
            else:
                rows.append(text[:width])
        return rows

    def input_display(self, width: int) -> tuple[list[str], int, int]:
        return fixed_prompt_input_display(self.input_buffer, self.cursor, width)

    def terminal_size(self) -> os.terminal_size:
        try:
            return os.get_terminal_size(self.stdout_fd)
        except OSError:
            return shutil.get_terminal_size((80, 24))


def chat_loop(conv: dict) -> None:
    if tui_enabled():
        try:
            MotokoTui(conv).run()
            return
        except Exception as exc:
            print(f"Motoko TUI failed; falling back to line mode: {exc}", file=sys.stderr)
    setup_readline_completion()
    print(f"{style('Motoko', 'purple', 'bold')} {style('conversation:', 'turquoise', 'bold')} {style(conv['title'], 'turquoise')} [{style(conv['id'], 'yellow')}]")
    print("Type /help for commands, /exit to save and leave.")
    resume_maintenance, resume_note = resume_interrupted_maintenance(conv)
    if resume_note:
        print(f"sys {resume_note}")
    if resume_maintenance:
        print("sys resuming memory maintenance")
        state = begin_maintenance_state(conv, resumed=True)
        try:
            notes = auto_maintain_conversation(
                conv,
                phase_callback=lambda phase: print(f"sys {phase}"),
                state=state,
            )
            clear_maintenance_state(state.get("job_id"))
            if notes:
                print(f"sys {'; '.join(notes)}")
        except Exception as exc:
            update_maintenance_state(
                state,
                "memory: failed",
                status="failed",
                error=f"{type(exc).__name__}: {exc}",
            )
            print(f"sys memory maintenance failed: {type(exc).__name__}: {exc}")
    while True:
        try:
            user_text = motoko_input("\n> ").strip()
        except (EOFError, KeyboardInterrupt):
