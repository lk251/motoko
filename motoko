def nix_managed_config_message(path: pathlib.Path, description: str) -> str | None:
    if not path.is_symlink():
        return None
    target = path.resolve(strict=False)
    if not str(target).startswith("/nix/store/"):
        return None
    return (
        f"cannot update Motoko {description} at {path}: it is Nix-managed "
        f"and points to {target}. Update the NixOS/Home Manager configuration "
        "that defines this file, then rebuild or activate it."
    )


def add_allowed_dir(path: str) -> None:
