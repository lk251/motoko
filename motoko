    personality_path_cmd = personality_sub.add_parser("path", help="print personality file path")
    personality_path_cmd.set_defaults(func=command_personality)
    personality_init = personality_sub.add_parser("init", help="write the default personality template")
    personality_init.add_argument("--force", action="store_true")
    personality_init.set_defaults(func=command_personality)
    personality.set_defaults(func=command_personality)

    profile = sub.add_parser("profile", help="show or refresh Motoko's profile dossier")
    profile_sub = profile.add_subparsers(dest="profile_command")
    profile_show = profile_sub.add_parser("show", help="show the profile dossier")
    profile_show.set_defaults(func=command_profile)
    profile_refresh = profile_sub.add_parser("refresh", help="rebuild the profile dossier")
    profile_refresh.set_defaults(func=command_profile)
    profile_path_cmd = profile_sub.add_parser("path", help="print profile dossier path")
    profile_path_cmd.set_defaults(func=command_profile)
    profile.set_defaults(func=command_profile)

    remember = sub.add_parser("remember", help="save a memory")
    remember.add_argument("text", nargs="+")
    remember.set_defaults(func=command_remember)

    allow_dir = sub.add_parser("allow-dir", help="allow document reads under a directory")
    allow_dir.add_argument("path")
    allow_dir.set_defaults(func=lambda args: add_allowed_dir(args.path))

    args = parser.parse_args(argv)
    if args.command is None:
        args = parser.parse_args(["chat"])
    args.func(args)
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
