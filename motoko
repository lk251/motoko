def normalize_ui_color(value, default: str = DEFAULT_ASSISTANT_COLOR) -> str:
    if isinstance(value, str):
        candidate = value.strip().lower()
        candidate = UI_COLOR_ALIASES.get(candidate, candidate)
        if candidate in UI_COLOR_NAMES:
            return candidate
    return default


