def format_model_routes(*, include_defaults: bool = False) -> str:
    lines = [
        "Model routes:",
        "  status/control source: motoko-model for NixOS Unix-socket routes; Motoko does not call systemctl.",
        "  note: backend=active is service state, not proof that full model weights are resident in VRAM.",
        "  use /models for live route status and /model-stop ROUTE for an explicit stop.",
    ]
    base_endpoint = endpoint()
    base_model = model_name()
    for route in configured_model_routes():
        info = model_route(route)
        is_default = info["endpoint"] == base_endpoint and info["model"] == base_model
        if not include_defaults and is_default and route != MODEL_ROUTE_CHAT:
            continue
        marker = "default" if is_default else "configured"
        manager = f"; manager={info['manager_kind']}" if info.get("manager_kind") else ""
        catalog_route = f"; catalog={info['catalog_route']}" if info.get("catalog_route") else ""
        profile = f"; profile={info['route_profile']}" if info.get("route_profile") else ""
        kv_cache = info.get("kv_cache") if isinstance(info.get("kv_cache"), dict) else {}
        kv_location = str(kv_cache.get("location") or "").strip()
        kv = f"; KV={kv_location}" if kv_location else ""
        policy_text = "".join(
            [
                format_route_cache_policy(info),
                format_route_request_policy(info),
                format_route_scheduling_policy(info),
                format_route_safety_policy(info),
            ]
        )
        lines.append(
            f"  {route}: {info['model']} endpoint={info['endpoint']} "
            f"({marker}; lane={model_route_lane(route)}{manager}{catalog_route}{profile}{kv}{policy_text}; {info['description']})"
        )
    lines.append("")
    lines.append(format_chat_route_governor())
    return "\n".join(lines)


def format_chat_route_governor() -> str:
    candidates = chat_route_candidates()
    lines = [
        "Chat context governor:",
        f"  schema: {CONTEXT_GOVERNOR_SCHEMA_VERSION}",
        f"  mode: {chat_context_mode()} ({CHAT_CONTEXT_MODE_ENV}=auto|default|quality|deep|max)",
        (
            "  soft tiers: "
            f"default<={CHAT_CONTEXT_DEFAULT_SOFT_TOKENS}tok, "
            f"deep<={CHAT_CONTEXT_DEEP_SOFT_TOKENS}tok, "
            f"max<={CHAT_CONTEXT_MAX_SOFT_TOKENS}tok"
        ),
    ]
    if not candidates:
        lines.append("  candidates: none; using configured chat route")
        return "\n".join(lines)
    lines.append("  candidates:")
    for info in candidates:
        route_id = info.get("catalog_route") or info.get("route", "")
        tier = route_governor_tier(info)
        ctx = route_context_limit(info)
        quant = f" quant={info.get('quant')}" if info.get("quant") else ""
        profile = f" profile={info.get('route_profile')}" if info.get("route_profile") else ""
        default = " default" if route_selection_default_value(info) else ""
        kv_cache = info.get("kv_cache") if isinstance(info.get("kv_cache"), dict) else {}
        kv_location = str(kv_cache.get("location") or "").strip()
        kv = f" KV={kv_location}" if kv_location else ""
        lines.append(
            f"    - {route_id}: {tier}{profile}{default} ctx={ctx}{quant}{kv} model={info.get('model', '')}"
        )
    return "\n".join(lines)


