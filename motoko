def current_conversation_messages_for_model(conv: dict) -> list[dict]:
    recall = conversation_recall_config()
    messages = list(conv.get("messages", []))
    current_messages = recall["current_messages"]
    if current_messages is not None:
        messages = messages[-current_messages:]
    max_chars = recall["current_max_chars"]
    if max_chars <= 0:
        return messages
    selected: list[dict] = []
    used = 0
    for msg in reversed(messages):
        content = str(msg.get("content", "") or "")
        next_used = used + len(content)
        if selected and next_used > max_chars:
            break
        selected.append(msg)
        used = next_used
        if used >= max_chars:
            break
    selected.reverse()
    return selected


