APP = "motoko"
DEFAULT_ENDPOINT = "http://127.0.0.1:8082/v1/chat/completions"
DEFAULT_MODEL = "qwen3.6-27b-ud-q5-k-xl"
MAX_CONTEXT_BYTES = 96 * 1024
MAX_CONTEXT_FILES = 24
INDEX_CHUNK_CHARS = 12000
SUMMARY_INPUT_CHARS = 14000
RETRIEVAL_TOP_CHUNKS = 6
RETRIEVAL_TOP_FILES = 8
MAX_RETRIEVAL_CHARS = 56000
MAX_MEMORY_CHARS = 1800
MAX_CONVERSATION_SUMMARY_CHARS = 12000
MAX_RECENT_MESSAGES = 24
COMPACT_KEEP_MESSAGES = 8
MAX_PERSONALITY_CHARS = 12000

DEFAULT_PERSONALITY = """
Motoko should be warm, attentive, and calm. She should sound like a trusted
personal conversation partner: direct, honest, emotionally present, and
genuinely interested in Javier's life, projects, memories, and preferences.
She may show gentle enthusiasm, but should not exaggerate certainty, flatter,
or pretend to know things that are not in context. She should preserve privacy,
ask clarifying questions only when useful, and keep a thoughtful, grounded tone.
""".strip()


def now() -> str:
    return _dt.datetime.now(_dt.timezone.utc).astimezone().isoformat(timespec="seconds")


def state_root() -> pathlib.Path:
    root = os.environ.get("MOTOKO_STATE_HOME")
    if root:
        return pathlib.Path(root).expanduser()
    xdg_state = os.environ.get("XDG_STATE_HOME")
    if xdg_state:
        return pathlib.Path(xdg_state).expanduser() / APP
    return pathlib.Path.home() / ".local" / "state" / APP


def config_root() -> pathlib.Path:
    root = os.environ.get("MOTOKO_CONFIG_HOME")
    if root:
        return pathlib.Path(root).expanduser()
    xdg_config = os.environ.get("XDG_CONFIG_HOME")
    if xdg_config:
        return pathlib.Path(xdg_config).expanduser() / APP
    return pathlib.Path.home() / ".config" / APP


def ensure_private_dir(path: pathlib.Path) -> pathlib.Path:
    path.mkdir(parents=True, exist_ok=True)
    path.chmod(0o700)
    return path


def conversations_dir() -> pathlib.Path:
    root = ensure_private_dir(state_root())
    return ensure_private_dir(root / "conversations")


def memories_path() -> pathlib.Path:
    root = ensure_private_dir(state_root())
    return root / "memories.jsonl"


def indexes_dir() -> pathlib.Path:
    root = ensure_private_dir(state_root())
    return ensure_private_dir(root / "indexes")


def allowdirs_path() -> pathlib.Path:
    root = ensure_private_dir(config_root())
    return root / "allowdirs"


def personality_path() -> pathlib.Path:
    root = ensure_private_dir(config_root())
    return root / "personality.md"


def conversation_path(conversation_id: str) -> pathlib.Path:
    return conversations_dir() / f"{conversation_id}.json"


def index_path(index_id: str) -> pathlib.Path:
    return indexes_dir() / f"{index_id}.json"


def index_data_dir(index_id: str) -> pathlib.Path:
    return ensure_private_dir(indexes_dir() / f"{index_id}.chunks")


def atomic_write(path: pathlib.Path, text: str) -> None:
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(text, encoding="utf-8")
    tmp.chmod(0o600)
    tmp.replace(path)


def slug_title(text: str) -> str:
    words = re.findall(r"[\w'-]+", text.strip(), re.UNICODE)
    if not words:
        return "Untitled"
    title = " ".join(words[:8])
    return title[:80]


def new_conversation(title: str | None = None) -> dict:
    cid = _dt.datetime.now().strftime("%Y%m%d-%H%M%S") + "-" + uuid.uuid4().hex[:6]
    created = now()
    return {
        "id": cid,
        "title": title or "Untitled",
        "created": created,
        "updated": created,
        "endpoint": endpoint(),
        "model": model_name(),
        "messages": [],
        "context_items": [],
    }


def save_conversation(conv: dict) -> None:
    conv["updated"] = now()
    atomic_write(conversation_path(conv["id"]), json.dumps(conv, ensure_ascii=False, indent=2) + "\n")


def load_conversation(conversation_id: str) -> dict:
    matches = sorted(conversations_dir().glob(f"{conversation_id}*.json"))
    if not matches:
        matches = sorted(conversations_dir().glob(f"*{conversation_id}*.json"))
    if len(matches) != 1:
        raise SystemExit(f"conversation id must match exactly one conversation; matched {len(matches)}")
    return json.loads(matches[0].read_text(encoding="utf-8"))


def list_conversations() -> list[dict]:
    rows = []
    for path in sorted(conversations_dir().glob("*.json"), reverse=True):
        try:
            conv = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            continue
        rows.append(conv)
    return rows


def endpoint() -> str:
    return os.environ.get("MOTOKO_ENDPOINT", DEFAULT_ENDPOINT)


def model_name() -> str:
    return os.environ.get("MOTOKO_MODEL", DEFAULT_MODEL)


def memory_id() -> str:
    return "mem-" + uuid.uuid4().hex[:10]


def read_memory_rows() -> list[dict]:
    path = memories_path()
    if not path.exists():
        return []
    rows = []
    for line in path.read_text(encoding="utf-8").splitlines():
        if not line.strip():
            continue
        try:
            rows.append(json.loads(line))
        except json.JSONDecodeError:
            continue
    return rows


def normalize_memory_row(row: dict, ordinal: int) -> dict:
    normalized = dict(row)
    normalized.setdefault("id", f"legacy-{ordinal:04d}")
    normalized.setdefault("created", "")
    normalized.setdefault("source", "unknown")
    normalized.setdefault("text", "")
    return normalized


def load_memories(limit: int = 80) -> list[dict]:
    rows = [normalize_memory_row(row, idx) for idx, row in enumerate(read_memory_rows(), 1)]
    return rows[-limit:]


def write_memory_rows(rows: list[dict]) -> None:
    text = "".join(json.dumps(row, ensure_ascii=False) + "\n" for row in rows)
    atomic_write(memories_path(), text)


def add_memory(
    text: str,
    source: str = "manual",
    *,
    conversation_id: str | None = None,
    derived_from: str | None = None,
) -> None:
    text = text.strip()
    if not text:
        raise SystemExit("empty memory")
    row = {
        "id": memory_id(),
        "created": now(),
        "source": source,
        "text": text[:MAX_MEMORY_CHARS],
    }
    if conversation_id:
        row["conversation_id"] = conversation_id
    if derived_from:
        row["derived_from"] = derived_from
    with memories_path().open("a", encoding="utf-8") as fh:
        fh.write(json.dumps(row, ensure_ascii=False) + "\n")
    memories_path().chmod(0o600)


def resolve_memory(rows: list[dict], selector: str) -> tuple[int, dict]:
    normalized = [normalize_memory_row(row, idx) for idx, row in enumerate(rows, 1)]
    if selector.isdigit():
        idx = int(selector) - 1
        if 0 <= idx < len(normalized):
            return idx, normalized[idx]
    matches = [
        (idx, row)
        for idx, row in enumerate(normalized)
        if row.get("id") == selector or row.get("id", "").startswith(selector)
    ]
    if len(matches) != 1:
        raise SystemExit(f"memory selector must match exactly one memory; matched {len(matches)}")
    return matches[0]


def edit_memory(selector: str, text: str) -> None:
    rows = [normalize_memory_row(row, idx) for idx, row in enumerate(read_memory_rows(), 1)]
    idx, row = resolve_memory(rows, selector)
    row["text"] = text.strip()[:MAX_MEMORY_CHARS]
    row["updated"] = now()
    rows[idx] = row
    write_memory_rows(rows)
    print(f"memory updated: {row['id']}")


def forget_memory(selector: str) -> None:
    rows = [normalize_memory_row(row, idx) for idx, row in enumerate(read_memory_rows(), 1)]
    idx, row = resolve_memory(rows, selector)
    del rows[idx]
    write_memory_rows(rows)
    print(f"memory forgotten: {row['id']}")


def print_memories(*, verbose: bool = False) -> None:
    memories = load_memories(limit=500)
    if not memories:
        print("No memories yet.")
        return
    for idx, row in enumerate(memories, 1):
        prefix = f"{idx:3d}  {row.get('id', '')}  {row.get('created', '')}"
        print(f"{prefix}  {row.get('text', '')}")
        if verbose:
            print(f"     source: {row.get('source', 'unknown')}")
            if row.get("conversation_id"):
                print(f"     conversation: {row.get('conversation_id')}")
            if row.get("derived_from"):
                print(f"     derived from: {row.get('derived_from')}")


def allowed_dirs() -> list[pathlib.Path]:
    path = allowdirs_path()
    if not path.exists():
        return []
    dirs = []
    for line in path.read_text(encoding="utf-8").splitlines():
        line = line.strip()
        if line and not line.startswith("#"):
            dirs.append(pathlib.Path(line).expanduser().resolve())
    return dirs


def add_allowed_dir(path: str) -> None:
    resolved = pathlib.Path(path).expanduser().resolve()
    if not resolved.is_dir():
        raise SystemExit(f"not a directory: {resolved}")
    existing = allowed_dirs()
    if resolved not in existing:
        with allowdirs_path().open("a", encoding="utf-8") as fh:
            fh.write(str(resolved) + "\n")
        allowdirs_path().chmod(0o600)
    print(f"allowed: {resolved}")


def load_personality() -> tuple[str, str, bool]:
    path = personality_path()
    if not path.exists():
        return DEFAULT_PERSONALITY, str(path), False
    try:
        text = path.read_text(encoding="utf-8").strip()
    except OSError as exc:
        raise SystemExit(f"cannot read personality file {path}: {exc}") from exc
    if not text:
        return DEFAULT_PERSONALITY, str(path), True
    return text[:MAX_PERSONALITY_CHARS], str(path), True


def init_personality(*, force: bool = False) -> None:
    path = personality_path()
    if path.exists() and not force:
        print(f"personality file already exists: {path}")
        return
    template = textwrap.dedent(
        f"""
        # Motoko Personality

        {DEFAULT_PERSONALITY}

        # Edit this file to define Motoko's style, tone, warmth, enthusiasm,
        # directness, and conversational personality. Free-form prose is more
        # likely to work well than numeric sliders.
        #
        # This file shapes tone and style. It should not override factual
        # accuracy, privacy boundaries, source-grounding, or explicit safety
        # constraints in Motoko's system prompt.
        """
    ).strip() + "\n"
    atomic_write(path, template)
    print(f"personality file written: {path}")


def print_personality() -> None:
    text, path, exists = load_personality()
    status = "custom" if exists else "default"
    print(f"path: {path}")
    print(f"status: {status}")
    print()
    print(text)


def is_under(path: pathlib.Path, root: pathlib.Path) -> bool:
    try:
        path.relative_to(root)
        return True
    except ValueError:
        return False


def require_allowed(path: pathlib.Path) -> None:
    resolved = path.expanduser().resolve()
    dirs = allowed_dirs()
    if not dirs:
        raise SystemExit(
            "Motoko has no allowed document directories yet; run 'motoko allow-dir DIR' first"
        )
    if any(resolved == directory or is_under(resolved, directory) for directory in dirs):
        return
    raise SystemExit(
        f"{resolved} is outside Motoko's allowed directories; run 'motoko allow-dir DIR' first"
    )


def read_text_file(path: pathlib.Path) -> str:
    require_allowed(path)
    data = path.read_bytes()
    if len(data) > MAX_CONTEXT_BYTES:
        data = data[:MAX_CONTEXT_BYTES]
    return data.decode("utf-8", errors="replace")


def context_item_from_file(path: str) -> dict:
    resolved = pathlib.Path(path).expanduser().resolve()
    if not resolved.is_file():
        raise SystemExit(f"not a file: {resolved}")
    text = read_text_file(resolved)
    return {
        "kind": "file",
        "path": str(resolved),
        "bytes": len(text.encode("utf-8")),
        "content": text,
    }


def context_items_from_dir(path: str, pattern: str) -> list[dict]:
    root = pathlib.Path(path).expanduser().resolve()
    require_allowed(root)
    if not root.is_dir():
        raise SystemExit(f"not a directory: {root}")
    items = []
    for candidate in sorted(root.rglob(pattern)):
        if len(items) >= MAX_CONTEXT_FILES:
            break
        if candidate.is_file():
            try:
                items.append(context_item_from_file(str(candidate)))
            except OSError:
                continue
    return items


def load_index(index_id: str) -> dict:
    matches = sorted(indexes_dir().glob(f"{index_id}*.json"))
    if not matches:
        matches = sorted(indexes_dir().glob(f"*{index_id}*.json"))
    if len(matches) != 1:
        raise SystemExit(f"index id must match exactly one document index; matched {len(matches)}")
    return json.loads(matches[0].read_text(encoding="utf-8"))


def list_indexes() -> list[dict]:
    rows = []
    for path in sorted(indexes_dir().glob("*.json"), reverse=True):
        try:
            rows.append(json.loads(path.read_text(encoding="utf-8")))
        except (OSError, json.JSONDecodeError):
            continue
    return rows


def token_counts(text: str) -> collections.Counter:
    words = re.findall(r"[A-Za-z0-9_'-]{3,}", text.lower())
    return collections.Counter(words)


def score_text(query_counts: collections.Counter, text: str) -> int:
    if not query_counts:
        return 0
    counts = token_counts(text)
    return sum(min(counts.get(word, 0), count) for word, count in query_counts.items())


def split_text(text: str, size: int = INDEX_CHUNK_CHARS) -> list[str]:
    chunks = []
    start = 0
    while start < len(text):
        end = min(len(text), start + size)
        if end < len(text):
            boundary = text.rfind("\n\n", start, end)
            if boundary > start + size // 2:
                end = boundary
        chunks.append(text[start:end].strip())
        start = end
    return [chunk for chunk in chunks if chunk]


def sha256_hex(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def sha256_file(path: pathlib.Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as fh:
        for chunk in iter(lambda: fh.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def source_fingerprint(path: pathlib.Path) -> dict:
    stat = path.stat()
    return {
        "size": stat.st_size,
        "mtime_ns": stat.st_mtime_ns,
        "sha256": sha256_file(path),
    }


def file_staleness(file_item: dict) -> tuple[str, list[str]]:
    path = pathlib.Path(file_item.get("path", "")).expanduser()
    expected = file_item.get("source_fingerprint") or {}
    if not expected:
        return "unknown", [f"{path}: no fingerprint stored; rebuild index to enable stale checks"]
    if not path.exists():
        return "stale", [f"{path}: missing"]
    try:
        current_stat = path.stat()
    except OSError as exc:
        return "stale", [f"{path}: cannot stat file: {exc}"]

    warnings = []
    if current_stat.st_size != expected.get("size"):
        warnings.append(
            f"{path}: size changed from {expected.get('size')} to {current_stat.st_size}"
        )
    if current_stat.st_mtime_ns != expected.get("mtime_ns"):
        warnings.append(f"{path}: mtime changed")
    if warnings:
        try:
            current_hash = sha256_file(path)
            if current_hash == expected.get("sha256"):
                return "mtime-only", [f"{path}: metadata changed but content hash still matches"]
            warnings.append(f"{path}: content hash changed")
        except OSError as exc:
            warnings.append(f"{path}: cannot hash current file: {exc}")
        return "stale", warnings
    return "fresh", []


def index_staleness(index: dict) -> tuple[str, list[str]]:
    statuses = []
    warnings = []
    for file_item in index.get("files", []):
        status, file_warnings = file_staleness(file_item)
        statuses.append(status)
        warnings.extend(file_warnings)
    if not statuses:
        return "empty", ["index has no files"]
    if "stale" in statuses:
        return "stale", warnings
    if "unknown" in statuses:
        return "unknown", warnings
    if "mtime-only" in statuses:
        return "metadata-changed", warnings
    artifact_warnings = index_artifact_warnings(index)
    if artifact_warnings:
        return "stale", warnings + artifact_warnings
    return "fresh", warnings


def quiet_model(messages: list[dict], *, temperature: float = 0.2) -> str:
    return call_model(messages, temperature=temperature, stream=False, echo=False).strip()


def summarize_text(label: str, text: str, instruction: str) -> str:
    clipped = text[:SUMMARY_INPUT_CHARS]
    prompt = textwrap.dedent(
        f"""
        {instruction}

        Label: {label}

        Text:
        {clipped}
        """
    ).strip()
    return quiet_model(
        [
            {
                "role": "system",
                "content": "Create compact, faithful summaries for retrieval. Do not invent facts.",
            },
            {"role": "user", "content": prompt},
        ],
        temperature=0.2,
    )


def chunk_content_relpath(index_id: str, ordinal: int, chunk_idx: int) -> str:
    return f"{index_id}.chunks/{ordinal:06d}-{chunk_idx:06d}.txt"


def chunk_content_path(index: dict, chunk: dict) -> pathlib.Path | None:
    relpath = chunk.get("content_path")
    if not relpath:
        return None
    base = indexes_dir().resolve()
    candidate = (base / relpath).resolve()
    if candidate != base and not is_under(candidate, base):
        raise ValueError(f"chunk content path escapes Motoko index state: {relpath}")
    return candidate


def read_chunk_content(index: dict, chunk: dict) -> str:
    if "content" in chunk:
        return chunk.get("content", "")
    try:
        path = chunk_content_path(index, chunk)
    except ValueError:
        return ""
    if path is None:
        return ""
    try:
        return path.read_text(encoding="utf-8")
    except OSError:
        return ""


def index_artifact_warnings(index: dict) -> list[str]:
    warnings = []
    for file_item in index.get("files", []):
        for chunk in file_item.get("chunks", []):
            if "content" in chunk:
                continue
            try:
                path = chunk_content_path(index, chunk)
            except ValueError as exc:
                warnings.append(str(exc))
                continue
            if path is None:
                warnings.append(
                    f"{file_item.get('path', '')}: chunk {chunk.get('chunk')} has no stored content"
                )
            elif not path.exists():
                warnings.append(
                    f"{file_item.get('path', '')}: missing stored chunk {chunk.get('chunk')}"
                )
    return warnings


def write_index_chunk(index_id: str, ordinal: int, chunk_idx: int, content: str) -> tuple[str, int]:
    relpath = chunk_content_relpath(index_id, ordinal, chunk_idx)
    path = indexes_dir() / relpath
    ensure_private_dir(path.parent)
    atomic_write(path, content)
    return relpath, len(content.encode("utf-8"))


def summarize_and_store_chunk(
    path: pathlib.Path,
    index_id: str,
    ordinal: int,
    chunk_idx: int,
    content: str,
) -> dict | None:
    content = content.strip()
    if not content:
        return None
    label = f"{path} chunk {chunk_idx}"
    print(f"  summarizing {label}", flush=True)
    summary = summarize_text(
        label,
        content[:SUMMARY_INPUT_CHARS],
        "Summarize this document chunk in 4-8 dense bullets. Preserve names, dates, decisions, obligations, and unusual details.",
    )
    relpath, content_bytes = write_index_chunk(index_id, ordinal, chunk_idx, content)
    return {
        "id": f"{ordinal}.{chunk_idx}",
        "path": str(path),
        "chunk": chunk_idx,
        "summary": summary,
        "content_path": relpath,
        "content_bytes": content_bytes,
        "content_sha256": sha256_hex(content.encode("utf-8")),
    }


def stream_index_file(path: pathlib.Path, index_id: str, ordinal: int) -> tuple[dict, list[dict], int]:
    stat = path.stat()
    digest = hashlib.sha256()
    decoder = codecs.getincrementaldecoder("utf-8")(errors="replace")
    buffer = ""
    indexed_chunks = []
    chunk_idx = 0
    derived_content_bytes = 0

    def emit(text: str) -> None:
        nonlocal chunk_idx, derived_content_bytes
        chunk = text.strip()
        if not chunk:
            return
        chunk_idx += 1
        item = summarize_and_store_chunk(path, index_id, ordinal, chunk_idx, chunk)
        if item is not None:
            derived_content_bytes += item.get("content_bytes", 0)
            indexed_chunks.append(item)

    with path.open("rb") as fh:
        for raw in iter(lambda: fh.read(1024 * 1024), b""):
            digest.update(raw)
            buffer += decoder.decode(raw)
            while len(buffer) >= INDEX_CHUNK_CHARS:
                end = INDEX_CHUNK_CHARS
                boundary = buffer.rfind("\n\n", 0, end)
                if boundary > INDEX_CHUNK_CHARS // 2:
                    end = boundary + 2
                if end <= 0:
                    end = INDEX_CHUNK_CHARS
                emit(buffer[:end])
                buffer = buffer[end:]
    buffer += decoder.decode(b"", final=True)
    emit(buffer)

    fingerprint = {
        "size": stat.st_size,
        "mtime_ns": stat.st_mtime_ns,
        "sha256": digest.hexdigest(),
    }
    return fingerprint, indexed_chunks, derived_content_bytes


def chunk_blocks_by_chars(blocks: list[str], max_chars: int) -> list[list[str]]:
    batches = []
    current = []
    current_len = 0
    for block in blocks:
        block = block.strip()
        if not block:
            continue
        if len(block) > max_chars:
            block = block[:max_chars]
        next_len = current_len + len(block) + (2 if current else 0)
        if current and next_len > max_chars:
            batches.append(current)
            current = []
            current_len = 0
        current.append(block)
        current_len += len(block) + (2 if current_len else 0)
    if current:
        batches.append(current)
    return batches


def summarize_blocks(label: str, blocks: list[str], instruction: str) -> str:
    pending = [block.strip() for block in blocks if block.strip()]
    if not pending:
        return summarize_text(label, "", instruction)

    round_no = 1
    while True:
        combined = "\n\n".join(pending)
        if len(combined) <= SUMMARY_INPUT_CHARS or len(pending) == 1 or round_no > 8:
            return summarize_text(label, combined, instruction)

        batches = chunk_blocks_by_chars(pending, SUMMARY_INPUT_CHARS)
        reduced = []
        for idx, batch in enumerate(batches, 1):
            batch_label = f"{label} summary batch {idx}/{len(batches)} round {round_no}"
            print(f"  reducing {batch_label}", flush=True)
            reduced.append(
                summarize_text(
                    batch_label,
                    "\n\n".join(batch),
                    "Summarize this batch faithfully for a higher-level retrieval summary. Preserve names, dates, decisions, obligations, and unusual details.",
                )
            )
        if len(reduced) >= len(pending):
            return summarize_text(label, "\n\n".join(reduced), instruction)
        pending = reduced
        round_no += 1


def index_file(path: pathlib.Path, index_id: str, ordinal: int) -> dict:
    fingerprint, indexed_chunks, derived_content_bytes = stream_index_file(path, index_id, ordinal)

    print(f"  summarizing file {path}", flush=True)
    file_summary = summarize_blocks(
        str(path),
        [f"Chunk {chunk['chunk']}:\n{chunk['summary']}" for chunk in indexed_chunks]
        or [""],
        "Create a file-level summary from these chunk summaries. Include what the file is about and when to retrieve it.",
    )
    return {
        "path": str(path),
        "source_fingerprint": fingerprint,
        "indexed_sha256": fingerprint["sha256"],
        "bytes_indexed": fingerprint["size"],
        "bytes_omitted": 0,
        "truncated": False,
        "chunk_count": len(indexed_chunks),
        "content_storage": "motoko-state-chunks-v1",
        "derived_content_bytes": derived_content_bytes,
        "summary": file_summary,
        "chunks": indexed_chunks,
    }


def build_document_index(path: str, pattern: str, name: str | None = None) -> dict:
    root = pathlib.Path(path).expanduser().resolve()
    require_allowed(root)
    if root.is_file():
        candidates = [root]
    elif root.is_dir():
        candidates = [candidate for candidate in sorted(root.rglob(pattern)) if candidate.is_file()]
    else:
        raise SystemExit(f"not a file or directory: {root}")
    if not candidates:
        raise SystemExit(f"no files matched {pattern} under {root}")

    index_id = _dt.datetime.now().strftime("%Y%m%d-%H%M%S") + "-" + uuid.uuid4().hex[:6]
    files = []
    print(f"Building document index {index_id} from {len(candidates)} file(s).")
    saved = False
    try:
        for idx, candidate in enumerate(candidates, 1):
            try:
                files.append(index_file(candidate, index_id, idx))
            except OSError as exc:
                print(f"  skipped {candidate}: {exc}", file=sys.stderr)

        print("  summarizing corpus", flush=True)
        corpus_summary = summarize_blocks(
            str(root),
            [f"{item['path']}:\n{item['summary']}" for item in files],
            "Create a corpus-level map from these file summaries. Explain the main themes and which files matter for which questions.",
        )
        index = {
            "id": index_id,
            "name": name or root.name or str(root),
            "root": str(root),
            "glob": pattern,
            "created": now(),
            "technique": "hierarchical retrieval-augmented generation",
            "content_storage": "motoko-state-chunks-v1",
            "derived_content_bytes": sum(item.get("derived_content_bytes", 0) for item in files),
            "corpus_summary": corpus_summary,
            "files": files,
        }
        atomic_write(index_path(index_id), json.dumps(index, ensure_ascii=False, indent=2) + "\n")
        saved = True
        print(f"index saved: {index_id}")
        return index
    finally:
        if not saved:
            shutil.rmtree(index_data_dir(index_id), ignore_errors=True)


def context_item_from_index(index: dict) -> dict:
    status, warnings = index_staleness(index)
    return {
        "kind": "index",
        "id": index["id"],
        "name": index.get("name", index["id"]),
        "root": index.get("root", ""),
        "status": status,
        "warnings": warnings[:5],
        "summary": index.get("corpus_summary", ""),
    }


def retrieve_from_index(index: dict, query: str) -> tuple[str, list[dict]]:
    query_counts = token_counts(query)
    index_status, index_warnings = index_staleness(index)
    file_rows = []
    chunk_rows = []
    for file_item in index.get("files", []):
        file_score = score_text(query_counts, file_item.get("summary", ""))
        file_rows.append((file_score, file_item))
        for chunk in file_item.get("chunks", []):
            content = read_chunk_content(index, chunk)
            haystack = "\n".join(
                [
                    file_item.get("summary", ""),
                    chunk.get("summary", ""),
                    content[:4000],
                ]
            )
            chunk_rows.append((score_text(query_counts, haystack), file_item, chunk))

    file_rows.sort(key=lambda row: row[0], reverse=True)
    chunk_rows.sort(key=lambda row: row[0], reverse=True)
    selected_files = [row[1] for row in file_rows[:RETRIEVAL_TOP_FILES] if row[0] > 0]
    selected_chunks = [row for row in chunk_rows[:RETRIEVAL_TOP_CHUNKS] if row[0] > 0]
    if not selected_chunks:
        selected_chunks = chunk_rows[: min(2, len(chunk_rows))]

    parts = [
        f"=== Document index: {index.get('name', index.get('id'))} ===",
        f"Root: {index.get('root', '')}",
        f"Freshness: {index_status}",
        "Corpus summary:",
        index.get("corpus_summary", ""),
    ]
    if index_warnings:
        parts.append("Freshness warnings:\n" + "\n".join(f"- {warning}" for warning in index_warnings[:8]))
    sources = [
        {
            "kind": "index",
            "id": index.get("id", ""),
            "name": index.get("name", ""),
            "root": index.get("root", ""),
            "status": index_status,
            "warnings": index_warnings[:8],
        }
    ]
    if selected_files:
        parts.append("Relevant file summaries:")
        for file_item in selected_files:
            parts.append(
                f"- [file:{file_item.get('path')}] {file_item.get('path')}:\n"
                f"{file_item.get('summary', '')}"
            )
            sources.append(
                {
                    "kind": "file-summary",
                    "index": index.get("id", ""),
                    "path": file_item.get("path", ""),
                    "status": file_staleness(file_item)[0],
                }
            )
    if selected_chunks:
        parts.append("Retrieved excerpts:")
        used = 0
        for _score, file_item, chunk in selected_chunks:
            content = read_chunk_content(index, chunk)
            remaining = MAX_RETRIEVAL_CHARS - used
            if remaining <= 0:
                break
            excerpt = content[:remaining]
            used += len(excerpt)
            parts.append(
                f"--- [index:{index.get('id')} file:{file_item.get('path')} chunk:{chunk.get('chunk')}] ---\n"
                f"Chunk summary:\n{chunk.get('summary', '')}\n\n"
                f"Excerpt:\n{excerpt}"
            )
            sources.append(
                {
                    "kind": "chunk",
                    "index": index.get("id", ""),
                    "path": file_item.get("path", ""),
                    "chunk": chunk.get("chunk"),
                }
            )
    return "\n\n".join(part for part in parts if part), sources


def render_memories_with_sources() -> tuple[str, list[dict]]:
    memories = load_memories()
    if not memories:
        return "No saved memories yet.", []
    lines = []
    sources = []
    for row in memories:
        memory_ref = row.get("id", "unknown")
        lines.append(f"- [memory:{memory_ref}] {row.get('text', '')}")
        sources.append(
            {
                "kind": "memory",
                "id": memory_ref,
                "source": row.get("source", "unknown"),
                "conversation_id": row.get("conversation_id", ""),
                "created": row.get("created", ""),
            }
        )
    return "\n".join(lines), sources


def render_context_with_sources(items: list[dict], query: str = "") -> tuple[str, list[dict]]:
    if not items:
        return "No explicit documents are attached.", []
    parts = []
    sources = []
    for item in items:
        if item.get("kind") == "index":
            index = load_index(item["id"])
            if query:
                text, index_sources = retrieve_from_index(index, query)
                parts.append(text)
                sources.extend(index_sources)
            else:
                status, warnings = index_staleness(index)
                parts.append(
                    textwrap.dedent(
                        f"""
                        === Document index: {index.get('name', index.get('id'))} ===
                        Root: {index.get('root', '')}
                        Freshness: {status}
                        Corpus summary:
                        {index.get('corpus_summary', '')}
                        """
                    ).strip()
                )
                sources.append(
                    {
                        "kind": "index",
                        "id": index.get("id", ""),
                        "name": index.get("name", ""),
                        "root": index.get("root", ""),
                        "status": status,
                        "warnings": warnings[:8],
                    }
                )
            continue
        label = item.get("path", "context")
        content = item.get("content", "")
        parts.append(f"--- [file:{label}] {label} ---\n{content}")
        sources.append(
            {
                "kind": "file",
                "path": label,
                "bytes": item.get("bytes", 0),
            }
        )
    return "\n\n".join(parts), sources


def render_conversation_summary(conv: dict) -> str:
    summary = conv.get("summary", "").strip()
    if not summary:
        return "No compacted conversation summary yet."
    return summary


def build_system_prompt_and_sources(conv: dict, query: str = "") -> tuple[str, list[dict]]:
    memory_text, memory_sources = render_memories_with_sources()
    context_text, context_sources = render_context_with_sources(conv.get("context_items", []), query)
    personality_text, personality_file, personality_exists = load_personality()
    sources = []
    sources.append(
        {
            "kind": "personality",
            "path": personality_file,
            "status": "custom" if personality_exists else "default",
        }
    )
    sources.extend(memory_sources)
    if conv.get("summary", "").strip():
        sources.append({"kind": "conversation-summary", "conversation_id": conv.get("id", "")})
    sources.extend(context_sources)
    return textwrap.dedent(
        f"""
        You are Motoko, Javier's personal local assistant running in the HB3
        personal realm. You are a conversational assistant, not a system
        administrator and not an autonomous agent.

        Conversation style and personality guidance:
        {personality_text}

        This style guidance shapes tone and personality. It must not override
        factual accuracy, privacy boundaries, source-grounding, or explicit user
        instructions.

        Use the saved memories, compacted conversation summary, and explicitly attached documents as context.
        Do not claim access to files or directories unless their contents are
        included in this prompt. If a memory seems stale, say so and ask before
        relying on it heavily.

        Saved memories:
        {memory_text}

        Compacted conversation summary:
        {render_conversation_summary(conv)}

        Attached documents:
        {context_text}
        """
    ).strip(), sources


def build_messages(conv: dict, query: str = "") -> tuple[list[dict], list[dict]]:
    prompt, sources = build_system_prompt_and_sources(conv, query)
    messages = [{"role": "system", "content": prompt}]
    messages.extend(conv.get("messages", [])[-MAX_RECENT_MESSAGES:])
    return messages, sources


def call_model(
    messages: list[dict],
    *,
    temperature: float = 0.7,
    stream: bool = True,
    echo: bool = True,
) -> str:
    payload = {
        "model": model_name(),
        "messages": messages,
        "temperature": temperature,
        "stream": stream,
    }
    data = json.dumps(payload).encode("utf-8")
    req = urllib.request.Request(
        endpoint(),
        data=data,
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    try:
        with urllib.request.urlopen(req, timeout=600) as resp:
            if stream:
                return read_streaming_response(resp, echo=echo)
            return read_json_response(resp)
    except urllib.error.URLError as exc:
        raise SystemExit(f"model request failed: {exc}") from exc


def read_json_response(resp) -> str:
    event = json.loads(resp.read().decode("utf-8", errors="replace"))
    choices = event.get("choices") or []
    if not choices:
        return ""
    message = choices[0].get("message") or {}
    return message.get("content") or ""


def read_streaming_response(resp, *, echo: bool = True) -> str:
    collected = []
    for raw in resp:
        line = raw.decode("utf-8", errors="replace").strip()
        if not line or not line.startswith("data:"):
            continue
        data = line[5:].strip()
        if data == "[DONE]":
            break
        try:
            event = json.loads(data)
        except json.JSONDecodeError:
            continue
        choices = event.get("choices") or []
        if not choices:
            continue
        delta = choices[0].get("delta") or {}
        content = delta.get("content") or ""
        if content:
            if echo:
                print(content, end="", flush=True)
            collected.append(content)
    if echo:
        print()
    return "".join(collected)


