def route_catalog_args(route_info: dict) -> list[str]:
    catalog_route = str(route_info.get("catalog_route") or "").strip()
    if not catalog_route:
        return []
    raw = local_model_catalog_routes().get(catalog_route)
    if not isinstance(raw, dict):
        return []
    args = raw.get("args")
    return [str(item) for item in args] if isinstance(args, list) else []


def route_kv_offload_disabled(route_info: dict) -> bool:
    if route_info.get("kv_offload") is False:
        return True
    if route_info.get("kv_offload") is True:
        return False
    kv_cache = route_info.get("kv_cache") if isinstance(route_info.get("kv_cache"), dict) else {}
    location = str(kv_cache.get("location") or kv_cache.get("loc") or "").strip().lower()
    if location in {"host-ram", "host_ram", "ram", "cpu", "system-ram", "system_ram"}:
        return True
    if location in {"gpu", "vram"}:
        return False
    args = route_catalog_args(route_info)
    return "--no-kv-offload" in args


def reasoning_mode() -> str:
    raw = os.environ.get(REASONING_MODE_ENV, "default").strip().lower()
    return raw if raw in REASONING_PRESETS else "default"


def route_uses_chat_reasoning(route_info: dict) -> bool:
    return normalize_model_route(str(route_info.get("route") or MODEL_ROUTE_CHAT), strict=False) == MODEL_ROUTE_CHAT


def chat_reasoning_request(route_info: dict) -> dict:
    if not route_uses_chat_reasoning(route_info):
        return {}
    mode = reasoning_mode()
    enabled, budget = REASONING_PRESETS[mode]
    return {
        "mode": mode,
        "reasoning_format": REASONING_FORMAT,
        "enable_thinking": enabled,
        "thinking_budget_tokens": budget,
    }


def apply_chat_reasoning_payload(payload: dict, route_info: dict) -> dict:
    request = chat_reasoning_request(route_info)
    if not request:
        return request
    payload["reasoning_format"] = request["reasoning_format"]
    kwargs = payload.get("chat_template_kwargs")
    if not isinstance(kwargs, dict):
        kwargs = {}
    kwargs["enable_thinking"] = bool(request["enable_thinking"])
    payload["chat_template_kwargs"] = kwargs
    payload["thinking_budget_tokens"] = int(request["thinking_budget_tokens"])
    return request


def endpoint() -> str:
