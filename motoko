def select_retrieval_debug_indexes(
    query: str,
    *,
    conv: dict | None = None,
    index_ids: list[str] | None = None,
    limit: int = 3,
    project_scope: dict | None = None,
) -> list[dict]:
    if index_ids:
        return [load_index_exact(index_id) for index_id in index_ids]
    project_scope = project_scope or project_scope_for_request(conv, query)
    project_roots = project_scope_roots(project_scope)
    attached = attached_index_ids(conv or {}, project_roots=project_roots) if conv else []
    if attached:
        return [load_index_exact(index_id) for index_id in attached[:limit]]
    ranked = [
        row
        for row in ranked_indexes_for_query(query, project_scope=project_scope)
        if int(row.get("_score", 0) or 0) > 0
    ]
    if ranked:
        return [load_index_exact(row.get("id", "")) for row in ranked[:limit]]
    latest = latest_indexes_by_family()
    if project_roots:
        latest = [
            row
            for row in latest
            if project_root_matches(str(row.get("root", "") or ""), project_roots)
        ]
    return latest[:limit]


def run_retrieval_debug(
    query: str,
    *,
    conv: dict | None = None,
    index_ids: list[str] | None = None,
    limit: int = 8,
) -> dict:
    query = query.strip()
    if not query:
        raise SystemExit("usage: retrieval-debug QUERY")
    if conv is not None and not index_ids:
        sync_attached_indexes_to_latest(conv)
    limit = max(1, min(int(limit or 8), 50))
    query_counts = token_counts(query)
    project_scope = project_scope_for_request(conv, query)
    indexes = select_retrieval_debug_indexes(query, conv=conv, index_ids=index_ids, project_scope=project_scope)
    report = {
        "schema": RETRIEVAL_DEBUG_SCHEMA_VERSION,
        "id": _dt.datetime.now().strftime("%Y%m%d-%H%M%S") + "-" + uuid.uuid4().hex[:6],
        "created": now(),
        "query": query,
        "query_terms": list(query_counts),
        "path_mentions": query_path_mentions(query),
        "task_context": query_wants_task_context(query),
        "indexes": [],
    }
    for index in indexes:
        try:
            retrieval_result = retrieve_index_result(index, query)
        except SystemExit as exc:
            status, warnings = index_staleness(index)
            file_rows = [
                retrieval_debug_file_row(index, query, query_counts, file_item)
                for file_item in index.get("files", [])
            ]
            chunk_rows = []
            for file_item in index.get("files", []):
                for chunk in file_item.get("chunks", []):
                    chunk_rows.append(retrieval_debug_chunk_row(index, query, query_counts, file_item, chunk))
            file_rows.sort(key=lambda row: row.get("total", 0), reverse=True)
            chunk_rows.sort(key=lambda row: row.get("total", 0), reverse=True)
            index_report = {
                "id": index.get("id", ""),
                "name": index.get("name", ""),
                "root": index.get("root", ""),
                "freshness": status,
                "production_retrieval": "hybrid lexical+structured+evidence+embedding -> rerank",
                "warnings": warnings[:8],
                "files_considered": len(file_rows),
                "chunks_considered": len(chunk_rows),
                "files": file_rows[:limit],
                "chunks": chunk_rows[:limit],
            }
            index_report["production_retrieval_error"] = str(exc).splitlines()[0][:240]
        else:
            debug_index = retrieval_result.diagnostics.get("debug_index")
            if isinstance(debug_index, dict) and debug_index:
                index_report = dict(debug_index)
                index_report["warnings"] = list(index_report.get("warnings", [])[:8])
                index_report["files"] = list(index_report.get("files", [])[:limit])
                index_report["chunks"] = list(index_report.get("chunks", [])[:limit])
                index_report["production_sources"] = list(
                    index_report.get("production_sources") or retrieval_result.source_summary(limit=limit)
                )[:limit]
                if index_report.get("evidence_rows"):
                    index_report["evidence_rows"] = list(index_report.get("evidence_rows", [])[:limit])
                if index_report.get("vector_chunks"):
                    index_report["vector_chunks"] = list(index_report.get("vector_chunks", [])[:limit])
            else:
                status, warnings = index_staleness(index)
                index_report = {
                    "id": index.get("id", ""),
                    "name": index.get("name", ""),
                    "root": index.get("root", ""),
                    "freshness": status,
                    "production_retrieval": "retrieval service",
                    "warnings": warnings[:8],
                    "files_considered": 0,
                    "chunks_considered": 0,
                    "files": [],
                    "chunks": [],
                    "production_sources": retrieval_result.source_summary(limit=limit),
                    "production_diagnostics": {
                        "schema": retrieval_result.diagnostics.get("schema", ""),
                        "source_count": retrieval_result.diagnostics.get("source_count", 0),
                    },
                }
        index_report["diagnosis"] = diagnose_retrieval_debug(index_report, query)
        report["indexes"].append(index_report)
    report["status"] = "empty" if not report["indexes"] else "ok"
    return report


