def skill_suggestion_id() -> str:
    return "skill-" + uuid.uuid4().hex[:10]


def _skill_suggestion_text_field(row: dict, key: str, limit: int) -> str:
    return str(row.get(key) or "").strip()[:limit]


def normalize_skill_suggestion(row: dict) -> dict:
    row = dict(row or {})
    row.setdefault("schema", SKILL_SUGGESTION_SCHEMA_VERSION)
    row.setdefault("id", skill_suggestion_id())
    row.setdefault("status", "pending")
    row.setdefault("created_at", now())
    row.setdefault("updated_at", row.get("created_at", now()))
    try:
        row["action"] = normalize_skill_manage_action(row.get("action") or row.get("skill_action") or "create")
    except SystemExit:
        row["action"] = "create"
    if row.get("target") and not row.get("target_skill"):
        row["target_skill"] = row.get("target")
    if row.get("skill") and not row.get("target_skill"):
        row["target_skill"] = row.get("skill")
    row["name"] = compact_text(str(row.get("name", "")).strip(), 64)
    row["slug"] = skill_slug(row.get("name", ""))
    row["description"] = compact_text(str(row.get("description", "")).strip(), 400)
    row["target_skill"] = skill_slug(row.get("target_skill", "")) or (
        row["slug"] if row["action"] != "create" else ""
    )
    row["kind"] = str(row.get("kind") or DEFAULT_SKILL_KIND).strip() or DEFAULT_SKILL_KIND
    row["handler"] = normalize_skill_handler(row.get("handler"))
    row["allowed_effects"] = normalize_skill_effects(row.get("allowed_effects"), handler=row["handler"])[:8]
    triggers = row.get("triggers")
    if isinstance(triggers, str):
        triggers = [item.strip() for item in triggers.split(",") if item.strip()]
    row["triggers"] = (triggers if isinstance(triggers, list) else [])[:8]
    signals = row.get("signals")
    if isinstance(signals, str):
        signals = [item.strip() for item in signals.split(",") if item.strip()]
    row["signals"] = (signals if isinstance(signals, list) else [])[:8]
    row["reason"] = compact_text(str(row.get("reason", "")).strip(), 1000)
    row["body"] = str(row.get("body", "")).strip()[:SKILL_SUGGESTION_BODY_CHARS]
    row["file_path"] = _skill_suggestion_text_field(row, "file_path", 240)
    row["file_content"] = _skill_suggestion_text_field(row, "file_content", SKILL_SUGGESTION_BODY_CHARS)
    row["old_string"] = _skill_suggestion_text_field(row, "old_string", SKILL_SUGGESTION_BODY_CHARS)
    row["new_string"] = _skill_suggestion_text_field(row, "new_string", SKILL_SUGGESTION_BODY_CHARS)
    row["replace_all"] = bool(row.get("replace_all"))
    row["security"] = str(row.get("security") or "prompt-only suggested skill; no script execution").strip()
    return row


def list_skill_suggestions(*, status: str | None = None) -> list[dict]:
    rows = [normalize_skill_suggestion(row) for row in read_skill_suggestion_state().get("suggestions", [])]
    if status:
        rows = [row for row in rows if row.get("status") == status]
    rows.sort(key=lambda row: row.get("created_at", ""), reverse=True)
    return rows


def skill_suggestion_payload_ok(row: dict) -> bool:
    row = normalize_skill_suggestion(row)
    action = row.get("action", "create")
    if not row.get("description"):
        return False
    if action == "create":
        return bool(row.get("slug") and row.get("body"))
    if action == "patch":
        return bool(row.get("target_skill") and row.get("old_string") and row.get("new_string"))
    if action == "write_file":
        return bool(row.get("target_skill") and row.get("file_path") and row.get("file_content"))
    if action == "remove_file":
        return bool(row.get("target_skill") and row.get("file_path"))
    return False


def write_skill_suggestions(rows: list[dict]) -> None:
    write_skill_suggestion_state({"schema": SKILL_SUGGESTION_SCHEMA_VERSION, "suggestions": rows})


def resolve_skill_suggestion(selector: str, *, pending_only: bool = False) -> tuple[int, dict, list[dict]]:
    rows = [normalize_skill_suggestion(row) for row in read_skill_suggestion_state().get("suggestions", [])]
    matches = []
    for idx, row in enumerate(rows):
        if pending_only and row.get("status") != "pending":
            continue
        if (
            row.get("id") == selector
            or row.get("id", "").startswith(selector)
            or row.get("slug") == selector
            or row.get("slug", "").startswith(selector)
        ):
            matches.append((idx, row))
    if len(matches) != 1:
        raise SystemExit(f"skill suggestion selector must match exactly one suggestion; matched {len(matches)}")
    idx, row = matches[0]
    return idx, row, rows


