def render_motoko_codebase_context(query: str) -> tuple[str, list[dict]]:
    plan = build_retrieval_plan(query, skills=active_skills())
    if not plan.get("codebase"):
        return "", []
    report = motoko_code_query(query, limit=10)
    return (
        format_code_query_report(report),
        [
            {
                "kind": "motoko-codebase",
                "schema": report.get("schema", ""),
                "root": report.get("root", ""),
                "query": report.get("query", ""),
                "handler": plan.get("codebase", {}).get("handler", ""),
            }
        ],
    )


