    if not sources:
        return "No recorded sources for the last answer."
    lines = []
    for idx, source in enumerate(sources, 1):
        kind = source.get("kind", "source")
        if kind == "identity":
            lines.append(
                f"{idx:3d}  identity  {source.get('name', 'Motoko')}  "
                f"realm {source.get('realm', 'personal')}"
