        if row.get("base"):
            lines.append(f"  base: {row.get('base')}")
        if row.get("target_branch"):
            lines.append(f"  target branch: {row.get('target_branch')}")
        if row.get("path_count"):
            lines.append(f"  path count: {row.get('path_count')}")
        if row.get("reason"):
            lines.append(f"  reason: {row.get('reason')}")
    lines.append("apply: motoko action apply-proposal RUN_ID INDEX --yes")
    return "\n".join(lines)


def apply_action_proposal_text(selector: str, index: int, *, yes: bool = False, cancel_event=None) -> str:
    try:
        _data, actions = _tool_proposed_actions(selector)
        if index < 1 or index > len(actions):
            raise AgenticValidationError(f"proposal index must be 1..{len(actions)}")
        action = actions[index - 1]
        if action.get("kind") != "project_file_write":
            raise AgenticValidationError("only project_file_write proposals can be applied")
    except AgenticValidationError as exc:
        return f"action apply-proposal:\nstatus: rejected\nerror: {exc}"
    return run_action_text_from_record(action, yes=yes, cancel_event=cancel_event)


