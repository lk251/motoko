def read_memory_rows() -> list[dict]:
    path = memories_path()
    if not path.exists():
        return []
    rows = []
    for line in path.read_text(encoding="utf-8").splitlines():
        if not line.strip():
            continue
        try:
            rows.append(json.loads(line))
        except json.JSONDecodeError:
            continue
    return rows


def normalize_memory_row(row: dict, ordinal: int) -> dict:
    normalized = dict(row)
    normalized.setdefault("id", f"legacy-{ordinal:04d}")
    normalized.setdefault("created", "")
    normalized.setdefault("source", "unknown")
    normalized.setdefault("text", "")
    normalized.setdefault("importance", MEMORY_DEFAULT_IMPORTANCE)
    normalized.setdefault("pinned", False)
    normalized.setdefault("tags", [])
    try:
        normalized["importance"] = max(
            1,
            min(MEMORY_MAX_IMPORTANCE, int(normalized.get("importance", MEMORY_DEFAULT_IMPORTANCE))),
        )
    except (TypeError, ValueError):
        normalized["importance"] = MEMORY_DEFAULT_IMPORTANCE
    if not isinstance(normalized.get("tags"), list):
        normalized["tags"] = []
    normalized["pinned"] = bool(normalized.get("pinned"))
    return normalized


def load_memories(limit: int = 80) -> list[dict]:
    rows = [normalize_memory_row(row, idx) for idx, row in enumerate(read_memory_rows(), 1)]
    return rows[-limit:]


def write_memory_rows(rows: list[dict]) -> None:
    text = "".join(json.dumps(row, ensure_ascii=False) + "\n" for row in rows)
    atomic_write(memories_path(), text)


def read_maintenance_state() -> dict | None:
    path = maintenance_path()
    if not path.exists():
        return None
    try:
        state = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return None
    return state if isinstance(state, dict) else None


def write_maintenance_state(state: dict) -> None:
    state["updated"] = now()
    atomic_write(maintenance_path(), json.dumps(state, ensure_ascii=False, indent=2) + "\n")
    maintenance_path().chmod(0o600)


def clear_maintenance_state(job_id: str | None = None) -> None:
    state = read_maintenance_state()
    if job_id and state and state.get("job_id") != job_id:
        return
    try:
        maintenance_path().unlink()
    except FileNotFoundError:
        pass


def maintenance_incomplete(state: dict | None) -> bool:
    if not state:
        return False
    return state.get("status") in {"running", "resuming"}


def begin_maintenance_state(conv: dict, *, resumed: bool = False) -> dict:
    previous = read_maintenance_state()
    retry_count = 0
    if resumed and previous and previous.get("conversation_id") == conv.get("id"):
        retry_count = int(previous.get("retry_count", 0) or 0)
    state = {
        "job_id": "maint-" + uuid.uuid4().hex[:10],
        "kind": "auto-maintenance",
        "conversation_id": conv.get("id", ""),
        "conversation_title": conv.get("title", "Untitled"),
        "started": now(),
        "updated": now(),
        "phase": "memory: checking",
        "status": "resuming" if resumed else "running",
        "retry_count": retry_count,
    }
    write_maintenance_state(state)
    return state


def update_maintenance_state(
    state: dict,
    phase: str,
    *,
    status: str = "running",
    note: str | None = None,
    error: str | None = None,
) -> None:
    state["phase"] = phase
    state["status"] = status
    if note is not None:
        state["note"] = note
    if error is not None:
        state["error"] = error
    write_maintenance_state(state)


def resume_interrupted_maintenance(conv: dict) -> tuple[bool, str | None]:
    state = read_maintenance_state()
    if not maintenance_incomplete(state):
        return False, None
    if state.get("conversation_id") != conv.get("id"):
        state["status"] = "abandoned"
        state["abandoned"] = now()
        state["abandoned_reason"] = "opened different conversation"
        write_maintenance_state(state)
        return False, None
    retry_count = int(state.get("retry_count", 0) or 0)
    if retry_count >= MAINTENANCE_MAX_RETRIES:
        state["status"] = "abandoned"
        state["abandoned"] = now()
        write_maintenance_state(state)
        return False, "abandoned interrupted maintenance after repeated retries"
    state["retry_count"] = retry_count + 1
    state["status"] = "resuming"
    state["phase"] = "memory: queued"
    write_maintenance_state(state)
    return True, "resuming interrupted memory maintenance"


def text_similarity(left: str, right: str) -> float:
    left_terms = set(token_counts(left))
    right_terms = set(token_counts(right))
    if not left_terms or not right_terms:
        return 0.0
    overlap = left_terms & right_terms
    return len(overlap) / max(1, min(len(left_terms), len(right_terms)))


def memory_tags(text: str) -> list[str]:
    counts = token_counts(text)
    stop = {
        "about",
        "after",
        "also",
        "because",
        "before",
        "could",
        "from",
        "have",
        "into",
        "javier",
        "motoko",
        "should",
        "that",
        "their",
        "there",
        "this",
        "with",
        "would",
    }
    tags = []
    for word, _count in counts.most_common(20):
        if word in stop:
            continue
        tags.append(word)
        if len(tags) >= 8:
            break
    return tags


def find_similar_memory(text: str, rows: list[dict]) -> dict | None:
    best = None
    best_score = 0.0
    for row in rows:
        score = text_similarity(text, row.get("text", ""))
        if score > best_score:
            best = row
            best_score = score
    if best is not None and best_score >= MEMORY_DUPLICATE_THRESHOLD:
        return best
    return None


def add_memory(
    text: str,
    source: str = "manual",
    *,
    conversation_id: str | None = None,
    derived_from: str | None = None,
    importance: int = MEMORY_DEFAULT_IMPORTANCE,
    pinned: bool = False,
    tags: list[str] | None = None,
) -> None:
    text = text.strip()
    if not text:
        raise SystemExit("empty memory")
    existing_rows = [normalize_memory_row(row, idx) for idx, row in enumerate(read_memory_rows(), 1)]
    duplicate = find_similar_memory(text, existing_rows)
    if duplicate is not None:
        duplicate["updated"] = now()
        duplicate["last_seen"] = now()
        duplicate["seen_count"] = int(duplicate.get("seen_count", 1)) + 1
        if source:
            duplicate["source"] = duplicate.get("source", source)
        if conversation_id:
            duplicate["conversation_id"] = duplicate.get("conversation_id") or conversation_id
        if derived_from:
            duplicate["derived_from"] = duplicate.get("derived_from") or derived_from
        duplicate["importance"] = max(
            int(duplicate.get("importance", MEMORY_DEFAULT_IMPORTANCE)),
            max(1, min(MEMORY_MAX_IMPORTANCE, int(importance))),
        )
        merged_tags = list(dict.fromkeys([*duplicate.get("tags", []), *(tags or memory_tags(text))]))
        duplicate["tags"] = merged_tags[:8]
        write_memory_rows(existing_rows)
        return
    row = {
        "id": memory_id(),
        "created": now(),
        "source": source,
        "text": text[:MAX_MEMORY_CHARS],
        "importance": max(1, min(MEMORY_MAX_IMPORTANCE, int(importance))),
        "pinned": bool(pinned),
        "tags": (tags or memory_tags(text))[:8],
        "seen_count": 1,
    }
    if conversation_id:
        row["conversation_id"] = conversation_id
    if derived_from:
        row["derived_from"] = derived_from
    with memories_path().open("a", encoding="utf-8") as fh:
        fh.write(json.dumps(row, ensure_ascii=False) + "\n")
    memories_path().chmod(0o600)


def explicit_memory_candidates(text: str) -> list[str]:
    value = text.strip()
    if not value:
        return []
    if re.search(r"\b(don't|dont|do not)\s+remember\b", value, flags=re.IGNORECASE):
        return []
    patterns = [
        r"^\s*(?:please\s+)?remember(?:\s+that|:)?\s+(.+)$",
        r"\b(?:please\s+)?remember(?:\s+that|:)?\s+(.+)$",
        r"\b(?:make|create|save)\s+(?:a\s+)?memory(?:\s+that|:)?\s+(.+)$",
        r"\b(?:keep|store)\s+this\s+(?:as\s+)?(?:a\s+)?memory(?:\s*:)?\s+(.+)$",
    ]
    candidates = []
    for pattern in patterns:
        match = re.search(pattern, value, flags=re.IGNORECASE | re.DOTALL)
        if not match:
            continue
        candidate = re.sub(r"\s+", " ", match.group(1).strip())
        candidate = candidate.strip(" \t\r\n\"'")
        if candidate and len(candidate) <= MAX_MEMORY_CHARS:
            candidates.append(candidate)
            break
    return candidates


def save_explicit_user_memories(text: str, conversation_id: str) -> int:
    saved = 0
    for candidate in explicit_memory_candidates(text):
        add_memory(
            candidate,
            source="explicit-chat",
            conversation_id=conversation_id,
            derived_from="explicit-user-request",
            importance=4,
        )
        saved += 1
    return saved


def resolve_memory(rows: list[dict], selector: str) -> tuple[int, dict]:
    normalized = [normalize_memory_row(row, idx) for idx, row in enumerate(rows, 1)]
    if selector.isdigit():
        idx = int(selector) - 1
        if 0 <= idx < len(normalized):
            return idx, normalized[idx]
    matches = [
        (idx, row)
        for idx, row in enumerate(normalized)
        if row.get("id") == selector or row.get("id", "").startswith(selector)
    ]
    if len(matches) != 1:
        raise SystemExit(f"memory selector must match exactly one memory; matched {len(matches)}")
    return matches[0]


def edit_memory(selector: str, text: str) -> None:
    rows = [normalize_memory_row(row, idx) for idx, row in enumerate(read_memory_rows(), 1)]
    idx, row = resolve_memory(rows, selector)
    row["text"] = text.strip()[:MAX_MEMORY_CHARS]
    row["updated"] = now()
    rows[idx] = row
    write_memory_rows(rows)
    print(f"memory updated: {row['id']}")


def set_memory_importance(selector: str, importance: str) -> None:
    try:
        value = int(importance)
    except ValueError as exc:
        raise SystemExit("importance must be an integer from 1 to 5") from exc
    if value < 1 or value > MEMORY_MAX_IMPORTANCE:
        raise SystemExit("importance must be an integer from 1 to 5")
    rows = [normalize_memory_row(row, idx) for idx, row in enumerate(read_memory_rows(), 1)]
    idx, row = resolve_memory(rows, selector)
    row["importance"] = value
    row["updated"] = now()
    rows[idx] = row
    write_memory_rows(rows)
    print(f"memory importance updated: {row['id']} -> {value}")


def set_memory_pinned(selector: str, pinned: bool) -> None:
    rows = [normalize_memory_row(row, idx) for idx, row in enumerate(read_memory_rows(), 1)]
    idx, row = resolve_memory(rows, selector)
    row["pinned"] = pinned
    row["updated"] = now()
    rows[idx] = row
    write_memory_rows(rows)
    state = "pinned" if pinned else "unpinned"
    print(f"memory {state}: {row['id']}")


def forget_memory(selector: str) -> None:
    rows = [normalize_memory_row(row, idx) for idx, row in enumerate(read_memory_rows(), 1)]
    idx, row = resolve_memory(rows, selector)
    del rows[idx]
    write_memory_rows(rows)
    print(f"memory forgotten: {row['id']}")


