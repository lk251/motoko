    )


def parse_skill_patch_args(raw: str) -> dict:
    usage = "usage: /skill patch NAME --old OLD --new NEW [--file SKILL.md|references/x.md] [--all]"
    try:
        tokens = shlex.split(raw)
    except ValueError as exc:
        raise SystemExit(f"{usage}\nerror: {exc}") from exc
    if not tokens:
        raise SystemExit(usage)
    name = tokens[0]
    old_string = ""
    new_string = ""
    file_path = "SKILL.md"
    replace_all = False
    idx = 1
    while idx < len(tokens):
        token = tokens[idx]
        if token == "--all":
            replace_all = True
            idx += 1
            continue
        if token in {"--file", "-f"}:
            if idx + 1 >= len(tokens):
                raise SystemExit(usage)
            file_path = tokens[idx + 1]
            idx += 2
            continue
        if token == "--old":
            if idx + 1 >= len(tokens):
                raise SystemExit(usage)
            old_string = tokens[idx + 1]
            idx += 2
            continue
        if token == "--new":
            if idx + 1 >= len(tokens):
                raise SystemExit(usage)
            new_string = tokens[idx + 1]
            idx += 2
            continue
        raise SystemExit(f"{usage}\nunknown argument: {token}")
    if not old_string or not new_string:
        raise SystemExit(usage)
    return {
        "name": name,
        "file_path": file_path,
        "old_string": old_string,
        "new_string": new_string,
        "replace_all": replace_all,
    }


def parse_skill_write_file_args(raw: str) -> dict:
    usage = "usage: /skill write-file NAME SUPPORT_PATH (--content TEXT | --from PATH)"
    try:
        tokens = shlex.split(raw)
    except ValueError as exc:
        raise SystemExit(f"{usage}\nerror: {exc}") from exc
    if len(tokens) < 2:
        raise SystemExit(usage)
    name = tokens[0]
    file_path = tokens[1]
    file_content = ""
    source_path = ""
    idx = 2
    while idx < len(tokens):
        token = tokens[idx]
        if token == "--content":
            if idx + 1 >= len(tokens):
                raise SystemExit(usage)
            file_content = tokens[idx + 1]
            idx += 2
            continue
        if token == "--from":
            if idx + 1 >= len(tokens):
                raise SystemExit(usage)
            source_path = tokens[idx + 1]
            idx += 2
            continue
        raise SystemExit(f"{usage}\nunknown argument: {token}")
    if bool(file_content) == bool(source_path):
        raise SystemExit(usage)
    if source_path:
        file_content = pathlib.Path(source_path).read_text(encoding="utf-8")
    return {"name": name, "file_path": file_path, "file_content": file_content}


def parse_skill_remove_file_args(raw: str) -> dict:
    usage = "usage: /skill remove-file NAME SUPPORT_PATH --yes"
    try:
        tokens = shlex.split(raw)
    except ValueError as exc:
        raise SystemExit(f"{usage}\nerror: {exc}") from exc
    if len(tokens) < 3 or "--yes" not in tokens[2:]:
        raise SystemExit(usage)
    return {"name": tokens[0], "file_path": tokens[1]}


def load_profile_dossier() -> dict | None:
    path = profile_path()
    if not path.exists():
        return None
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return None
    return data if isinstance(data, dict) else None


def profile_matches_project_scope(profile: dict | None, project_scope: dict | None) -> bool:
    if not isinstance(profile, dict) or project_scope is None:
        return True
    project_roots = project_scope_roots(project_scope)
    if not project_roots:
        return True
    conversation_ids = [
        str(conversation_id or "").strip()
        for conversation_id in profile.get("conversation_ids", []) or []
        if str(conversation_id or "").strip()
    ]
    if not conversation_ids:
        return True
    for conversation_id in conversation_ids:
        conv = load_conversation_if_exists(conversation_id)
        if conv is None:
            return False
        roots = conversation_project_roots(conv)
        if not roots_match_project(roots, project_roots):
            return False
    return True


def profile_source_material() -> tuple[str, list[str], list[str]]:
    memories = load_memories(limit=PROFILE_SOURCE_MEMORIES)
    conversations = [
        conv
        for conv in list_conversations()[:PROFILE_SOURCE_CONVERSATIONS]
        if conversation_recall_text(conv).strip()
    ]
    memory_lines = [
        f"- [{row.get('id', '')}; i{row.get('importance', MEMORY_DEFAULT_IMPORTANCE)}] {row.get('text', '')}"
        for row in memories
    ]
    conversation_blocks = []
    for conv in conversations:
        title = conv.get("title") or "Untitled"
        conversation_blocks.append(
            f"--- conversation:{conv.get('id', '')} title:{title} updated:{conv.get('updated', '')} ---\n"
            f"{compact_text(conversation_recall_text(conv), 2500)}"
        )
    text = textwrap.dedent(
        f"""
        Durable memories:
        {chr(10).join(memory_lines) if memory_lines else "(none)"}

        Recent conversation material:
        {chr(10).join(conversation_blocks) if conversation_blocks else "(none)"}
        """
    ).strip()
    return (
        text,
        [row.get("id", "") for row in memories if row.get("id")],
        [conv.get("id", "") for conv in conversations if conv.get("id")],
    )


def refresh_profile_dossier() -> dict:
    source_text, memory_ids, conversation_ids = profile_source_material()
    if not memory_ids and not conversation_ids:
        raise SystemExit("no memories or conversations available for a profile dossier yet")
    prompt = textwrap.dedent(
        f"""
        Build a compact profile dossier for future private conversations with Javier.

        Use only the source material below. Do not invent facts.
        Prefer stable, recurring, useful context over transient task details.
        Preserve uncertainty when the sources are ambiguous.

        Organize the dossier with these headings:
        - Stable preferences
        - Goals and projects
        - Working style
        - Personal context
        - Constraints and sensitivities
        - Open questions

        Keep it under {MAX_PROFILE_DOSSIER_CHARS} characters.

        Source material:
        {source_text}
        """
    ).strip()
    text = quiet_model(
        [
            {
                "role": "system",
                "content": "Create faithful personal context dossiers from supplied sources only.",
            },
            {"role": "user", "content": prompt},
        ],
        temperature=0.2,
        timeout=MAINTENANCE_MODEL_TIMEOUT_SECONDS,
        route=MODEL_ROUTE_PROFILE,
    )[:MAX_PROFILE_DOSSIER_CHARS]
    data = {
        "updated": now(),
        "memory_ids": memory_ids,
        "conversation_ids": conversation_ids,
        "text": text,
        "summary_artifact": artifact_provenance(
            "profile-dossier",
            PROFILE_DOSSIER_SCHEMA_VERSION,
            route=MODEL_ROUTE_PROFILE,
            prompt_version=PROFILE_DOSSIER_SCHEMA_VERSION,
            source_sha256=sha256_hex(source_text.encode("utf-8")),
        ),
    }
    atomic_write(profile_path(), json.dumps(data, ensure_ascii=False, indent=2) + "\n")
    profile_path().chmod(0o600)
    return data


