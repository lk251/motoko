def model_command_request(text: str):
    text = text.strip()
    primary = command_primary(text)
    body = command_body(text)
    if primary == "/model-stop":
        selector = body
        if not selector:
            return "/model-stop", lambda: "usage: /model-stop ROUTE"
        return "/model-stop", lambda: stop_model_service(selector)
    if primary == "/model-metrics":
        selector = body
        if not selector:
            return "/model-metrics", lambda: "usage: /model-metrics ROUTE"
        return "/model-metrics", lambda: model_service_metrics(selector)
    if primary == "/slot-cache":
        parts = body.split()
        if parts and parts[0] == "gc":
            if len(parts) < 2:
                return "/slot-cache gc", lambda: "usage: /slot-cache gc ROUTE"
            return "/slot-cache gc", lambda: slot_cache_gc_text(" ".join(parts[1:]).strip())
        if parts and parts[0] == "erase":
            if len(parts) < 2:
                return "/slot-cache erase", lambda: "usage: /slot-cache erase ROUTE"
            return "/slot-cache erase", lambda: slot_cache_erase_text(parts[1])
        if parts and parts[0] == "clear":
            yes = "--yes" in parts
            conversation_id = ""
            route_parts = []
            idx = 1
            while idx < len(parts):
                item = parts[idx]
                if item == "--yes":
                    idx += 1
                    continue
                if item == "--conversation" and idx + 1 < len(parts):
                    conversation_id = parts[idx + 1]
                    idx += 2
                    continue
                route_parts.append(item)
                idx += 1
            selector = " ".join(route_parts).strip() or None
            return "/slot-cache clear", lambda: slot_cache_clear_text(selector, conversation_id=conversation_id, yes=yes)
        selector = body or None
        return "/slot-cache", lambda: format_slot_cache(selector)
    return None


