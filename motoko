def refresh_profile_dossier() -> dict:
    source_text, memory_ids, conversation_ids = profile_source_material()
    if not memory_ids and not conversation_ids:
        raise SystemExit("no memories or conversations available for a profile dossier yet")
    prompt = textwrap.dedent(
        f"""
        Build a compact profile dossier for future private conversations with Javier.

        Use only the source material below. Do not invent facts.
        Prefer stable, recurring, useful context over transient task details.
        Preserve uncertainty when the sources are ambiguous.

        Organize the dossier with these headings:
        - Stable preferences
        - Goals and projects
        - Working style
        - Personal context
        - Constraints and sensitivities
        - Open questions

        Keep it under {MAX_PROFILE_DOSSIER_CHARS} characters.

        Source material:
        {source_text}
        """
    ).strip()
    text = quiet_model(
        [
            {
                "role": "system",
                "content": "Create faithful personal context dossiers from supplied sources only.",
            },
            {"role": "user", "content": prompt},
        ],
        temperature=0.2,
        timeout=MAINTENANCE_MODEL_TIMEOUT_SECONDS,
    )[:MAX_PROFILE_DOSSIER_CHARS]
    data = {
        "updated": now(),
        "memory_ids": memory_ids,
        "conversation_ids": conversation_ids,
        "text": text,
    }
    atomic_write(profile_path(), json.dumps(data, ensure_ascii=False, indent=2) + "\n")
    profile_path().chmod(0o600)
    return data


