    )


def format_index_cleanup_report(report: dict) -> str:
    lines = [
        f"index cleanup: {report.get('schema', INDEX_CLEANUP_SCHEMA_VERSION)}",
        f"created: {report.get('created', '')}",
        f"mode: {'dry-run' if report.get('dry_run') else 'apply'}",
        f"candidates: {report.get('candidate_count', 0)} selected: {report.get('selected_count', 0)}",
    ]
    for item in report.get("materialized", []):
        lines.append(
            f"- materialized latest {item.get('index', '')}: "
            f"{item.get('materialized_chunks', 0)} chunk(s), {human_bytes(item.get('materialized_bytes', 0))}"
        )
        if item.get("missing_chunks"):
            lines.append(f"  warning: {item.get('missing_chunks', 0)} duplicate chunk(s) still missing source text")
    for item in report.get("deleted", []):
        status = item.get("status", "deleted")
        lines.append(
            f"- {status}: {item.get('index', '')} "
            f"{human_bytes(item.get('bytes', 0))}"
        )
        extras = []
        for key, label in [
            ("vector_stores_deleted", "vector"),
            ("evidence_stores_deleted", "evidence"),
            ("topics_deleted", "topics"),
            ("dossiers_deleted", "dossiers"),
            ("retrieval_debug_deleted", "retrieval-debug"),
            ("retrieval_evals_deleted", "retrieval-evals"),
            ("feedback_evals_deleted", "feedback-evals"),
        ]:
            if item.get(key):
                extras.append(f"{label}:{item.get(key)}")
        if extras:
            lines.append("  derived deleted: " + ", ".join(extras))
        for warning in item.get("warnings", [])[:3]:
            lines.append(f"  warning: {warning}")
    for item in report.get("blocked", []):
        lines.append(f"- blocked: {item.get('index', '')} {item.get('reason', '')}".rstrip())
        for warning in item.get("warnings", [])[:3]:
            lines.append(f"  warning: {warning}")
    if not report.get("deleted") and not report.get("blocked") and not report.get("materialized"):
        lines.append("no stale superseded index artifacts were safe to clean")
    return "\n".join(lines)


def index_file_path_keys(index: dict) -> set[str]:
    keys = set()
    for file_item in index.get("files", []):
        path_text = str(file_item.get("path", "")).strip()
        if not path_text:
            continue
        keys.add(path_text)
        try:
            keys.add(str(pathlib.Path(path_text).expanduser().resolve()))
        except OSError:
            keys.add(str(pathlib.Path(path_text).expanduser()))
    return keys


def source_lifecycle_replacement(index: dict, source_paths: set[str]) -> tuple[dict | None, bool, str]:
    latest = latest_index_for_family(index, list_indexes())
    if latest is None or latest.get("id") == index.get("id"):
        return None, False, "no newer replacement index for this corpus family"
    latest_status, latest_warnings = index_staleness(latest)
    if latest_status != "fresh":
        warning = f": {'; '.join(latest_warnings[:2])}" if latest_warnings else ""
        return latest, False, f"replacement index is {latest_status}{warning}"
    replacement_paths = index_file_path_keys(latest)
    still_attached = sorted(path for path in source_paths if path in replacement_paths)
    if still_attached:
        return latest, False, "replacement index still references detached source path(s)"
    return latest, True, "replacement index is fresh and does not reference detached source path(s)"


def source_lifecycle_report_for_index(index: dict, *, apply: bool = False, yes: bool = False) -> dict:
    index_id = str(index.get("id", "")).strip()
    summary = index_change_summary(index)
    source_lifecycle = summary.get("source_lifecycle", [])
    source_paths = source_lifecycle_affected_paths(source_lifecycle)
    if source_lifecycle:
        replacement, replacement_ready, replacement_reason = source_lifecycle_replacement(index, source_paths)
    else:
        replacement, replacement_ready, replacement_reason = None, False, "all indexed sources are fresh"
    records = source_lifecycle_artifact_records(index_id, source_paths) if source_lifecycle else []
    plan = source_lifecycle_cleanup_plan(
        index_id=index_id,
        source_lifecycle=source_lifecycle,
        artifact_records=records,
        replacement_index_id=str((replacement or {}).get("id", "")),
        replacement_ready=replacement_ready,
    )
    report = {
        "schema": "source-lifecycle-report-v1",
        "created": now(),
        "index": {
            "id": index_id,
            "name": index.get("name", ""),
            "root": index.get("root", ""),
            "glob": index.get("glob") or AUTO_INDEX_GLOB,
            "status": summary.get("status", ""),
            "warnings": summary.get("warnings", [])[:6],
        },
        "replacement": {
            "id": str((replacement or {}).get("id", "")),
            "ready": replacement_ready,
            "reason": replacement_reason,
        },
        "dry_run": not apply,
        "source_lifecycle": source_lifecycle[:100],
        "plan": plan,
        "artifact_records": records[:200],
        "artifact_record_count": len(records),
        "applied": None,
    }
    if apply:
        if not yes:
            raise SystemExit("refusing source lifecycle cleanup without --yes")
        if plan.get("apply_status") != "ready":
            report["applied"] = {
                "status": "blocked",
                "reason": plan.get("apply_reason", "cleanup is not ready"),
            }
            return report
        deletion = delete_index_snapshot(index)
        invalidate_context_catalog_after_cleanup()
        report["applied"] = {
            "status": "deleted-superseded-index-snapshot",
            "index": index_id,
            "deleted": deletion,
            "manual_review_artifacts_preserved": plan.get("manual_review_artifact_count", 0),
        }
    return report


def format_source_lifecycle_report(report: dict) -> str:
    index = report.get("index", {})
    replacement = report.get("replacement", {})
    plan = report.get("plan", {})
    lines = [
