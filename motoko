def matching_cwd_indexes(root: pathlib.Path, pattern: str = AUTO_INDEX_GLOB) -> list[dict]:
    root_text = str(root.resolve())
    glob_text = pattern or AUTO_INDEX_GLOB
    rows = [
        index
        for index in list_indexes()
        if index.get("root") == root_text and (index.get("glob") or AUTO_INDEX_GLOB) == glob_text
    ]
    rows.sort(key=lambda index: index.get("created", ""), reverse=True)
    return rows


def cwd_learning_plan(root: pathlib.Path | None = None, pattern: str = AUTO_INDEX_GLOB) -> dict | None:
    if not env_flag("MOTOKO_CWD_LEARN", True):
        return None
    root = (root or pathlib.Path.cwd()).expanduser().resolve()
    try:
        plan = plan_document_index(str(root), pattern)
    except SystemExit:
        return None
    if not plan.get("files", 0):
        return None
    return {
        "root": root,
        "glob": pattern or AUTO_INDEX_GLOB,
        "files": plan.get("files", 0),
        "bytes": plan.get("bytes", 0),
        "estimated_chunks": plan.get("estimated_chunks", 0),
        "estimated_model_calls": plan.get("estimated_model_calls", 0),
        "existing": matching_cwd_indexes(root, pattern),
    }


def attach_best_cwd_index(conv: dict, plan: dict) -> dict | None:
    for index in plan.get("existing", []):
        status, _warnings = index_staleness(index)
        if status in {"fresh", "metadata-changed", "stale", "unknown"}:
            attach_context_item(conv, context_item_from_index(index))
            return index
    return None


