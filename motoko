def ranked_index_chunks(index: dict, query: str) -> list[tuple[int, dict, dict, str]]:
    query_counts = token_counts(query)
    rows = []
    for file_item in index.get("files", []):
        for chunk in file_item.get("chunks", []):
            content = read_chunk_content(index, chunk)
            haystack = "\n".join(
                [
                    file_item.get("path", ""),
                    file_item.get("summary", ""),
                    chunk.get("summary", ""),
                    content[:4000],
                ]
            )
            rows.append((score_text(query_counts, haystack), file_item, chunk, content))
    rows.sort(key=lambda row: row[0], reverse=True)
    return rows


def wants_deep_context(query: str) -> bool:
    terms = set(token_counts(query))
    return bool(terms & DEEP_RETRIEVAL_TERMS)


def retrieval_limits(query: str) -> tuple[int, int, int]:
    if wants_deep_context(query):
        return RETRIEVAL_TOP_FILES * 2, RETRIEVAL_TOP_CHUNKS * 3, MAX_RETRIEVAL_CHARS * 2
    return RETRIEVAL_TOP_FILES, RETRIEVAL_TOP_CHUNKS, MAX_RETRIEVAL_CHARS


def build_topic_dossier(
    index_ids: list[str],
    query: str,
    *,
    name: str | None = None,
    max_chunks: int = TOPIC_DEFAULT_CHUNKS,
) -> dict:
    query = query.strip()
    if not query:
        raise SystemExit("topic query is empty")
    if not index_ids:
        raise SystemExit("topic dossier needs at least one document index")
    max_chunks = max(1, min(max_chunks, TOPIC_MAX_CHUNKS))

    selected_rows = []
    source_indexes = []
    for index_id in index_ids:
        index = load_index(index_id)
        status, warnings = index_staleness(index)
        source_indexes.append(
            {
                "id": index.get("id", index_id),
                "name": index.get("name", ""),
                "root": index.get("root", ""),
                "status_at_build": status,
                "warnings_at_build": warnings[:8],
            }
        )
        for score, file_item, chunk, content in ranked_index_chunks(index, query):
            selected_rows.append((score, index, file_item, chunk, content))

    selected_rows.sort(key=lambda row: row[0], reverse=True)
    positive_rows = [row for row in selected_rows if row[0] > 0]
    selected_rows = (positive_rows or selected_rows)[:max_chunks]
    if not selected_rows:
        raise SystemExit("no chunks available in the selected index(es)")

    topic_id = _dt.datetime.now().strftime("%Y%m%d-%H%M%S") + "-" + uuid.uuid4().hex[:6]
    evidence = []
    blocks = []
    for score, index, file_item, chunk, content in selected_rows:
        excerpt = content[:TOPIC_EXCERPT_CHARS]
        evidence_item = {
            "index": index.get("id", ""),
            "index_name": index.get("name", ""),
            "path": file_item.get("path", ""),
            "chunk": chunk.get("chunk"),
            "score": score,
            "chunk_summary": chunk.get("summary", ""),
            "file_summary": file_item.get("summary", ""),
            "excerpt": excerpt,
            "excerpt_sha256": sha256_hex(excerpt.encode("utf-8")),
        }
        evidence.append(evidence_item)
        blocks.append(
            textwrap.dedent(
                f"""
                Source: index={evidence_item['index']} file={evidence_item['path']} chunk={evidence_item['chunk']} score={score}
                File summary:
                {evidence_item['file_summary']}

                Chunk summary:
                {evidence_item['chunk_summary']}

                Excerpt:
                {excerpt}
                """
            ).strip()
        )

    print(f"Building topic dossier {topic_id} from {len(evidence)} chunk(s).")
    summary = summarize_blocks(
        f"topic dossier: {query}",
        blocks,
        textwrap.dedent(
            """
            Create a detailed topic dossier from these retrieved source chunks.
            Use headings: Overview, Detailed Findings, Source Map, Tensions Or
            Uncertainties, Follow-up Questions. Ground claims in the supplied
            excerpts and source paths. Do not invent facts.
            """
        ).strip(),
    )
    topic = {
        "id": topic_id,
        "name": name or slug_title(query),
        "query": query,
        "created": now(),
        "technique": "topic-focused hierarchical retrieval-augmented dossier",
        "source_indexes": source_indexes,
        "selected_chunk_count": len(evidence),
        "summary": summary,
        "evidence": evidence,
    }
    atomic_write(topic_path(topic_id), json.dumps(topic, ensure_ascii=False, indent=2) + "\n")
    print(f"topic saved: {topic_id}")
    return topic


def build_memory_dossier(query: str, *, name: str | None = None) -> dict:
    query = query.strip()
    if not query:
        raise SystemExit("dossier query is empty")

    seed_conv = {
        "id": "",
        "title": query,
        "summary": "",
        "messages": [{"role": "user", "content": query}],
    }
    memories = ranked_memories(
        conv=seed_conv,
        query=query,
        limit=MEMORY_DOSSIER_SOURCE_MEMORIES,
    )
    conversations = ranked_recent_conversations(seed_conv, query)[:MEMORY_DOSSIER_SOURCE_CONVERSATIONS]
    profile = load_profile_dossier()

    if not memories and not conversations and not profile:
        raise SystemExit("dossier needs saved memories, prior conversations, or a profile dossier")

    dossier_id = _dt.datetime.now().strftime("%Y%m%d-%H%M%S") + "-" + uuid.uuid4().hex[:6]
    source_memories = []
    source_conversations = []
    blocks = []
    used = 0

    if profile:
        profile_text = profile.get("text", "")[:MEMORY_DOSSIER_EXCERPT_CHARS]
        blocks.append(f"Profile dossier updated {profile.get('updated', '')}:\n{profile_text}")
        used += len(blocks[-1])

    for row in memories:
        if used >= MEMORY_DOSSIER_MAX_SOURCE_CHARS:
            break
        text = row.get("text", "")[:MEMORY_DOSSIER_EXCERPT_CHARS]
        item = {
            "id": row.get("id", ""),
            "source": row.get("source", "unknown"),
            "conversation_id": row.get("conversation_id", ""),
            "created": row.get("created", ""),
            "importance": row.get("importance", MEMORY_DEFAULT_IMPORTANCE),
            "pinned": bool(row.get("pinned")),
            "score": row.get("_score", 0),
            "matched_terms": row.get("_matched_terms", 0),
            "excerpt": text,
        }
        source_memories.append(item)
        block = (
            f"Memory {item['id']} importance={item['importance']} "
            f"score={item['score']} match={item['matched_terms']}:\n{text}"
        )
        blocks.append(block)
        used += len(block)

    for row in conversations:
        if used >= MEMORY_DOSSIER_MAX_SOURCE_CHARS:
            break
        recall = conversation_recall_text(row)[:MEMORY_DOSSIER_EXCERPT_CHARS]
        item = {
            "id": row.get("id", ""),
            "title": row.get("title", "Untitled"),
            "created": row.get("created", ""),
            "updated": row.get("updated", row.get("created", "")),
            "branch": row.get("branch", ""),
            "score": row.get("_recall_score", 0),
            "matched_terms": row.get("_matched_terms", 0),
            "selection": row.get("_selection_reasons", []),
            "excerpt": recall,
        }
        source_conversations.append(item)
        block = (
            f"Conversation {item['id']} title={item['title']} "
            f"updated={item['updated']} score={item['score']} "
            f"selection={','.join(item['selection']) or '-'}:\n{recall}"
        )
        blocks.append(block)
        used += len(block)

    print(
        f"Building memory dossier {dossier_id} from "
        f"{len(source_memories)} memor{'y' if len(source_memories) == 1 else 'ies'} "
        f"and {len(source_conversations)} conversation(s)."
    )
    summary = summarize_blocks(
        f"memory dossier: {query}",
        blocks,
        textwrap.dedent(
            """
            Create a query-focused private memory dossier from these supplied
            memories, profile notes, and conversation capsules. Use headings:
            Overview, Stable Facts, Relevant History, Tensions Or Uncertainties,
            Open Questions, Useful Next Context. Separate durable facts from
            tentative inferences. Do not invent facts.
            """
        ).strip(),
    )
    dossier = {
        "id": dossier_id,
        "name": name or slug_title(query),
        "query": query,
        "created": now(),
        "technique": "query-focused hierarchical retrieval over memories and conversations",
        "summary": summary,
        "profile_used": bool(profile),
        "source_memory_count": len(source_memories),
        "source_conversation_count": len(source_conversations),
        "source_memories": source_memories,
        "source_conversations": source_conversations,
    }
    atomic_write(dossier_path(dossier_id), json.dumps(dossier, ensure_ascii=False, indent=2) + "\n")
    print(f"dossier saved: {dossier_id}")
    return dossier


def attached_item_ids(conv: dict, kind: str) -> set[str]:
    return {
        item.get("id", "")
        for item in conv.get("context_items", [])
        if item.get("kind") == kind and item.get("id")
    }


def attach_context_item(conv: dict, item: dict) -> bool:
    existing = attached_item_ids(conv, item.get("kind", ""))
    if item.get("id") in existing:
        return False
    conv.setdefault("context_items", []).append(item)
    save_conversation(conv)
    return True


def maybe_attach_relevant_existing_dossier(conv: dict, query: str) -> dict | None:
    attached = attached_item_ids(conv, "dossier")
    for dossier in ranked_dossiers_for_query(query):
        if dossier.get("id", "") in attached:
            continue
        if dossier.get("_score", 0) < STUDY_REUSE_MIN_SCORE:
            break
        attach_context_item(conv, context_item_from_dossier(dossier))
        return dossier
    return None


def maybe_attach_relevant_existing_topic(conv: dict, query: str) -> dict | None:
    attached = attached_item_ids(conv, "topic")
    for topic in ranked_topics_for_query(query):
        if topic.get("id", "") in attached:
            continue
        if topic.get("_score", 0) < STUDY_REUSE_MIN_SCORE:
            break
        attach_context_item(conv, context_item_from_topic(topic))
        return topic
    return None


def best_relevant_index(query: str) -> dict | None:
    for index in ranked_indexes_for_query(query):
        if index.get("_score", 0) >= STUDY_INDEX_MIN_SCORE:
            return index
        break
    return None


def profile_refresh_due(catalog: dict | None = None) -> bool:
    catalog = catalog or read_context_catalog() or build_context_catalog()
    if not catalog.get("memory_count", 0) and not catalog.get("conversation_count", 0):
        return False
    _source_text, memory_ids, conversation_ids = profile_source_material()
    if not memory_ids and not conversation_ids:
        return False
    profile = load_profile_dossier()
    if not profile or not profile.get("text", "").strip():
        return True
    updated = parse_timestamp(profile.get("updated", ""))
    if updated is None:
        return True
    age = (_dt.datetime.now(_dt.timezone.utc).astimezone() - updated.astimezone()).total_seconds()
    if age < BACKGROUND_PROFILE_REFRESH_INTERVAL_SECONDS:
        return False
    known_memories = set(profile.get("memory_ids", []))
    known_conversations = set(profile.get("conversation_ids", []))
    return bool(set(memory_ids) - known_memories or set(conversation_ids) - known_conversations)


def study_query(conv: dict, query: str) -> str:
    query = query.strip()
    if not query:
        raise SystemExit("usage: /study QUERY")

    topic = maybe_attach_relevant_existing_topic(conv, query)
    if topic:
        return f"attached existing topic dossier: {topic.get('id')} ({topic.get('name', '')})"

    dossier = maybe_attach_relevant_existing_dossier(conv, query)
    if dossier:
        return f"attached existing memory dossier: {dossier.get('id')} ({dossier.get('name', '')})"

    index_ids = attached_index_ids(conv)
    if index_ids:
        topic = build_topic_dossier(index_ids, query)
        attach_context_item(conv, context_item_from_topic(topic))
        return f"built topic dossier from attached index(es): {topic.get('id')}"

    index = best_relevant_index(query)
    if index:
        topic = build_topic_dossier([index["id"]], query)
        attach_context_item(conv, context_item_from_topic(topic))
        return f"built topic dossier from index {index.get('id')}: {topic.get('id')}"

    dossier = build_memory_dossier(query)
    attach_context_item(conv, context_item_from_dossier(dossier))
    return f"built memory dossier: {dossier.get('id')}"


def context_sufficiency_note(conv: dict, query: str, sources: list[dict]) -> str:
    kinds = collections.Counter(source.get("kind", "unknown") for source in sources)
    has_deep_context = any(
        kind in kinds
        for kind in (
            "dossier",
            "dossier-memory",
            "dossier-conversation",
            "topic",
            "topic-evidence",
            "chunk",
            "index",
        )
    )
    if has_deep_context:
        status = "likely enough for a grounded answer if the selected sources match the question"
    elif kinds.get("memory", 0) or kinds.get("recent-conversation", 0) or conv.get("summary"):
        status = "partial; answer from available memory, but suggest /study if details matter"
    else:
        status = "thin; say what is missing and suggest /study or attaching/indexing documents"

    reusable = []
    topic = next((row for row in ranked_topics_for_query(query) if row.get("_score", 0) >= STUDY_REUSE_MIN_SCORE), None)
    dossier = next((row for row in ranked_dossiers_for_query(query) if row.get("_score", 0) >= STUDY_REUSE_MIN_SCORE), None)
    index = best_relevant_index(query)
    if topic and topic.get("id") not in attached_item_ids(conv, "topic"):
        reusable.append(f"existing topic dossier {topic.get('id')}")
    if dossier and dossier.get("id") not in attached_item_ids(conv, "dossier"):
        reusable.append(f"existing memory dossier {dossier.get('id')}")
    if index:
        reusable.append(f"document index {index.get('id')}")
    action = "; relevant stored context: " + ", ".join(reusable) if reusable else ""
    return f"Context sufficiency: {status}.{action}"


def background_study_step(conv: dict, phase_callback=None) -> list[str]:
    job_id = study_job_id()
    previous_state = read_study_state()
    previous_job = previous_state.get("job_id") if study_state_incomplete(previous_state) else None
    append_study_job_event(
        job_id,
        "started",
        mode="catalog-and-planning",
        conversation_id=conv.get("id", ""),
        resumed_from_job_id=previous_job or "",
        resumed_from_phase=previous_state.get("phase", "") if previous_job else "",
    )

    def set_phase(phase: str, *, notes: list[str] | None = None) -> None:
        write_study_phase(phase, notes=notes, job_id=job_id)
        append_study_job_event(job_id, "phase", phase=phase, notes=notes or [])
        if phase_callback is not None:
            phase_callback(phase)

    set_phase("study: catalog")
    catalog = write_context_catalog()
    notes = []
    if previous_job:
        notes.append(
            f"resumed after interrupted study job {previous_job} "
            f"at {previous_state.get('phase', 'unknown')}"
        )
    stale_indexes = [
        item
        for item in catalog.get("indexes", [])
        if item.get("status") not in {"fresh", "empty"}
    ]
    if stale_indexes:
        notes.append(f"{len(stale_indexes)} index(es) need review or rebuild")
    if env_flag("MOTOKO_BACKGROUND_PROFILE", False) and profile_refresh_due(catalog):
        set_phase("study: profile", notes=notes)
        try:
            refresh_profile_dossier()
        except SystemExit as exc:
            notes.append(f"profile refresh skipped: {exc}")
        except Exception as exc:
            notes.append(f"profile refresh failed: {type(exc).__name__}: {exc}")
        else:
            notes.append("profile dossier refreshed")
            catalog = write_context_catalog()
    elif catalog.get("memory_count", 0) and not catalog.get("profile_updated"):
        notes.append("profile dossier is not built yet")
    set_phase("study: planning", notes=notes)
    if conv.get("messages"):
        query = context_query_text(conv, conv.get("title", ""))
        if query.strip():
            topic = next((row for row in ranked_topics_for_query(query) if row.get("_score", 0) >= STUDY_REUSE_MIN_SCORE), None)
            dossier = next((row for row in ranked_dossiers_for_query(query) if row.get("_score", 0) >= STUDY_REUSE_MIN_SCORE), None)
            if topic and topic.get("id") not in attached_item_ids(conv, "topic"):
                notes.append(f"existing topic dossier may fit this chat: {topic.get('id')}")
            if dossier and dossier.get("id") not in attached_item_ids(conv, "dossier"):
                notes.append(f"existing memory dossier may fit this chat: {dossier.get('id')}")
            if not topic and not dossier and (catalog.get("memory_count", 0) or catalog.get("indexes")):
                notes.append("current chat may benefit from /study")
    state = {
        "updated": now(),
        "phase": "study: idle",
        "status": "completed",
        "mode": "catalog-and-planning",
        "job_id": job_id,
        "notes": notes[:8],
        "catalog_updated": catalog.get("updated", ""),
    }
    write_study_state(state)
    append_study_job_event(job_id, "completed", notes=notes[:8], catalog_updated=catalog.get("updated", ""))
    return notes[:3]


def retrieve_from_index(index: dict, query: str) -> tuple[str, list[dict]]:
    query_counts = token_counts(query)
    top_files, top_chunks, max_retrieval_chars = retrieval_limits(query)
    index_status, index_warnings = index_staleness(index)
    file_rows = []
    chunk_rows = []
    for file_item in index.get("files", []):
        file_score = score_text(
            query_counts,
            "\n".join([file_item.get("path", ""), file_item.get("summary", "")]),
        )
        file_rows.append((file_score, file_item))
        for chunk in file_item.get("chunks", []):
            content = read_chunk_content(index, chunk)
            haystack = "\n".join(
                [
                    file_item.get("path", ""),
                    file_item.get("summary", ""),
                    chunk.get("summary", ""),
                    content[:4000],
                ]
            )
            chunk_rows.append((score_text(query_counts, haystack), file_item, chunk))

    file_rows.sort(key=lambda row: row[0], reverse=True)
    chunk_rows.sort(key=lambda row: row[0], reverse=True)
    selected_files = [row[1] for row in file_rows[:top_files] if row[0] > 0]
    selected_chunks = [row for row in chunk_rows[:top_chunks] if row[0] > 0]
    if not selected_chunks:
        selected_chunks = chunk_rows[: min(2, len(chunk_rows))]

    parts = [
        f"=== Document index: {index.get('name', index.get('id'))} ===",
        f"Root: {index.get('root', '')}",
        f"Freshness: {index_status}",
        "Corpus summary:",
        index.get("corpus_summary", ""),
    ]
    if index_warnings:
        parts.append("Freshness warnings:\n" + "\n".join(f"- {warning}" for warning in index_warnings[:8]))
    sources = [
        {
            "kind": "index",
            "id": index.get("id", ""),
            "name": index.get("name", ""),
            "root": index.get("root", ""),
            "status": index_status,
            "warnings": index_warnings[:8],
            "retrieval": "deep" if wants_deep_context(query) else "normal",
        }
    ]
    if selected_files:
        parts.append("Relevant file summaries:")
        for file_item in selected_files:
            parts.append(
                f"- [file:{file_item.get('path')}] {file_item.get('path')}:\n"
                f"{file_item.get('summary', '')}"
            )
            sources.append(
                {
                    "kind": "file-summary",
                    "index": index.get("id", ""),
                    "path": file_item.get("path", ""),
                    "status": file_staleness(file_item)[0],
                }
            )
    if selected_chunks:
        parts.append("Retrieved excerpts:")
        used = 0
        for _score, file_item, chunk in selected_chunks:
            content = read_chunk_content(index, chunk)
            remaining = max_retrieval_chars - used
            if remaining <= 0:
                break
            excerpt = content[:remaining]
            used += len(excerpt)
            parts.append(
                f"--- [index:{index.get('id')} file:{file_item.get('path')} chunk:{chunk.get('chunk')}] ---\n"
                f"Chunk summary:\n{chunk.get('summary', '')}\n\n"
                f"Excerpt:\n{excerpt}"
            )
            sources.append(
                {
                    "kind": "chunk",
                    "index": index.get("id", ""),
                    "path": file_item.get("path", ""),
                    "chunk": chunk.get("chunk"),
                }
            )
    return "\n\n".join(part for part in parts if part), sources


def retrieve_from_topic(topic: dict, query: str) -> tuple[str, list[dict]]:
    query_counts = token_counts(query or topic.get("query", ""))
    evidence = list(topic.get("evidence", []))
    if query_counts:
        evidence.sort(
            key=lambda item: score_text(
                query_counts,
                "\n".join(
                    [
                        item.get("chunk_summary", ""),
                        item.get("file_summary", ""),
                        item.get("excerpt", "")[:4000],
                    ]
                ),
            ),
            reverse=True,
        )
    parts = [
        f"=== Topic dossier: {topic.get('name', topic.get('id'))} ===",
        f"Topic query: {topic.get('query', '')}",
        "Topic summary:",
        topic.get("summary", ""),
    ]
    sources = [
        {
            "kind": "topic",
            "id": topic.get("id", ""),
            "name": topic.get("name", ""),
            "query": topic.get("query", ""),
        }
    ]
    used = 0
    if evidence:
        parts.append("Topic evidence excerpts:")
    for item in evidence:
        remaining = MAX_RETRIEVAL_CHARS - used
        if remaining <= 0:
            break
        excerpt = item.get("excerpt", "")[:remaining]
        used += len(excerpt)
        parts.append(
            f"--- [topic:{topic.get('id')} index:{item.get('index')} file:{item.get('path')} chunk:{item.get('chunk')}] ---\n"
            f"Chunk summary:\n{item.get('chunk_summary', '')}\n\n"
            f"Excerpt:\n{excerpt}"
        )
        sources.append(
            {
                "kind": "topic-evidence",
                "topic": topic.get("id", ""),
                "index": item.get("index", ""),
                "path": item.get("path", ""),
                "chunk": item.get("chunk"),
            }
        )
    return "\n\n".join(part for part in parts if part), sources


def retrieve_from_dossier(dossier: dict, query: str) -> tuple[str, list[dict]]:
    query_counts = token_counts(query or dossier.get("query", ""))
    memory_rows = list(dossier.get("source_memories", []))
    conversation_rows = list(dossier.get("source_conversations", []))
    if query_counts:
        memory_rows.sort(
            key=lambda item: score_text(
                query_counts,
                "\n".join([item.get("excerpt", ""), item.get("id", "")]),
            ),
            reverse=True,
        )
        conversation_rows.sort(
            key=lambda item: score_text(
                query_counts,
                "\n".join([item.get("title", ""), item.get("excerpt", "")]),
            ),
            reverse=True,
        )

    parts = [
        f"=== Memory dossier: {dossier.get('name', dossier.get('id'))} ===",
        f"Dossier query: {dossier.get('query', '')}",
        "Dossier summary:",
        dossier.get("summary", ""),
    ]
    sources = [
        {
            "kind": "dossier",
            "id": dossier.get("id", ""),
            "name": dossier.get("name", ""),
            "query": dossier.get("query", ""),
        }
    ]
    used = 0
    if memory_rows:
        parts.append("Dossier memory excerpts:")
    for item in memory_rows:
        remaining = MAX_RETRIEVAL_CHARS - used
        if remaining <= 0:
            break
        excerpt = item.get("excerpt", "")[:remaining]
        used += len(excerpt)
        parts.append(
            f"--- [dossier:{dossier.get('id')} memory:{item.get('id')}] ---\n"
            f"importance={item.get('importance')} score={item.get('score')} "
            f"source={item.get('source')}\n{excerpt}"
        )
        sources.append(
            {
                "kind": "dossier-memory",
                "dossier": dossier.get("id", ""),
                "memory": item.get("id", ""),
                "source": item.get("source", ""),
            }
        )
    if conversation_rows and used < MAX_RETRIEVAL_CHARS:
        parts.append("Dossier conversation excerpts:")
    for item in conversation_rows:
        remaining = MAX_RETRIEVAL_CHARS - used
        if remaining <= 0:
            break
        excerpt = item.get("excerpt", "")[:remaining]
        used += len(excerpt)
        parts.append(
            f"--- [dossier:{dossier.get('id')} conversation:{item.get('id')}] ---\n"
            f"title={item.get('title')} updated={item.get('updated')} "
            f"selection={','.join(item.get('selection', [])) or '-'}\n{excerpt}"
        )
        sources.append(
            {
                "kind": "dossier-conversation",
                "dossier": dossier.get("id", ""),
                "conversation_id": item.get("id", ""),
                "title": item.get("title", ""),
                "updated": item.get("updated", ""),
            }
        )
    return "\n\n".join(part for part in parts if part), sources


def render_memories_with_sources(conv: dict, query: str = "") -> tuple[str, list[dict]]:
    memories = ranked_memories(conv=conv, query=query)
    if not memories:
        if load_memories(limit=1):
            return "No saved memories matched this turn strongly.", []
        return "No saved memories yet.", []
    lines = []
    sources = []
    for row in memories:
        memory_ref = row.get("id", "unknown")
        markers = []
        if row.get("pinned"):
            markers.append("pinned")
        markers.append(f"importance={row.get('importance', MEMORY_DEFAULT_IMPORTANCE)}")
        if row.get("_matched_terms", 0):
            markers.append(f"match={row.get('_matched_terms')}")
        if row.get("_thread_matched_terms", 0):
            markers.append(f"thread={row.get('_thread_matched_terms')}")
        lines.append(f"- [memory:{memory_ref}; {', '.join(markers)}] {row.get('text', '')}")
        sources.append(
            {
                "kind": "memory",
                "id": memory_ref,
                "source": row.get("source", "unknown"),
                "conversation_id": row.get("conversation_id", ""),
                "created": row.get("created", ""),
                "importance": row.get("importance", MEMORY_DEFAULT_IMPORTANCE),
                "pinned": bool(row.get("pinned")),
                "score": row.get("_score", 0),
                "matched_terms": row.get("_matched_terms", 0),
            }
        )
    return "\n".join(lines), sources


def render_context_with_sources(items: list[dict], query: str = "") -> tuple[str, list[dict]]:
    if not items:
        return "No explicit documents are attached.", []
    parts = []
    sources = []
    for item in items:
        if item.get("kind") == "index":
            index = load_index(item["id"])
            if query:
                text, index_sources = retrieve_from_index(index, query)
                parts.append(text)
                sources.extend(index_sources)
            else:
                status, warnings = index_staleness(index)
                parts.append(
                    textwrap.dedent(
                        f"""
                        === Document index: {index.get('name', index.get('id'))} ===
                        Root: {index.get('root', '')}
                        Freshness: {status}
                        Corpus summary:
                        {index.get('corpus_summary', '')}
                        """
                    ).strip()
                )
                sources.append(
                    {
                        "kind": "index",
                        "id": index.get("id", ""),
                        "name": index.get("name", ""),
                        "root": index.get("root", ""),
                        "status": status,
                        "warnings": warnings[:8],
                    }
            )
            continue
        if item.get("kind") == "topic":
            topic = load_topic(item["id"])
            text, topic_sources = retrieve_from_topic(topic, query)
            parts.append(text)
            sources.extend(topic_sources)
            continue
        if item.get("kind") == "dossier":
            dossier = load_dossier(item["id"])
            text, dossier_sources = retrieve_from_dossier(dossier, query)
            parts.append(text)
            sources.extend(dossier_sources)
            continue
        label = item.get("path", "context")
        content = item.get("content", "")
        parts.append(f"--- [file:{label}] {label} ---\n{content}")
        sources.append(
            {
                "kind": "file",
                "path": label,
                "bytes": item.get("bytes", 0),
            }
        )
    return "\n\n".join(parts), sources


def render_conversation_summary(conv: dict) -> str:
    summary = conv.get("summary", "").strip()
    if not summary:
        return "No compacted conversation summary yet."
    return summary


def context_plan_from_lanes(lanes: list[dict]) -> dict:
    total_chars = sum(int(lane.get("chars", 0) or 0) for lane in lanes)
    return {
        "kind": "context-plan",
        "budget_chars": CONTEXT_PLAN_BUDGET_CHARS,
        "total_chars": total_chars,
        "status": "over-budget" if total_chars > CONTEXT_PLAN_BUDGET_CHARS else "ok",
        "lanes": lanes,
    }


def format_context_plan(plan: dict) -> str:
    lines = [
        (
            "Context plan: "
            f"{plan.get('total_chars', 0)}/{plan.get('budget_chars', CONTEXT_PLAN_BUDGET_CHARS)} "
            f"chars ({plan.get('status', 'unknown')})"
        )
    ]
    for lane in plan.get("lanes", []):
        lines.append(
            f"- {lane.get('lane')}: {lane.get('chars', 0)} chars, "
            f"{lane.get('sources', 0)} source(s), {lane.get('purpose', '')}"
        )
    return "\n".join(lines)


def build_system_prompt_and_sources(conv: dict, query: str = "") -> tuple[str, list[dict]]:
    memory_text, memory_sources = render_memories_with_sources(conv, query)
    recent_text, recent_sources = render_recent_conversations_with_sources(conv, query)
    profile_text, profile_sources = render_profile_with_sources()
    retrieval_query = context_query_text(conv, query)
    context_text, context_sources = render_context_with_sources(conv.get("context_items", []), retrieval_query)
    catalog = read_context_catalog() or build_context_catalog()
    catalog_text = format_context_catalog(catalog)
    personality_text, personality_file, personality_exists = load_personality()
    sources = []
    sources.append(
        {
            "kind": "personality",
            "path": personality_file,
            "status": "custom" if personality_exists else "default",
        }
    )
    sources.extend(profile_sources)
    sources.extend(memory_sources)
    sources.extend(recent_sources)
    if conv.get("summary", "").strip():
        sources.append({"kind": "conversation-summary", "conversation_id": conv.get("id", "")})
    sources.extend(context_sources)
    sources.append({"kind": "context-catalog", "updated": catalog.get("updated", "")})
    context_plan = context_plan_from_lanes(
        [
            {
                "lane": "personality",
                "chars": len(personality_text),
                "sources": 1,
                "purpose": "tone and behavior only",
            },
            {
                "lane": "profile",
                "chars": len(profile_text),
                "sources": len(profile_sources),
                "purpose": "stable Javier context",
            },
            {
                "lane": "durable memories",
                "chars": len(memory_text),
                "sources": len(memory_sources),
                "purpose": "ranked personal facts and preferences",
            },
            {
                "lane": "recent conversations",
                "chars": len(recent_text),
                "sources": len(recent_sources),
                "purpose": "bounded recency plus relevance recall",
            },
            {
                "lane": "conversation summary",
                "chars": len(render_conversation_summary(conv)),
                "sources": 1 if conv.get("summary", "").strip() else 0,
                "purpose": "compacted older turns",
            },
            {
                "lane": "attached context",
                "chars": len(context_text),
                "sources": len(context_sources),
                "purpose": "explicit files, indexes, topics, dossiers",
            },
            {
                "lane": "catalog",
                "chars": len(catalog_text),
                "sources": 1,
                "purpose": "available private context inventory",
            },
        ]
    )
    sources.append(context_plan)
    sufficiency = context_sufficiency_note(conv, query, sources)
    return textwrap.dedent(
        f"""
        You are Motoko, Javier's personal local assistant running in the HB3
        personal realm. You are a conversational assistant, not a system
        administrator and not an autonomous agent.

        Conversation style and personality guidance:
        {personality_text}

        This style guidance shapes tone and personality. It must not override
        factual accuracy, privacy boundaries, source-grounding, or explicit user
        instructions.

        Use the profile dossier, selected saved memories, recent saved
        conversations, compacted conversation summary, attached memory
        dossiers, and explicitly attached documents as context.
        Do not claim access to files or directories unless their contents are
        included in this prompt. If a memory seems stale, say so and ask before
        relying on it heavily.
        Use the context sufficiency note to decide whether to answer directly,
        mention uncertainty, or suggest /study for a deeper bounded study pass.

        Profile dossier:
        {profile_text}

        Selected saved memories:
        {memory_text}

        Recent saved conversations:
        {recent_text}

        Compacted conversation summary:
        {render_conversation_summary(conv)}

        Attached documents and dossiers:
        {context_text}

        Available private context catalog:
        {catalog_text}

        Context selection plan:
        {format_context_plan(context_plan)}

        {sufficiency}
        """
    ).strip(), sources


def build_messages(conv: dict, query: str = "") -> tuple[list[dict], list[dict]]:
    prompt, sources = build_system_prompt_and_sources(conv, query)
    messages = [{"role": "system", "content": prompt}]
    messages.extend(conv.get("messages", [])[-MAX_RECENT_MESSAGES:])
    return messages, sources


def call_model(
    messages: list[dict],
    *,
    temperature: float = 0.7,
    stream: bool = True,
    echo: bool = True,
    timeout: float = MODEL_TIMEOUT_SECONDS,
) -> str:
    payload = {
        "model": model_name(),
        "messages": messages,
        "temperature": temperature,
        "stream": stream,
    }
    data = json.dumps(payload).encode("utf-8")
    req = urllib.request.Request(
        endpoint(),
        data=data,
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    spinner = ThinkingSpinner(enabled=echo)
    try:
        spinner.start()
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            if stream:
                return read_streaming_response(resp, echo=echo, spinner=spinner)
            spinner.stop()
            return read_json_response(resp)
    except (urllib.error.URLError, TimeoutError, OSError) as exc:
        raise SystemExit(f"model request failed: {exc}") from exc
    finally:
        spinner.stop()


def run_with_wall_timeout(label: str, wall_timeout: float, func, *args, **kwargs):
    result: list[object] = []
    errors: list[BaseException] = []

    def target() -> None:
        try:
            result.append(func(*args, **kwargs))
        except BaseException as exc:  # Preserve the original exception type.
            errors.append(exc)

    thread = threading.Thread(target=target, daemon=True)
    thread.start()
    thread.join(wall_timeout)
    if thread.is_alive():
        raise TimeoutError(f"{label} timed out after {int(wall_timeout)}s")
    if errors:
        raise errors[0]
    return result[0] if result else None


def call_model_with_callback(
    messages: list[dict],
    *,
    on_token,
    temperature: float = 0.7,
    timeout: float = MODEL_TIMEOUT_SECONDS,
) -> str:
    payload = {
        "model": model_name(),
        "messages": messages,
        "temperature": temperature,
        "stream": True,
    }
    data = json.dumps(payload).encode("utf-8")
    req = urllib.request.Request(
        endpoint(),
        data=data,
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    collected = []
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            for raw in resp:
                line = raw.decode("utf-8", errors="replace").strip()
                if not line or not line.startswith("data:"):
                    continue
                data = line[5:].strip()
                if data == "[DONE]":
                    break
                try:
                    event = json.loads(data)
                except json.JSONDecodeError:
                    continue
                choices = event.get("choices") or []
                if not choices:
                    continue
                delta = choices[0].get("delta") or {}
                content = delta.get("content") or ""
                if content:
                    collected.append(content)
                    on_token(content)
    except (urllib.error.URLError, TimeoutError, OSError) as exc:
        raise SystemExit(f"model request failed: {exc}") from exc
    return "".join(collected)


def read_json_response(resp) -> str:
    event = json.loads(resp.read().decode("utf-8", errors="replace"))
    choices = event.get("choices") or []
    if not choices:
        return ""
    message = choices[0].get("message") or {}
    return message.get("content") or ""


def read_streaming_response(
    resp,
    *,
    echo: bool = True,
    spinner: ThinkingSpinner | None = None,
) -> str:
    collected = []
    for raw in resp:
        line = raw.decode("utf-8", errors="replace").strip()
        if not line or not line.startswith("data:"):
            continue
        data = line[5:].strip()
        if data == "[DONE]":
            break
        try:
            event = json.loads(data)
        except json.JSONDecodeError:
            continue
        choices = event.get("choices") or []
        if not choices:
            continue
        delta = choices[0].get("delta") or {}
        content = delta.get("content") or ""
        if content:
            if spinner is not None:
                spinner.stop()
            if echo:
                print(content, end="", flush=True)
            collected.append(content)
    if echo:
        print()
    return "".join(collected)


