    if env_endpoint:
        return env_endpoint
    local_route = merged_local_model_route(MODEL_ROUTE_CHAT)
    if isinstance(local_route.get("endpoint"), str) and local_route["endpoint"].strip():
        return local_route["endpoint"].strip()
    return DEFAULT_ENDPOINT


def model_name() -> str:
    env_model = os.environ.get("MOTOKO_MODEL")
    if env_model:
        return env_model
    local_route = merged_local_model_route(MODEL_ROUTE_CHAT)
    if isinstance(local_route.get("model"), str) and local_route["model"].strip():
        return local_route["model"].strip()
    return DEFAULT_MODEL


def model_route(route: str = MODEL_ROUTE_CHAT) -> dict:
    route = normalize_model_route(route)
    env_endpoint = os.environ.get(model_route_env_key(route, "endpoint"))
    env_model = os.environ.get(model_route_env_key(route, "model"))
    global_env_endpoint = os.environ.get("MOTOKO_ENDPOINT")
    global_env_model = os.environ.get("MOTOKO_MODEL")
    configured = {}
    if not env_endpoint or not env_model:
        candidate = config_root() / "config.json"
        if candidate.exists():
            configured = load_config().get("model_routes", {}).get(route, {})
    local_route = merged_local_model_route(route)
    route_endpoint = env_endpoint or configured.get("endpoint") or global_env_endpoint or local_route.get("endpoint") or DEFAULT_ENDPOINT
    route_model = env_model or configured.get("model") or global_env_model or local_route.get("model") or DEFAULT_MODEL
    request_path = local_route.get("request_path") or LOCAL_MODEL_UNIX_REQUEST_PATH
    local_endpoint = str(local_route.get("endpoint") or "")
    uses_catalog_endpoint = bool(local_endpoint) and str(route_endpoint) == local_endpoint
    return {
        "route": route,
        "endpoint": str(route_endpoint),
        "model": str(route_model),
        "request_path": str(request_path),
        "endpoint_paths": normalize_endpoint_paths(local_route.get("endpoint_paths")),
        "manager_kind": str(local_route.get("manager_kind") or ""),
        "catalog_route": str(local_route.get("catalog_route") or ""),
        "model_path": str(local_route.get("model_path") or ""),
        "max_parallel": local_route.get("maxParallel") or local_route.get("max_parallel") or 1,
        "download_url": str(local_route.get("download_url") or local_route.get("url") or ""),
        "download_hash": str(local_route.get("download_hash") or local_route.get("sha256") or local_route.get("hash") or ""),
        "cache": normalize_route_cache_policy(local_route.get("cache")) if uses_catalog_endpoint else {},
        "metrics_endpoint": str(local_route.get("metrics_endpoint") or "") if uses_catalog_endpoint else "",
        "metrics_path": str(local_route.get("metrics_path") or "") if uses_catalog_endpoint else "",
        "request_policy": normalize_request_policy(local_route.get("request_policy")) if uses_catalog_endpoint else {},
        "scheduling": normalize_scheduling_policy(local_route.get("scheduling")) if uses_catalog_endpoint else {},
        "idle_seconds": local_route.get("idle_seconds") if uses_catalog_endpoint else None,
        "safety_policy": normalize_safety_policy(local_route.get("safety_policy")) if uses_catalog_endpoint else {},
        "lane": str(local_route.get("lane") or ""),
        "ctx_size": route_context_size(local_route) or 0,
        "quant": route_quant_label(local_route),
        "tasks": [str(item) for item in local_route.get("tasks", [])] if isinstance(local_route.get("tasks"), list) else [],
        "route_profile": str(local_route.get("route_profile") or local_route.get("routeProfile") or ""),
        "role": str(local_route.get("role") or ""),
        "context_tokens": route_context_size(local_route) or 0,
        "kv_offload": local_route.get("kv_offload") if isinstance(local_route.get("kv_offload"), bool) else local_route.get("kvOffload"),
        "kv_cache": route_kv_cache_policy(local_route),
        "selection": route_selection(local_route),
        "description": MODEL_ROUTE_DESCRIPTIONS.get(route, ""),
    }


def estimate_text_tokens(text: str) -> int:
    if not text:
        return 0
    chars = len(text)
    words = len(re.findall(r"\S+", text))
    return max(1, words, (chars + TOKEN_ESTIMATE_CHARS_PER_TOKEN - 1) // TOKEN_ESTIMATE_CHARS_PER_TOKEN)


def estimate_messages_tokens(messages: list[dict]) -> int:
    total = 0
    for msg in messages:
        if not isinstance(msg, dict):
            continue
        total += 4
        total += estimate_text_tokens(str(msg.get("role", "")))
        total += estimate_text_tokens(str(msg.get("content", "")))
    return total + 3


def chat_context_mode() -> str:
    mode = os.environ.get(CHAT_CONTEXT_MODE_ENV, "auto").strip().lower()
