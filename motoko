            lines.append(f"  reject: motoko skill reject {row.get('id', '')}")
    return "\n".join(lines)


def skill_suggestion_duplicate(candidate: dict, rows: list[dict]) -> bool:
    candidate = normalize_skill_suggestion(candidate)
    action = candidate.get("action", "create")
    slug = candidate.get("slug", "")
    target = candidate.get("target_skill", "")
    if action == "create" and not slug:
        return True
    if action != "create" and not target:
        return True
    fingerprint_parts = [
        action,
        slug,
        target,
        candidate.get("file_path", ""),
        hashlib.sha256(candidate.get("old_string", "").encode("utf-8")).hexdigest()[:12],
        hashlib.sha256(candidate.get("new_string", "").encode("utf-8")).hexdigest()[:12],
        hashlib.sha256(candidate.get("file_content", "").encode("utf-8")).hexdigest()[:12],
    ]
    fingerprint = "\0".join(fingerprint_parts)
    for row in rows:
        normalized = normalize_skill_suggestion(row)
        other = "\0".join(
            [
                normalized.get("action", "create"),
                normalized.get("slug", ""),
                normalized.get("target_skill", ""),
                normalized.get("file_path", ""),
                hashlib.sha256(normalized.get("old_string", "").encode("utf-8")).hexdigest()[:12],
                hashlib.sha256(normalized.get("new_string", "").encode("utf-8")).hexdigest()[:12],
                hashlib.sha256(normalized.get("file_content", "").encode("utf-8")).hexdigest()[:12],
            ]
        )
        if normalized.get("status") == "pending" and other == fingerprint:
            return True
    if action == "create":
        for row in list_skills():
            if row.get("slug") == slug:
                return True
    return False


def add_skill_suggestions(
    candidates: list[dict],
    *,
    conversation_id: str,
    source: str = "auto-skill-review",
) -> list[dict]:
    if not candidates:
        return []
    state = read_skill_suggestion_state()
    rows = [normalize_skill_suggestion(row) for row in state.get("suggestions", [])]
    added = []
    for candidate in candidates[:AUTO_SKILL_MAX_PROPOSALS]:
        row = normalize_skill_suggestion(candidate)
        if not skill_suggestion_payload_ok(row):
            continue
        if skill_suggestion_duplicate(row, rows):
            continue
        row["id"] = skill_suggestion_id()
        row["status"] = "pending"
        row["created_at"] = now()
        row["updated_at"] = row["created_at"]
        row["conversation_id"] = conversation_id
        row["source"] = source
        rows.append(row)
        added.append(row)
    if added:
        write_skill_suggestions(rows)
    return added


def accept_skill_suggestion_text(selector: str) -> str:
    idx, row, rows = resolve_skill_suggestion(selector, pending_only=True)
    result = core_manage_skill(
        skills_dir(),
        action=row.get("action", "create"),
        name=row.get("name") or row.get("slug", ""),
        target_skill=row.get("target_skill", ""),
        description=row.get("description", ""),
        body=row.get("body", ""),
        kind=row.get("kind", DEFAULT_SKILL_KIND),
        handler=row.get("handler", DEFAULT_SKILL_HANDLER),
        allowed_effects=row.get("allowed_effects", list(DEFAULT_SKILL_EFFECTS)),
        triggers=row.get("triggers", []),
        security=row.get("security", "prompt-only suggested skill; no script execution"),
        source="skill-suggestion",
        replace=False,
        file_path=row.get("file_path", ""),
        file_content=row.get("file_content", ""),
        old_string=row.get("old_string", ""),
        new_string=row.get("new_string", ""),
        replace_all=row.get("replace_all", False),
        writer=atomic_write,
    )
    skill = result.get("skill", {})
    if skill.get("slug"):
        record_skill_lifecycle(
            skill.get("slug", ""),
            result.get("action", row.get("action", "")),
            note=f"accepted suggestion {row.get('id', '')}",
        )
    row["status"] = "accepted"
    row["accepted_at"] = now()
    row["updated_at"] = row["accepted_at"]
    row["accepted_skill"] = skill.get("slug", "")
    row["accepted_action"] = result.get("action", row.get("action", ""))
    row["accepted_path"] = result.get("path", "")
    rows[idx] = row
    write_skill_suggestions(rows)
    lines = [
        f"skill accepted: {skill.get('slug', '')}",
        f"action: {result.get('action', row.get('action', ''))}",
    ]
    if result.get("path"):
        lines.append(f"path: {result.get('path', '')}")
    if result.get("message"):
        lines.append(result.get("message", ""))
    return "\n".join(lines)


def reject_skill_suggestion_text(selector: str) -> str:
    idx, row, rows = resolve_skill_suggestion(selector, pending_only=True)
    row["status"] = "rejected"
    row["rejected_at"] = now()
    row["updated_at"] = row["rejected_at"]
