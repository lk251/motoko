def build_messages(conv: dict, query: str = "") -> tuple[list[dict], list[dict]]:
    prompt, sources = build_system_prompt_and_sources(conv, query)
    messages = [{"role": "system", "content": prompt}]
    messages.extend(conv.get("messages", [])[-MAX_RECENT_MESSAGES:])
    return messages, sources


def call_model(
    messages: list[dict],
    *,
    temperature: float = 0.7,
    stream: bool = True,
    echo: bool = True,
    timeout: float = MODEL_TIMEOUT_SECONDS,
) -> str:
    payload = {
        "model": model_name(),
        "messages": messages,
        "temperature": temperature,
        "stream": stream,
    }
    data = json.dumps(payload).encode("utf-8")
    req = urllib.request.Request(
        endpoint(),
        data=data,
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    spinner = ThinkingSpinner(enabled=echo)
    try:
        spinner.start()
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            if stream:
                return read_streaming_response(resp, echo=echo, spinner=spinner)
            spinner.stop()
            return read_json_response(resp)
    except (urllib.error.URLError, TimeoutError, OSError) as exc:
        raise SystemExit(f"model request failed: {exc}") from exc
    finally:
        spinner.stop()


def run_with_wall_timeout(label: str, wall_timeout: float, func, *args, **kwargs):
    result: list[object] = []
    errors: list[BaseException] = []

    def target() -> None:
        try:
            result.append(func(*args, **kwargs))
        except BaseException as exc:  # Preserve the original exception type.
            errors.append(exc)

    thread = threading.Thread(target=target, daemon=True)
    thread.start()
    thread.join(wall_timeout)
    if thread.is_alive():
        raise TimeoutError(f"{label} timed out after {int(wall_timeout)}s")
    if errors:
        raise errors[0]
    return result[0] if result else None


def motoko_program_path() -> str:
    source = pathlib.Path(__file__).resolve()
    if source.exists():
        return str(source)
    return sys.argv[0]


def propose_memories_subprocess(conv: dict, *, timeout: float = MAINTENANCE_MODEL_TIMEOUT_SECONDS) -> list[str]:
    payload = json.dumps({"conversation": conv, "timeout": timeout}, ensure_ascii=False)
    env = dict(os.environ)
    env["MOTOKO_INTERNAL"] = "1"
    try:
        result = subprocess.run(
            [sys.executable, motoko_program_path(), "__internal-propose-memories"],
            input=payload,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            env=env,
            timeout=timeout + 5,
            check=False,
        )
    except subprocess.TimeoutExpired as exc:
        raise TimeoutError(
            f"memory proposal timed out after {int(timeout)}s; helper process was terminated"
        ) from exc
    if result.returncode != 0:
        detail = (result.stderr or result.stdout).strip()
        raise RuntimeError(f"memory proposal helper failed: {detail or 'no diagnostic'}")
    try:
        data = json.loads(result.stdout or "[]")
    except json.JSONDecodeError as exc:
        raise RuntimeError("memory proposal helper returned invalid JSON") from exc
    if not isinstance(data, list):
        raise RuntimeError("memory proposal helper returned a non-list result")
    return [str(item).strip() for item in data if str(item).strip()]


def propose_memories_bounded(
    conv: dict,
    *,
    timeout: float = MAINTENANCE_MODEL_TIMEOUT_SECONDS,
) -> list[str]:
    if os.environ.get("MOTOKO_INTERNAL") == "1":
        return propose_memories(conv, timeout=timeout)
    if env_flag("MOTOKO_MEMORY_PROPOSAL_HELPER", True):
        return propose_memories_subprocess(conv, timeout=timeout)
    return run_with_wall_timeout(
        "memory proposal",
        timeout,
        propose_memories,
        conv,
        timeout=timeout,
    )


def command_internal_propose_memories() -> int:
    try:
        payload = json.loads(sys.stdin.read() or "{}")
        conv = payload.get("conversation") or {}
        timeout = float(payload.get("timeout") or MAINTENANCE_MODEL_TIMEOUT_SECONDS)
        proposals = propose_memories(conv, timeout=timeout)
    except BaseException as exc:
        print(f"{type(exc).__name__}: {exc}", file=sys.stderr)
        return 1
    print(json.dumps(proposals, ensure_ascii=False))
    return 0


def call_model_with_callback(
    messages: list[dict],
    *,
    on_token,
    temperature: float = 0.7,
    timeout: float = MODEL_TIMEOUT_SECONDS,
) -> str:
    payload = {
        "model": model_name(),
        "messages": messages,
        "temperature": temperature,
        "stream": True,
    }
    data = json.dumps(payload).encode("utf-8")
    req = urllib.request.Request(
        endpoint(),
        data=data,
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    collected = []
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            for raw in resp:
                line = raw.decode("utf-8", errors="replace").strip()
                if not line or not line.startswith("data:"):
                    continue
                data = line[5:].strip()
                if data == "[DONE]":
                    break
                try:
                    event = json.loads(data)
                except json.JSONDecodeError:
                    continue
                choices = event.get("choices") or []
                if not choices:
                    continue
                delta = choices[0].get("delta") or {}
                content = delta.get("content") or ""
                if content:
                    collected.append(content)
                    on_token(content)
    except (urllib.error.URLError, TimeoutError, OSError) as exc:
        raise SystemExit(f"model request failed: {exc}") from exc
    return "".join(collected)


def read_json_response(resp) -> str:
    event = json.loads(resp.read().decode("utf-8", errors="replace"))
    choices = event.get("choices") or []
    if not choices:
        return ""
    message = choices[0].get("message") or {}
    return message.get("content") or ""


def read_streaming_response(
    resp,
    *,
    echo: bool = True,
    spinner: ThinkingSpinner | None = None,
) -> str:
    collected = []
    for raw in resp:
        line = raw.decode("utf-8", errors="replace").strip()
        if not line or not line.startswith("data:"):
            continue
        data = line[5:].strip()
        if data == "[DONE]":
            break
        try:
            event = json.loads(data)
        except json.JSONDecodeError:
            continue
        choices = event.get("choices") or []
        if not choices:
            continue
        delta = choices[0].get("delta") or {}
        content = delta.get("content") or ""
        if content:
            if spinner is not None:
                spinner.stop()
            if echo:
                print(content, end="", flush=True)
            collected.append(content)
    if echo:
        print()
    return "".join(collected)


