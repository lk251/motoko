def parse_config_byte_count(raw, field: str) -> int:
    if isinstance(raw, int):
        if raw < 0:
            raise ValueError(f"{field} must be non-negative")
        return raw
    if isinstance(raw, str):
        return parse_byte_count(raw)
    raise ValueError(f"{field} must be a byte count string or integer")


def parse_optional_positive_int(raw, field: str) -> int | None:
    if raw in (None, ""):
        return None
    try:
        value = int(raw)
    except (TypeError, ValueError) as exc:
        raise SystemExit(f"{field} must be a positive integer") from exc
    if value <= 0:
        raise SystemExit(f"{field} must be a positive integer")
    return value


def parse_config_nonnegative_int(raw, field: str, *, minimum: int = 0, maximum: int | None = None) -> int:
    try:
        value = int(raw)
    except (TypeError, ValueError) as exc:
        raise SystemExit(f"{field} must be an integer >= {minimum}") from exc
    if value < minimum:
        raise SystemExit(f"{field} must be an integer >= {minimum}")
    if maximum is not None and value > maximum:
        raise SystemExit(f"{field} must be an integer <= {maximum}")
    return value


def parse_config_message_limit(raw, field: str, *, minimum: int = 1) -> int | None:
    if isinstance(raw, str) and raw.strip().lower() == "all":
        return None
    return parse_config_nonnegative_int(raw, field, minimum=minimum)


def conversation_recall_config() -> dict:
    raw = load_config().get("conversation_recall", {})
    if not isinstance(raw, dict):
        raw = {}

    recent_conversations = parse_config_nonnegative_int(
        raw.get("recent_conversations", RECENT_CONVERSATION_RECENCY_LANE),
        "conversation_recall.recent_conversations",
    )
    relevant_conversations = parse_config_nonnegative_int(
        raw.get("relevant_conversations", RECENT_CONVERSATION_RELEVANCE_LANE),
        "conversation_recall.relevant_conversations",
    )
    if raw.get("conversation_limit") not in (None, ""):
        conversation_limit = parse_config_nonnegative_int(
            raw.get("conversation_limit"),
            "conversation_recall.conversation_limit",
        )
    else:
        conversation_limit = max(RECENT_CONVERSATION_LIMIT, recent_conversations + relevant_conversations)

    return {
        "current_messages": parse_config_message_limit(
            raw.get("current_messages", MAX_RECENT_MESSAGES),
            "conversation_recall.current_messages",
            minimum=1,
        ),
        "current_max_chars": parse_config_nonnegative_int(
            raw.get("current_max_chars", MAX_RECENT_MESSAGE_CHARS),
            "conversation_recall.current_max_chars",
        ),
        "recent_conversations": recent_conversations,
        "relevant_conversations": relevant_conversations,
        "conversation_limit": conversation_limit,
        "conversation_messages": parse_config_nonnegative_int(
            raw.get("conversation_messages", RECENT_CONVERSATION_MESSAGES),
            "conversation_recall.conversation_messages",
        ),
        "matched_snippets": parse_config_nonnegative_int(
            raw.get("matched_snippets", RECENT_CONVERSATION_MATCHED_SNIPPETS),
            "conversation_recall.matched_snippets",
            maximum=10,
        ),
        "snippet_chars": parse_config_nonnegative_int(
            raw.get("snippet_chars", RECENT_CONVERSATION_SNIPPET_CHARS),
            "conversation_recall.snippet_chars",
            minimum=100,
            maximum=12000,
        ),
        "max_chars": parse_config_nonnegative_int(
            raw.get("max_chars", RECENT_CONVERSATION_MAX_CHARS),
            "conversation_recall.max_chars",
        ),
    }


