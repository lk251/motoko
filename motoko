CHAT_CONTEXT_ROUTE_TASKS = {
    "chat",
    "default_chat",
    "quality_chat",
    "short_context_chat",
    "long_context_chat",
    "max_context_chat",
    "max_context",
    "deep_synthesis",
}


def route_profile(info: dict) -> str:
    profile = str(info.get("route_profile") or "").strip().lower().replace("-", "_")
    return profile if profile in {"default", "quality", "deep", "max"} else ""


def route_tasks(info: dict) -> set[str]:
    tasks = info.get("tasks")
    return {str(item) for item in tasks} if isinstance(tasks, list) else set()


def route_selection_priority_value(info: dict) -> int:
    selection = info.get("selection") if isinstance(info.get("selection"), dict) else {}
    try:
        return int(selection.get("priority") or 0)
    except (TypeError, ValueError):
        return 0


def route_selection_default_value(info: dict) -> bool:
    selection = info.get("selection") if isinstance(info.get("selection"), dict) else {}
