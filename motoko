def format_task_candidates_from_chat(conv: dict, query: str = "", *, project_scope: dict | None = None) -> str:
    query = query.strip() or context_query_text(conv, conv.get("title", "")) or "priority tasks"
    project_scope = project_scope or project_scope_for_request(conv, query)
    indexes = []
    for index_id in attached_index_ids(conv, project_scope=project_scope):
        try:
            indexes.append(load_index(index_id))
        except SystemExit:
            continue
    if not indexes:
        best = best_relevant_index(query, project_scope=project_scope)
        if best is not None:
            indexes.append(best)
    if not indexes:
        return "No attached or relevant corpus index with structured Org task signals is available."

    lines = [f"Task candidates for: {query}"]
    found = False
    for index in indexes:
        ranked = ranked_task_items_from_index(index, query, limit=24)
        if not ranked:
            continue
        found = True
        lines.append(f"\nindex {index.get('id', '')}  {index.get('name', '')}  {index.get('root', '')}")
        for _score, item in ranked:
            lines.append(f"- {format_task_item(item)}")
    if not found:
        return "No structured Org task candidates were found in the selected corpus index(es)."
    return "\n".join(lines)


