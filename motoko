def unfinished_work_notice(limit: int = 3) -> str:
    partials = list_resumable_partial_indexes()
    if not partials:
        return ""
    lines = ["Unfinished Motoko work:"]
    for partial in partials[:limit]:
        completed = int(partial.get("completed_files", len(partial.get("files", []))) or 0)
        total = int(partial.get("total_files", completed) or completed)
        lines.append(
            f"- partial index {partial.get('id', '')}: {partial.get('status', 'unknown')}, "
            f"{completed}/{total} file(s), {partial.get('name', '')} {partial.get('root', '')}"
        )
    if len(partials) > limit:
        lines.append(f"- ... {len(partials) - limit} more partial index(es)")
    lines.append("Use /resume-work [INDEX_ID] or motoko resume-work INDEX_ID to continue.")
    return "\n".join(lines)


