def profile_refresh_due(catalog: dict | None = None) -> bool:
    catalog = catalog or read_context_catalog() or build_context_catalog()
    if not catalog.get("memory_count", 0) and not catalog.get("conversation_count", 0):
        return False
    _source_text, memory_ids, conversation_ids = profile_source_material()
    if not memory_ids and not conversation_ids:
        return False
    profile = load_profile_dossier()
    if not profile or not profile.get("text", "").strip():
        return True
    updated = parse_timestamp(profile.get("updated", ""))
    if updated is None:
        return True
    age = (_dt.datetime.now(_dt.timezone.utc).astimezone() - updated.astimezone()).total_seconds()
    if age < BACKGROUND_PROFILE_REFRESH_INTERVAL_SECONDS:
        return False
    known_memories = set(profile.get("memory_ids", []))
    known_conversations = set(profile.get("conversation_ids", []))
    return bool(set(memory_ids) - known_memories or set(conversation_ids) - known_conversations)


def parse_study_directive(text: str) -> tuple[str, str | None]:
    try:
        parts = shlex.split(text)
    except ValueError:
        parts = text.split()
    focus = None
    query_parts = []
    idx = 0
    while idx < len(parts):
        part = parts[idx]
        if part == "--focus":
            if idx + 1 >= len(parts):
                raise SystemExit("usage: /study QUERY [--focus recent]")
            focus = parts[idx + 1].strip().lower()
            idx += 2
            continue
        if part.startswith("--focus="):
            focus = part.split("=", 1)[1].strip().lower()
            idx += 1
            continue
        query_parts.append(part)
        idx += 1
    if focus and focus not in {"recent"}:
        raise SystemExit("unknown study focus; currently supported: recent")
    return " ".join(query_parts).strip(), focus


def recent_focus_terms() -> str:
    today = _dt.datetime.now().astimezone().date()
    yesterday = today - _dt.timedelta(days=1)
    values = []
    for day in (today, yesterday):
        values.extend(
            [
                day.isoformat(),
                day.strftime("%Y-%m-%d %a"),
                day.strftime("%Y/%m/%d"),
                day.strftime("%b %d %Y"),
                day.strftime("%B %d %Y"),
            ]
        )
    return " ".join(values + ["today", "yesterday", "recent", "latest", "logbook"])


def study_retrieval_query(query: str, focus: str | None) -> str:
    if focus == "recent":
        return f"{query} {recent_focus_terms()}".strip()
    return query


def study_query(conv: dict, query: str, *, focus: str | None = None, cancel_event=None) -> str:
    query = query.strip()
    if not query:
        raise SystemExit("usage: /study QUERY")
    raise_if_work_cancelled(cancel_event, "study interrupted by request", work_kind="study")
    retrieval_query = study_retrieval_query(query, focus)
    project_scope = project_scope_for_request(conv, retrieval_query)
    topic_limit = min(TOPIC_DEFAULT_CHUNKS, 8) if focus == "recent" else TOPIC_DEFAULT_CHUNKS

    topic = maybe_attach_relevant_existing_topic(conv, retrieval_query, project_scope=project_scope)
    raise_if_work_cancelled(cancel_event, "study interrupted by request", work_kind="study")
    if topic:
        return f"attached existing topic dossier: {topic.get('id')} ({topic.get('name', '')})"

    dossier = maybe_attach_relevant_existing_dossier(conv, retrieval_query, project_scope=project_scope)
    raise_if_work_cancelled(cancel_event, "study interrupted by request", work_kind="study")
    if dossier:
        return f"attached existing memory dossier: {dossier.get('id')} ({dossier.get('name', '')})"

    index_ids = attached_index_ids(conv, project_scope=project_scope)
    if index_ids:
        topic = build_topic_dossier(
            index_ids,
            query,
            max_chunks=topic_limit,
            retrieval_query=retrieval_query,
            focus=focus,
            owner_conversation_id=str(conv.get("id", "")),
            cancel_event=cancel_event,
        )
        attach_context_item(conv, context_item_from_topic(topic))
        return f"built topic dossier from attached index(es): {topic.get('id')}"

    index = best_relevant_index(retrieval_query, project_scope=project_scope)
    if index:
        topic = build_topic_dossier(
            [index["id"]],
            query,
            max_chunks=topic_limit,
            retrieval_query=retrieval_query,
            focus=focus,
            owner_conversation_id=str(conv.get("id", "")),
            cancel_event=cancel_event,
        )
        attach_context_item(conv, context_item_from_topic(topic))
        return f"built topic dossier from index {index.get('id')}: {topic.get('id')}"

    dossier = build_memory_dossier(
        retrieval_query,
        owner_conversation_id=str(conv.get("id", "")),
        cancel_event=cancel_event,
    )
    attach_context_item(conv, context_item_from_dossier(dossier))
    return f"built memory dossier: {dossier.get('id')}"


