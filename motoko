def auto_maintain_conversation(
    conv: dict,
    *,
    phase_callback=None,
    state: dict | None = None,
) -> list[str]:
    def set_phase(phase: str, *, note: str | None = None) -> None:
        if state is not None:
            update_maintenance_state(state, phase, note=note)
        if phase_callback is not None:
            phase_callback(phase)
        if work_pause_requested():
            if state is not None:
                update_maintenance_state(state, "memory: paused", status="paused", note="paused by request")
            clear_work_pause_request()
            raise WorkPaused("memory maintenance paused by request", work_id=state.get("job_id", "") if state else "", work_kind="maintenance")

    notes = []
    set_phase("memory: checking")
    messages = conv.get("messages", [])
    message_count = len(messages)
    set_phase("skills: upgrading")
    skill_upgrade_report = upgrade_skills()
    if skill_upgrade_report.get("upgraded"):
        notes.append(f"upgraded {skill_upgrade_report.get('upgraded')} skill file(s)")
    if skill_upgrade_report.get("errors"):
        notes.append(f"skill upgrade errors: {len(skill_upgrade_report.get('errors', []))}")
    if should_generate_conversation_title(conv):
        set_phase("title: naming")
        try:
            title = run_with_wall_timeout(
                "title generation",
                TITLE_MODEL_TIMEOUT_SECONDS,
                maybe_generate_conversation_title,
                conv,
                timeout=TITLE_MODEL_TIMEOUT_SECONDS,
            )
        except (Exception, SystemExit):
            title = None
        if title:
            notes.append(f"title: {title}")

    last_memory = int(conv.get("last_auto_memory_message_count", 0) or 0)
    if (
        message_count >= AUTO_MEMORY_MIN_MESSAGES
        and message_count - last_memory >= AUTO_MEMORY_INTERVAL_MESSAGES
    ):
        set_phase("memory: queueing")
        enqueue_memory_proposal(conv, message_count=message_count)

    if queued_memory_proposal_count():
        notes.extend(
            run_queued_memory_proposals(
                current_conv=conv,
                limit=MEMORY_PROPOSAL_QUEUE_DRAIN_LIMIT,
                phase_callback=set_phase,
            )
        )

    last_skill = int(conv.get("last_auto_skill_message_count", 0) or 0)
    skill_reasons = skill_review_triggers(conv, message_count=message_count, last_skill=last_skill)
    if skill_reasons:
        set_phase("skills: reviewing")
        suggestions = []
        try:
            suggestions = run_with_wall_timeout(
                "skill suggestion",
                MAINTENANCE_MODEL_TIMEOUT_SECONDS,
                propose_skill_suggestions,
                conv,
                timeout=MAINTENANCE_MODEL_TIMEOUT_SECONDS,
                review_reasons=skill_reasons,
            )
        except (Exception, SystemExit):
            suggestions = []
        if suggestions:
            set_phase("skills: suggesting")
            added = add_skill_suggestions(suggestions, conversation_id=conv.get("id", ""))
            if added:
                label = ", ".join(row.get("slug", "") for row in added[:AUTO_SKILL_MAX_PROPOSALS])
                notes.append(f"skill suggestion pending: {label}")
        conv["last_auto_skill_message_count"] = message_count

    last_compact = int(conv.get("last_auto_compact_message_count", 0) or 0)
    if (
        message_count >= AUTO_SUMMARY_MIN_MESSAGES
        and message_count - last_compact >= AUTO_SUMMARY_INTERVAL_MESSAGES
    ):
        set_phase("memory: compacting")
        if compact_conversation(conv, quiet=True, timeout=MAINTENANCE_MODEL_TIMEOUT_SECONDS):
            notes.append("compacted older conversation context")
    save_conversation(conv)
    set_phase("memory: done", note="; ".join(notes) if notes else "no changes")
    return notes


