            return "/skill unpin", lambda: "usage: /skill unpin NAME"
        return "/skill unpin", lambda: pin_skill_text(subbody, False)
    if subcommand == "archive":
        if not subbody:
            return "/skill archive", lambda: "usage: /skill archive NAME --yes"
        parts = subbody.split()
        yes = "--yes" in parts
        name = " ".join(part for part in parts if part != "--yes").strip()
        return "/skill archive", lambda: archive_skill_text(name, yes=yes)
    if subcommand == "restore":
        if not subbody:
            return "/skill restore", lambda: "usage: /skill restore NAME"
        return "/skill restore", lambda: restore_skill_text(subbody)
    if subcommand == "patch":
        if not subbody:
            return "/skill patch", lambda: "usage: /skill patch NAME --old OLD --new NEW [--file SKILL.md|references/x.md] [--all]"
        return "/skill patch", lambda: manage_skill_text(action="patch", **parse_skill_patch_args(subbody))
    if subcommand == "write-file":
        if not subbody:
            return "/skill write-file", lambda: "usage: /skill write-file NAME SUPPORT_PATH (--content TEXT | --from PATH)"
        return "/skill write-file", lambda: manage_skill_text(action="write_file", **parse_skill_write_file_args(subbody))
    if subcommand == "remove-file":
        if not subbody:
            return "/skill remove-file", lambda: "usage: /skill remove-file NAME SUPPORT_PATH --yes"
        return "/skill remove-file", lambda: manage_skill_text(action="remove_file", **parse_skill_remove_file_args(subbody))
    if subcommand == "accept":
        if not subbody:
            return "/skill accept", lambda: "usage: /skill accept SUGGESTION_ID"
        return "/skill accept", lambda: accept_skill_suggestion_text(subbody)
    if subcommand == "reject":
