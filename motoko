def ranked_index_chunks(index: dict, query: str) -> list[tuple[int, dict, dict, str]]:
    query_counts = token_counts(query)
    rows = []
    for file_item in index.get("files", []):
        file_signal_text = format_signal_summary(file_item.get("signals") or {}, limit=12)
        for chunk in file_item.get("chunks", []):
            content = read_chunk_content(index, chunk)
            chunk_signal_text = format_signal_summary(chunk.get("signals") or {}, limit=12)
            haystack = "\n".join(
                [
                    file_item.get("path", ""),
                    file_item.get("summary", ""),
                    file_signal_text,
                    chunk.get("summary", ""),
                    chunk_signal_text,
                    query_aware_content_excerpt(query, content, 4000),
                ]
            )
            score = score_text(query_counts, haystack)
            score += query_path_match_boost(query, file_item.get("path", ""))
            score += task_signal_boost(query, file_item.get("signals") or {})
            score += task_signal_boost(query, chunk.get("signals") or {})
            rows.append((score, file_item, chunk, content))
    rows.sort(key=lambda row: row[0], reverse=True)
    return rows


def wants_deep_context(query: str) -> bool:
    terms = set(token_counts(query))
    return bool(terms & DEEP_RETRIEVAL_TERMS)


def retrieval_limits(query: str) -> tuple[int, int, int]:
    if wants_deep_context(query):
        return RETRIEVAL_TOP_FILES * 2, RETRIEVAL_TOP_CHUNKS * 3, MAX_RETRIEVAL_CHARS * 2
    return RETRIEVAL_TOP_FILES, RETRIEVAL_TOP_CHUNKS, MAX_RETRIEVAL_CHARS


def build_topic_dossier(
    index_ids: list[str],
    query: str,
    *,
    name: str | None = None,
    max_chunks: int = TOPIC_DEFAULT_CHUNKS,
    retrieval_query: str | None = None,
    focus: str | None = None,
    owner_conversation_id: str = "",
    cancel_event=None,
) -> dict:
    query = query.strip()
    if not query:
        raise SystemExit("topic query is empty")
    retrieval_query = (retrieval_query or query).strip()
    if not index_ids:
        raise SystemExit("topic dossier needs at least one document index")
    max_chunks = max(1, min(max_chunks, TOPIC_MAX_CHUNKS))

    selected_rows = []
    source_indexes = []
    for index_id in index_ids:
        raise_if_work_cancelled(cancel_event, "topic dossier interrupted by request", work_kind="topic")
        index = load_index(index_id)
        status, warnings = index_staleness(index)
        source_indexes.append(
            {
                "id": index.get("id", index_id),
                "name": index.get("name", ""),
                "root": index.get("root", ""),
                "status_at_build": status,
                "warnings_at_build": warnings[:8],
            }
        )
        for score, file_item, chunk, content in ranked_index_chunks(index, retrieval_query):
            selected_rows.append((score, index, file_item, chunk, content))

    selected_rows.sort(key=lambda row: row[0], reverse=True)
    positive_rows = [row for row in selected_rows if row[0] > 0]
    selected_rows = (positive_rows or selected_rows)[:max_chunks]
    if not selected_rows:
        raise SystemExit("no chunks available in the selected index(es)")

    topic_id = _dt.datetime.now().strftime("%Y%m%d-%H%M%S") + "-" + uuid.uuid4().hex[:6]
    evidence = []
    blocks = []
    for score, index, file_item, chunk, content in selected_rows:
        raise_if_work_cancelled(cancel_event, "topic dossier interrupted by request", work_kind="topic")
        excerpt = query_aware_content_excerpt(retrieval_query, content, TOPIC_EXCERPT_CHARS)
        evidence_item = {
            "index": index.get("id", ""),
            "index_name": index.get("name", ""),
            "path": file_item.get("path", ""),
            "chunk": chunk.get("chunk"),
            "score": score,
            "chunk_summary": chunk.get("summary", ""),
            "file_summary": file_item.get("summary", ""),
            "excerpt": excerpt,
            "excerpt_sha256": sha256_hex(excerpt.encode("utf-8")),
        }
        evidence.append(evidence_item)
        blocks.append(
            textwrap.dedent(
                f"""
                Source: index={evidence_item['index']} file={evidence_item['path']} chunk={evidence_item['chunk']} score={score}
                File summary:
                {evidence_item['file_summary']}

                Chunk summary:
                {evidence_item['chunk_summary']}

                Excerpt:
                {excerpt}
                """
            ).strip()
        )

    focus_note = f" focus={focus}" if focus else ""
    print(f"Building topic dossier {topic_id} from {len(evidence)} chunk(s).{focus_note}")
    summary = summarize_blocks(
        f"topic dossier: {query}{focus_note}",
        blocks,
        textwrap.dedent(
            """
            Create a detailed topic dossier from these retrieved source chunks.
            Use headings: Overview, Detailed Findings, Source Map, Tensions Or
            Uncertainties, Follow-up Questions. Ground claims in the supplied
            excerpts and source paths. Do not invent facts.
            """
        ).strip(),
        route=MODEL_ROUTE_TOPIC,
        prompt_version=TOPIC_DOSSIER_SCHEMA_VERSION,
        cancel_event=cancel_event,
    )
    evidence_source = "\n\n".join(
        f"{item.get('index', '')}:{item.get('path', '')}:{item.get('chunk', '')}:{item.get('excerpt_sha256', '')}"
        for item in evidence
    )
    topic = {
        "id": topic_id,
        "name": name or slug_title(query),
        "query": query,
        "focus": focus or "",
        "retrieval_query": retrieval_query,
        "created": now(),
        "owner_conversation_id": owner_conversation_id,
        "technique": "topic-focused hierarchical retrieval-augmented dossier",
        "source_indexes": source_indexes,
        "selected_chunk_count": len(evidence),
        "summary": summary,
        "summary_artifact": artifact_provenance(
            "topic-dossier",
            TOPIC_DOSSIER_SCHEMA_VERSION,
            route=MODEL_ROUTE_TOPIC,
            prompt_version=TOPIC_DOSSIER_SCHEMA_VERSION,
            source_sha256=sha256_hex(evidence_source.encode("utf-8")),
        ),
        "evidence": evidence,
    }
    atomic_write(topic_path(topic_id), json.dumps(topic, ensure_ascii=False, indent=2) + "\n")
    print(f"topic saved: {topic_id}")
    return topic


def build_memory_dossier(query: str, *, name: str | None = None, owner_conversation_id: str = "", cancel_event=None) -> dict:
    query = query.strip()
    if not query:
        raise SystemExit("dossier query is empty")

    seed_conv = {
        "id": "",
        "title": query,
        "summary": "",
        "messages": [{"role": "user", "content": query}],
    }
    memories = ranked_memories(
        conv=seed_conv,
        query=query,
        limit=MEMORY_DOSSIER_SOURCE_MEMORIES,
    )
    conversations = ranked_recent_conversations(seed_conv, query)[:MEMORY_DOSSIER_SOURCE_CONVERSATIONS]
    profile = load_profile_dossier()

    if not memories and not conversations and not profile:
        raise SystemExit("dossier needs saved memories, prior conversations, or a profile dossier")

    dossier_id = _dt.datetime.now().strftime("%Y%m%d-%H%M%S") + "-" + uuid.uuid4().hex[:6]
    source_memories = []
    source_conversations = []
    blocks = []
    used = 0

    raise_if_work_cancelled(cancel_event, "memory dossier interrupted by request", work_kind="dossier")
    if profile:
        profile_text = profile.get("text", "")[:MEMORY_DOSSIER_EXCERPT_CHARS]
        blocks.append(f"Profile dossier updated {profile.get('updated', '')}:\n{profile_text}")
        used += len(blocks[-1])

    for row in memories:
        raise_if_work_cancelled(cancel_event, "memory dossier interrupted by request", work_kind="dossier")
        if used >= MEMORY_DOSSIER_MAX_SOURCE_CHARS:
            break
        text = row.get("text", "")[:MEMORY_DOSSIER_EXCERPT_CHARS]
        item = {
            "id": row.get("id", ""),
            "source": row.get("source", "unknown"),
            "conversation_id": row.get("conversation_id", ""),
            "created": row.get("created", ""),
            "importance": row.get("importance", MEMORY_DEFAULT_IMPORTANCE),
            "pinned": bool(row.get("pinned")),
            "score": row.get("_score", 0),
            "matched_terms": row.get("_matched_terms", 0),
            "excerpt": text,
        }
        source_memories.append(item)
        block = (
            f"Memory {item['id']} importance={item['importance']} "
            f"score={item['score']} match={item['matched_terms']}:\n{text}"
        )
        blocks.append(block)
        used += len(block)

    for row in conversations:
        raise_if_work_cancelled(cancel_event, "memory dossier interrupted by request", work_kind="dossier")
        if used >= MEMORY_DOSSIER_MAX_SOURCE_CHARS:
            break
        recall = conversation_recall_text(row)[:MEMORY_DOSSIER_EXCERPT_CHARS]
        item = {
            "id": row.get("id", ""),
            "title": row.get("title", "Untitled"),
            "created": row.get("created", ""),
            "updated": row.get("updated", row.get("created", "")),
            "branch": row.get("branch", ""),
            "score": row.get("_recall_score", 0),
            "matched_terms": row.get("_matched_terms", 0),
            "selection": row.get("_selection_reasons", []),
            "excerpt": recall,
        }
        source_conversations.append(item)
        block = (
            f"Conversation {item['id']} title={item['title']} "
            f"updated={item['updated']} score={item['score']} "
            f"selection={','.join(item['selection']) or '-'}:\n{recall}"
        )
        blocks.append(block)
        used += len(block)

    print(
        f"Building memory dossier {dossier_id} from "
        f"{len(source_memories)} memor{'y' if len(source_memories) == 1 else 'ies'} "
        f"and {len(source_conversations)} conversation(s)."
    )
    summary = summarize_blocks(
        f"memory dossier: {query}",
        blocks,
        textwrap.dedent(
            """
            Create a query-focused private memory dossier from these supplied
            memories, profile notes, and conversation capsules. Use headings:
            Overview, Stable Facts, Relevant History, Tensions Or Uncertainties,
            Open Questions, Useful Next Context. Separate durable facts from
            tentative inferences. Do not invent facts.
            """
        ).strip(),
        route=MODEL_ROUTE_MEMORY,
        prompt_version=MEMORY_DOSSIER_SCHEMA_VERSION,
        cancel_event=cancel_event,
    )
    memory_source_rows = [
        item.get("id", "") + ":" + item.get("excerpt", "")
        for item in source_memories
    ] + [
        item.get("id", "") + ":" + item.get("excerpt", "")
        for item in source_conversations
    ]
    memory_source = "\n\n".join(memory_source_rows)
    dossier = {
        "id": dossier_id,
        "name": name or slug_title(query),
        "query": query,
        "created": now(),
        "owner_conversation_id": owner_conversation_id,
        "technique": "query-focused hierarchical retrieval over memories and conversations",
        "summary": summary,
        "summary_artifact": artifact_provenance(
            "memory-dossier",
            MEMORY_DOSSIER_SCHEMA_VERSION,
            route=MODEL_ROUTE_MEMORY,
            prompt_version=MEMORY_DOSSIER_SCHEMA_VERSION,
            source_sha256=sha256_hex(memory_source.encode("utf-8")),
        ),
        "profile_used": bool(profile),
        "source_memory_count": len(source_memories),
        "source_conversation_count": len(source_conversations),
        "source_memories": source_memories,
        "source_conversations": source_conversations,
    }
    atomic_write(dossier_path(dossier_id), json.dumps(dossier, ensure_ascii=False, indent=2) + "\n")
    print(f"dossier saved: {dossier_id}")
    return dossier


def attached_item_ids(conv: dict, kind: str) -> set[str]:
    return {
        item.get("id", "")
        for item in conv.get("context_items", [])
        if item.get("kind") == kind and item.get("id")
    }


def attach_context_item(conv: dict, item: dict) -> bool:
    existing = attached_item_ids(conv, item.get("kind", ""))
    if item.get("id") in existing:
        return False
    conv.setdefault("context_items", []).append(item)
    save_conversation(conv)
    return True


def replace_attached_index(conv: dict, old_index_id: str, new_index: dict) -> None:
    replacement = context_item_from_index(new_index)
    items = conv.setdefault("context_items", [])
    for idx, item in enumerate(items):
        if item.get("kind") == "index" and item.get("id") == old_index_id:
            items[idx] = replacement
            save_conversation(conv)
            return
    items.append(replacement)
    save_conversation(conv)


def sync_attached_indexes_to_latest(conv: dict) -> list[str]:
    """Refresh attached index references to newer completed same-family indexes.

    This is deliberately cheap: it only swaps conversation context items to
    already materialized index records. Source rebuilds, evidence refreshes,
    and vector refreshes remain normal background work.
    """

    items = conv.setdefault("context_items", [])
    if not items:
        return []
    available_indexes = list_indexes()
    by_id = {str(index.get("id", "")): index for index in available_indexes if index.get("id")}
    notes = []
    changed = False
    for idx, item in enumerate(list(items)):
        if item.get("kind") != "index" or not item.get("id"):
            continue
        current = by_id.get(str(item.get("id", "")))
        if current is None:
            continue
        latest = latest_index_for_family(current, available_indexes)
        if latest is None or latest.get("id") == current.get("id"):
            continue
        if stored_record_sort_key(latest) <= stored_record_sort_key(current):
            continue
        items[idx] = context_item_from_index(latest)
        changed = True
        notes.append(f"attached newer index {current.get('id')} -> {latest.get('id')}")
    if changed:
        save_conversation(conv)
    return notes


def read_heavy_study_state() -> dict:
    path = heavy_study_path()
    if not path.exists():
        return {"indexes": {}}
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return {"indexes": {}}
    return data if isinstance(data, dict) else {"indexes": {}}


def write_heavy_study_state(state: dict) -> None:
    state.setdefault("indexes", {})
    atomic_write(heavy_study_path(), json.dumps(state, ensure_ascii=False, indent=2) + "\n")
    heavy_study_path().chmod(0o600)


def heavy_index_key(index: dict) -> str:
    return index_family_key(index)


def heavy_index_cooldown_active(index: dict, state: dict) -> bool:
    key = heavy_index_key(index)
    record = state.get("indexes", {}).get(key, {})
    attempted = parse_timestamp(record.get("last_attempt", ""))
    if attempted is None:
        return False
    cooldown = env_seconds(
        "MOTOKO_BACKGROUND_HEAVY_INDEX_COOLDOWN",
        BACKGROUND_HEAVY_INDEX_COOLDOWN_SECONDS,
    )
    age = (_dt.datetime.now(_dt.timezone.utc).astimezone() - attempted.astimezone()).total_seconds()
    return age < cooldown


def mark_heavy_index_attempt(index: dict, state: dict, *, result: str, new_index_id: str = "") -> None:
    state.setdefault("indexes", {})[heavy_index_key(index)] = {
        "root": index.get("root", ""),
        "glob": index.get("glob", AUTO_INDEX_GLOB),
        "name": index.get("name", ""),
        "last_attempt": now(),
        "last_result": result,
        "new_index_id": new_index_id,
    }
    write_heavy_study_state(state)


def index_change_summary(index: dict) -> dict:
    status, warnings = index_staleness(index)
    root = pathlib.Path(index.get("root", "")).expanduser().resolve()
    pattern = index.get("glob") or AUTO_INDEX_GLOB
    known_paths = {
        str(pathlib.Path(file_item.get("path", "")).expanduser().resolve())
        for file_item in index.get("files", [])
        if file_item.get("path")
    }
    try:
        require_allowed(root)
        candidate_report = index_candidate_report(root, pattern)
        candidates = apply_index_limits(candidate_report["candidates"])
    except SystemExit as exc:
        return {
            "status": status,
            "warnings": warnings + [str(exc)],
            "new_files": [],
            "new_bytes": 0,
            "candidate_files": 0,
            "indexed_files": len(known_paths),
            "covered_files": 0,
            "missing_files": [],
            "ignored_count": 0,
            "ignored_file_count": 0,
            "ignored_dir_count": 0,
            "source_lifecycle": [],
            "source_lifecycle_counts": {},
            "artifact_lifecycle_plan": source_lifecycle_artifact_plan(
                index_id=str(index.get("id", "")),
                source_lifecycle=[],
                dependent_counts={},
            ),
            "coverage_score": 0,
        }
    current_paths = {str(candidate.resolve()): candidate for candidate in candidates}
    new_files = sorted(
        path for path_text, path in current_paths.items() if path_text not in known_paths
    )
    missing_paths = sorted(path_text for path_text in known_paths if path_text not in current_paths)
    rules = candidate_report.get("selection_policy", {}).get("motokoignore", {}).get("rules", [])
    source_lifecycle = []
    for file_item in index.get("files", []):
        path_text = file_item.get("path", "")
        if not path_text:
            continue
        path = pathlib.Path(path_text).expanduser()
        try:
            resolved = str(path.resolve())
        except OSError:
            resolved = str(path)
        exists = path.exists()
        ignored = exists and resolved not in current_paths
        if exists and rules and root.is_dir():
            with contextlib.suppress(OSError, ValueError):
                rel = path.resolve().relative_to(root).as_posix()
                ignored = ignored or motoko_ignore_matches(rules, rel, is_dir=False) is not None
        file_status, _file_warnings = file_staleness(file_item)
        lifecycle = source_lifecycle_state(
            path=path_text,
            exists=exists,
            ignored=ignored,
            fingerprint_changed=file_status == "stale" and exists and not ignored,
        )
        if lifecycle.get("status") != "fresh":
            source_lifecycle.append(lifecycle)
    lifecycle_counts = dict(collections.Counter(item.get("status", "unknown") for item in source_lifecycle))
    artifact_plan = source_lifecycle_artifact_plan(
        index_id=str(index.get("id", "")),
        source_lifecycle=source_lifecycle,
        dependent_counts=artifact_dependency_counts_for_index(str(index.get("id", ""))),
    )
    covered_files = len(known_paths & set(current_paths))
    new_bytes = 0
    for path in new_files:
        try:
            new_bytes += path.stat().st_size
        except OSError:
            pass
    candidate_count = len(current_paths)
    indexed_count = len(known_paths)
    denominator = max(candidate_count, indexed_count, 1)
    coverage_score = int((covered_files / denominator) * 100)
    if status == "stale":
        coverage_score = min(coverage_score, 70)
    elif status in {"unknown", "empty"}:
        coverage_score = min(coverage_score, 40)
    return {
        "status": status,
        "warnings": warnings,
        "new_files": new_files,
        "new_bytes": new_bytes,
        "candidate_files": candidate_count,
        "indexed_files": indexed_count,
        "covered_files": covered_files,
        "missing_files": missing_paths,
        "ignored_count": candidate_report.get("ignored_count", 0),
        "ignored_file_count": candidate_report.get("ignored_file_count", 0),
        "ignored_dir_count": candidate_report.get("ignored_dir_count", 0),
        "source_lifecycle": source_lifecycle[:50],
        "source_lifecycle_counts": lifecycle_counts,
        "artifact_lifecycle_plan": artifact_plan,
        "coverage_score": coverage_score,
    }


def format_index_health(summary: dict) -> str:
    score = summary.get("coverage_score")
    if score is None:
        return "health ?"
    parts = [f"health {score}%"]
    new_files = len(summary.get("new_files", []) or [])
    missing_files = len(summary.get("missing_files", []) or [])
    lifecycle_counts = summary.get("source_lifecycle_counts") or {}
    if new_files:
        parts.append(f"new {new_files}")
    if missing_files:
        parts.append(f"missing {missing_files}")
    if lifecycle_counts.get("changed"):
        parts.append(f"changed {lifecycle_counts.get('changed')}")
    if lifecycle_counts.get("deleted"):
        parts.append(f"deleted {lifecycle_counts.get('deleted')}")
    if lifecycle_counts.get("ignored"):
        parts.append(f"ignored-indexed {lifecycle_counts.get('ignored')}")
    ignored = int(summary.get("ignored_count", 0) or 0)
    if ignored:
        parts.append(f"ignored {summary.get('ignored_count')}")
    if summary.get("status") == "stale":
        parts.append("stale")
    return " ".join(parts)


def format_index_signal_state(index: dict) -> str:
    profile = index.get("corpus_profile")
    if not index_needs_corpus_profile(index):
        profile_state = "profile current"
    elif index.get("corpus_profile_schema") or isinstance(profile, dict):
        profile_state = "profile old"
    else:
        profile_state = "profile missing"
    schema = index.get("signal_schema")
    if schema == SIGNAL_SCHEMA_VERSION:
        return f"signals current {profile_state}"
    if schema:
        return f"signals old {profile_state}"
    return f"signals missing {profile_state}"


def heavy_index_refresh_reason(summary: dict) -> str | None:
    if summary.get("status") == "stale":
        return "stale indexed source content"
    new_files = len(summary.get("new_files", []))
    new_bytes = int(summary.get("new_bytes", 0) or 0)
    min_files = env_int(
        "MOTOKO_BACKGROUND_HEAVY_INDEX_MIN_NEW_FILES",
        BACKGROUND_HEAVY_INDEX_MIN_NEW_FILES,
    )
    min_bytes = env_int(
        "MOTOKO_BACKGROUND_HEAVY_INDEX_MIN_NEW_BYTES",
        BACKGROUND_HEAVY_INDEX_MIN_NEW_BYTES,
    )
    if new_files >= min_files:
        return f"{new_files} new files"
    if new_bytes >= min_bytes:
        return f"{human_bytes(new_bytes)} of new files"
    return None


def refresh_heavy_attached_indexes(
    conv: dict,
    phase_callback=None,
    *,
    ignore_cooldown: bool = False,
    cancel_event=None,
) -> list[str]:
    if not env_flag("MOTOKO_BACKGROUND_HEAVY_INDEX", True):
        return []
    raise_if_work_cancelled(cancel_event, "background study paused by request", work_kind="study")
    if work_pause_requested():
        return ["heavy index refresh paused by request"]
    state = read_heavy_study_state()
    notes = []
    available_indexes = list_indexes()
    for item in list(conv.get("context_items", [])):
        raise_if_work_cancelled(cancel_event, "background study paused by request", work_kind="study")
        if item.get("kind") != "index" or not item.get("id"):
            continue
        try:
            index = load_index(item.get("id"))
        except SystemExit as exc:
            notes.append(f"heavy index refresh skipped: {exc}")
            continue
        latest = latest_index_for_family(index, available_indexes)
        if latest and latest.get("id") != index.get("id"):
            replace_attached_index(conv, index.get("id", ""), latest)
            notes.append(f"attached newer index {index.get('id')} -> {latest.get('id')}")
            index = latest
        summary = index_change_summary(index)
        reason = heavy_index_refresh_reason(summary)
        if reason is None:
            new_files = len(summary.get("new_files", []))
            if new_files:
                name = index.get("name", index.get("id"))
                notes.append(f"{new_files} new file(s) below heavy index threshold for {name}")
            continue
        if heavy_index_cooldown_active(index, state) and not ignore_cooldown:
            notes.append(f"heavy index refresh on cooldown for {index.get('name', index.get('id'))}")
            continue
        if ignore_cooldown and heavy_index_cooldown_active(index, state):
            notes.append(
                f"heavy index cooldown bypassed for {index.get('name', index.get('id'))}"
            )
        mark_heavy_index_attempt(index, state, result=f"started: {reason}")
        if phase_callback is not None:
            phase_callback("bg-heavy: indexing(model)")
        def on_progress(progress: dict) -> None:
            if phase_callback is not None:
                phase_callback(format_index_progress_status(progress))

        try:
            refreshed = build_document_index_quiet(
                index.get("root", ""),
                index.get("glob") or AUTO_INDEX_GLOB,
                index.get("name", ""),
                progress_callback=on_progress,
                cancel_event=cancel_event,
            )
            replace_attached_index(conv, index.get("id", ""), refreshed)
        except WorkPaused as exc:
            mark_heavy_index_attempt(index, state, result=f"paused: {exc}")
            notes.append(f"heavy index refresh paused for {index.get('name', index.get('id'))}: {exc}")
            break
        except SystemExit as exc:
            mark_heavy_index_attempt(index, state, result=f"failed: {exc}")
            notes.append(f"heavy index refresh failed for {index.get('name', index.get('id'))}: {exc}")
            continue
        except Exception as exc:
            mark_heavy_index_attempt(index, state, result=f"failed: {type(exc).__name__}: {exc}")
            notes.append(f"heavy index refresh failed for {index.get('name', index.get('id'))}: {exc}")
            continue
        mark_heavy_index_attempt(index, state, result="refreshed", new_index_id=refreshed.get("id", ""))
        notes.append(
            f"heavy index refreshed {index.get('id')} -> {refreshed.get('id')} ({reason})"
        )
        break
    return notes


def cwd_learning_key(root: pathlib.Path, pattern: str = AUTO_INDEX_GLOB) -> str:
    raw = f"{root}\0{pattern or AUTO_INDEX_GLOB}"
    return sha256_hex(raw.encode("utf-8"))[:16]


def cwd_learning_declined_recently(root: pathlib.Path, pattern: str = AUTO_INDEX_GLOB) -> bool:
    state = read_heavy_study_state()
    record = state.get("cwd_declines", {}).get(cwd_learning_key(root, pattern), {})
    declined = parse_timestamp(record.get("declined_at", ""))
    if declined is None:
        return False
    cooldown = env_seconds(
        "MOTOKO_CWD_LEARN_DECLINE_COOLDOWN",
        CWD_LEARN_DECLINE_COOLDOWN_SECONDS,
    )
    age = (_dt.datetime.now(_dt.timezone.utc).astimezone() - declined.astimezone()).total_seconds()
    return age < cooldown


def record_cwd_learning_decline(root: pathlib.Path, pattern: str = AUTO_INDEX_GLOB) -> None:
    state = read_heavy_study_state()
    state.setdefault("cwd_declines", {})[cwd_learning_key(root, pattern)] = {
        "root": str(root),
        "glob": pattern or AUTO_INDEX_GLOB,
        "declined_at": now(),
    }
    write_heavy_study_state(state)


def matching_cwd_indexes(root: pathlib.Path, pattern: str = AUTO_INDEX_GLOB) -> list[dict]:
    root_text = str(root.resolve())
    glob_text = pattern or AUTO_INDEX_GLOB
    rows = [
        index
        for index in list_indexes()
        if index.get("root") == root_text and (index.get("glob") or AUTO_INDEX_GLOB) == glob_text
    ]
    rows.sort(key=lambda index: index.get("created", ""), reverse=True)
    return rows


def matching_cwd_partial_indexes(root: pathlib.Path, pattern: str = AUTO_INDEX_GLOB) -> list[dict]:
    root_text = str(root.resolve())
    glob_text = pattern or AUTO_INDEX_GLOB
    rows = [
        index
        for index in list_resumable_partial_indexes()
        if index.get("root") == root_text and (index.get("glob") or AUTO_INDEX_GLOB) == glob_text
    ]
    rows.sort(key=stored_record_sort_key, reverse=True)
    return rows


def cwd_learning_plan(root: pathlib.Path | None = None, pattern: str = AUTO_INDEX_GLOB) -> dict | None:
    if not env_flag("MOTOKO_CWD_LEARN", True):
        return None
    root = (root or pathlib.Path.cwd()).expanduser().resolve()
    try:
        plan = plan_document_index(str(root), pattern)
    except SystemExit:
        return None
    if not plan.get("files", 0):
        return None
    return {
        "root": root,
        "glob": pattern or AUTO_INDEX_GLOB,
        "files": plan.get("files", 0),
        "bytes": plan.get("bytes", 0),
        "estimated_chunks": plan.get("estimated_chunks", 0),
        "estimated_model_calls": plan.get("estimated_model_calls", 0),
        "existing": matching_cwd_indexes(root, pattern),
        "partials": matching_cwd_partial_indexes(root, pattern),
    }


def attach_best_cwd_index(conv: dict, plan: dict) -> dict | None:
    for index in plan.get("existing", []):
        status, _warnings = index_staleness(index)
        if status in {"fresh", "metadata-changed", "stale", "unknown"}:
            attach_context_item(conv, context_item_from_index(index))
            return index
    return None


def cwd_learning_offer_text(plan: dict) -> str:
    root = plan["root"]
    partials = plan.get("partials") or []
    if partials:
        partial = partials[0]
        completed = int(partial.get("completed_files", len(partial.get("files", []))) or 0)
        total = int(partial.get("total_files", plan.get("files", completed)) or plan.get("files", completed))
        return (
            f"I found a partial corpus index for {root}: {partial.get('id', '')} "
            f"({completed}/{total} file(s), status {partial.get('status', 'unknown')}). "
            "Resume learning this directory tree now? Reply yes or no."
        )
    return (
        f"This is the first time in this conversation that I have seen {root} "
        "without a fresh full-text index attached. Learn this directory tree now? "
        f"Suggested scope: all readable text files under this tree ({plan['files']} file(s), "
        f"{human_bytes(plan['bytes'])}, about {plan.get('estimated_chunks', 0)} chunk(s) and "
        f"{plan.get('estimated_model_calls', 0)} HRAG model call(s)). "
        "Binary/cache/vendor files are skipped. Reply yes or no."
    )


def build_cwd_learning_index(plan: dict, *, progress_callback=None, quiet: bool = False, cancel_event=None) -> dict:
    raise_if_work_cancelled(cancel_event, "cwd indexing interrupted by request", work_kind="index")
    partials = plan.get("partials") or []
    if partials:
        index_id = str(partials[0].get("id", "")).strip()
        if quiet:
            buf = io.StringIO()
            with contextlib.redirect_stdout(buf), contextlib.redirect_stderr(buf):
                return resume_document_index(index_id, progress_callback=progress_callback, cancel_event=cancel_event)
        return resume_document_index(index_id, progress_callback=progress_callback, cancel_event=cancel_event)
    builder = build_document_index_quiet if quiet else build_document_index
    return builder(
        str(plan["root"]),
        plan["glob"],
        plan["root"].name or str(plan["root"]),
        progress_callback=progress_callback,
        cancel_event=cancel_event,
    )


def resume_partial_index(index_id: str | None = None, *, progress_callback=None, cancel_event=None) -> dict:
