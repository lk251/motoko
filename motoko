def index_progress_finish_model(progress: dict | None, callback=None, *, chunk_done: bool = False) -> None:
    if progress is None:
        return
    phase = str(progress.get("phase") or "model")
    started = progress.pop("_current_model_started_monotonic", None)
    if started is not None:
        duration = max(0.0, time.monotonic() - float(started))
        progress["last_model_call_seconds"] = round(duration, 2)
        progress["completed_model_seconds"] = round(float(progress.get("completed_model_seconds", 0.0) or 0.0) + duration, 2)
        phase_stats = progress.setdefault("model_call_phase_stats", {})
        item = phase_stats.setdefault(phase, {"calls": 0, "seconds": 0.0})
        item["calls"] = int(item.get("calls", 0) or 0) + 1
        item["seconds"] = round(float(item.get("seconds", 0.0) or 0.0) + duration, 2)
    progress.pop("current_model_started", None)
    progress.pop("current_model_elapsed_seconds", None)
    progress["completed_model_calls"] = int(progress.get("completed_model_calls", 0) or 0) + 1
    if chunk_done:
        progress["completed_chunks"] = int(progress.get("completed_chunks", 0) or 0) + 1
    emit_index_progress(progress, callback)


def index_progress_finish_file(progress: dict | None, callback=None) -> None:
    if progress is None:
        return
    progress["completed_files"] = int(progress.get("completed_files", 0) or 0) + 1
    progress["phase"] = "file indexed"
    emit_index_progress(progress, callback)


def finish_index_progress(progress: dict | None, status: str, callback=None, *, error: str = "") -> None:
    if progress is None:
        return
    progress["status"] = status
    if status == "completed":
        progress["phase"] = "completed"
    elif status in {"paused", "deferred"}:
        progress["phase"] = status
    else:
        progress["phase"] = "failed"
    if error:
        progress["error"] = error
    emit_index_progress(progress, callback)


def format_index_progress_status(progress: dict) -> str:
    phase = str(progress.get("phase") or "indexing")
    status = str(progress.get("status") or "running")
    if status == "completed":
        return "bg-heavy: index complete"
    if status == "failed":
        return "bg-heavy: index failed"
    if status == "paused":
        return "bg-heavy: index paused"
    if status == "deferred":
        return "bg-heavy: index deferred"
    current = int(progress.get("current_file_index", 0) or 0)
    total = int(progress.get("total_files", 0) or 0)
    files = f"file {current}/{total}" if total else "files"
    chunks_done = int(progress.get("completed_chunks", 0) or 0)
    chunks_total = int(progress.get("estimated_chunks", 0) or 0)
    chunks = f"chunk {chunks_done}/{chunks_total}" if chunks_total else ""
    percent = progress.get("percent")
    pct = f"{percent}%" if percent is not None else ""
    eta = progress.get("eta_seconds")
    eta_text = f"eta {human_duration(eta)}" if eta is not None else "eta ?"
    lane = progress.get("background_lane", "")
    route = progress.get("model_route", "")
    worker = f"lane {lane}/{route}" if lane and route else ""
    parts = ["bg-heavy:", phase, worker, files, chunks, pct, eta_text]
    return " ".join(part for part in parts if part)


def format_index_progress_line(progress: dict) -> str:
    updated = relative_time(str(progress.get("updated", "")))
    elapsed = human_duration(progress.get("elapsed_seconds"))
    return (
        f"{progress.get('id', '')}  {progress.get('status', 'unknown')}  "
        f"{format_index_progress_status(progress)}  elapsed {elapsed}  "
        f"updated {updated}  {progress.get('root', '')}"
    )


def safe_ref(value: object, *, prefix: str = "ref") -> str:
    text = str(value or "")
    if not text:
        return f"{prefix}:none"
    return f"{prefix}:{sha256_hex(text.encode('utf-8'))[:12]}"


def age_seconds_from_timestamp(value: object) -> int | None:
    parsed = parse_timestamp(str(value or ""))
    if parsed is None:
        return None
    delta = _dt.datetime.now(_dt.timezone.utc).astimezone() - parsed.astimezone()
    return max(0, int(delta.total_seconds()))


def safe_duration_field(seconds: object) -> str:
    try:
        return human_duration(int(seconds))
    except (TypeError, ValueError):
        return "?"


def safe_age_field(seconds: int | None) -> str:
    if seconds is None:
        return "unknown"
    return human_duration(seconds)


def safe_progress_state(updated_age_seconds: int | None, *, complete: bool = False) -> str:
    if complete:
        return "finalizing"
    if updated_age_seconds is not None and updated_age_seconds >= SAFE_PROGRESS_STALE_SECONDS:
        return "stale"
    return "running"


def sanitize_background_phase(phase: object) -> str:
    text = str(phase or "").strip()
    if not text:
        return "idle"
    if text.startswith("bg-heavy: vectorizing"):
        rows_match = re.search(r"\brows\s+\d+/\d+\b", text)
        if "finalizing" in text:
            rows_text = f" {rows_match.group(0)}" if rows_match else ""
            return f"bg-heavy: vectorizing finalizing{rows_text}"
        parts = ["bg-heavy: vectorizing(model)"]
        if "retry" in text:
            parts.append("retry")
        reuse_match = re.search(r"\breuse\s+\d+\b", text)
        new_match = re.search(r"\bnew\s+\d+\b", text)
        if "incremental" in text or reuse_match or new_match:
            parts.append("incremental")
            if reuse_match:
                parts.append(reuse_match.group(0))
            if new_match:
                parts.append(new_match.group(0))
        for pattern in [
            r"\bbatch\s+\d+/\d+\b",
            r"\bparallel\s+\d+\b",
            r"\brows\s+\d+/\d+\b",
            r"\beta\s+\S+",
        ]:
            match = re.search(pattern, text)
            if match:
                parts.append(match.group(0))
        return " ".join(parts)
    if text.startswith("bg-heavy: index"):
        return phase_timer_key(text)
    if text.startswith("study:"):
        return text.split(":", 1)[0] + ":" + text.split(":", 1)[1].strip().split(" ", 1)[0]
    if text.startswith("memory:") or text.startswith("mem:"):
        return text.split(" ", 1)[0]
    if text.startswith("bg-heavy:") or text.startswith("bg:"):
        return text.split(" ", 1)[0]
    return "active"


def format_vector_progress_phase(
    *,
    completed_batches: int,
    total_batches: int,
    active_parallelism: int,
    completed_rows: int,
    total_rows: int,
    eta_seconds: int | None = None,
    state: str = "running",
    reused_rows: int = 0,
    pending_rows: int | None = None,
) -> str:
    state = str(state or "running").strip()
    if state == "finalizing":
        return f"bg-heavy: vectorizing finalizing rows {completed_rows}/{total_rows}"
    eta_text = f"eta {human_duration(eta_seconds)}" if eta_seconds is not None else "eta ?"
    batch_text = f"batch {completed_batches}/{total_batches}" if total_batches else "batch 0/0"
    incremental_text = ""
    if reused_rows:
        new_rows = max(0, int(total_rows or 0) - int(reused_rows or 0)) if pending_rows is None else max(0, int(pending_rows or 0))
        incremental_text = f"incremental reuse {max(0, int(reused_rows or 0))} new {new_rows}"
    return (
        f"bg-heavy: vectorizing(model) {incremental_text} {batch_text} parallel {max(1, int(active_parallelism or 1))} "
        f"rows {completed_rows}/{total_rows} {eta_text}"
    ).replace("  ", " ")


def safe_model_route_state(route_name: str) -> str:
    route_name = str(route_name or "").strip()
    if not route_name:
        return "route=unknown state=unavailable"
    try:
        try:
            info = model_route(route_name)
        except SystemExit:
            info = resolve_model_service_route(route_name)
        if not endpoint_is_unix(str(info.get("endpoint", ""))):
            return f"route={route_name} state=not-unix-route"
        raw = local_model_status_text(info)
        values = parse_local_model_status(raw)
    except SystemExit as exc:  # pragma: no cover - defensive around missing route declarations.
        return f"route={route_name} state=unavailable error_type={type(exc).__name__}"
    except Exception as exc:  # pragma: no cover - defensive around local helper failures.
        return f"route={route_name} state=unavailable error_type={type(exc).__name__}"
    pieces = [f"route={values.get('route') or local_model_helper_route(info)}"]
    for key in ("socket", "proxy", "backend"):
        if values.get(key):
            pieces.append(f"{key}={values[key]}")
    if len(pieces) == 1:
        pieces.append("state=unknown")
    return " ".join(pieces)


def list_vector_progress() -> list[dict]:
    rows = []
    root = vector_progress_dir()
    if not root.exists():
        return rows
    for path in sorted(root.glob("*.json"), reverse=True):
        try:
            row = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            continue
        if isinstance(row, dict):
            rows.append(row)
    rows.sort(key=lambda row: row.get("updated", row.get("created", "")), reverse=True)
    return rows


def format_safe_index_progress_row(progress: dict) -> str:
    updated_age = age_seconds_from_timestamp(progress.get("updated"))
    completed_calls = int(progress.get("completed_model_calls", 0) or 0)
    estimated_calls = int(progress.get("estimated_model_calls", 0) or 0)
    completed_files = int(progress.get("completed_files", 0) or 0)
    total_files = int(progress.get("total_files", 0) or 0)
    completed_chunks = int(progress.get("completed_chunks", 0) or 0)
    estimated_chunks = int(progress.get("estimated_chunks", 0) or 0)
    phase = sanitize_background_phase(progress.get("phase"))
    status = str(progress.get("status") or "running")
    complete = status == "completed" or (
        estimated_calls > 0 and completed_calls >= estimated_calls
    )
    state = safe_progress_state(updated_age, complete=complete and status not in {"failed", "paused", "deferred"})
    parts = [
        f"- {safe_ref(progress.get('id'), prefix='job')}",
        "kind=index",
        f"state={state if status == 'running' else status}",
        f"phase={phase}",
        f"files={completed_files}/{total_files}",
        f"chunks={completed_chunks}/{estimated_chunks}",
        f"calls={completed_calls}/{estimated_calls}",
    ]
    if progress.get("percent") is not None:
        parts.append(f"percent={progress.get('percent')}%")
    if progress.get("eta_seconds") is not None:
        parts.append(f"eta={safe_duration_field(progress.get('eta_seconds'))}")
    if progress.get("elapsed_seconds") is not None:
        parts.append(f"elapsed={safe_duration_field(progress.get('elapsed_seconds'))}")
    parts.append(f"updated_age={safe_age_field(updated_age)}")
    lane = str(progress.get("background_lane") or "")
    route = str(progress.get("model_route") or "")
    if lane:
        parts.append(f"lane={lane}")
    if route:
        parts.append(f"route={route}")
    return " ".join(parts)


def format_safe_vector_progress_row(progress: dict) -> str:
    updated_age = age_seconds_from_timestamp(progress.get("updated"))
    expected_rows = int(progress.get("expected_rows", 0) or 0)
    completed_rows = int(progress.get("completed_rows", 0) or 0)
    batch_size = int(progress.get("embedding_batch_size", 0) or 0)
    total_batches = (expected_rows + batch_size - 1) // batch_size if batch_size else 0
    completed_batches = (completed_rows + batch_size - 1) // batch_size if batch_size else 0
    state = safe_progress_state(updated_age, complete=expected_rows > 0 and completed_rows >= expected_rows)
    route = progress.get("embedding_route") if isinstance(progress.get("embedding_route"), dict) else {}
    route_name = str(route.get("catalog_route") or route.get("route") or "")
    parts = [
        f"- {safe_ref(progress.get('id'), prefix='job')}",
        "kind=vector",
        f"state={state}",
        f"rows={completed_rows}/{expected_rows}",
        f"batches={completed_batches}/{total_batches}",
        f"batch_size={batch_size}",
        f"parallel={int(progress.get('embedding_parallelism', 0) or 0)}",
        f"requested={int(progress.get('embedding_requested_parallelism', 0) or 0)}",
        f"fallbacks={len(progress.get('embedding_parallel_fallbacks') or [])}",
    ]
    if progress.get("eta_seconds") is not None:
        parts.append(f"eta={safe_duration_field(progress.get('eta_seconds'))}")
    parts.append(f"updated_age={safe_age_field(updated_age)}")
    if route_name:
        parts.append(f"route={route_name}")
    return " ".join(parts)


def format_safe_live_job_row(job: dict) -> str:
    parts = [
        f"- {safe_ref(job.get('job_id'), prefix='live')}",
        f"kind={job.get('kind', '') or 'unknown'}",
        f"lane={job.get('lane', '') or 'unknown'}",
        f"status={job.get('status', '') or 'unknown'}",
        f"age={safe_duration_field(job.get('age_seconds'))}",
        f"updated_age={safe_duration_field(job.get('updated_seconds_ago'))}",
    ]
    progress = job.get("progress") if isinstance(job.get("progress"), dict) else {}
    for key in ("completed", "total", "rows", "batches", "percent"):
        if key in progress and isinstance(progress.get(key), (int, float)):
            parts.append(f"{key}={progress.get(key)}")
    if job.get("error_type"):
        parts.append(f"error_type={job.get('error_type')}")
    if job.get("stop_requested"):
        parts.append("stop_requested=true")
    if job.get("pause_requested"):
        parts.append("pause_requested=true")
    return " ".join(parts)


def format_diagnose_safe(conv: dict | None = None) -> str:
    lines = [
        f"safe diagnose: {SAFE_DIAGNOSE_SCHEMA_VERSION}",
        "privacy: content-free; no paths, filenames, prompts, responses, memories, summaries, or corpus names",
        f"realm: {identity_realm()}",
        f"permissions: {permission_mode()}",
    ]
    study_state = read_study_state()
    if study_state:
        updated_age = age_seconds_from_timestamp(study_state.get("updated"))
        lines.append(
            "study: "
            f"status={study_state.get('status', 'unknown')} "
            f"phase={sanitize_background_phase(study_state.get('phase'))} "
            f"updated_age={safe_age_field(updated_age)}"
        )
    maintenance = read_maintenance_state()
    if maintenance:
        updated_age = age_seconds_from_timestamp(maintenance.get("updated"))
        lines.append(
            "maintenance: "
            f"status={maintenance.get('status', 'unknown')} "
            f"phase={sanitize_background_phase(maintenance.get('phase'))} "
            f"updated_age={safe_age_field(updated_age)}"
        )
    live_jobs = LIVE_JOB_SUPERVISOR.snapshots(include_done=False)
    lines.append(f"live jobs: {len(live_jobs)}")
    lines.extend(format_safe_live_job_row(job) for job in live_jobs[:12])
    index_jobs = active_index_progress()
    lines.append(f"index progress: {len(index_jobs)}")
    lines.extend(format_safe_index_progress_row(job) for job in index_jobs[:12])
    vector_jobs = list_vector_progress()
    lines.append(f"vector progress: {len(vector_jobs)}")
    lines.extend(format_safe_vector_progress_row(job) for job in vector_jobs[:12])
    route_names = {MODEL_ROUTE_CHAT}
    for job in index_jobs:
        if job.get("model_route"):
            route_names.add(str(job.get("model_route")))
    for job in vector_jobs:
        route = job.get("embedding_route") if isinstance(job.get("embedding_route"), dict) else {}
        route_name = str(route.get("catalog_route") or route.get("route") or "")
        if route_name:
            route_names.add(route_name)
    lines.append("route states:")
    for route_name in sorted(route_names):
        lines.append(f"- {safe_model_route_state(route_name)}")
    if conv is not None:
        lines.append(
            "conversation: "
            f"messages={len(conv.get('messages', []))} "
            f"context_items={len(conv.get('context_items', []))}"
        )
    return "\n".join(lines)


