def route_max_parallel(route_info: dict, *, default: int = 1, maximum: int = 32) -> int:
    try:
        value = int(route_info.get("max_parallel") or default)
    except (TypeError, ValueError):
        value = default
    return max(1, min(value, maximum))


def embedding_parallelism(route_info: dict, batch_count: int) -> int:
    limit = embedding_parallel_limit(route_info)
    return max(1, min(limit, max(1, batch_count)))


def embedding_parallel_limit(route_info: dict) -> int:
    default = route_max_parallel(route_info, default=1)
    configured = env_int("MOTOKO_EMBEDDING_PARALLEL", default, minimum=1)
    return max(1, min(configured, 32))


def embedding_batch_size(route_info: dict, candidate_count: int) -> int:
    override = os.environ.get("MOTOKO_EMBEDDING_BATCH_SIZE")
    if override is not None and override.strip():
        try:
            value = int(override)
        except ValueError:
            value = EMBEDDING_BATCH_SIZE
        return max(1, min(value, EMBEDDING_MAX_BATCH_SIZE))
    candidate_count = max(1, int(candidate_count or 1))
    parallel_limit = embedding_parallel_limit(route_info)
    batches_per_worker = env_int(
        "MOTOKO_EMBEDDING_BATCHES_PER_WORKER",
        EMBEDDING_TARGET_BATCHES_PER_WORKER,
        minimum=1,
    )
    target_batches = max(1, min(candidate_count, parallel_limit * batches_per_worker))
    batch_size = max(1, candidate_count // target_batches)
    return max(1, min(batch_size, EMBEDDING_MAX_BATCH_SIZE))


def embedding_input_chars_limit() -> int:
    return max(400, min(env_int("MOTOKO_EMBEDDING_INPUT_CHARS", EMBEDDING_INPUT_CHARS, minimum=400), 8000))


def embedding_max_parts_per_chunk() -> int:
    return max(
        1,
        min(
            env_int(
                "MOTOKO_EMBEDDING_MAX_PARTS_PER_CHUNK",
                EMBEDDING_MAX_PARTS_PER_CHUNK,
                minimum=1,
            ),
            64,
        ),
    )


def resolve_vector_method(method: str = VECTOR_METHOD_AUTO) -> str:
    method = str(method or VECTOR_METHOD_AUTO).strip()
    if method == VECTOR_METHOD_AUTO:
        try:
            select_embedding_route()
        except SystemExit:
            return LEXICAL_VECTOR_METHOD
        return EMBEDDING_VECTOR_METHOD
    if method not in {LEXICAL_VECTOR_METHOD, EMBEDDING_VECTOR_METHOD}:
        raise SystemExit(
            f"unsupported vector method {method!r}; choose {VECTOR_METHOD_AUTO}, {LEXICAL_VECTOR_METHOD}, or {EMBEDDING_VECTOR_METHOD}"
        )
    if method == EMBEDDING_VECTOR_METHOD:
        select_embedding_route()
    return method


def vector_store_source_fingerprint(index: dict) -> str:
    items = [
        {
            "id": index.get("id", ""),
            "root": index.get("root", ""),
            "created": index.get("created", ""),
        }
    ]
    for file_item in index.get("files", []):
        chunks = []
        for chunk in file_item.get("chunks", []):
            chunks.append(
                {
                    "chunk": chunk.get("chunk", ""),
                    "content_sha256": chunk.get("content_sha256", ""),
                    "summary_sha256": sha256_hex(str(chunk.get("summary", "")).encode("utf-8")),
                }
            )
        items.append(
            {
                "path": file_item.get("path", ""),
                "summary_sha256": sha256_hex(str(file_item.get("summary", "")).encode("utf-8")),
                "chunks": chunks,
            }
        )
    return sha256_hex(json.dumps(items, sort_keys=True, ensure_ascii=False).encode("utf-8"))


def vector_store_row_text(index: dict, file_item: dict, chunk: dict) -> str:
    content = read_chunk_content(index, chunk)
    return retrieval_chunk_haystack(file_item, chunk, content)


def vector_embedding_header(file_item: dict, chunk: dict, *, part_label: str = "") -> str:
    file_signal_text = format_signal_summary(file_item.get("signals") or {}, limit=12)
    chunk_signal_text = format_signal_summary(chunk.get("signals") or {}, limit=12)
    return "\n".join(
        part
        for part in [
            f"path: {compact_text(file_item.get('path', ''), 360)}",
            f"file_summary: {compact_text(file_item.get('summary', ''), 360)}",
            f"file_signals: {compact_text(file_signal_text, 360)}" if file_signal_text else "",
            f"chunk_summary: {compact_text(chunk.get('summary', ''), 560)}",
            f"chunk_signals: {compact_text(chunk_signal_text, 360)}" if chunk_signal_text else "",
            f"embedding_part: {part_label}" if part_label else "",
        ]
        if part.strip()
    )


def vector_embedding_input_rows(index: dict, file_item: dict, chunk: dict) -> list[tuple[str, str, dict]]:
    limit = embedding_input_chars_limit()
    max_parts = embedding_max_parts_per_chunk()
    content = read_chunk_content(index, chunk)
    base_id = f"{file_item.get('path', '')}#{chunk.get('chunk', '')}"
    base_header = vector_embedding_header(file_item, chunk)
    base_budget = max(120, limit - len(base_header) - len("\ncontent: "))
    content_parts = split_embedding_content_parts(content, base_budget, max_parts)
    if not content_parts:
        text = compact_text(base_header, limit)
        metadata = {
            "id": f"{base_id}:metadata",
            "embedding_kind": "chunk_metadata",
            "embedding_part": 1,
            "embedding_part_count": 1,
            "embedding_input_chars": len(text),
            "embedding_input_sha256": sha256_hex(text.encode("utf-8")),
        }
        return [(metadata["id"], text, metadata)] if text.strip() else []
    rows = []
    part_count = len(content_parts)
    for idx, part in enumerate(content_parts, start=1):
        part_label = f"{idx}/{part_count}" if part_count > 1 else "1/1"
        header = vector_embedding_header(file_item, chunk, part_label=part_label)
        text = bounded_vector_embedding_text(header, part, limit=limit)
        if not text.strip():
            continue
        row_id = base_id if part_count == 1 else f"{base_id}:content:{idx}"
        rows.append(
            (
                row_id,
                text,
                {
                    "id": row_id,
                    "embedding_kind": "chunk_content",
                    "embedding_part": idx,
                    "embedding_part_count": part_count,
                    "embedding_input_chars": len(text),
                    "embedding_input_sha256": sha256_hex(text.encode("utf-8")),
                },
            )
        )
    return rows


def evidence_embedding_text(file_item: dict, row: dict, *, limit: int) -> str:
    header = "\n".join(
        part
        for part in [
            f"path: {compact_text(file_item.get('path', ''), 360)}",
            f"evidence_kind: {row.get('kind', '')}",
            f"title: {compact_text(row.get('title', ''), 240)}" if row.get("title") else "",
            f"parents: {compact_text(' / '.join(row.get('parent_titles', []) or []), 240)}" if row.get("parent_titles") else "",
            f"date: {row.get('date', '')}" if row.get("date") else "",
            f"todo: {row.get('todo', '')}" if row.get("todo") else "",
            f"priority: {row.get('priority', '')}" if row.get("priority") else "",
            f"tags: {', '.join(row.get('tags', []) or [])}" if row.get("tags") else "",
        ]
        if part.strip()
    )
    return bounded_vector_embedding_text(header, str(row.get("text", "")), limit=limit)


def evidence_vector_embedding_input_rows(index: dict, file_item: dict, chunk: dict) -> list[tuple[str, str, dict]]:
    limit = embedding_input_chars_limit()
    rows = []
    for item in evidence_objects_for_chunk(index, file_item, chunk):
        text = evidence_embedding_text(file_item, item, limit=limit)
        if not text.strip():
            continue
        stable_payload = "|".join(
            [
                str(file_item.get("path", "")),
                str(chunk.get("chunk", "")),
                str(item.get("kind", "")),
                str(item.get("date", "")),
                str(item.get("todo", "")),
                str(item.get("priority", "")),
                ",".join(item.get("tags", []) or []),
                str(item.get("title", "")),
                str(item.get("text_sha256", "")),
            ]
        )
        stable_id = "sev-" + sha256_hex(stable_payload.encode("utf-8"))[:24]
        row_id = f"{file_item.get('path', '')}#{chunk.get('chunk', '')}:evidence:{stable_id}"
        rows.append(
            (
                row_id,
                text,
                {
                    "id": row_id,
                    "vector_row_kind": "evidence_embedding",
                    "embedding_kind": "evidence_object",
                    "embedding_part": 1,
                    "embedding_part_count": 1,
                    "embedding_input_chars": len(text),
                    "embedding_input_sha256": sha256_hex(text.encode("utf-8")),
                    "evidence_id": item.get("id", ""),
                    "evidence_kind": item.get("kind", ""),
                    "evidence_title": item.get("title", ""),
                    "evidence_date": item.get("date", ""),
                    "evidence_todo": item.get("todo", ""),
                    "evidence_priority": item.get("priority", ""),
                    "evidence_tags": item.get("tags", []),
                    "evidence_start": item.get("start", 0),
                    "evidence_end": item.get("end", 0),
                    "evidence_excerpt": compact_source_text_middle(str(item.get("text", "")), 1000),
                    "evidence_text_sha256": item.get("text_sha256", ""),
                },
            )
        )
    return rows


def default_vector_index(conv: dict | None = None, *, project_scope: dict | None = None) -> dict:
    project_scope = project_scope or project_scope_for_request(conv)
    project_roots = project_scope_roots(project_scope)
    if conv:
        attached = attached_index_ids(conv, project_scope=project_scope)
        if attached:
            return load_index_exact(attached[0])
    latest = latest_indexes_by_family()
    if project_roots:
        latest = [
            index
            for index in latest
            if project_root_matches(str(index.get("root", "") or ""), project_roots)
        ]
    if latest:
        return latest[0]
    raise SystemExit("No document indexes yet. Run 'motoko index PATH' first.")


def build_vector_store_from_index(
    index: dict,
    *,
    dims: int = DEFAULT_LEXICAL_VECTOR_DIMS,
    method: str = VECTOR_METHOD_AUTO,
    store_id: str | None = None,
    write: bool = True,
    progress_callback=None,
    cancel_event=None,
) -> dict:
    raise_if_work_cancelled(cancel_event, "vectorization interrupted by request", work_kind="vector")
    method = resolve_vector_method(method)
    if method == EMBEDDING_VECTOR_METHOD:
        return build_embedding_vector_store_from_index(
            index,
            store_id=store_id,
            write=write,
            progress_callback=progress_callback,
            cancel_event=cancel_event,
        )
    dims = max(8, int(dims or DEFAULT_LEXICAL_VECTOR_DIMS))
    store_id = store_id or _dt.datetime.now().strftime("%Y%m%d-%H%M%S") + "-" + uuid.uuid4().hex[:6]
    source_fingerprint = vector_store_source_fingerprint(index)
    rows = []
    for file_item in index.get("files", []):
        raise_if_work_cancelled(cancel_event, "vectorization interrupted by request", work_kind="vector")
        for chunk in file_item.get("chunks", []):
            raise_if_work_cancelled(cancel_event, "vectorization interrupted by request", work_kind="vector")
            text = vector_store_row_text(index, file_item, chunk)
            vector = lexical_sparse_vector(text, dims=dims)
            if not vector:
                continue
            rows.append(
                {
                    "id": f"{file_item.get('path', '')}#{chunk.get('chunk', '')}",
                    "kind": "raw_chunk_embedding",
                    "index": index.get("id", ""),
                    "path": file_item.get("path", ""),
                    "chunk": chunk.get("chunk", ""),
                    "content_sha256": chunk.get("content_sha256", ""),
                    "source_fingerprint": chunk.get("content_sha256", ""),
                    "vector": vector,
                    "terms": retrieval_haystack_terms(
                        token_counts(file_item.get("path", "") + " " + chunk.get("summary", "")),
                        text,
                    )[:16],
                    "summary": compact_text(chunk.get("summary", "") or file_item.get("summary", ""), 280),
                }
            )
            for item in evidence_objects_for_chunk(index, file_item, chunk):
                evidence_text = evidence_row_haystack(item)
                vector = lexical_sparse_vector(evidence_text, dims=dims)
                if not vector:
                    continue
                rows.append(
                    {
                        "id": f"{file_item.get('path', '')}#{chunk.get('chunk', '')}:evidence:{item.get('id', '')}",
                        "kind": "evidence_embedding",
                        "embedding_kind": "evidence_object",
                        "index": index.get("id", ""),
                        "path": file_item.get("path", ""),
                        "chunk": chunk.get("chunk", ""),
                        "content_sha256": chunk.get("content_sha256", ""),
                        "source_fingerprint": item.get("source_fingerprint", chunk.get("content_sha256", "")),
                        "vector": vector,
                        "terms": retrieval_haystack_terms(
                            token_counts(file_item.get("path", "") + " " + item.get("title", "") + " " + item.get("text", "")),
                            evidence_text,
                        )[:16],
                        "summary": compact_text(item.get("text", "") or item.get("title", ""), 280),
                        "evidence_id": item.get("id", ""),
                        "evidence_kind": item.get("kind", ""),
                        "evidence_title": item.get("title", ""),
                        "evidence_date": item.get("date", ""),
                        "evidence_todo": item.get("todo", ""),
                        "evidence_priority": item.get("priority", ""),
                        "evidence_tags": item.get("tags", []),
                        "evidence_start": item.get("start", 0),
                        "evidence_end": item.get("end", 0),
                        "evidence_excerpt": compact_source_text_middle(str(item.get("text", "")), 1000),
                    }
                )
    store = {
        "schema": VECTOR_STORE_SCHEMA_VERSION,
        "id": store_id,
        "created": now(),
        "realm": identity_realm(),
        "method": method,
        "vector_format": "sparse-json-normalized",
        "production_embedding": False,
        "dims": dims,
        "source_index": {
            "id": index.get("id", ""),
            "name": index.get("name", ""),
            "root": index.get("root", ""),
            "created": index.get("created", ""),
            "glob": index.get("glob") or AUTO_INDEX_GLOB,
            "family_key": index_family_key(index),
            "fingerprint": source_fingerprint,
        },
        "provenance": artifact_provenance(
            "vector-store",
            VECTOR_STORE_SCHEMA_VERSION,
            deterministic=True,
            source_sha256=source_fingerprint,
        ),
        "rows": rows,
        "row_count": len(rows),
        "note": "Deterministic lexical vector baseline. This validates storage and query plumbing; it is not a semantic embedding model.",
    }
    store["provenance"].update(
        {
            "source_realm": identity_realm(),
            "security_context": permission_mode(),
            "input_hash": source_fingerprint,
        }
    )
    if write:
        path = vector_store_path(store_id)
        store["path"] = str(path)
        atomic_write(path, json.dumps(store, ensure_ascii=False, indent=2) + "\n")
    return store


def build_vector_store(
    index_id: str | None = None,
    *,
    dims: int = DEFAULT_LEXICAL_VECTOR_DIMS,
    method: str = VECTOR_METHOD_AUTO,
    cancel_event=None,
) -> dict:
    index = load_index(index_id) if index_id else default_vector_index()
    return build_vector_store_from_index(index, dims=dims, method=method, cancel_event=cancel_event)


def vector_refresh_candidates(
    *,
    index_id: str | None = None,
    force: bool = False,
    method: str = EMBEDDING_VECTOR_METHOD,
    max_chunks: int | None = None,
) -> list[tuple[dict, str]]:
    indexes = [load_index(index_id)] if index_id else latest_indexes_by_family()
    max_chunks = max_chunks if max_chunks is not None else env_int(
        "MOTOKO_BACKGROUND_VECTOR_REFRESH_MAX_CHUNKS",
        BACKGROUND_VECTOR_REFRESH_MAX_CHUNKS,
    )
    rows = []
    for index in indexes:
        status, warnings = index_staleness(index)
        if status == "stale":
            rows.append((index, "skip: source index stale"))
            continue
        chunk_count = sum(len(file_item.get("chunks", [])) for file_item in index.get("files", []))
        if max_chunks and chunk_count > max_chunks:
            rows.append((index, f"skip: {chunk_count} chunk(s) exceeds automatic limit {max_chunks}"))
            continue
        due, reason = vector_store_due(index, method=method)
        if due or force:
            rows.append((index, reason))
    return rows


def refresh_vector_stores(
    *,
    index_id: str | None = None,
    force: bool = False,
    limit: int = 1,
    method: str = EMBEDDING_VECTOR_METHOD,
    max_chunks: int | None = None,
    phase_callback=None,
    cancel_event=None,
) -> dict:
    raise_if_work_cancelled(cancel_event, "vectorization interrupted by request", work_kind="vector")
    method = resolve_vector_method(method)
    limit = max(1, int(limit or 1))
    report = {
        "schema": "vector-refresh-v1",
        "created": now(),
        "method": method,
        "limit": limit,
        "items": [],
    }
    built = 0
    candidates = vector_refresh_candidates(
        index_id=index_id,
        force=force,
        method=method,
        max_chunks=max_chunks,
    )
    for index, reason in candidates:
        raise_if_work_cancelled(cancel_event, "vectorization interrupted by request", work_kind="vector")
        if built >= limit:
            break
        item = {
            "index": index.get("id", ""),
            "name": index.get("name", ""),
            "root": index.get("root", ""),
            "reason": reason,
        }
        if reason.startswith("skip:"):
            item["status"] = "skipped"
            report["items"].append(item)
            continue
        if work_pause_requested():
            item["status"] = "paused"
            item["note"] = "pause requested before vector refresh"
            report["items"].append(item)
            break
        if phase_callback is not None:
            phase_callback("bg-heavy: vectorizing(model)")
        try:
            store = build_vector_store_from_index(
                index,
                method=method,
                progress_callback=phase_callback,
                cancel_event=cancel_event,
            )
        except WorkPaused as exc:
            item["status"] = "paused"
            item["note"] = str(exc)
            item["progress_id"] = exc.work_id
            report["items"].append(item)
            break
        except SystemExit as exc:
            if model_request_deferred_by_residency(exc):
                item["status"] = "deferred"
                item["note"] = str(exc)
                report["items"].append(item)
                break
            else:
                item["status"] = "failed"
                item["error"] = str(exc)
        else:
            item["status"] = "built"
            item["store_id"] = store.get("id", "")
            item["rows"] = store.get("row_count", 0)
            item["batches"] = store.get("embedding_batch_count", 0)
            item["parallelism"] = store.get("embedding_parallelism", 1)
            item["requested_parallelism"] = store.get("embedding_requested_parallelism", item["parallelism"])
            item["fallbacks"] = len(store.get("embedding_parallel_fallbacks", []) or [])
            item["reused_rows"] = store.get("embedding_reused_rows", 0)
            item["embedded_rows"] = store.get("embedding_embedded_rows", item["rows"])
            item["superseded_rows"] = store.get("embedding_superseded_rows", 0)
            item["path"] = store.get("path", "")
            built += 1
        report["items"].append(item)
    report["built"] = built
    if any(item.get("status") == "paused" for item in report["items"]):
        report["status"] = "paused"
    elif any(item.get("status") == "deferred" for item in report["items"]):
        report["status"] = "deferred"
    else:
        report["status"] = "built" if built else ("empty" if not report["items"] else "no-build")
    return report


def vector_store_source_matches_family(store: dict, index: dict, *, method: str | None = None) -> bool:
    if method and store.get("method") != method:
        return False
    source = store.get("source_index") if isinstance(store.get("source_index"), dict) else {}
    if source.get("id") == index.get("id"):
        return True
    family_key = str(source.get("family_key") or "")
    if family_key and family_key == index_family_key(index):
        return True
    source_root = str(source.get("root", ""))
    source_name = str(source.get("name", ""))
    source_glob = str(source.get("glob") or AUTO_INDEX_GLOB)
    return (
        bool(source_root)
        and source_root == str(index.get("root", ""))
        and source_name == str(index.get("name", ""))
        and source_glob == str(index.get("glob") or AUTO_INDEX_GLOB)
    )


def embedding_vector_store_reuse_compatible(store: dict, index: dict, route_info: dict) -> bool:
    if not vector_store_source_matches_family(store, index, method=EMBEDDING_VECTOR_METHOD):
        return False
    if store.get("schema") != VECTOR_STORE_SCHEMA_VERSION:
        return False
    if store.get("vector_format") != "dense-json-normalized":
        return False
    stored_route = store.get("embedding_route") if isinstance(store.get("embedding_route"), dict) else {}
    stored_route_id = str(stored_route.get("catalog_route") or stored_route.get("route") or "")
    current_route_id = str(route_info.get("catalog_route") or route_info.get("route") or "")
    if not stored_route_id or stored_route_id != current_route_id:
        return False
    if str(stored_route.get("model") or "") != str(route_info.get("model") or ""):
        return False

    def int_or_zero(value) -> int:
        try:
            return int(value or 0)
        except (TypeError, ValueError):
            return 0

    current_dims = int_or_zero(route_info.get("embedding_dimensions"))
    stored_route_dims = int_or_zero(stored_route.get("embedding_dimensions"))
    store_dims = int_or_zero(store.get("dims"))
    if current_dims and stored_route_dims and current_dims != stored_route_dims:
        return False
    if current_dims and store_dims and current_dims != store_dims:
        return False
    if str(store.get("embedding_input_schema") or "") != EMBEDDING_INPUT_SCHEMA_VERSION:
        return False
    if int_or_zero(store.get("embedding_input_chars")) != embedding_input_chars_limit():
        return False
    if int_or_zero(store.get("embedding_max_parts_per_chunk")) != embedding_max_parts_per_chunk():
        return False
    return True


def latest_reusable_embedding_vector_store(index: dict, route_info: dict) -> dict | None:
    for store in list_vector_stores():
        if embedding_vector_store_reuse_compatible(store, index, route_info):
            return store
    return None


def build_embedding_vector_store_from_index(
    index: dict,
    *,
    store_id: str | None = None,
    write: bool = True,
    progress_callback=None,
    cancel_event=None,
) -> dict:
    raise_if_work_cancelled(cancel_event, "vectorization interrupted by request", work_kind="vector")
    route_info = embedding_route_info()
    store_id = store_id or _dt.datetime.now().strftime("%Y%m%d-%H%M%S") + "-" + uuid.uuid4().hex[:6]
    source_fingerprint = vector_store_source_fingerprint(index)
    route_id = str(route_info.get("catalog_route") or route_info.get("route") or "")
    route_model = str(route_info.get("model") or "")
    route_dims = int(route_info.get("embedding_dimensions") or 0)
    candidates = []
    for file_item in index.get("files", []):
        raise_if_work_cancelled(cancel_event, "vectorization interrupted by request", work_kind="vector")
        for chunk in file_item.get("chunks", []):
            raise_if_work_cancelled(cancel_event, "vectorization interrupted by request", work_kind="vector")
            for row_id, text, row_meta in vector_embedding_input_rows(index, file_item, chunk):
                if text.strip():
                    candidates.append((row_id, file_item, chunk, text, row_meta))
            for row_id, text, row_meta in evidence_vector_embedding_input_rows(index, file_item, chunk):
                if text.strip():
                    candidates.append((row_id, file_item, chunk, text, row_meta))
    batch_size = embedding_batch_size(route_info, len(candidates))
    dimensions = route_dims
    batches = [
        (offset, candidates[offset : offset + batch_size])
        for offset in range(0, len(candidates), batch_size)
    ]
    requested_parallelism = embedding_parallelism(route_info, len(batches))
    active_parallelism = requested_parallelism
    progress_key = {
        "schema": VECTOR_PROGRESS_SCHEMA_VERSION,
        "target_schema": VECTOR_STORE_SCHEMA_VERSION,
        "method": EMBEDDING_VECTOR_METHOD,
        "source_index": index.get("id", ""),
        "source_fingerprint": source_fingerprint,
        "route": route_id,
        "model": route_model,
        "embedding_dimensions": route_dims,
        "embedding_input_schema": EMBEDDING_INPUT_SCHEMA_VERSION,
        "embedding_input_chars": embedding_input_chars_limit(),
        "embedding_max_parts_per_chunk": embedding_max_parts_per_chunk(),
        "vector_row_id_schema": VECTOR_ROW_ID_SCHEMA_VERSION,
    }
    progress_id = "embedding-" + sha256_hex(json.dumps(progress_key, sort_keys=True).encode("utf-8"))[:16]
    progress_path = vector_progress_path(progress_id)
    candidate_ids = [row_id for row_id, _file_item, _chunk, _text, _row_meta in candidates]
    completed_rows_by_id: dict[str, dict] = {}
    checkpoint_rows_by_id: dict[str, dict] = {}
    progress_created = now()
    if write and progress_path.exists():
        try:
            progress = json.loads(progress_path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            progress = {}
        source = progress.get("source_index") if isinstance(progress.get("source_index"), dict) else {}
        route = progress.get("embedding_route") if isinstance(progress.get("embedding_route"), dict) else {}
        if (
            progress.get("schema") == VECTOR_PROGRESS_SCHEMA_VERSION
            and progress.get("method") == EMBEDDING_VECTOR_METHOD
            and source.get("id") == index.get("id", "")
            and source.get("fingerprint") == source_fingerprint
            and route.get("catalog_route") == route_id
            and route.get("model") == route_model
            and int(route.get("embedding_dimensions") or 0) == route_dims
            and progress.get("target_schema") == VECTOR_STORE_SCHEMA_VERSION
            and progress.get("embedding_input_schema") == EMBEDDING_INPUT_SCHEMA_VERSION
            and int(progress.get("embedding_input_chars") or 0) == embedding_input_chars_limit()
            and int(progress.get("embedding_max_parts_per_chunk") or 0) == embedding_max_parts_per_chunk()
            and progress.get("vector_row_id_schema") == VECTOR_ROW_ID_SCHEMA_VERSION
        ):
            progress_created = str(progress.get("created") or progress_created)
            for row in progress.get("rows", []):
                if not isinstance(row, dict) or not row.get("id") or not row.get("vector"):
                    continue
                if row.get("id") in candidate_ids:
                    checkpoint_rows_by_id[str(row.get("id"))] = row
    fallback_events = []

    def vector_eta_seconds() -> int | None:
        done_this_session = len(completed_rows_by_id) - session_start_completed_rows
        remaining = len(candidates) - len(completed_rows_by_id)
        if done_this_session <= 0 or remaining <= 0:
            return None
        elapsed = max(0.001, time.monotonic() - session_started)
        return int((elapsed / done_this_session) * remaining)

    def vector_eta_text() -> str:
        eta = vector_eta_seconds()
        return f"eta {human_duration(eta)}" if eta is not None else "eta ?"

    def row_from_vector(file_item: dict, chunk: dict, vector: list[float], row_meta: dict) -> dict:
        row = {
            "id": row_meta.get("id") or f"{file_item.get('path', '')}#{chunk.get('chunk', '')}",
            "kind": row_meta.get("vector_row_kind", "raw_chunk_embedding"),
            "embedding_kind": row_meta.get("embedding_kind", "chunk_content"),
            "embedding_input_schema": EMBEDDING_INPUT_SCHEMA_VERSION,
            "embedding_input_chars": row_meta.get("embedding_input_chars", 0),
            "embedding_input_sha256": row_meta.get("embedding_input_sha256", ""),
            "embedding_part": row_meta.get("embedding_part", 1),
            "embedding_part_count": row_meta.get("embedding_part_count", 1),
            "index": index.get("id", ""),
            "path": file_item.get("path", ""),
            "chunk": chunk.get("chunk", ""),
            "content_sha256": chunk.get("content_sha256", ""),
            "source_fingerprint": chunk.get("content_sha256", ""),
            "vector": vector,
            "summary": compact_text(chunk.get("summary", "") or file_item.get("summary", ""), 280),
        }
        for key in [
            "evidence_id",
            "evidence_kind",
            "evidence_title",
            "evidence_date",
            "evidence_todo",
            "evidence_priority",
            "evidence_start",
            "evidence_end",
            "evidence_excerpt",
            "evidence_text_sha256",
        ]:
            if row_meta.get(key) not in (None, "", []):
                row[key] = row_meta.get(key)
        if row.get("evidence_excerpt"):
            row["summary"] = compact_text(str(row.get("evidence_excerpt", "")), 280)
        return row

    def reusable_completed_row(existing: dict, file_item: dict, chunk: dict, row_meta: dict) -> dict | None:
        if not isinstance(existing, dict) or not existing.get("vector"):
            return None
        if str(existing.get("id", "")) != str(row_meta.get("id", "")):
            return None
        if str(existing.get("embedding_input_sha256", "")) != str(row_meta.get("embedding_input_sha256", "")):
            return None
        if str(existing.get("embedding_input_schema", "")) != EMBEDDING_INPUT_SCHEMA_VERSION:
            return None
        expected_kind = str(row_meta.get("vector_row_kind", "raw_chunk_embedding"))
        if str(existing.get("kind", "")) != expected_kind:
            return None
        vector = existing.get("vector")
        if not isinstance(vector, list) or not vector:
            return None
        if route_dims and len(vector) != route_dims:
            return None
        return row_from_vector(file_item, chunk, vector, row_meta)

    checkpoint_reused_rows = 0
    for row_id, file_item, chunk, _text, row_meta in candidates:
        row = reusable_completed_row(checkpoint_rows_by_id.get(row_id, {}), file_item, chunk, row_meta)
        if row is None:
            continue
        completed_rows_by_id[row_id] = row
        checkpoint_reused_rows += 1
        if not dimensions and isinstance(row.get("vector"), list):
            dimensions = len(row.get("vector", []))

    previous_store = latest_reusable_embedding_vector_store(index, route_info) if write else None
    previous_rows_by_id = {
        str(row.get("id", "")): row
        for row in (previous_store or {}).get("rows", [])
        if isinstance(row, dict) and row.get("id")
    }
    previous_store_reused_rows = 0
    if previous_rows_by_id:
        for row_id, file_item, chunk, _text, row_meta in candidates:
            if row_id in completed_rows_by_id:
                continue
            row = reusable_completed_row(previous_rows_by_id.get(row_id, {}), file_item, chunk, row_meta)
            if row is None:
                continue
            completed_rows_by_id[row_id] = row
            previous_store_reused_rows += 1
            if not dimensions and isinstance(row.get("vector"), list):
                dimensions = len(row.get("vector", []))
    previous_store_row_count = len(previous_rows_by_id)
    previous_store_superseded_rows = max(0, previous_store_row_count - previous_store_reused_rows)
    initial_completed_rows = len(completed_rows_by_id)
    session_started = time.monotonic()
    session_start_completed_rows = initial_completed_rows

    def write_progress() -> None:
        if not write:
            return
        progress = {
            "schema": VECTOR_PROGRESS_SCHEMA_VERSION,
            "id": progress_id,
            "created": progress_created,
            "updated": now(),
            "method": EMBEDDING_VECTOR_METHOD,
            "target_schema": VECTOR_STORE_SCHEMA_VERSION,
            "realm": identity_realm(),
            "source_index": {
                "id": index.get("id", ""),
                "name": index.get("name", ""),
                "root": index.get("root", ""),
                "created": index.get("created", ""),
                "glob": index.get("glob") or AUTO_INDEX_GLOB,
                "family_key": index_family_key(index),
                "fingerprint": source_fingerprint,
            },
            "embedding_route": {
                "catalog_route": route_id,
                "model": route_model,
                "request_path": route_info.get("request_path", "/v1/embeddings"),
                "embedding_dimensions": route_dims,
                "max_parallel": route_info.get("max_parallel"),
            },
            "embedding_input_schema": EMBEDDING_INPUT_SCHEMA_VERSION,
            "embedding_input_chars": embedding_input_chars_limit(),
            "embedding_max_parts_per_chunk": embedding_max_parts_per_chunk(),
            "vector_row_id_schema": VECTOR_ROW_ID_SCHEMA_VERSION,
            "embedding_batch_size": batch_size,
            "embedding_requested_parallelism": requested_parallelism,
            "embedding_parallelism": active_parallelism,
            "embedding_parallel_fallbacks": fallback_events,
            "expected_rows": len(candidates),
            "completed_rows": len(completed_rows_by_id),
            "checkpoint_reused_rows": checkpoint_reused_rows,
            "previous_store_reused_rows": previous_store_reused_rows,
            "eta_seconds": vector_eta_seconds(),
            "rows": [completed_rows_by_id[row_id] for row_id in candidate_ids if row_id in completed_rows_by_id],
        }
        atomic_write(progress_path, json.dumps(progress, ensure_ascii=False, indent=2) + "\n")

    def pause_vectorization(message: str | None = None) -> None:
        write_progress()
        clear_work_pause_request()
        raise WorkPaused(
            message
            or f"vectorization paused at durable checkpoint; resume with motoko vector-refresh {index.get('id', '')}",
            work_id=progress_id,
            work_kind="vector",
        )

    def embed_batch(batch):
        embeddings, embedded_route = embed_texts(
            [text for _row_id, _file_item, _chunk, text, _row_meta in batch],
            route_id=route_id or None,
            cancel_event=cancel_event,
        )
        rows = []
        for (_row_id, file_item, chunk, _text, row_meta), vector in zip(batch, embeddings):
            if vector:
                rows.append(row_from_vector(file_item, chunk, vector, row_meta))
        return rows, embedded_route

    pending_batches = [
        (offset, [item for item in batch if item[0] not in completed_rows_by_id])
        for offset, batch in batches
    ]
    pending_batches = [(offset, batch) for offset, batch in pending_batches if batch]
    completed_batches = len(batches) - len(pending_batches)
    pending_row_count = max(0, len(candidates) - initial_completed_rows)
    if progress_callback is not None and initial_completed_rows:
        progress_callback(
            format_vector_progress_phase(
                completed_batches=completed_batches,
                total_batches=len(batches),
                active_parallelism=active_parallelism,
                completed_rows=len(completed_rows_by_id),
                total_rows=len(candidates),
                eta_seconds=vector_eta_seconds(),
                reused_rows=initial_completed_rows,
                pending_rows=pending_row_count,
            )
        )

    def record_completed_batch(new_rows: list[dict], embedded_route: dict | None) -> None:
        nonlocal dimensions, route_info, completed_batches
        route_info = embedded_route or route_info
        for row in new_rows:
            completed_rows_by_id[str(row.get("id", ""))] = row
            if not dimensions and isinstance(row.get("vector"), list):
                dimensions = len(row.get("vector", []))
        completed_batches += 1
        write_progress()
        if progress_callback is not None:
            progress_callback(
                format_vector_progress_phase(
                    completed_batches=completed_batches,
                    total_batches=len(batches),
                    active_parallelism=active_parallelism,
                    completed_rows=len(completed_rows_by_id),
                    total_rows=len(candidates),
                    eta_seconds=vector_eta_seconds(),
                    reused_rows=initial_completed_rows,
                    pending_rows=pending_row_count,
                )
            )

    def current_pending_batches() -> list[tuple[int, list[tuple[str, dict, dict, str, dict]]]]:
        rows = [
            (offset, [item for item in batch if item[0] not in completed_rows_by_id])
            for offset, batch in batches
        ]
        return [(offset, batch) for offset, batch in rows if batch]

    def run_parallel_batches(run_batches, run_parallelism: int) -> None:
        failure = None
        with concurrent.futures.ThreadPoolExecutor(max_workers=run_parallelism) as executor:
            batch_iter = iter(run_batches)
            futures = {}

            def submit_next() -> bool:
                if failure is not None:
                    return False
                if work_cancel_requested(cancel_event):
                    return False
                if work_pause_requested():
                    return False
                try:
                    offset, batch = next(batch_iter)
                except StopIteration:
                    return False
                futures[executor.submit(embed_batch, batch)] = (offset, batch)
                return True

            for _slot in range(run_parallelism):
                submit_next()
            if not futures and run_batches:
                if work_cancel_requested(cancel_event):
                    pause_vectorization(
                        f"vectorization interrupted at durable checkpoint; resume with motoko vector-refresh {index.get('id', '')}"
                    )
                pause_vectorization()
            while futures:
                if work_cancel_requested(cancel_event):
                    for future in futures:
                        future.cancel()
                    pause_vectorization(
                        f"vectorization interrupted at durable checkpoint; resume with motoko vector-refresh {index.get('id', '')}"
                    )
                done, _pending = concurrent.futures.wait(
                    futures,
                    timeout=0.1,
                    return_when=concurrent.futures.FIRST_COMPLETED,
                )
                if not done:
                    continue
                for future in done:
                    _offset, _batch = futures.pop(future)
                    try:
                        new_rows, embedded_route = future.result()
                    except SystemExit as exc:
                        if failure is None:
                            failure = exc
                    except RuntimeError as exc:
                        if model_call_cancelled(exc):
                            pause_vectorization(
                                f"vectorization interrupted at durable checkpoint; resume with motoko vector-refresh {index.get('id', '')}"
                            )
                        if failure is None:
                            failure = SystemExit(f"embedding request failed: {exc}")
                    except Exception as exc:  # pragma: no cover - defensive around worker threads.
                        if failure is None:
                            failure = SystemExit(f"embedding request failed: {exc}")
                    else:
                        record_completed_batch(new_rows, embedded_route)
                        submit_next()
            if failure is not None:
                raise failure

    while True:
        raise_if_work_cancelled(
            cancel_event,
            f"vectorization interrupted at durable checkpoint; resume with motoko vector-refresh {index.get('id', '')}",
            work_id=progress_id,
            work_kind="vector",
        )
        pending_batches = current_pending_batches()
        if not pending_batches:
            break
        if active_parallelism > 1:
            try:
                run_parallel_batches(pending_batches, active_parallelism)
            except SystemExit as exc:
                write_progress()
                if model_request_deferred_by_residency(exc):
                    raise
                if active_parallelism <= 1:
                    raise
                next_parallelism = max(1, active_parallelism // 2)
                fallback_events.append(
                    {
                        "at": now(),
                        "from": active_parallelism,
                        "to": next_parallelism,
                        "error": compact_text(str(exc), 240),
                    }
                )
                active_parallelism = next_parallelism
                write_progress()
                if progress_callback is not None:
                    progress_callback(
                        format_vector_progress_phase(
                            completed_batches=completed_batches,
                            total_batches=len(batches),
                            active_parallelism=active_parallelism,
                            completed_rows=len(completed_rows_by_id),
                            total_rows=len(candidates),
                            eta_seconds=vector_eta_seconds(),
                            state="retry",
                            reused_rows=initial_completed_rows,
                            pending_rows=pending_row_count,
                        ).replace("bg-heavy: vectorizing(model)", "bg-heavy: vectorizing(model) retry", 1)
                    )
                continue
        else:
            for _offset, batch in pending_batches:
                if work_cancel_requested(cancel_event):
                    pause_vectorization(
                        f"vectorization interrupted at durable checkpoint; resume with motoko vector-refresh {index.get('id', '')}"
                    )
                if work_pause_requested():
                    pause_vectorization()
                new_rows, embedded_route = embed_batch(batch)
                record_completed_batch(new_rows, embedded_route)
        break

    rows = [completed_rows_by_id[row_id] for row_id in candidate_ids if row_id in completed_rows_by_id]
    write_progress()
    if progress_callback is not None:
        progress_callback(
            format_vector_progress_phase(
                completed_batches=len(batches),
                total_batches=len(batches),
                active_parallelism=active_parallelism,
                completed_rows=len(completed_rows_by_id),
                total_rows=len(candidates),
                state="finalizing",
            )
        )
    store = {
        "schema": VECTOR_STORE_SCHEMA_VERSION,
        "id": store_id,
        "created": now(),
        "realm": identity_realm(),
        "method": EMBEDDING_VECTOR_METHOD,
        "vector_format": "dense-json-normalized",
        "production_embedding": True,
        "dims": dimensions or int(route_info.get("embedding_dimensions") or 0),
        "embedding_route": {
            "catalog_route": route_info.get("catalog_route") or route_info.get("route", ""),
            "model": route_info.get("model", ""),
            "request_path": route_info.get("request_path", "/v1/embeddings"),
            "embedding_dimensions": route_info.get("embedding_dimensions"),
            "max_parallel": route_info.get("max_parallel"),
        },
        "embedding_batch_size": batch_size,
        "embedding_batch_count": len(batches),
        "embedding_requested_parallelism": requested_parallelism,
        "embedding_parallelism": active_parallelism,
        "embedding_parallel_fallbacks": fallback_events,
        "embedding_input_schema": EMBEDDING_INPUT_SCHEMA_VERSION,
        "embedding_input_chars": embedding_input_chars_limit(),
        "embedding_max_parts_per_chunk": embedding_max_parts_per_chunk(),
        "vector_row_id_schema": VECTOR_ROW_ID_SCHEMA_VERSION,
        "embedding_checkpoint_reused_rows": checkpoint_reused_rows,
        "embedding_previous_store_reused_rows": previous_store_reused_rows,
        "embedding_reused_rows": checkpoint_reused_rows + previous_store_reused_rows,
        "embedding_embedded_rows": max(0, len(rows) - initial_completed_rows),
        "embedding_superseded_rows": previous_store_superseded_rows,
        "embedding_reuse_store_id": (previous_store or {}).get("id", "") if previous_store_reused_rows else "",
        "source_index": {
            "id": index.get("id", ""),
            "name": index.get("name", ""),
            "root": index.get("root", ""),
            "created": index.get("created", ""),
            "glob": index.get("glob") or AUTO_INDEX_GLOB,
            "family_key": index_family_key(index),
            "fingerprint": source_fingerprint,
        },
        "provenance": {
            "artifact_kind": "vector-store",
            "artifact_schema": VECTOR_STORE_SCHEMA_VERSION,
            "schema": VECTOR_STORE_SCHEMA_VERSION,
            "builder": "motoko",
            "builder_version": APP_VERSION,
            "created": now(),
            "quality_status": "needs-eval",
            "mode": "model",
            "route": route_info.get("catalog_route") or route_info.get("route", ""),
            "model": route_info.get("model", ""),
            "endpoint": route_info.get("endpoint", ""),
            "source_realm": identity_realm(),
            "security_context": permission_mode(),
            "input_hash": source_fingerprint,
            "source_sha256": source_fingerprint,
            "source_fingerprint": {"sha256": source_fingerprint},
        },
