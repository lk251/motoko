def cancellation_requested(cancel_event) -> bool:
    return bool(cancel_event is not None and cancel_event.is_set())


def git_run(args: list[str], *, cwd: pathlib.Path, timeout: float = 300.0) -> subprocess.CompletedProcess:
    return subprocess.run(
        ["git", *args],
        cwd=str(cwd),
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        timeout=timeout,
        check=False,
    )


def git_checked(args: list[str], *, cwd: pathlib.Path, timeout: float = 300.0) -> subprocess.CompletedProcess:
    proc = git_run(args, cwd=cwd, timeout=timeout)
    if proc.returncode != 0:
        detail = (proc.stderr or proc.stdout or "").strip()
        if len(detail) > 500:
            detail = detail[:500].rstrip() + "..."
        raise AgenticValidationError(f"git {' '.join(args[:2])} failed: {detail or proc.returncode}")
    return proc


def git_repo_root_for_path(path: pathlib.Path) -> pathlib.Path:
    target = path.expanduser()
    if not target.exists():
        raise AgenticValidationError(f"git repo path does not exist: {target}")
    proc = git_checked(["rev-parse", "--show-toplevel"], cwd=target)
    root = pathlib.Path(proc.stdout.strip()).expanduser().resolve(strict=False)
    return root


def git_current_branch(repo: pathlib.Path) -> str:
    proc = git_checked(["branch", "--show-current"], cwd=repo)
    return proc.stdout.strip()


def git_status_porcelain(repo: pathlib.Path) -> str:
    proc = git_checked(["status", "--porcelain=v1"], cwd=repo)
    return proc.stdout.strip()


def require_clean_git_tree(repo: pathlib.Path, *, label: str) -> None:
    status = git_status_porcelain(repo)
    if status:
        raise AgenticValidationError(f"{label} has uncommitted changes; refusing git operation")


def require_git_repo_allowed(repo: pathlib.Path) -> pathlib.Path:
    try:
        require_allowed(repo)
    except SystemExit as exc:
        raise AgenticValidationError(str(exc)) from None
    root = git_repo_root_for_path(repo)
    allowed_root_for_path(root)
    require_not_cross_home(root)
    return root


def require_managed_git_worktree_path(path: pathlib.Path) -> pathlib.Path:
    root = managed_git_worktrees_root().resolve(strict=False)
    resolved = path.expanduser().resolve(strict=False)
    try:
        resolved.relative_to(root)
    except ValueError as exc:
        raise AgenticValidationError(f"git worktree path must be under Motoko state: {root}") from exc
    return resolved


def git_branch_exists(repo: pathlib.Path, branch: str) -> bool:
    proc = git_run(["show-ref", "--verify", "--quiet", f"refs/heads/{branch}"], cwd=repo)
    return proc.returncode == 0


def git_commit_sha(repo: pathlib.Path, ref: str = "HEAD") -> str:
    proc = git_checked(["rev-parse", "--verify", ref], cwd=repo)
    return proc.stdout.strip()


def action_field_path(action: dict, key: str) -> pathlib.Path:
    text = str(action.get(key) or "").strip()
    if not text:
        raise AgenticValidationError(f"{key} is required")
    path = pathlib.Path(text).expanduser()
    if not path.is_absolute():
        raise AgenticValidationError(f"{key} must be absolute")
    return path


def git_action_result(validation: dict, *, status: str, start: float, error: str = "", **fields) -> dict:
    result = {
        "result_schema": "motoko-action-result-v1",
        "action_id": validation.get("id", ""),
        "tool_run_id": "",
        "status": status,
        "exit_code": "",
        "duration_ms": int((time.monotonic() - start) * 1000),
        "stdout_bytes": 0,
        "stderr_bytes": 0,
        "stdout_sha256": "",
        "stderr_sha256": "",
        "output_json_valid": False,
        "private_result_path": "",
        "target_path_sha256": "",
        "mode": "",
        "bytes_written": 0,
        "previous_sha256": "",
        "new_sha256": "",
        "error": error,
    }
    result.update(fields)
    return result


def apply_git_worktree_create_action(action: dict, validation: dict, *, cancel_event=None) -> dict:
    if validation.get("status") != "valid":
        raise AgenticValidationError(f"cannot apply invalid action: {validation.get('status', '')}")
    start = time.monotonic()
    if cancellation_requested(cancel_event):
        return git_action_result(validation, status="interrupted", start=start, error="action interrupted before git worktree create")
    repo = require_git_repo_allowed(action_field_path(action, "repo"))
    worktree = require_managed_git_worktree_path(action_field_path(action, "path"))
    branch = str(action.get("branch") or "").strip()
    base = str(action.get("base") or "master").strip()
    if worktree.exists():
        raise AgenticValidationError("git worktree create target already exists")
    if git_branch_exists(repo, branch):
        raise AgenticValidationError(f"git branch already exists: {branch}")
    worktree.parent.mkdir(parents=True, exist_ok=True)
    git_checked(["rev-parse", "--verify", f"{base}^{{commit}}"], cwd=repo)
    git_checked(["worktree", "add", "-b", branch, str(worktree), base], cwd=repo, timeout=600.0)
    register_managed_git_worktree(repo=repo, path=worktree, branch=branch, base=base, status="active")
    return git_action_result(
        validation,
        status="completed",
        start=start,
        branch=branch,
        base=base,
        commit_sha=git_commit_sha(worktree),
    )


def commit_action_paths(repo: pathlib.Path, action: dict) -> list[str]:
    paths = action.get("paths")
    if not isinstance(paths, list) or not paths:
        raise AgenticValidationError("git_commit paths must be a non-empty list")
    rows: list[str] = []
    for item in paths:
        raw = str(item or "").strip()
        if not raw:
            continue
        path = pathlib.Path(raw).expanduser()
        candidate = path if path.is_absolute() else repo / raw
        checked = require_project_write_allowed(candidate)
        try:
            rel = checked.resolve(strict=False).relative_to(repo.resolve(strict=False))
        except ValueError as exc:
            raise AgenticValidationError("git_commit path is outside the target repo") from exc
        rel_text = rel.as_posix()
        if rel_text not in rows:
            rows.append(rel_text)
    if not rows:
        raise AgenticValidationError("git_commit paths resolved to no files")
    return rows


def apply_git_commit_action(action: dict, validation: dict, *, cancel_event=None) -> dict:
    if validation.get("status") != "valid":
        raise AgenticValidationError(f"cannot apply invalid action: {validation.get('status', '')}")
    start = time.monotonic()
    if cancellation_requested(cancel_event):
        return git_action_result(validation, status="interrupted", start=start, error="action interrupted before git commit")
    repo = git_repo_root_for_path(action_field_path(action, "repo"))
    if managed_git_worktree_root_for_path(repo) is None:
        repo = require_git_repo_allowed(repo)
    paths = commit_action_paths(repo, action)
    message = str(action.get("message") or "").strip()
    git_checked(["add", "--", *paths], cwd=repo)
    if cancellation_requested(cancel_event):
        return git_action_result(validation, status="interrupted", start=start, error="action interrupted after git add")
    git_checked(["commit", "-m", message, "--", *paths], cwd=repo, timeout=600.0)
    return git_action_result(
        validation,
        status="completed",
        start=start,
        branch=git_current_branch(repo),
        commit_sha=git_commit_sha(repo),
    )


def find_registered_worktree_for_action(action: dict, *, branch: str | None = None) -> dict:
    path_text = str(action.get("path") or "").strip()
    if path_text:
        row = find_managed_git_worktree_for_path(pathlib.Path(path_text), active_only=False)
        if row:
            return row
    branch_text = branch or str(action.get("branch") or "").strip()
    matches = [
        row
        for row in managed_git_worktree_records(include_removed=True)
        if str(row.get("branch") or "") == branch_text and row.get("status") != "removed"
    ]
    if not matches:
        raise AgenticValidationError("git worktree is not managed by Motoko")
    if len(matches) > 1:
        raise AgenticValidationError("ambiguous managed git worktree branch; include path")
    return matches[0]


def apply_git_worktree_merge_action(action: dict, validation: dict, *, cancel_event=None) -> dict:
    if validation.get("status") != "valid":
        raise AgenticValidationError(f"cannot apply invalid action: {validation.get('status', '')}")
    start = time.monotonic()
    if cancellation_requested(cancel_event):
        return git_action_result(validation, status="interrupted", start=start, error="action interrupted before git worktree merge")
    repo = require_git_repo_allowed(action_field_path(action, "repo"))
    branch = str(action.get("branch") or "").strip()
    target = str(action.get("target_branch") or "master").strip()
    row = find_registered_worktree_for_action(action, branch=branch)
    worktree = pathlib.Path(str(row.get("path") or "")).expanduser()
    if str(row.get("repo") or "") != str(repo):
        raise AgenticValidationError("managed worktree belongs to a different repo")
    require_clean_git_tree(repo, label="target repo")
    require_clean_git_tree(worktree, label="worktree")
    git_checked(["switch", target], cwd=repo)
    git_checked(["merge", "--ff-only", branch], cwd=repo, timeout=600.0)
    merge_sha = git_commit_sha(repo)
    update_managed_git_worktree_status(worktree, status="merged", merged_at=now(), target_branch=target, merge_sha=merge_sha)
    return git_action_result(
        validation,
        status="completed",
        start=start,
        branch=branch,
        target_branch=target,
        merge_sha=merge_sha,
    )


def apply_git_worktree_remove_action(action: dict, validation: dict, *, cancel_event=None) -> dict:
    if validation.get("status") != "valid":
        raise AgenticValidationError(f"cannot apply invalid action: {validation.get('status', '')}")
    start = time.monotonic()
    if cancellation_requested(cancel_event):
        return git_action_result(validation, status="interrupted", start=start, error="action interrupted before git worktree remove")
    row = find_registered_worktree_for_action(action)
    repo = pathlib.Path(str(row.get("repo") or "")).expanduser()
    worktree = pathlib.Path(str(row.get("path") or "")).expanduser()
    force = bool(action.get("force", False))
    if not force:
        require_clean_git_tree(worktree, label="worktree")
    args = ["worktree", "remove"]
    if force:
        args.append("--force")
    args.append(str(worktree))
    git_checked(args, cwd=repo, timeout=600.0)
    update_managed_git_worktree_status(worktree, status="removed", removed_at=now(), force=force)
    return git_action_result(
        validation,
        status="completed",
        start=start,
        branch=str(row.get("branch") or ""),
        force=force,
    )


def execute_validated_action(
    action: dict,
    validation: dict,
    *,
    session_approvals: set[str],
    cancel_event=None,
) -> dict:
    if validation.get("kind") == "skill_tool_run":
        return core_execute_skill_tool_action(
            action,
            validation,
            skill_resolver=lambda name: core_load_skill(skills_dir(), name),
            approval_path=tool_approvals_path(),
            state_root=state_root(),
            realm=identity_realm(),
            session_approvals=session_approvals,
            path_checker=action_path_checker,
            cancel_event=cancel_event,
        )
    if validation.get("kind") == "project_file_write":
        return core_apply_project_file_write_action(action, validation, cancel_event=cancel_event)
    if validation.get("kind") == "git_worktree_create":
        return apply_git_worktree_create_action(action, validation, cancel_event=cancel_event)
    if validation.get("kind") == "git_commit":
        return apply_git_commit_action(action, validation, cancel_event=cancel_event)
    if validation.get("kind") == "git_worktree_merge":
        return apply_git_worktree_merge_action(action, validation, cancel_event=cancel_event)
    if validation.get("kind") == "git_worktree_remove":
        return apply_git_worktree_remove_action(action, validation, cancel_event=cancel_event)
    raise AgenticValidationError(f"no runner for action kind: {validation.get('kind', '')}")


def execute_action_record(action: dict, *, yes: bool = False, cancel_event=None) -> tuple[dict, dict | None]:
    session_approvals: set[str] = set()
    try:
        preview_validation = core_validate_action_record(
            action,
            skill_resolver=lambda name: core_load_skill(skills_dir(), name),
            approval_path=tool_approvals_path(),
            realm=identity_realm(),
            path_checker=action_path_checker,
            preview=True,
        )
        if preview_validation.get("status") == "needs_confirmation" and yes:
            session_approvals.add(str(preview_validation.get("session_repeat_key") or core_session_approval_key(action)))
        validation = core_validate_action_record(
            action,
            skill_resolver=lambda name: core_load_skill(skills_dir(), name),
            approval_path=tool_approvals_path(),
            realm=identity_realm(),
            session_approvals=session_approvals,
            path_checker=action_path_checker,
            preview=False,
        )
    except AgenticValidationError as exc:
        validation = rejected_action_validation(action, str(exc))
        core_write_action_ledger(action_ledger_path(), validation, status="rejected")
        return validation, None
    if validation.get("status") != "valid":
        core_write_action_ledger(action_ledger_path(), validation, status="blocked")
        return validation, None
    core_write_action_ledger(action_ledger_path(), validation, status="running")
    try:
        if cancellation_requested(cancel_event) and validation.get("kind") == "project_file_write":
            result = interrupted_action_result(validation, "action interrupted before execution")
        else:
            result = execute_validated_action(
                action,
                validation,
                session_approvals=session_approvals,
                cancel_event=cancel_event,
            )
    except KeyboardInterrupt:
        result = interrupted_action_result(validation, "action interrupted by keyboard")
    except RuntimeError as exc:
        if str(exc) == "__motoko_stopped__":
            result = interrupted_action_result(validation, "action interrupted by request")
        else:
            raise
    except AgenticValidationError as exc:
        result = failed_action_result(validation, str(exc))
    core_write_action_ledger(action_ledger_path(), {**validation, **result}, status=result.get("status", "unknown"))
    return validation, result


def run_action_text(path_text: str, *, yes: bool = False, cancel_event=None) -> str:
    action = read_action_file(path_text)
    return run_action_text_from_record(action, yes=yes, cancel_event=cancel_event)


def run_action_text_from_record(action: dict, *, yes: bool = False, cancel_event=None) -> str:
    validation, result = execute_action_record(action, yes=yes, cancel_event=cancel_event)
    if result is None:
        return core_format_action_validation(validation) + "\nnot run"
    return core_format_action_result(validation, result)


def apply_action_text(path_text: str, *, yes: bool = False, cancel_event=None) -> str:
