def apply_index_limits(candidates: list[pathlib.Path]) -> list[pathlib.Path]:
    max_files = index_max_files()
    if max_files is not None and len(candidates) > max_files:
        raise SystemExit(
            f"index candidate count {len(candidates)} exceeds configured limit {max_files}; "
            "use --glob or raise index.max_files for this user"
        )

    max_file_bytes = index_max_file_bytes()
    if max_file_bytes is not None:
        oversized = []
        for candidate in candidates:
            try:
                size = candidate.stat().st_size
            except OSError:
                continue
            if size > max_file_bytes:
                oversized.append((size, candidate))
        if oversized:
            oversized.sort(reverse=True)
            examples = "\n".join(
                f"  {human_bytes(size):>10}  {candidate}"
                for size, candidate in oversized[:5]
            )
            raise SystemExit(
                f"{len(oversized)} file(s) exceed configured index.max_file_bytes "
                f"{human_bytes(max_file_bytes)}:\n{examples}\n"
                "Use --glob to narrow the index, remove generated files from the source set, "
                "or raise the per-user limit."
            )
    return candidates


def plan_document_index(path: str, pattern: str | None = AUTO_INDEX_GLOB) -> dict:
    require_permission("index")
    root = pathlib.Path(path).expanduser().resolve()
    require_allowed(root)
    if not root.exists():
        raise SystemExit(f"not found: {root}")
    candidate_report = index_candidate_report(root, pattern)
    candidates = apply_index_limits(candidate_report["candidates"])
    total_bytes = 0
    estimated_chunks = 0
    estimated_file_summary_calls = 0
    largest: list[tuple[int, pathlib.Path]] = []
    for candidate in candidates:
        try:
            size = candidate.stat().st_size
        except OSError:
            continue
        total_bytes += size
        file_chunks = estimate_file_chunks(candidate)
        estimated_chunks += file_chunks
        estimated_file_summary_calls += estimate_summary_calls_for_block_count(file_chunks)
        largest.append((size, candidate))
    largest.sort(reverse=True)
    estimated_model_calls = estimated_chunks + estimated_file_summary_calls + estimate_corpus_summary_calls(len(candidates))
    return {
        "root": str(root),
        "glob": pattern or AUTO_INDEX_GLOB,
        "files": len(candidates),
        "bytes": total_bytes,
        "estimated_chunks": estimated_chunks,
        "estimated_file_summary_calls": estimated_file_summary_calls,
        "estimated_model_calls": estimated_model_calls,
        "largest": largest[:5],
        "ignored_count": candidate_report.get("ignored_count", 0),
        "ignored_file_count": candidate_report.get("ignored_file_count", 0),
        "ignored_dir_count": candidate_report.get("ignored_dir_count", 0),
        "ignored_examples": candidate_report.get("ignored_examples", []),
        "selection_policy": candidate_report.get("selection_policy", {}),
    }


def print_index_plan(path: str, pattern: str | None = AUTO_INDEX_GLOB) -> None:
    print(format_index_plan(path, pattern))


def format_index_plan(path: str, pattern: str | None = AUTO_INDEX_GLOB) -> str:
    plan = plan_document_index(path, pattern)
    lines = [
        f"root: {plan['root']}",
        f"glob: {plan['glob']}",
        f"candidate files: {plan['files']}",
        f"source bytes: {human_bytes(plan['bytes'])}",
        f"estimated chunks: {plan['estimated_chunks']}",
        f"estimated file-summary model calls: {plan['estimated_file_summary_calls']}",
        f"estimated HRAG model calls: {plan['estimated_model_calls']}",
    ]
    if plan.get("ignored_count"):
        lines.append(
            f"ignored by {MOTOKO_IGNORE_FILE}: {plan['ignored_count']} "
            f"({plan.get('ignored_file_count', 0)} file(s), {plan.get('ignored_dir_count', 0)} dir(s))"
        )
        for item in plan.get("ignored_examples", [])[:MAX_INDEX_IGNORE_EXAMPLES]:
            lines.append(
                f"  line {item.get('line', 0)} {item.get('pattern', '')}: "
                f"{item.get('relative_path', '')}"
            )
    if plan["largest"]:
        lines.append("largest files:")
        for size, candidate in plan["largest"]:
            lines.append(f"  {human_bytes(size):>10}  {candidate}")
    return "\n".join(lines)


def context_item_from_file(path: str) -> dict:
