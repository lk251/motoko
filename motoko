def model_endpoint_suffix(endpoint_text: str) -> str:
    if endpoint_is_unix(endpoint_text):
        parsed = urllib.parse.urlparse(endpoint_text)
        socket_name = pathlib.PurePosixPath(urllib.parse.unquote(parsed.path)).stem
        return f":{socket_name}" if socket_name else ":sock"
    match = re.search(r":(\d+)(?:/|$)", endpoint_text)
    return f":{match.group(1)}" if match else ""


def model_route_badge(route: str = MODEL_ROUTE_CHAT) -> str:
    info = model_route(route)
    raw = info["model"]
    lower = raw.lower()
    pieces = []
    if "qwen" in lower:
        match = re.search(r"qwen[0-9.]*", lower)
        pieces.append(match.group(0) if match else "qwen")
    if "27b" in lower:
        pieces.append("27b")
    elif match := re.search(r"\b([0-9]+(?:\.[0-9]+)?b)\b", lower):
        pieces.append(match.group(1))
    if "mtp" in lower:
        pieces.append("mtp")
    if not pieces:
        pieces.append(raw[:28])
    return "-".join(pieces) + model_endpoint_suffix(info["endpoint"])


def configured_model_routes() -> list[str]:
    routes = list(MODEL_ROUTE_DESCRIPTIONS)
    candidate = config_root() / "config.json"
    configured = load_config().get("model_routes", {}) if candidate.exists() else {}
    for route in configured:
        if route in MODEL_ROUTE_DESCRIPTIONS and route not in routes:
            routes.append(route)
    for raw_route in local_model_catalog_routes():
        route = normalize_model_route(raw_route, strict=False)
        if route in MODEL_ROUTE_DESCRIPTIONS and route not in routes:
            routes.append(route)
    return routes


def model_service_routes() -> list[dict]:
    configured_routes = [(route, model_route(route)) for route in configured_model_routes()]
    catalog = load_local_model_catalog()
    catalog_summaries = []
    for route_id, raw in local_model_catalog_routes(catalog).items():
        if not isinstance(route_id, str) or not isinstance(raw, dict):
            continue
        catalog_summaries.append((route_id, local_model_route_summary(route_id, raw, catalog)))
    return build_model_service_rows(
        configured_routes,
        catalog_summaries,
        default_request_path=LOCAL_MODEL_UNIX_REQUEST_PATH,
    )


