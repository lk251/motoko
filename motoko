def extract_document_signals(path: pathlib.Path, text: str) -> dict:
    signals = {
        "format": "org" if path.suffix.lower() == ".org" else "",
        "headline_count": 0,
        "task_count": 0,
        "active_task_count": 0,
        "done_task_count": 0,
        "priorities": {},
        "headlines": [],
        "tasks": [],
        "task_items": [],
        "deadlines": [],
        "scheduled": [],
    }
    current_task = None
    for line in text.splitlines():
        stripped = line.strip()
        headline = parse_org_headline(stripped)
        if headline is not None:
            rendered = format_org_headline_signal(headline)
            signals["headline_count"] += 1
            append_limited(signals["headlines"], rendered, 40)
            current_task = None
            todo = headline.get("todo", "")
            if todo:
                signals["task_count"] += 1
                if active_org_todo(todo):
                    signals["active_task_count"] += 1
                else:
                    signals["done_task_count"] += 1
                priority = headline.get("priority", "")
                if priority:
                    signals["priorities"][priority] = signals["priorities"].get(priority, 0) + 1
                append_limited(signals["tasks"], rendered, 60)
                current_task = append_task_item(signals["task_items"], task_item_from_headline(headline), 80)
        if "DEADLINE:" in stripped:
            append_limited(signals["deadlines"], stripped, 30)
            if current_task is not None:
                current_task["deadline"] = stripped
                current_task["deadline_date"] = org_timestamp_date(stripped)
        if "SCHEDULED:" in stripped:
            append_limited(signals["scheduled"], stripped, 30)
            if current_task is not None:
                current_task["scheduled"] = stripped
                current_task["scheduled_date"] = org_timestamp_date(stripped)
    return clean_signal_dict(signals)


def merge_signal_sets(signal_sets: list[dict], *, limit: int = 80) -> dict:
    merged = {
        "headline_count": 0,
        "task_count": 0,
        "active_task_count": 0,
        "done_task_count": 0,
        "priorities": {},
        "headlines": [],
        "tasks": [],
        "task_items": [],
        "deadlines": [],
        "scheduled": [],
    }
    for signals in signal_sets:
        if not signals:
            continue
        for key in ["headline_count", "task_count", "active_task_count", "done_task_count"]:
            merged[key] += int(signals.get(key, 0) or 0)
        for priority, count in (signals.get("priorities") or {}).items():
            merged["priorities"][priority] = merged["priorities"].get(priority, 0) + int(count or 0)
        for key in ["headlines", "tasks", "deadlines", "scheduled"]:
            for value in signals.get(key, []) or []:
                append_limited(merged[key], value, limit)
        for item in signals.get("task_items", []) or []:
            if len(merged["task_items"]) < limit:
                merged["task_items"].append(dict(item))
    return clean_signal_dict(merged)


def file_signals_from_chunks(chunks: list[dict]) -> dict:
    return merge_signal_sets([chunk.get("signals") or {} for chunk in chunks])


def corpus_signals_from_files(files: list[dict]) -> dict:
    rows = []
    for file_item in files:
        signals = file_item.get("signals") or {}
        if not signals:
            continue
        path = file_item.get("path", "")
        prefixed = dict(signals)
        for key in ["headlines", "tasks", "deadlines", "scheduled"]:
            prefixed[key] = [f"{path}: {item}" for item in signals.get(key, []) or []]
        prefixed["task_items"] = [
            dict(item, path=path)
            for item in signals.get("task_items", []) or []
        ]
        rows.append(prefixed)
    return merge_signal_sets(rows, limit=120)


def format_signal_summary(signals: dict, *, limit: int = 20) -> str:
    if not signals:
        return ""
    lines = []
    task_bits = []
    if signals.get("active_task_count"):
        task_bits.append(f"{signals.get('active_task_count')} active")
    if signals.get("done_task_count"):
        task_bits.append(f"{signals.get('done_task_count')} done")
    if signals.get("task_count") and not task_bits:
        task_bits.append(f"{signals.get('task_count')} task(s)")
    if task_bits:
        lines.append("tasks: " + ", ".join(task_bits))
    priorities = signals.get("priorities") or {}
    if priorities:
        lines.append("priorities: " + ", ".join(f"{key}:{priorities[key]}" for key in sorted(priorities)))
    task_items = signals.get("task_items") or []
    if task_items:
        lines.append("task candidates:")
        lines.extend(f"- {format_task_item(item)}" for item in task_items[:limit])
        return "\n".join(lines)
    for label, key in [("deadlines", "deadlines"), ("scheduled", "scheduled"), ("task headlines", "tasks")]:
        values = signals.get(key) or []
        if values:
            lines.append(f"{label}:")
            lines.extend(f"- {value}" for value in values[:limit])
    return "\n".join(lines)


def task_signal_boost(query: str, signals: dict) -> int:
    if not query_wants_task_context(query) or not signals:
        return 0
    priorities = signals.get("priorities") or {}
    boost = int(signals.get("active_task_count", 0) or 0) * 3
    boost += len(signals.get("deadlines", []) or []) * 2
    boost += len(signals.get("scheduled", []) or [])
    boost += int(priorities.get("A", 0) or 0) * 4
    boost += int(priorities.get("B", 0) or 0) * 2
    return min(boost, 30)


def query_target_date(query: str) -> _dt.date | None:
    terms = set(token_counts(query))
    today = _dt.date.today()
    if "tomorrow" in terms:
        return today + _dt.timedelta(days=1)
    if "today" in terms:
        return today
    match = re.search(r"\b(\d{4}-\d{2}-\d{2})\b", query)
    if match:
        try:
            return _dt.date.fromisoformat(match.group(1))
        except ValueError:
            return None
    return None


def parse_iso_date(value: str) -> _dt.date | None:
    if not value:
        return None
    try:
        return _dt.date.fromisoformat(value)
    except ValueError:
        return None


def task_item_rank(item: dict, query: str) -> int:
    score = 0
    todo = str(item.get("todo", ""))
    if active_org_todo(todo):
        score += 30
    elif todo:
        score -= 20
    priority = str(item.get("priority", "")).upper()
    score += {"A": 40, "B": 24, "C": 10}.get(priority, 0)
    target = query_target_date(query)
    for key, exact_bonus, near_bonus in [
        ("deadline_date", 35, 18),
        ("scheduled_date", 25, 12),
    ]:
        date_value = parse_iso_date(str(item.get(key, "")))
        if date_value is None:
            continue
        if target is not None:
            delta = (date_value - target).days
            if delta == 0:
                score += exact_bonus
            elif -7 <= delta < 0:
                score += near_bonus
            elif 0 < delta <= 7:
                score += max(4, near_bonus // 2)
        else:
            score += 8
    score += score_text(token_counts(query), " ".join(str(item.get(key, "")) for key in ["title", "todo", "priority", "path"]))
    return score


def ranked_task_items_from_index(index: dict, query: str, *, limit: int = 20) -> list[tuple[int, dict]]:
    rows = []
    for file_item in index.get("files", []):
        path = file_item.get("path", "")
        for item in (file_item.get("signals") or {}).get("task_items", []) or []:
            row = dict(item)
            row.setdefault("path", path)
            rows.append((task_item_rank(row, query), row))
    rows.sort(key=lambda row: row[0], reverse=True)
    return [row for row in rows[:limit] if row[0] > -10]


def format_ranked_task_items(index: dict, query: str, *, limit: int = 16) -> str:
    rows = ranked_task_items_from_index(index, query, limit=limit)
    if not rows:
        return ""
    lines = []
    for _score, item in rows:
        lines.append(f"- {format_task_item(item)}")
    return "\n".join(lines)


def corpus_profile_file_role(file_item: dict) -> tuple[str, list[str], list[str]]:
    path_text = str(file_item.get("path", ""))
    lower = path_text.lower()
    name = pathlib.Path(path_text).name.lower()
    suffix = pathlib.Path(path_text).suffix.lower()
    signals = file_item.get("signals") or {}
    roles: list[tuple[int, str, str]] = []

    def add(score: int, role: str, reason: str) -> None:
        roles.append((score, role, reason))

    if int(signals.get("active_task_count", 0) or 0):
        add(90, "planning", "active Org tasks")
    if signals.get("deadlines") or signals.get("scheduled"):
        add(82, "calendar", "Org dates")
    if signals.get("headline_count") and suffix == ".org":
        add(55, "notes", "Org hierarchy")
    if any(word in lower for word in ["/archive", "archive", "old/", "done/"]):
        add(40, "archive", "archive path")
    if any(word in name for word in ["readme", "manual", "guide", "docs", "doc"]):
        add(72, "reference", "reference filename")
    if any(part in lower for part in ["/docs/", "/doc/"]):
        add(56, "reference", "documentation path")
    if suffix in {".py", ".nix", ".sh", ".js", ".ts", ".rs", ".go", ".c", ".h"}:
        add(66, "source", "source-code suffix")
    if suffix in {".json", ".yaml", ".yml", ".toml", ".ini"}:
        add(58, "config", "configuration suffix")
    if any(word in name for word in ["journal", "diary", "log", "daily"]):
        add(62, "journal", "journal filename")
    if suffix in {".csv", ".tsv", ".jsonl"}:
        add(52, "data", "data suffix")
    if not roles:
        add(10, "notes", "general text")

    roles.sort(key=lambda row: row[0], reverse=True)
    primary = roles[0][1]
    secondary = []
    reasons = []
    for _score, role, reason in roles:
        if role != primary and role not in secondary:
            secondary.append(role)
        if reason not in reasons:
            reasons.append(reason)
    return primary, secondary[:4], reasons[:5]


def corpus_profile_tags(files: list[dict]) -> dict[str, int]:
    counts: dict[str, int] = {}
    for file_item in files:
        for item in (file_item.get("signals") or {}).get("task_items", []) or []:
            for tag in item.get("tags", []) or []:
                counts[str(tag)] = counts.get(str(tag), 0) + 1
    return dict(sorted(counts.items(), key=lambda row: (-row[1], row[0]))[:40])


def corpus_profile_date_items(files: list[dict], *, limit: int = 40) -> list[dict]:
    rows = []
    for file_item in files:
        path = file_item.get("path", "")
        for item in (file_item.get("signals") or {}).get("task_items", []) or []:
            for kind, date_key, raw_key in [
                ("deadline", "deadline_date", "deadline"),
                ("scheduled", "scheduled_date", "scheduled"),
            ]:
                date_value = str(item.get(date_key, ""))
                if not date_value:
                    continue
                rows.append(
                    clean_signal_dict(
                        {
                            "date": date_value,
                            "kind": kind,
                            "path": path,
                            "todo": item.get("todo", ""),
                            "priority": item.get("priority", ""),
                            "title": item.get("title", ""),
                            "raw": item.get(raw_key, ""),
                        }
                    )
                )
    rows.sort(key=lambda row: (row.get("date", ""), row.get("path", ""), row.get("title", "")))
    return rows[:limit]


def corpus_profile_task_items(files: list[dict], *, limit: int = 30) -> list[dict]:
    rows = []
    query = "priority tasks deadlines scheduled today tomorrow next plan"
    for file_item in files:
        path = file_item.get("path", "")
        for item in (file_item.get("signals") or {}).get("task_items", []) or []:
            row = dict(item)
            row.setdefault("path", path)
            rows.append((task_item_rank(row, query), row))
    rows.sort(key=lambda row: row[0], reverse=True)
    return [row for score, row in rows[:limit] if score > -10]


def build_corpus_profile(
    index_id: str,
    root: pathlib.Path,
    files: list[dict],
    *,
    created: str = "",
) -> dict:
    file_profiles = []
    role_counts: dict[str, int] = {}
    for file_item in files:
        role, secondary_roles, reasons = corpus_profile_file_role(file_item)
        role_counts[role] = role_counts.get(role, 0) + 1
        signals = file_item.get("signals") or {}
        file_profiles.append(
            clean_signal_dict(
                {
                    "path": file_item.get("path", ""),
                    "role": role,
                    "secondary_roles": secondary_roles,
                    "reasons": reasons,
                    "summary": compact_text(file_item.get("summary", ""), 700),
                    "headline_count": signals.get("headline_count", 0),
                    "active_task_count": signals.get("active_task_count", 0),
                    "done_task_count": signals.get("done_task_count", 0),
                    "priorities": signals.get("priorities", {}),
                    "task_samples": [
                        format_task_item(dict(item, path=file_item.get("path", "")))
                        for item in (signals.get("task_items") or [])[:8]
                    ],
                    "deadlines": signals.get("deadlines", [])[:8],
                    "scheduled": signals.get("scheduled", [])[:8],
                }
            )
        )

    top_tasks = corpus_profile_task_items(files)
    profile = {
        "schema": CORPUS_PROFILE_SCHEMA_VERSION,
        "generated": now(),
        "index_id": index_id,
        "root": str(root),
        "source_index_created": created,
        "source_file_count": len(files),
        "role_counts": dict(sorted(role_counts.items())),
        "file_roles": file_profiles,
        "top_tasks": top_tasks,
        "date_items": corpus_profile_date_items(files),
        "tags": corpus_profile_tags(files),
        "profile_kind": "deterministic-corpus-profile",
        "provenance": artifact_provenance(
            "corpus-profile",
            CORPUS_PROFILE_SCHEMA_VERSION,
            deterministic=True,
        ),
    }
    profile["summary"] = format_corpus_profile(profile, max_files=10, max_tasks=10, max_dates=8)
    return profile


def format_corpus_profile(profile: dict | None, *, max_files: int = 12, max_tasks: int = 12, max_dates: int = 10) -> str:
    if not profile:
        return ""
    lines = [
        f"schema: {profile.get('schema', '')}",
        f"root: {profile.get('root', '')}",
        f"files: {profile.get('source_file_count', 0)}",
    ]
    role_counts = profile.get("role_counts") or {}
    if role_counts:
        lines.append("roles: " + ", ".join(f"{role}:{count}" for role, count in sorted(role_counts.items())))
    tags = profile.get("tags") or {}
    if tags:
        lines.append("tags: " + ", ".join(f"{tag}:{count}" for tag, count in list(tags.items())[:12]))
    tasks = profile.get("top_tasks") or []
    if tasks:
        lines.append("top tasks:")
        lines.extend(f"- {format_task_item(item)}" for item in tasks[:max_tasks])
    dates = profile.get("date_items") or []
    if dates:
        lines.append("date signals:")
        for item in dates[:max_dates]:
            task = format_task_item(item)
            lines.append(f"- {item.get('date', '')} {item.get('kind', '')}: {task}")
    file_roles = profile.get("file_roles") or []
    if file_roles:
        lines.append("file map:")
        for item in file_roles[:max_files]:
            bits = [f"- {item.get('path', '')}: {item.get('role', 'notes')}"]
            if item.get("secondary_roles"):
                bits.append("also " + ",".join(item.get("secondary_roles", [])))
            if item.get("active_task_count"):
                bits.append(f"{item.get('active_task_count')} active task(s)")
            if item.get("summary"):
                bits.append(compact_text(item.get("summary", ""), 220))
            lines.append("; ".join(bits))
    return "\n".join(lines)


def corpus_profile_text(index: dict) -> str:
    return index.get("corpus_profile_text") or format_corpus_profile(index.get("corpus_profile") or {})


def artifact_schema_current(artifact: dict | None, schema: str) -> bool:
    if not isinstance(artifact, dict):
        return False
    return artifact.get("artifact_schema") == schema or artifact.get("schema") == schema


def artifact_has_provenance(artifact: dict | None, schema: str) -> bool:
    if not artifact_schema_current(artifact, schema):
        return False
    if not artifact.get("artifact_kind"):
        return False
    if not artifact.get("builder"):
        return False
    if not artifact.get("created"):
        return False
    if not artifact.get("quality_status"):
        return False
    if artifact.get("mode") in {"model", "legacy-model"}:
        return bool(artifact.get("model") and artifact.get("route") and artifact.get("prompt_version"))
    return artifact.get("mode") == "deterministic"


def legacy_summary_provenance(artifact_kind: str, schema: str, *, source_sha256: str = "") -> dict:
    item = artifact_provenance(
        artifact_kind,
        schema,
        deterministic=True,
        prompt_version="legacy-pre-provenance",
        source_sha256=source_sha256,
        quality_status="legacy-unverified",
    )
    item["mode"] = "legacy-model"
    item["route"] = "legacy"
    item["model"] = "unknown-legacy"
    item["endpoint"] = ""
    return item


def index_quality_gate(index: dict) -> dict:
    checks = []
    routes: dict[str, int] = {}

    def add(name: str, ok: bool, detail: str = "") -> None:
        checks.append({"name": name, "ok": bool(ok), "detail": detail})

    add("files present", bool(index.get("files")), f"{len(index.get('files', []))} file(s)")
    add(
        "corpus summary provenance",
        artifact_has_provenance(index.get("corpus_summary_artifact"), CORPUS_SUMMARY_SCHEMA_VERSION)
        if index.get("corpus_summary")
        else True,
    )
    add("structured signals current", not index_needs_signal_enrichment(index))
    add("corpus profile current", not index_needs_corpus_profile(index))
    add(
        "corpus profile provenance",
        artifact_has_provenance(index.get("corpus_profile_artifact"), CORPUS_PROFILE_SCHEMA_VERSION),
    )

    task_signal_text = "\n".join(
        [
            index.get("signal_summary", ""),
            corpus_profile_text(index),
        ]
    )
    active_tasks = []
    for item in (index.get("signals") or {}).get("task_items", []) or []:
        if active_org_todo(item.get("todo", "")):
            active_tasks.append(item)
    missing_tasks = []
    for item in active_tasks[:QUALITY_TASK_CHECK_LIMIT]:
        title = str(item.get("title", ""))
        deadline = str(item.get("deadline_date", ""))
        if title and title not in task_signal_text:
            missing_tasks.append(title)
        if deadline and deadline not in task_signal_text:
            missing_tasks.append(f"{title} deadline {deadline}".strip())
    add(
        "task/date evidence preserved",
        not missing_tasks,
        "; ".join(missing_tasks[:5]),
    )

    missing_file_artifacts = []
    missing_chunk_artifacts = []
    for file_item in index.get("files", []) or []:
        if not file_item.get("summary"):
            missing_file_artifacts.append(file_item.get("path", ""))
        if not artifact_has_provenance(file_item.get("summary_artifact"), FILE_SUMMARY_SCHEMA_VERSION):
            missing_file_artifacts.append(f"{file_item.get('path', '')} provenance")
        artifact = file_item.get("summary_artifact") or {}
        if artifact.get("route"):
            routes[artifact["route"]] = routes.get(artifact["route"], 0) + 1
        for chunk in file_item.get("chunks", []) or []:
            if not chunk.get("summary") or not chunk.get("content_sha256"):
                missing_chunk_artifacts.append(f"{file_item.get('path', '')} chunk {chunk.get('chunk')}")
            if not artifact_has_provenance(chunk.get("summary_artifact"), CHUNK_SUMMARY_SCHEMA_VERSION):
                missing_chunk_artifacts.append(f"{file_item.get('path', '')} chunk {chunk.get('chunk')} provenance")
            artifact = chunk.get("summary_artifact") or {}
            if artifact.get("route"):
                routes[artifact["route"]] = routes.get(artifact["route"], 0) + 1
    add("file summaries have provenance", not missing_file_artifacts, "; ".join(missing_file_artifacts[:5]))
    add("chunk summaries have provenance", not missing_chunk_artifacts, "; ".join(missing_chunk_artifacts[:5]))

    passed = sum(1 for check in checks if check["ok"])
    return {
        "schema": "index-quality-gate-v1",
        "index_id": index.get("id", ""),
        "status": "pass" if passed == len(checks) else "fail",
        "passed": passed,
        "total": len(checks),
        "checks": checks,
        "routes": dict(sorted(routes.items())),
    }


def format_index_quality_gate(report: dict) -> str:
    lines = [
        f"index quality: {report.get('status', 'unknown')} "
        f"({report.get('passed', 0)}/{report.get('total', 0)})",
        f"index: {report.get('index_id', '')}",
    ]
    routes = report.get("routes") or {}
    if routes:
        lines.append("routes: " + ", ".join(f"{route}:{count}" for route, count in routes.items()))
    for check in report.get("checks", []):
        marker = "ok" if check.get("ok") else "fail"
        detail = f" - {check.get('detail')}" if check.get("detail") else ""
        lines.append(f"- {marker}: {check.get('name', '')}{detail}")
    return "\n".join(lines)


def path_supports_structured_signals(path: pathlib.Path) -> bool:
    return path.suffix.lower() == ".org"


def index_progress_running(index_id: str) -> bool:
    progress = read_index_progress(index_id)
    if not progress:
        return False
    return progress.get("status") not in {"completed", "failed", "paused"}


def index_needs_signal_enrichment(index: dict) -> bool:
    if index.get("signal_schema") != SIGNAL_SCHEMA_VERSION:
        return True
    for file_item in index.get("files", []):
        path = pathlib.Path(file_item.get("path", ""))
        supported = path_supports_structured_signals(path)
        if supported and "signals" not in file_item:
            return True
        for chunk in file_item.get("chunks", []):
            if supported and "signals" not in chunk and read_chunk_content(index, chunk).strip():
                return True
    return False


def index_needs_corpus_profile(index: dict) -> bool:
    if index.get("corpus_profile_schema") != CORPUS_PROFILE_SCHEMA_VERSION:
        return True
    profile = index.get("corpus_profile")
    if not isinstance(profile, dict):
        return True
    if profile.get("schema") != CORPUS_PROFILE_SCHEMA_VERSION:
        return True
    if len(profile.get("file_roles", []) or []) != len(index.get("files", []) or []):
        return True
    if not index.get("corpus_profile_text"):
        return True
    return False


def index_needs_summary_provenance(index: dict) -> bool:
    if index.get("corpus_summary") and not artifact_has_provenance(index.get("corpus_summary_artifact"), CORPUS_SUMMARY_SCHEMA_VERSION):
        return True
    for file_item in index.get("files", []) or []:
        if file_item.get("summary") and not artifact_has_provenance(file_item.get("summary_artifact"), FILE_SUMMARY_SCHEMA_VERSION):
            return True
        for chunk in file_item.get("chunks", []) or []:
            if chunk.get("summary") and not artifact_has_provenance(chunk.get("summary_artifact"), CHUNK_SUMMARY_SCHEMA_VERSION):
                return True
    return False


def index_needs_artifact_upgrade(index: dict) -> bool:
    return index_needs_signal_enrichment(index) or index_needs_corpus_profile(index) or index_needs_summary_provenance(index)


def index_with_current_summary_provenance(index: dict) -> dict:
    enriched = dict(index)
    enriched_files = []
    for file_item in enriched.get("files", []) or []:
        enriched_file = dict(file_item)
        if enriched_file.get("summary") and not artifact_has_provenance(enriched_file.get("summary_artifact"), FILE_SUMMARY_SCHEMA_VERSION):
            source_sha = (
                (enriched_file.get("source_fingerprint") or {}).get("sha256")
                or enriched_file.get("indexed_sha256", "")
            )
            enriched_file["summary_artifact"] = legacy_summary_provenance(
                "file-summary",
                FILE_SUMMARY_SCHEMA_VERSION,
                source_sha256=source_sha,
            )
        enriched_chunks = []
        for chunk in enriched_file.get("chunks", []) or []:
            enriched_chunk = dict(chunk)
            if enriched_chunk.get("summary") and not artifact_has_provenance(enriched_chunk.get("summary_artifact"), CHUNK_SUMMARY_SCHEMA_VERSION):
                enriched_chunk["summary_artifact"] = legacy_summary_provenance(
                    "chunk-summary",
                    CHUNK_SUMMARY_SCHEMA_VERSION,
                    source_sha256=enriched_chunk.get("content_sha256", ""),
                )
            enriched_chunks.append(enriched_chunk)
        enriched_file["chunks"] = enriched_chunks
        enriched_files.append(enriched_file)
    enriched["files"] = enriched_files
    if enriched.get("corpus_summary") and not artifact_has_provenance(enriched.get("corpus_summary_artifact"), CORPUS_SUMMARY_SCHEMA_VERSION):
        corpus_source = "\n\n".join(f"{item.get('path', '')}\n{item.get('summary', '')}" for item in enriched_files)
        enriched["corpus_summary_artifact"] = legacy_summary_provenance(
            "corpus-summary",
            CORPUS_SUMMARY_SCHEMA_VERSION,
            source_sha256=sha256_hex(corpus_source.encode("utf-8")),
        )
    return enriched


def index_with_current_signals(index: dict) -> dict:
    enriched = dict(index)
    enriched_files = []
    for file_item in index.get("files", []):
        path = pathlib.Path(file_item.get("path", ""))
        enriched_file = dict(file_item)
        enriched_chunks = []
        for chunk in file_item.get("chunks", []):
            enriched_chunk = dict(chunk)
            content = read_chunk_content(index, chunk)
            signals = extract_document_signals(path, content)
            if signals:
                enriched_chunk["signals"] = signals
            elif path_supports_structured_signals(path):
                enriched_chunk["signals"] = {}
            else:
                enriched_chunk.pop("signals", None)
            enriched_chunks.append(enriched_chunk)
        enriched_file["chunks"] = enriched_chunks
        file_signals = file_signals_from_chunks(enriched_chunks)
        if file_signals or path_supports_structured_signals(path):
            enriched_file["signals"] = file_signals
        else:
            enriched_file.pop("signals", None)
        enriched_files.append(enriched_file)

    enriched["files"] = enriched_files
    corpus_signals = corpus_signals_from_files(enriched_files)
    if corpus_signals:
        enriched["signals"] = corpus_signals
        enriched["signal_summary"] = format_signal_summary(corpus_signals, limit=SIGNAL_SUMMARY_TASK_LIMIT)
    else:
        enriched.pop("signals", None)
        enriched.pop("signal_summary", None)
    enriched["signal_schema"] = SIGNAL_SCHEMA_VERSION
    enriched["signal_enriched"] = now()
    return enriched


def index_with_current_corpus_profile(index: dict) -> dict:
    enriched = dict(index)
    try:
        root = pathlib.Path(enriched.get("root", "")).expanduser().resolve()
    except OSError:
        root = pathlib.Path(enriched.get("root", ""))
    profile = build_corpus_profile(
        enriched.get("id", ""),
        root,
        enriched.get("files", []) or [],
        created=enriched.get("created", ""),
    )
    enriched["corpus_profile_schema"] = CORPUS_PROFILE_SCHEMA_VERSION
    enriched["corpus_profile_enriched"] = profile.get("generated", now())
    enriched["corpus_profile"] = profile
    enriched["corpus_profile_artifact"] = profile.get("provenance", {})
    enriched["corpus_profile_text"] = profile.get("summary", "")
    return enriched


def upgrade_index_artifacts(index: dict) -> tuple[dict, bool, str]:
    index_id = index.get("id", "")
    if not index_id:
        raise SystemExit("index has no id")
    if index_progress_running(index_id):
        raise SystemExit(f"index {index_id} is still being built; wait for the active job to finish")

    changed = []
    upgraded = dict(index)
    if index_needs_summary_provenance(upgraded):
        upgraded = index_with_current_summary_provenance(upgraded)
        changed.append("summary provenance")
    signals_changed = False
    if index_needs_signal_enrichment(upgraded):
        upgraded = index_with_current_signals(upgraded)
        signals_changed = True
        changed.append("signals")
    if signals_changed or index_needs_corpus_profile(upgraded):
        upgraded = index_with_current_corpus_profile(upgraded)
        changed.append("corpus profile")
    if not changed:
        return index, False, f"index artifacts already current: {index_id}"
    atomic_write(index_path(index_id), json.dumps(upgraded, ensure_ascii=False, indent=2) + "\n")
    return upgraded, True, f"index artifacts enriched: {index_id} ({', '.join(changed)})"


def enrich_index_signals(index: dict) -> tuple[dict, bool, str]:
    return upgrade_index_artifacts(index)


def enrich_indexes_needing_signals(*, limit: int | None = None) -> list[str]:
    notes = []
    changed = 0
    for index in list_indexes():
        if limit is not None and changed >= limit:
            break
        if not index_needs_artifact_upgrade(index):
            continue
        index_id = index.get("id", "")
        if index_progress_running(index_id):
            notes.append(f"index artifact upgrade skipped active job {index_id}")
            continue
        try:
            _enriched, did_change, note = upgrade_index_artifacts(index)
        except Exception as exc:
            notes.append(f"index artifact upgrade failed for {index_id}: {type(exc).__name__}: {exc}")
            continue
        if did_change:
            changed += 1
            notes.append(note)
    return notes


def upgrade_indexes_needing_artifacts(*, limit: int | None = None) -> list[str]:
    return enrich_indexes_needing_signals(limit=limit)


def quality_gate_check_failed(report: dict, name: str) -> bool:
    for check in report.get("checks", []) or []:
        if check.get("name") == name:
            return not bool(check.get("ok"))
    return False


def extractive_summary(text: str, *, max_lines: int = 8, max_chars: int = 1600) -> str:
    lines = []
    for raw_line in text.splitlines():
        line = raw_line.strip()
        if not line:
            continue
        lines.append(line)
        if len(lines) >= max_lines:
            break
    summary = "\n".join(f"- {line}" for line in lines)
    return compact_text(summary or text.strip(), max_chars)


def chunk_repair_reasons(index: dict, file_item: dict, chunk: dict) -> list[str]:
    reasons = []
    content = read_chunk_content(index, chunk)
    if not chunk.get("content_sha256") and content:
        reasons.append("missing content hash")
    if not str(chunk.get("summary", "")).strip():
        reasons.append("empty chunk summary")
    if chunk.get("summary") and not artifact_has_provenance(
        chunk.get("summary_artifact"),
        CHUNK_SUMMARY_SCHEMA_VERSION,
    ):
        reasons.append("missing chunk summary provenance")
    return reasons


def file_repair_reasons(file_item: dict) -> list[str]:
    reasons = []
    if not str(file_item.get("summary", "")).strip():
        reasons.append("empty file summary")
    if file_item.get("summary") and not artifact_has_provenance(
        file_item.get("summary_artifact"),
        FILE_SUMMARY_SCHEMA_VERSION,
    ):
        reasons.append("missing file summary provenance")
    return reasons


def summarize_for_repair(
    label: str,
    text: str,
    instruction: str,
    *,
    route: str,
    prompt_version: str,
    timeout: float = INDEX_MODEL_TIMEOUT_SECONDS,
) -> tuple[str, dict]:
    summary = summarize_text(
        label,
        text,
        instruction,
        timeout=timeout,
        route=route,
        prompt_version=prompt_version,
    ).strip()
    source_sha = sha256_hex(text.encode("utf-8"))
    if summary:
        return summary, artifact_provenance(
            prompt_version.removesuffix("-v1"),
            prompt_version,
            route=route,
            prompt_version=prompt_version,
            source_sha256=source_sha,
        )
    return extractive_summary(text), artifact_provenance(
        prompt_version.removesuffix("-v1"),
        prompt_version,
        deterministic=True,
        prompt_version="extractive-repair-v1",
        source_sha256=source_sha,
        quality_status="fallback-extractive",
    )


def repair_chunk_summary(index: dict, file_item: dict, chunk: dict) -> tuple[dict, str]:
    content = read_chunk_content(index, chunk)
    if not content.strip():
        raise ValueError(f"no stored chunk text for {file_item.get('path', '')} chunk {chunk.get('chunk')}")
    label = f"{file_item.get('path', '')} chunk {chunk.get('chunk')}"
    summary, provenance = summarize_for_repair(
        label,
        content[:SUMMARY_INPUT_CHARS],
        "Repair this retrieval chunk summary. Preserve names, dates, TODOs, obligations, decisions, and concrete details.",
        route=MODEL_ROUTE_INDEX_CHUNK,
        prompt_version=CHUNK_SUMMARY_SCHEMA_VERSION,
    )
    repaired = dict(chunk)
    repaired["summary"] = summary
    repaired["content_sha256"] = repaired.get("content_sha256") or sha256_hex(content.encode("utf-8"))
    repaired["summary_artifact"] = provenance
    signals = extract_document_signals(pathlib.Path(file_item.get("path", "")), content)
    if signals or path_supports_structured_signals(pathlib.Path(file_item.get("path", ""))):
        repaired["signals"] = signals
    return repaired, f"{file_item.get('path', '')} chunk {chunk.get('chunk')}"


def repair_file_summary(file_item: dict) -> dict:
    repaired = dict(file_item)
    blocks = [f"Chunk {chunk.get('chunk')}:\n{chunk.get('summary', '')}" for chunk in repaired.get("chunks", [])]
    input_text = "\n\n".join(blocks).strip()
    summary, provenance = summarize_for_repair(
        str(file_item.get("path", "")),
        input_text,
        "Repair this file-level summary from chunk summaries. Include what the file is for and when to retrieve it.",
        route=MODEL_ROUTE_INDEX_FILE,
        prompt_version=FILE_SUMMARY_SCHEMA_VERSION,
    )
    repaired["summary"] = summary
    source_sha = (
        (repaired.get("source_fingerprint") or {}).get("sha256")
        or repaired.get("indexed_sha256", "")
        or sha256_hex(input_text.encode("utf-8"))
    )
    repaired["summary_artifact"] = artifact_provenance(
        "file-summary",
        FILE_SUMMARY_SCHEMA_VERSION,
        route=MODEL_ROUTE_INDEX_FILE if provenance.get("mode") == "model" else None,
        deterministic=provenance.get("mode") != "model",
        prompt_version=FILE_SUMMARY_SCHEMA_VERSION if provenance.get("mode") == "model" else "extractive-repair-v1",
        source_sha256=source_sha,
        quality_status=provenance.get("quality_status", "current"),
    )
    return repaired


def repair_corpus_summary(index: dict) -> dict:
    repaired = dict(index)
    files = repaired.get("files", []) or []
    blocks = [f"{item.get('path', '')}:\n{item.get('summary', '')}" for item in files]
    input_text = "\n\n".join(blocks).strip()
    summary, provenance = summarize_for_repair(
        str(repaired.get("root", repaired.get("id", ""))),
        input_text,
        "Repair this corpus-level map from file summaries. Explain the main themes and which files matter for which questions.",
        route=MODEL_ROUTE_INDEX_CORPUS,
        prompt_version=CORPUS_SUMMARY_SCHEMA_VERSION,
    )
    repaired["corpus_summary"] = summary
    repaired["corpus_summary_artifact"] = artifact_provenance(
        "corpus-summary",
        CORPUS_SUMMARY_SCHEMA_VERSION,
        route=MODEL_ROUTE_INDEX_CORPUS if provenance.get("mode") == "model" else None,
        deterministic=provenance.get("mode") != "model",
        prompt_version=CORPUS_SUMMARY_SCHEMA_VERSION if provenance.get("mode") == "model" else "extractive-repair-v1",
        source_sha256=sha256_hex(input_text.encode("utf-8")),
        quality_status=provenance.get("quality_status", "current"),
    )
    return repaired


def repair_index_artifacts(
    index: dict,
    *,
    limit: int | None = None,
    phase_callback=None,
) -> tuple[dict, bool, str]:
    index_id = index.get("id", "")
    if not index_id:
        raise SystemExit("index has no id")
    if index_progress_running(index_id):
        raise SystemExit(f"index {index_id} is still being built; wait for the active job to finish")
    status, _warnings = index_staleness(index)
    if status == "stale":
        return index, False, f"index quality repair skipped stale index: {index_id}; refresh the source index first"

    before = index_quality_gate(index)
    repaired = dict(index)
    changes = []
    if index_needs_summary_provenance(repaired):
        repaired = index_with_current_summary_provenance(repaired)
        changes.append("summary provenance")
    if index_needs_signal_enrichment(repaired) or quality_gate_check_failed(before, "task/date evidence preserved"):
        repaired = index_with_current_signals(repaired)
        repaired = index_with_current_corpus_profile(repaired)
        changes.append("structured signals")

    max_repairs = BACKGROUND_INDEX_REPAIR_LIMIT if limit is None else max(0, int(limit))
    repaired_chunks = 0
    affected_files: set[str] = set()
    repaired_files = []
    for file_item in repaired.get("files", []) or []:
        new_file = dict(file_item)
        new_chunks = []
        file_changed = False
        for chunk in file_item.get("chunks", []) or []:
            reasons = chunk_repair_reasons(repaired, file_item, chunk)
            if reasons and repaired_chunks < max_repairs:
                if phase_callback is not None:
                    phase_callback("bg-heavy: repairing index(model)")
                new_chunk, label = repair_chunk_summary(repaired, file_item, chunk)
                new_chunks.append(new_chunk)
                repaired_chunks += 1
                file_changed = True
                affected_files.add(str(file_item.get("path", "")))
                changes.append(f"chunk summary {label}")
                continue
            new_chunks.append(chunk)
        new_file["chunks"] = new_chunks
        file_signals = file_signals_from_chunks(new_chunks)
        path = pathlib.Path(file_item.get("path", ""))
        if file_signals or path_supports_structured_signals(path):
            new_file["signals"] = file_signals
        else:
            new_file.pop("signals", None)
        if file_changed or file_repair_reasons(new_file):
            if phase_callback is not None:
                phase_callback("bg-heavy: repairing index(model)")
            new_file = repair_file_summary(new_file)
            affected_files.add(str(file_item.get("path", "")))
            changes.append(f"file summary {file_item.get('path', '')}")
        repaired_files.append(new_file)
    repaired["files"] = repaired_files

    if affected_files or not repaired.get("corpus_summary") or not artifact_has_provenance(
        repaired.get("corpus_summary_artifact"),
        CORPUS_SUMMARY_SCHEMA_VERSION,
    ):
        if phase_callback is not None:
            phase_callback("bg-heavy: repairing index(model)")
        repaired = repair_corpus_summary(repaired)
        changes.append("corpus summary")

    repaired = index_with_current_signals(repaired)
    repaired = index_with_current_corpus_profile(repaired)
    after = index_quality_gate(repaired)
    if not changes:
        if before.get("status") == "pass":
            return index, False, f"index quality already passes: {index_id}"
        return index, False, f"index quality repair found no repairable artifacts: {index_id}"

    history = list(repaired.get("repair_history", []) or [])[-19:]
    history.append(
        {
            "schema": "index-repair-v1",
            "created": now(),
            "quality_before": before.get("status", "unknown"),
            "quality_after": after.get("status", "unknown"),
            "chunk_repairs": repaired_chunks,
            "affected_files": sorted(affected_files),
            "changes": changes[:40],
        }
    )
    repaired["repair_history"] = history
    repaired["repair_schema"] = "index-repair-v1"
    atomic_write(index_path(index_id), json.dumps(repaired, ensure_ascii=False, indent=2) + "\n")
    return (
        repaired,
        True,
        f"index quality repaired: {index_id} ({repaired_chunks} chunk(s); {after.get('status', 'unknown')})",
    )


def repair_indexes_needing_quality(*, limit: int | None = None, quiet: bool = False, phase_callback=None) -> list[str]:
    notes = []
    remaining = BACKGROUND_INDEX_REPAIR_LIMIT if limit is None else max(0, int(limit))
    if remaining <= 0:
        return notes
    for index in latest_indexes_by_family():
        if remaining <= 0:
            break
        status, _warnings = index_staleness(index)
        if status == "stale":
            continue
        if index_quality_gate(index).get("status") == "pass":
            continue
        index_id = index.get("id", "")
        try:
            if quiet:
                buf = io.StringIO()
                with contextlib.redirect_stdout(buf), contextlib.redirect_stderr(buf):
                    _repaired, changed, note = repair_index_artifacts(
                        index,
                        limit=remaining,
                        phase_callback=phase_callback,
                    )
            else:
                _repaired, changed, note = repair_index_artifacts(
                    index,
                    limit=remaining,
                    phase_callback=phase_callback,
                )
        except Exception as exc:
            notes.append(f"index quality repair failed for {index_id}: {type(exc).__name__}: {exc}")
            continue
        notes.append(note)
        if changed:
            remaining -= max(1, int((_repaired.get("repair_history") or [{}])[-1].get("chunk_repairs", 1) or 1))
    return notes


def split_text(text: str, size: int = INDEX_CHUNK_CHARS) -> list[str]:
    chunks = []
    start = 0
    while start < len(text):
        end = min(len(text), start + size)
        if end < len(text):
            boundary = text.rfind("\n\n", start, end)
            if boundary > start + size // 2:
                end = boundary
        chunks.append(text[start:end].strip())
        start = end
    return [chunk for chunk in chunks if chunk]


def sha256_hex(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def index_staleness(index: dict) -> tuple[str, list[str]]:
    return corpus_index_staleness(index, artifact_warning_provider=index_artifact_warnings)


