def model_output_cache_key(
    messages: list[dict],
    *,
    route_info: dict,
    temperature: float,
    prompt_version: str,
    request_options: dict | None = None,
) -> tuple[str, str]:
    material = {
        "schema": MODEL_OUTPUT_CACHE_SCHEMA_VERSION,
        "route": route_info["route"],
        "endpoint": route_info["endpoint"],
        "model": route_info["model"],
        "temperature": temperature,
        "prompt_version": prompt_version,
        "request_options": request_options or {},
        "messages": messages,
    }
    raw = json.dumps(material, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
    return sha256_hex(raw.encode("utf-8")), sha256_hex(json.dumps(messages, ensure_ascii=False, sort_keys=True).encode("utf-8"))


def read_model_output_cache(cache_key: str, *, route_info: dict, prompt_version: str) -> str | None:
    try:
        data = json.loads(model_cache_path(cache_key).read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return None
    if not isinstance(data, dict):
        return None
    if data.get("schema") != MODEL_OUTPUT_CACHE_SCHEMA_VERSION:
        return None
    if data.get("key") != cache_key:
        return None
    if data.get("route") != route_info["route"]:
        return None
    if data.get("model") != route_info["model"] or data.get("endpoint") != route_info["endpoint"]:
        return None
    if data.get("prompt_version") != prompt_version:
        return None
    output = data.get("output")
    return output if isinstance(output, str) else None


