def allowed_dirs() -> list[pathlib.Path]:
    path = allowdirs_path()
    if not path.exists():
        return []
    dirs = []
    for line in path.read_text(encoding="utf-8").splitlines():
        line = line.strip()
        if line and not line.startswith("#"):
            dirs.append(pathlib.Path(line).expanduser().resolve())
    return dirs


def add_allowed_dir(path: str) -> None:
    resolved = pathlib.Path(path).expanduser().resolve()
    if not resolved.is_dir():
        raise SystemExit(f"not a directory: {resolved}")
    existing = allowed_dirs()
    if resolved not in existing:
        with allowdirs_path().open("a", encoding="utf-8") as fh:
            fh.write(str(resolved) + "\n")
        allowdirs_path().chmod(0o600)
    print(f"allowed: {resolved}")


def load_personality() -> tuple[str, str, bool]:
