def background_study_step(
    conv: dict,
    phase_callback=None,
    *,
    manual: bool = False,
    cancel_event=None,
) -> list[str]:
    raise_if_work_cancelled(cancel_event, "background study paused by request", work_kind="study")
    job_id = study_job_id()
    previous_state = read_study_state()
    previous_job = previous_state.get("job_id") if study_state_incomplete(previous_state) else None
    mode = "manual-background-catchup" if manual else "catalog-and-planning"
    append_study_job_event(
        job_id,
        "started",
        mode=mode,
        conversation_id=conv.get("id", ""),
        manual=manual,
        resumed_from_job_id=previous_job or "",
        resumed_from_phase=previous_state.get("phase", "") if previous_job else "",
    )

    def set_phase(phase: str, *, notes: list[str] | None = None) -> None:
        write_study_phase(phase, notes=notes, job_id=job_id)
        append_study_job_event(job_id, "phase", phase=phase, notes=notes or [])
        if phase_callback is not None:
            phase_callback(phase)
        raise_if_work_cancelled(cancel_event, "background study paused by request", work_id=job_id, work_kind="study")
        if work_pause_requested():
            pause_notes = (notes or []) + ["background study paused by request"]
            state = {
                "updated": now(),
                "phase": "study: paused",
                "status": "paused",
                "mode": mode,
                "job_id": job_id,
                "notes": pause_notes[:8],
            }
            write_study_state(state)
            append_study_job_event(job_id, "paused", notes=pause_notes[:8])
            clear_work_pause_request()
            raise WorkPaused("background study paused by request", work_id=job_id, work_kind="study")

    set_phase("study: catalog")
    catalog = write_context_catalog()
    notes = []
    if previous_job:
        notes.append(
            f"resumed after interrupted study job {previous_job} "
            f"at {previous_state.get('phase', 'unknown')}"
        )
    stale_indexes = [
        item
        for item in catalog.get("indexes", [])
        if item.get("status") not in {"fresh", "empty"}
    ]
    if stale_indexes:
        notes.append(f"{len(stale_indexes)} index(es) need review or rebuild")
    enrich_limit = env_int(
        "MOTOKO_BACKGROUND_INDEX_UPGRADE_LIMIT",
        env_int("MOTOKO_BACKGROUND_INDEX_ENRICH_LIMIT", BACKGROUND_INDEX_UPGRADE_LIMIT),
    )
    if env_flag("MOTOKO_BACKGROUND_INDEX_ENRICH", True) and enrich_limit:
        enrichment_candidates = [
            index
            for index in list_indexes()
            if index_needs_artifact_upgrade(index)
        ]
        if enrichment_candidates:
            set_phase("study: upgrading indexes", notes=notes)
            notes.extend(upgrade_indexes_needing_artifacts(limit=max(1, enrich_limit)))
            catalog = write_context_catalog()
    heavy_notes = refresh_heavy_attached_indexes(
        conv,
        phase_callback=lambda phase: set_phase(phase, notes=notes),
        ignore_cooldown=manual,
        cancel_event=cancel_event,
    )
    if heavy_notes:
        notes.extend(heavy_notes)
        catalog = write_context_catalog()
    cleanup_limit = env_int("MOTOKO_BACKGROUND_INDEX_CLEANUP_LIMIT", BACKGROUND_INDEX_CLEANUP_LIMIT)
    if env_flag("MOTOKO_BACKGROUND_INDEX_CLEANUP", True) and cleanup_limit:
        cleanup_candidates = index_cleanup_candidates()
        if cleanup_candidates:
            set_phase("bg-light: cleanup(cpu)", notes=notes)
            cleanup_report = cleanup_superseded_stale_indexes(limit=cleanup_limit)
            deleted_count = len(cleanup_report.get("deleted", []) or [])
            blocked_count = len(cleanup_report.get("blocked", []) or [])
            if deleted_count:
                notes.append(f"stale superseded index artifact(s) cleaned: {deleted_count}")
                catalog = write_context_catalog()
            if blocked_count:
                notes.append(f"index cleanup blocked: {blocked_count}")
    evidence_limit = env_int("MOTOKO_BACKGROUND_EVIDENCE_REFRESH_LIMIT", BACKGROUND_EVIDENCE_REFRESH_LIMIT)
    if env_flag("MOTOKO_BACKGROUND_EVIDENCE_REFRESH", True) and evidence_limit:
        evidence_candidates = evidence_refresh_candidates()
        if evidence_candidates:
            set_phase("study: evidence-store", notes=notes)
            evidence_report = refresh_evidence_stores(limit=evidence_limit)
            built = int(evidence_report.get("built", 0) or 0)
            if built:
                notes.append(f"evidence store(s) refreshed: {built}")
                catalog = write_context_catalog()
            for item in evidence_report.get("items", [])[:3]:
                if item.get("status") in {"skipped", "failed"}:
                    label = item.get("name") or item.get("index", "")
                    detail = item.get("error") or item.get("reason", "")
                    notes.append(f"evidence refresh {item.get('status')}: {label} {detail}".strip())
    repair_limit = env_int("MOTOKO_BACKGROUND_INDEX_REPAIR_LIMIT", BACKGROUND_INDEX_REPAIR_LIMIT)
    if env_flag("MOTOKO_BACKGROUND_INDEX_REPAIR", True) and repair_limit:
        repair_candidates = [
            index
            for index in latest_indexes_by_family()
            if index_staleness(index)[0] != "stale" and index_quality_gate(index).get("status") != "pass"
        ]
        if repair_candidates:
            set_phase("bg-heavy: repairing index(model)", notes=notes)
            repair_notes = repair_indexes_needing_quality(
                limit=repair_limit,
                quiet=True,
                phase_callback=lambda phase: set_phase(phase, notes=notes),
            )
            if repair_notes:
                notes.extend(repair_notes)
                catalog = write_context_catalog()
    vector_limit = env_int("MOTOKO_BACKGROUND_VECTOR_REFRESH_LIMIT", BACKGROUND_VECTOR_REFRESH_LIMIT)
    if env_flag("MOTOKO_BACKGROUND_VECTOR_REFRESH", True) and vector_limit:
        try:
            vector_report = refresh_vector_stores(
                limit=vector_limit,
                method=EMBEDDING_VECTOR_METHOD,
                phase_callback=lambda phase: set_phase(phase, notes=notes),
                cancel_event=cancel_event,
            )
        except SystemExit as exc:
            notes.append(f"vector refresh skipped: {exc}")
        else:
            built = int(vector_report.get("built", 0) or 0)
            if built:
                notes.append(f"vector store(s) refreshed: {built}")
                catalog = write_context_catalog()
            for item in vector_report.get("items", [])[:3]:
                if item.get("status") in {"skipped", "failed", "paused", "deferred"}:
                    label = item.get("name") or item.get("index", "")
                    detail = item.get("error") or item.get("note") or item.get("reason", "")
                    notes.append(f"vector refresh {item.get('status')}: {label} {detail}".strip())
    if env_flag("MOTOKO_BACKGROUND_PROFILE", False) and profile_refresh_due(catalog):
        set_phase("study: profile", notes=notes)
        try:
            refresh_profile_dossier()
        except SystemExit as exc:
            notes.append(f"profile refresh skipped: {exc}")
        except Exception as exc:
            notes.append(f"profile refresh failed: {type(exc).__name__}: {exc}")
        else:
            notes.append("profile dossier refreshed")
            catalog = write_context_catalog()
    elif catalog.get("memory_count", 0) and not catalog.get("profile_updated"):
        notes.append("profile dossier is not built yet")
    set_phase("study: planning", notes=notes)
    if conv.get("messages"):
        query = context_query_text(conv, conv.get("title", ""))
        if query.strip():
            project_scope = project_scope_for_request(conv, query)
            topic = next((row for row in ranked_topics_for_query(query, project_scope=project_scope) if row.get("_score", 0) >= STUDY_REUSE_MIN_SCORE), None)
            dossier = next((row for row in ranked_dossiers_for_query(query, project_scope=project_scope) if row.get("_score", 0) >= STUDY_REUSE_MIN_SCORE), None)
            if topic and topic.get("id") not in attached_item_ids(conv, "topic"):
                notes.append(f"existing topic dossier may fit this chat: {topic.get('id')}")
            if dossier and dossier.get("id") not in attached_item_ids(conv, "dossier"):
                notes.append(f"existing memory dossier may fit this chat: {dossier.get('id')}")
            if not topic and not dossier and (catalog.get("memory_count", 0) or catalog.get("indexes")):
                notes.append("current chat may benefit from /study")
    state = {
        "updated": now(),
        "phase": "study: idle",
        "status": "completed",
        "mode": mode,
        "job_id": job_id,
        "notes": notes[:8],
        "catalog_updated": catalog.get("updated", ""),
    }
    write_study_state(state)
    append_study_job_event(job_id, "completed", notes=notes[:8], catalog_updated=catalog.get("updated", ""))
    return notes[:12] if manual else notes[:3]


def hybrid_candidate_document(index: dict, candidate: dict, query: str = "") -> str:
    file_item = candidate.get("file_item") or {}
    chunk = candidate.get("chunk") or {}
    content = read_chunk_content(index, chunk)
    return compact_text(retrieval_chunk_haystack(file_item, chunk, content, query=query), 6000)


def add_structured_task_candidates(index: dict, query: str, candidates: dict[tuple[str, str], dict]) -> None:
    if not query_wants_task_context(query):
        return
    files_by_path = {file_item.get("path", ""): file_item for file_item in index.get("files", [])}
    for score, item in ranked_task_items_from_index(index, query, limit=HYBRID_STRUCTURED_CANDIDATE_LIMIT):
        file_item = files_by_path.get(item.get("path", ""))
        if not file_item:
            continue
        chunks = [chunk for chunk in file_item.get("chunks", []) if isinstance(chunk, dict)]
        if not chunks:
            continue
        title = str(item.get("title", "")).strip().lower()
        selected = chunks[0]
        if title:
            for chunk in chunks:
                if title in read_chunk_content(index, chunk).lower():
                    selected = chunk
                    break
        add_hybrid_candidate(
            candidates,
            file_item,
            selected,
            "structured",
            max(score, 1) + 50,
            {"task": format_task_item(item)},
        )


