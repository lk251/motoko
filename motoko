    lines = ["Motoko help", "TUI: press q or Esc to close help and return to the conversation.", ""]
    for section, rows in HELP_SECTIONS:
        lines.append(f"{section}:")
        for command, description in rows:
            lines.append(f"  {command:<30} {description}")
        lines.append("")
    lines.extend(
        [
            "Notes:",
            "  Indexes, topic dossiers, and memory dossiers live under ~/.local/state/motoko.",
            "  Each turn receives ranked memories and recent conversation capsules.",
            "  Use /sources after an answer to inspect why context was selected.",
