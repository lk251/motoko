def command_chat(args) -> None:
    conv = new_conversation(args.title)
    for path in args.file or []:
        conv.setdefault("context_items", []).append(context_item_from_file(path))
    for directory in args.dir or []:
        index = build_document_index(directory, args.glob)
        conv.setdefault("context_items", []).append(context_item_from_index(index))
    for index_id in args.index or []:
        index = load_index(index_id)
        conv.setdefault("context_items", []).append(context_item_from_index(index))
    save_conversation(conv)
    chat_loop(conv)


