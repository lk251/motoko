def _agentic_eval_fixture_action_interruption(docs: pathlib.Path, tmp: pathlib.Path) -> dict:
    _agentic_eval_write_reader_tool()
    action_file = tmp / "interrupt-action.json"
    write_eval_action_file(
        action_file,
        {
            "schema": "motoko-action-v1",
            "kind": "skill_tool_run",
            "skill": "eval-reader",
            "tool": "reader",
            "arguments": {"path": str(docs / "existing.org")},
        },
    )
    cancel_event = threading.Event()
    cancel_event.set()
    output = run_action_text(str(action_file), yes=True, cancel_event=cancel_event)
    rows = read_jsonl(action_ledger_path())
    invalid = {
