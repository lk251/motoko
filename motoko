        f"status: {freshness}",
        f"created: {store.get('created', '')}",
        f"realm: {store.get('realm', '')}",
        f"source index: {source.get('id', '')}  {source.get('name', '')}  {source.get('root', '')}",
        f"rows: {store.get('row_count', len(store.get('rows', [])))}",
        "kinds: "
        + (
            ", ".join(f"{kind}={count}" for kind, count in sorted((store.get("kind_counts") or {}).items()))
            or "-"
        ),
        f"path: {store.get('path', '')}",
        f"note: {store.get('note', '')}",
    ]
    for warning in warnings:
        lines.append(f"warning: {warning}")
    return "\n".join(lines)


def format_evidence_query_report(report: dict) -> str:
    source = report.get("source_index") if isinstance(report.get("source_index"), dict) else {}
    lines = [
        f"evidence query: {report.get('query', '')}",
        f"store: {report.get('store_id', '')}  freshness={report.get('freshness', '')}  index={source.get('id', '')}",
    ]
    for warning in report.get("warnings", [])[:5]:
        lines.append(f"warning: {warning}")
    if not report.get("rows"):
        lines.append("no evidence rows matched")
        return "\n".join(lines)
    for idx, row in enumerate(report.get("rows", [])[:20], 1):
        lines.append(
            f"{idx}. total={row.get('total', 0)} lex={row.get('lexical', 0)} "
            f"path={row.get('path_boost', 0)} structured={row.get('structured', 0)} "
            f"{row.get('kind', '')}  {row.get('path', '')} chunk {row.get('chunk', '')}"
        )
        labels = []
        if row.get("date"):
            labels.append(f"date={row.get('date')}")
        if row.get("todo"):
            labels.append(f"todo={row.get('todo')}")
        if row.get("priority"):
            labels.append(f"priority={row.get('priority')}")
        if row.get("tags"):
            labels.append("tags=:" + ":".join(row.get("tags", [])[:8]) + ":")
        if row.get("title"):
