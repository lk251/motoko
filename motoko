def build_context_catalog() -> dict:
    indexes = []
    for index in latest_indexes_by_family()[:CONTEXT_CATALOG_INDEX_LIMIT]:
        status, warnings = index_staleness(index)
        indexes.append(
            {
                "id": index.get("id", ""),
                "name": index.get("name", ""),
                "root": index.get("root", ""),
                "status": status,
                "warnings": warnings[:4],
                "summary": compact_text(index.get("corpus_summary", ""), CONTEXT_CATALOG_SUMMARY_CHARS),
                "corpus_profile": compact_text(corpus_profile_text(index), CONTEXT_CATALOG_SUMMARY_CHARS),
            }
        )
    topics = []
    for topic in list_topics()[:CONTEXT_CATALOG_DOSSIER_LIMIT]:
        topics.append(
            {
                "id": topic.get("id", ""),
                "name": topic.get("name", ""),
                "query": topic.get("query", ""),
                "summary": compact_text(topic.get("summary", ""), CONTEXT_CATALOG_SUMMARY_CHARS),
            }
        )
    dossiers = []
    for dossier in list_dossiers()[:CONTEXT_CATALOG_DOSSIER_LIMIT]:
        dossiers.append(
            {
                "id": dossier.get("id", ""),
                "name": dossier.get("name", ""),
                "query": dossier.get("query", ""),
                "summary": compact_text(dossier.get("summary", ""), CONTEXT_CATALOG_SUMMARY_CHARS),
            }
        )
    memories = load_memories(limit=1000)
    profile = load_profile_dossier()
    return {
        "updated": now(),
        "model": model_name(),
        "endpoint": endpoint(),
        "memory_count": len(memories),
        "pinned_memory_count": sum(1 for row in memories if row.get("pinned")),
        "conversation_count": len(list_conversations()),
        "profile_updated": profile.get("updated", "") if profile else "",
        "indexes": indexes,
