def parse_config_byte_count(raw, field: str) -> int:
    if isinstance(raw, int):
        if raw < 0:
            raise ValueError(f"{field} must be non-negative")
        return raw
    if isinstance(raw, str):
        return parse_byte_count(raw)
    raise ValueError(f"{field} must be a byte count string or integer")


def parse_optional_positive_int(raw, field: str) -> int | None:
    if raw in (None, ""):
        return None
    try:
        value = int(raw)
    except (TypeError, ValueError) as exc:
        raise SystemExit(f"{field} must be a positive integer") from exc
    if value <= 0:
        raise SystemExit(f"{field} must be a positive integer")
    return value


def index_max_files() -> int | None:
    return parse_optional_positive_int(
        os.environ.get("MOTOKO_INDEX_MAX_FILES") or config_index_value("max_files"),
        "index.max_files",
    )


def index_max_file_bytes() -> int | None:
    raw = os.environ.get("MOTOKO_INDEX_MAX_FILE_BYTES") or config_index_value("max_file_bytes")
    if raw in (None, ""):
        return None
    try:
        return parse_config_byte_count(raw, "index.max_file_bytes")
    except ValueError as exc:
        raise SystemExit(str(exc)) from exc


def permission_mode() -> str:
    mode = os.environ.get("MOTOKO_PERMISSIONS") or load_config().get("permissions", {}).get("mode")
    if mode not in PERMISSION_MODE_DESCRIPTIONS:
        valid = ", ".join(PERMISSION_MODE_DESCRIPTIONS)
        raise SystemExit(f"invalid Motoko permission mode {mode!r}; choose one of: {valid}")
    return mode


def require_permission(capability: str) -> None:
    mode = permission_mode()
    if capability in PERMISSION_MODE_CAPABILITIES.get(mode, set()):
        return
    raise SystemExit(
        f"Motoko permission mode '{mode}' does not allow {capability}; "
        "run 'motoko permissions' for available modes"
    )


def set_permission_mode(mode: str) -> None:
    if mode not in PERMISSION_MODE_DESCRIPTIONS:
        valid = ", ".join(PERMISSION_MODE_DESCRIPTIONS)
        raise SystemExit(f"unknown permission mode {mode!r}; choose one of: {valid}")
    config = load_config()
    config.setdefault("permissions", {})["mode"] = mode
    save_config(config)


def format_config_limit(raw, *, is_bytes: bool = False) -> str:
    if raw in (None, ""):
        return "unbounded"
    if is_bytes:
        try:
            return human_bytes(parse_config_byte_count(raw, "limit"))
        except ValueError:
            return str(raw)
    return str(raw)


def format_permissions() -> str:
    config = load_config()
    mode = permission_mode()
    index = config.get("index", {})
    lines = [
        f"mode: {mode}",
        f"config: {config_path()}",
        "",
        "Modes:",
    ]
    for name, description in PERMISSION_MODE_DESCRIPTIONS.items():
        marker = "*" if name == mode else " "
        lines.append(f" {marker} {name:<11} {description}")
    lines.extend(
        [
            "",
            "Index defaults:",
            f"  max derived text: {format_config_limit(index.get('max_derived_bytes'), is_bytes=True)}",
            f"  max files:        {format_config_limit(index.get('max_files'))}",
            f"  max file size:    {format_config_limit(index.get('max_file_bytes'), is_bytes=True)}",
            "",
            "Notes:",
            "  Permissions are Motoko feature gates, not an OS sandbox.",
            "  Document and repo reads still require allowlisted directories.",
            "  Repo commands are fixed read-only Git/review summaries; no shell, sudo, or push.",
        ]
    )
    if os.environ.get("MOTOKO_PERMISSIONS"):
        lines.append("  MOTOKO_PERMISSIONS is overriding the configured mode for this process.")
    return "\n".join(lines)


