def recent_conversation_matched_snippets(row: dict, query_counts, *, limit: int, snippet_chars: int) -> list[str]:
    if limit <= 0 or not query_counts:
        return []
    candidates: list[tuple[int, int, str]] = []
    order = 0
    summary = str(row.get("summary", "") or "").strip()
    if summary:
        score = score_text(query_counts, summary)
        if score > 0:
            candidates.append((score, order, "summary: " + compact_text(summary, snippet_chars)))
            order += 1
    for msg in row.get("messages", []):
        role = msg.get("role", "")
        if role not in {"user", "assistant"}:
            continue
        content = str(msg.get("content", "") or "").strip()
        if not content:
            continue
        score = score_text(query_counts, content)
        if score <= 0:
            continue
        label = "Javier" if role == "user" else "Motoko"
        candidates.append((score, order, f"{label}: {compact_text(content, snippet_chars)}"))
        order += 1
    candidates.sort(key=lambda item: (item[0], -item[1]), reverse=True)
    snippets = []
    seen = set()
    for _score, _order, text in candidates:
        if text in seen:
            continue
        snippets.append(text)
        seen.add(text)
        if len(snippets) >= limit:
            break
    return snippets


def attach_recent_conversation_snippets(rows: list[dict], query_counts, recall: dict) -> list[dict]:
    if not rows or recall["matched_snippets"] <= 0:
        return rows
    enriched_rows = []
    for row in rows:
        enriched = dict(row)
        snippets = recent_conversation_matched_snippets(
            enriched,
            query_counts,
            limit=recall["matched_snippets"],
            snippet_chars=recall["snippet_chars"],
        )
        if snippets:
            enriched["_matched_snippets"] = snippets
        enriched_rows.append(enriched)
    return enriched_rows


def ranked_recent_conversations(conv: dict, query: str = "", *, project_scope: dict | None = None) -> list[dict]:
    recall = conversation_recall_config()
    current_id = conv.get("id", "")
    project_scope = project_scope or project_scope_for_request(conv, query)
    project_roots = project_scope_roots(project_scope)
    rows = []
    for row in list_conversations():
        if row.get("id") == current_id:
            continue
        if not conversation_recall_text_with_config(row, recall).strip():
            continue
        row_roots = conversation_project_roots(row)
        if not row_roots:
            continue
        if not any(project_root_matches(root, project_roots) for root in row_roots):
            continue
        rows.append(row)
    if not rows:
        return []
    rows.sort(
        key=lambda row: parse_timestamp(row.get("updated", row.get("created", ""))) or _dt.datetime.min.replace(
            tzinfo=_dt.timezone.utc
        ),
        reverse=True,
    )
    query_counts = token_counts(context_query_text(conv, query))
    ranked = rank_recent_conversation_rows(
        rows,
        query_counts=query_counts,
        recall_text_func=lambda row: conversation_recall_text_with_config(row, recall),
        score_text_func=score_text,
        recency_lane=recall["recent_conversations"],
        relevance_lane=recall["relevant_conversations"],
        limit=recall["conversation_limit"],
    )
    return attach_recent_conversation_snippets(ranked, query_counts, recall)


