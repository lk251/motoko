    text = read_text_file(resolved)
    return {
        "kind": "file",
        "path": str(resolved),
        "bytes": len(text.encode("utf-8")),
        "content": text,
    }


def context_items_from_dir(path: str, pattern: str) -> list[dict]:
    root = pathlib.Path(path).expanduser().resolve()
    require_allowed(root)
    if not root.is_dir():
        raise SystemExit(f"not a directory: {root}")
    items = []
    for candidate in iter_index_candidates(root, pattern):
        if len(items) >= MAX_CONTEXT_FILES:
            break
        try:
            items.append(context_item_from_file(str(candidate)))
        except OSError:
            continue
    return items


