def resume_document_index(index_id: str, progress_callback=None, cancel_event=None) -> dict:
    partial = load_partial_index(index_id)
    require_permission("index")
    clear_work_pause_request()
    previous_progress = read_index_progress(index_id) or {}
    previous_elapsed = int(previous_progress.get("elapsed_seconds", 0) or 0)
    root = pathlib.Path(partial.get("root", "")).expanduser().resolve()
    require_allowed(root)
    pattern = partial.get("glob") or AUTO_INDEX_GLOB
    name = partial.get("name") or root.name or str(root)
    created = partial.get("created") or now()
    if not root.exists():
        raise SystemExit(f"not a file or directory: {root}")
    candidate_report = index_candidate_report(root, pattern)
    candidates = apply_index_limits(candidate_report["candidates"])
    selection_policy = candidate_report.get("selection_policy", {})
    if not candidates:
        raise SystemExit(f"no ingestible text files matched {pattern or AUTO_INDEX_GLOB} under {root}")
    files = list(partial.get("files", []))
    completed_by_path = {
        str(pathlib.Path(file_item.get("path", "")).expanduser().resolve()): file_item
        for file_item in files
        if file_item.get("path")
    }
    partial_policy = partial.get("selection_policy") or {}
    if partial_policy and partial_policy.get("fingerprint") != selection_policy.get("fingerprint"):
        raise SystemExit(
            f"cannot resume index {index_id}: source selection policy changed; rebuild this index"
        )
    candidate_keys = {str(candidate.resolve()) for candidate in candidates}
    completed_now_ignored = sorted(
        path_text for path_text in completed_by_path if path_text not in candidate_keys
    )
    if completed_now_ignored:
        raise SystemExit(
            f"cannot resume index {index_id}: source selection policy no longer includes "
            f"{completed_now_ignored[0]}"
        )
    budget = {
        "max_bytes": int(partial.get("derived_content_budget_bytes") or DEFAULT_MAX_DERIVED_INDEX_BYTES),
        "used_bytes": sum(int(item.get("derived_content_bytes", 0) or 0) for item in files),
    }
    progress = begin_index_progress(
        index_id,
        root,
        pattern,
        name,
        candidates,
        progress_callback,
        initial_elapsed_seconds=previous_elapsed,
    )
    completed_chunks = sum(len(item.get("chunks", [])) for item in files)
    completed_file_summary_calls = sum(
        estimate_summary_calls_for_block_count(len(item.get("chunks", [])))
        for item in files
    )
    progress["completed_files"] = len(files)
    progress["completed_chunks"] = completed_chunks
    progress["completed_model_calls"] = completed_chunks + completed_file_summary_calls
    emit_index_progress(progress, progress_callback)
    existing_chunks = existing_index_chunk_cache(root)
    used_ordinals = index_file_ordinals(files)
    try:
        for candidate_position, candidate in enumerate(candidates, 1):
            raise_if_work_cancelled(
                cancel_event,
                f"indexing interrupted at durable checkpoint; resume with motoko index-resume {index_id}",
                work_id=index_id,
                work_kind="index",
            )
            candidate_key = str(candidate.resolve())
            existing = completed_by_path.get(candidate_key)
            if existing is not None:
                status, _warnings = file_staleness(existing)
                if status in {"fresh", "metadata-changed"}:
                    continue
                raise SystemExit(
                    f"cannot resume index {index_id}: already-indexed source changed: {candidate}"
                )
            try:
                file_ordinal = next_index_file_ordinal(used_ordinals)
                print(f"[{candidate_position}/{len(candidates)}] indexing {candidate}", flush=True)
                remove_index_file_chunks(index_id, file_ordinal)
                index_progress_begin_file(progress, candidate, candidate_position, progress_callback)
                item = index_file(
                    candidate,
                    index_id,
                    file_ordinal,
                    budget,
                    existing_chunks,
                    progress,
                    progress_callback,
                    INDEX_MODEL_TIMEOUT_SECONDS,
                    cancel_event,
                )
                files.append(item)
                completed_by_path[candidate_key] = item
                write_partial_index(
                    document_index_record(
                        index_id=index_id,
                        root=root,
                        pattern=pattern,
                        name=name,
                        created=created,
                        budget=budget,
                        files=files,
                        candidates=candidates,
                        selection_policy=selection_policy,
                    ),
                    status="running",
                )
                pause_document_index_if_requested(
                    index_id=index_id,
                    root=root,
                    pattern=pattern,
                    name=name,
                    created=created,
                    budget=budget,
                    files=files,
                    candidates=candidates,
                    selection_policy=selection_policy,
                    progress=progress,
                    progress_callback=progress_callback,
                )
            except OSError as exc:
                print(f"  skipped {candidate}: {exc}", file=sys.stderr)
        pause_document_index_if_requested(
            index_id=index_id,
            root=root,
            pattern=pattern,
            name=name,
            created=created,
            budget=budget,
            files=files,
            candidates=candidates,
            selection_policy=selection_policy,
            progress=progress,
            progress_callback=progress_callback,
        )
        raise_if_work_cancelled(
            cancel_event,
            f"indexing interrupted at durable checkpoint; resume with motoko index-resume {index_id}",
            work_id=index_id,
            work_kind="index",
        )
        print("  summarizing corpus", flush=True)
        corpus_summary = summarize_blocks(
            str(root),
            [f"{item['path']}:\n{item['summary']}" for item in files],
            "Create a corpus-level map from these file summaries. Explain the main themes and which files matter for which questions.",
            progress,
            progress_callback,
            "summarizing corpus",
            timeout=INDEX_MODEL_TIMEOUT_SECONDS,
            route=MODEL_ROUTE_INDEX_CORPUS,
            prompt_version=CORPUS_SUMMARY_SCHEMA_VERSION,
            preplanned_calls=estimate_corpus_summary_calls(len(files)),
            cancel_event=cancel_event,
        )
        index = document_index_record(
            index_id=index_id,
            root=root,
            pattern=pattern,
            name=name,
            created=created,
            budget=budget,
            files=files,
            corpus_summary=corpus_summary,
            selection_policy=selection_policy,
        )
        atomic_write(index_path(index_id), json.dumps(index, ensure_ascii=False, indent=2) + "\n")
        try:
            index_partial_path(index_id).unlink()
        except OSError:
            pass
        finish_index_progress(progress, "completed", progress_callback)
        print(f"index saved: {index_id}")
        return index
    except WorkPaused as exc:
        write_partial_index(
            document_index_record(
                index_id=index_id,
                root=root,
                pattern=pattern,
                name=name,
                created=created,
                budget=budget,
                files=files,
                candidates=candidates,
                selection_policy=selection_policy,
            ),
            status="paused",
            error=str(exc),
        )
        finish_index_progress(progress, "paused", progress_callback, error=str(exc))
        raise
    except BaseException as exc:
        deferred = model_request_deferred_by_residency(exc)
        status = "deferred" if deferred else "failed"
        error = f"{type(exc).__name__}: {exc}"
        finish_index_progress(progress, status, progress_callback, error=error)
        write_partial_index(
            document_index_record(
