def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="motoko", description="Personal local Qwen chat client.")
    sub = parser.add_subparsers(dest="command")

    help_cmd = sub.add_parser("help", help="show the full Motoko command reference")
    help_cmd.set_defaults(func=lambda _args: print(format_help()))

    chat = sub.add_parser("chat", help="start a new chat")
    chat.add_argument("--title")
    chat.add_argument("--file", action="append")
    chat.add_argument("--dir", action="append")
    chat.add_argument("--index", action="append")
    chat.add_argument("--glob", default="*.txt")
    chat.set_defaults(func=command_chat)

    resume = sub.add_parser("resume", help="resume a conversation")
    resume.add_argument("id")
    resume.set_defaults(func=command_resume)

    show = sub.add_parser("show", help="show a transcript")
    show.add_argument("id")
    show.set_defaults(func=command_show)

    compact = sub.add_parser("compact", help="compact a conversation")
    compact.add_argument("id")
    compact.set_defaults(func=lambda args: compact_conversation(load_conversation(args.id)))

    listed = sub.add_parser("list", help="list conversations")
    listed.set_defaults(func=command_list)

    index = sub.add_parser("index", help="build a document index")
    index.add_argument("path")
    index.add_argument("--glob", default="*.txt")
    index.add_argument("--name")
    index.set_defaults(func=command_index)

    indexes = sub.add_parser("indexes", help="list document indexes")
    indexes.set_defaults(func=command_indexes)

    memories = sub.add_parser("memories", help="list memories")
    memories.set_defaults(func=lambda _args: print_memories())

    memory = sub.add_parser("memory", help="review or edit memory provenance")
    memory_sub = memory.add_subparsers(dest="memory_command", required=True)
    memory_review = memory_sub.add_parser("review", help="list memories with provenance")
    memory_review.set_defaults(func=command_memory)
    memory_edit = memory_sub.add_parser("edit", help="edit a memory")
    memory_edit.add_argument("id")
    memory_edit.add_argument("text", nargs="+")
    memory_edit.set_defaults(func=command_memory)
    memory_forget = memory_sub.add_parser("forget", help="delete a memory")
    memory_forget.add_argument("id")
    memory_forget.set_defaults(func=command_memory)

    forget = sub.add_parser("forget", help="delete a memory")
    forget.add_argument("id")
    forget.set_defaults(func=lambda args: forget_memory(args.id))

    personality = sub.add_parser("personality", help="show or initialize personality guidance")
    personality_sub = personality.add_subparsers(dest="personality_command")
    personality_show = personality_sub.add_parser("show", help="show active personality guidance")
    personality_show.set_defaults(func=command_personality)
    personality_path_cmd = personality_sub.add_parser("path", help="print personality file path")
    personality_path_cmd.set_defaults(func=command_personality)
    personality_init = personality_sub.add_parser("init", help="write the default personality template")
    personality_init.add_argument("--force", action="store_true")
    personality_init.set_defaults(func=command_personality)
    personality.set_defaults(func=command_personality)

    remember = sub.add_parser("remember", help="save a memory")
    remember.add_argument("text", nargs="+")
    remember.set_defaults(func=lambda args: add_memory(" ".join(args.text)))

    allow_dir = sub.add_parser("allow-dir", help="allow document reads under a directory")
    allow_dir.add_argument("path")
    allow_dir.set_defaults(func=lambda args: add_allowed_dir(args.path))

    args = parser.parse_args(argv)
    if args.command is None:
        args = parser.parse_args(["chat"])
    args.func(args)
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
