def merged_config(data: dict | None) -> dict:
    merged = default_config()
    if not isinstance(data, dict):
        return merged
    identity = data.get("identity")
    if isinstance(identity, dict):
        for key in ("name", "realm", "description"):
            value = identity.get(key)
            if isinstance(value, str) and value.strip():
                merged["identity"][key] = value.strip()[:1000]
    permissions = data.get("permissions")
    if isinstance(permissions, dict):
        mode = permissions.get("mode")
        if isinstance(mode, str) and mode in PERMISSION_MODE_DESCRIPTIONS:
            merged["permissions"]["mode"] = mode
    security = data.get("security")
    if isinstance(security, dict):
        allowed = security.get("allow_cross_home_paths")
        if isinstance(allowed, list):
            rows = []
            for item in allowed[:64]:
                value = str(item or "").strip()
                if value and "\x00" not in value and value not in rows:
                    rows.append(value[:2000])
            merged["security"]["allow_cross_home_paths"] = rows
    index = data.get("index")
    if isinstance(index, dict):
        for key in ("max_derived_bytes", "max_files", "max_file_bytes"):
            if key in index:
                merged["index"][key] = index[key]
    ui = data.get("ui")
    if isinstance(ui, dict):
        merged["ui"]["assistant_color"] = normalize_ui_color(ui.get("assistant_color"))
    conversation_recall = data.get("conversation_recall")
    if isinstance(conversation_recall, dict):
        for key in (
            "current_messages",
            "current_max_chars",
            "recent_conversations",
            "relevant_conversations",
            "conversation_limit",
            "conversation_messages",
            "matched_snippets",
            "snippet_chars",
            "max_chars",
        ):
            if key in conversation_recall:
                merged["conversation_recall"][key] = conversation_recall[key]
    model_routes = data.get("model_routes")
    if isinstance(model_routes, dict):
        for raw_route, raw_config in model_routes.items():
            route = normalize_model_route(raw_route, strict=False)
            if route not in MODEL_ROUTE_DESCRIPTIONS or not isinstance(raw_config, dict):
                continue
            route_config = {}
            for key in ("endpoint", "model"):
                value = raw_config.get(key)
                if isinstance(value, str) and value.strip():
                    route_config[key] = value.strip()
            if route_config:
                merged["model_routes"][route] = route_config
    return merged


def load_config() -> dict:
    path = config_path()
    if not path.exists():
        return default_config()
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as exc:
        raise SystemExit(f"invalid Motoko config JSON at {path}: {exc}") from exc
    except OSError as exc:
        raise SystemExit(f"cannot read Motoko config at {path}: {exc}") from exc
    if not isinstance(data, dict):
        raise SystemExit(f"invalid Motoko config at {path}: top-level value must be an object")
    return merged_config(data)


def save_config(config: dict) -> None:
    path = config_path()
    atomic_write(path, json.dumps(merged_config(config), ensure_ascii=False, indent=2) + "\n")


