    if report.get("saved_path"):
        lines.append(f"saved: {report.get('saved_path')}")
    for route, summary in (report.get("route_summaries") or {}).items():
        lines.append(
            f"\n{route}: {summary.get('model', '')} endpoint={summary.get('endpoint', '')} "
            f"lane={summary.get('lane', '')} pass {summary.get('passed', 0)}/{summary.get('total', 0)} "
            f"avg {summary.get('average_score', 0)}"
        )
        for row in report.get("fixtures", []):
            if row.get("route") != route:
                continue
            fact_text = f"{row.get('matched_fact_count', 0)}/{row.get('required_fact_count', 0)} facts"
            json_text = "json ok" if row.get("json_valid") else "json fail"
            lines.append(
                f"- {row.get('status', 'unknown')}: {row.get('id', '')} "
                f"score {row.get('score', 0)} {fact_text} {json_text} "
                f"{row.get('elapsed_seconds', 0)}s"
            )
            details = []
            if row.get("missing_keys"):
                details.append("missing keys " + ", ".join(row.get("missing_keys", [])[:6]))
            if row.get("missing_facts"):
                details.append("missing facts " + ", ".join(row.get("missing_facts", [])[:6]))
            if row.get("forbidden_hits"):
                details.append("forbidden " + ", ".join(row.get("forbidden_hits", [])[:6]))
            if row.get("error"):
                details.append(row.get("error", ""))
            if details:
                lines.append("  " + "; ".join(details))
    return "\n".join(lines)


