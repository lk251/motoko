def rerank_documents(
    query: str,
    documents: list[str],
    *,
    route_id: str | None = None,
    timeout: float = MODEL_TIMEOUT_SECONDS,
    socket_activation_min_timeout: float | None = None,
    cancel_event=None,
) -> tuple[list[float], dict]:
    if not documents:
        return [], reranker_route_info(route_id)
    route_info = reranker_route_info(route_id)
    payload = {
        "model": route_info["model"],
        "query": query,
        "documents": documents,
        "top_n": len(documents),
    }
    try:
        raise_if_cancelled(cancel_event)
        prepare_route_residency_for_request(route_info)
    except RouteResidencyBusy as exc:
        raise SystemExit(f"rerank request deferred: {exc}") from exc
    try:
        with open_model_response(
            route_info,
            payload,
            timeout=timeout,
            socket_activation_min_timeout=socket_activation_min_timeout,
            cancel_event=cancel_event,
            prepare_residency=False,
        ) as resp:
            raise_if_cancelled(cancel_event)
            data = json.loads(resp.read().decode("utf-8", errors="replace") or "{}")
            raise_if_cancelled(cancel_event)
    except (urllib.error.URLError, TimeoutError, OSError, http.client.HTTPException, json.JSONDecodeError) as exc:
        if cancel_event is not None and cancel_event.is_set():
            raise RuntimeError("__motoko_stopped__") from exc
        hint = local_model_verify_hint(route_info)
        raise SystemExit(model_request_failure_detail("rerank request failed", exc, hint)) from exc
    try:
        scores = parse_rerank_response(data, len(documents))
    except RuntimeError as exc:
        raise SystemExit(f"rerank request failed: {exc}") from exc
    return scores, route_info


