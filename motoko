        self.tui_spinner_index = 0
        self.messages = self.seed_messages(conv)
        self.resume_maintenance_on_start, resume_note = resume_interrupted_maintenance(conv)
        if resume_note:
            self.append("system", resume_note)

    def seed_messages(self, conv: dict) -> list[dict]:
        rows = [
            {
                "role": "system",
                "content": f"Motoko conversation: {conv.get('title', 'Untitled')} [{conv.get('id', '')}]",
            },
            {
                "role": "system",
                "content": "Type / for commands. Use arrows to select menu entries. Ctrl+C exits.",
            },
        ]
        if conv.get("summary"):
            rows.append({"role": "summary", "content": conv.get("summary", "")})
        for msg in conv.get("messages", [])[-MAX_RECENT_MESSAGES:]:
            rows.append({"role": msg.get("role", "?"), "content": msg.get("content", "")})
        return rows

    def append(self, role: str, content: str) -> dict:
        row = {"role": role, "content": content}
        self.messages.append(row)
        self.scroll = 0
        self.dirty = True
        return row

    def run(self) -> None:
        old_winch = signal.getsignal(signal.SIGWINCH)

        def on_winch(_signum, _frame):
            self.dirty = True

        try:
            self.old_termios = termios.tcgetattr(self.stdin_fd)
            tty.setcbreak(self.stdin_fd)
            signal.signal(signal.SIGWINCH, on_winch)
            self.write("\033[?25l\033[?7l")
            self.render(force=True)
            self.start_study_loop()
            if self.resume_maintenance_on_start:
                self.resume_maintenance_on_start = False
                self.start_maintenance(resumed=True)
            while self.running:
                self.drain_events()
                timeout = 0.04 if self.generating or self.maintaining or self.study_running else 0.12
                readable, _writeable, _errors = select.select([self.stdin_fd], [], [], timeout)
                if readable:
                    self.last_input_at = time.monotonic()
                    self.handle_key(self.read_key())
                now_ts = time.monotonic()
                if self.dirty or ((self.generating or self.maintaining or self.study_running) and now_ts - self.last_render > 0.08):
                    self.render()
        finally:
            signal.signal(signal.SIGWINCH, old_winch)
            self.restore_terminal()

    def restore_terminal(self) -> None:
        if self.old_termios is not None:
            termios.tcsetattr(self.stdin_fd, termios.TCSADRAIN, self.old_termios)
            self.old_termios = None
        self.write("\033[?7h\033[?25h\033[0m\n")

    def write(self, text: str) -> None:
        os.write(self.stdout_fd, text.encode("utf-8", errors="replace"))

    def read_key(self) -> str:
        first = os.read(self.stdin_fd, 1)
        if not first:
            return ""
        if first != b"\x1b":
            return utf8_key_from_first_byte(self.stdin_fd, first)
        seq = bytearray(first)
        while True:
            readable, _writeable, _errors = select.select([self.stdin_fd], [], [], 0.01)
            if not readable:
                break
            nxt = os.read(self.stdin_fd, 1)
            if not nxt:
                break
            seq.extend(nxt)
            if nxt.isalpha() or nxt == b"~":
                break
        text = bytes(seq).decode("utf-8", errors="replace")
        keymap = {
            "\x1b[A": "up",
            "\x1b[B": "down",
            "\x1b[C": "right",
            "\x1b[D": "left",
            "\x1b[H": "home",
            "\x1b[F": "end",
            "\x1b[1~": "home",
            "\x1b[4~": "end",
            "\x1b[3~": "delete",
            "\x1b[5~": "pageup",
            "\x1b[6~": "pagedown",
            "\x1bb": "word-left",
            "\x1bf": "word-right",
            "\x1bB": "word-left",
            "\x1bF": "word-right",
        }
        return keymap.get(text, "escape")

    def handle_key(self, key: str) -> None:
        if key == "\x03":
            save_conversation(self.conv)
            self.running = False
            return
        if key == "\x04":  # Ctrl+D
            if self.input_buffer and self.cursor < len(self.input_buffer):
                self.input_buffer = self.input_buffer[: self.cursor] + self.input_buffer[self.cursor + 1 :]
                self.dropdown_index = 0
                self.dirty = True
            elif not self.input_buffer:
                save_conversation(self.conv)
                self.running = False
            return
        if key in {"\r", "\n"}:
            self.handle_enter()
            return
        if key in {"\x7f", "\b"}:
            if self.cursor > 0:
                self.input_buffer = self.input_buffer[: self.cursor - 1] + self.input_buffer[self.cursor :]
                self.cursor -= 1
                self.dropdown_index = 0
                self.dirty = True
            return
        if key == "\x15":  # Ctrl+U
            self.kill_ring = self.input_buffer[: self.cursor]
            self.input_buffer = self.input_buffer[self.cursor :]
            self.cursor = 0
            self.dropdown_index = 0
            self.dirty = True
            return
        if key == "\x17":  # Ctrl+W
            left = self.input_buffer[: self.cursor].rstrip()
            cut = left.rfind(" ") + 1
            self.kill_ring = self.input_buffer[cut : self.cursor]
            self.input_buffer = self.input_buffer[:cut] + self.input_buffer[self.cursor :]
            self.cursor = cut
            self.dropdown_index = 0
            self.dirty = True
            return
        if key == "\x0b":  # Ctrl+K
            self.kill_ring = self.input_buffer[self.cursor :]
            self.input_buffer = self.input_buffer[: self.cursor]
            self.dropdown_index = 0
            self.dirty = True
            return
        if key == "\x19":  # Ctrl+Y
            if self.kill_ring:
                self.input_buffer = (
                    self.input_buffer[: self.cursor]
                    + self.kill_ring
                    + self.input_buffer[self.cursor :]
                )
                self.cursor += len(self.kill_ring)
                self.dropdown_index = 0
                self.dirty = True
            return
        if key == "\x01":  # Ctrl+A
            self.cursor = 0
            self.dirty = True
            return
        if key == "\x05":  # Ctrl+E
            self.cursor = len(self.input_buffer)
            self.dirty = True
            return
        if key == "\x02":  # Ctrl+B
            self.cursor = max(0, self.cursor - 1)
            self.dirty = True
            return
        if key == "\x06":  # Ctrl+F
            self.cursor = min(len(self.input_buffer), self.cursor + 1)
            self.dirty = True
            return
        if key == "\x10":  # Ctrl+P
            if self.dropdown_options():
                self.dropdown_index = max(0, self.dropdown_index - 1)
            else:
                self.history_up()
            self.dirty = True
            return
        if key == "\x0e":  # Ctrl+N
            if self.dropdown_options():
                self.dropdown_index = min(len(self.dropdown_options()) - 1, self.dropdown_index + 1)
            else:
                self.history_down()
            self.dirty = True
            return
        if key == "\x0c":
            self.dirty = True
            return
        if key == "left":
            self.cursor = max(0, self.cursor - 1)
            self.dirty = True
            return
        if key == "right":
            self.cursor = min(len(self.input_buffer), self.cursor + 1)
            self.dirty = True
            return
        if key == "word-left":
            self.move_word_left()
            self.dirty = True
            return
        if key == "word-right":
            self.move_word_right()
            self.dirty = True
            return
        if key == "home":
            self.cursor = 0
            self.dirty = True
            return
        if key == "end":
            self.cursor = len(self.input_buffer)
            self.dirty = True
            return
        if key == "delete":
            if self.cursor < len(self.input_buffer):
                self.input_buffer = self.input_buffer[: self.cursor] + self.input_buffer[self.cursor + 1 :]
                self.dirty = True
            return
        if key == "up":
            if self.dropdown_options():
                self.dropdown_index = max(0, self.dropdown_index - 1)
            else:
                self.history_up()
            self.dirty = True
            return
        if key == "down":
            if self.dropdown_options():
                self.dropdown_index = min(len(self.dropdown_options()) - 1, self.dropdown_index + 1)
            else:
                self.history_down()
            self.dirty = True
            return
        if key == "pageup":
            self.scroll += 8
            self.dirty = True
            return
        if key == "pagedown":
            self.scroll = max(0, self.scroll - 8)
            self.dirty = True
            return
        if key == "escape":
            self.dropdown_index = 0
            self.dirty = True
            return
        if key == "\t":
            options = self.dropdown_options()
            if options:
                self.apply_dropdown(options[self.dropdown_index])
            return
        if len(key) == 1 and key >= " ":
            self.input_buffer = self.input_buffer[: self.cursor] + key + self.input_buffer[self.cursor :]
            self.cursor += 1
            self.dropdown_index = min(self.dropdown_index, max(0, len(self.dropdown_options()) - 1))
            self.dirty = True

    def move_word_left(self) -> None:
        idx = self.cursor
        while idx > 0 and self.input_buffer[idx - 1].isspace():
            idx -= 1
        while idx > 0 and not self.input_buffer[idx - 1].isspace():
            idx -= 1
        self.cursor = idx

    def move_word_right(self) -> None:
        idx = self.cursor
        length = len(self.input_buffer)
        while idx < length and self.input_buffer[idx].isspace():
            idx += 1
        while idx < length and not self.input_buffer[idx].isspace():
            idx += 1
        self.cursor = idx

    def history_up(self) -> None:
        if not self.history:
            return
        if self.history_index is None:
            self.history_index = len(self.history) - 1
        else:
            self.history_index = max(0, self.history_index - 1)
        self.input_buffer = self.history[self.history_index]
        self.cursor = len(self.input_buffer)

    def history_down(self) -> None:
        if self.history_index is None:
            return
        self.history_index += 1
        if self.history_index >= len(self.history):
            self.history_index = None
            self.input_buffer = ""
        else:
            self.input_buffer = self.history[self.history_index]
        self.cursor = len(self.input_buffer)

    def handle_enter(self) -> None:
        options = self.dropdown_options()
        if options:
            self.apply_dropdown(options[self.dropdown_index])
            return
        text = self.input_buffer.strip()
        self.input_buffer = ""
        self.cursor = 0
        self.history_index = None
        self.dropdown_index = 0
        if not text:
            self.dirty = True
            return
        self.history.append(text)
        self.submit_text(text)

    def submit_text(self, text: str) -> None:
        if text.startswith("/"):
            self.handle_command(text)
            return
        if self.generating:
            self.pending_prompts.append(text)
            self.append("queued", text)
            self.status = f"queued {len(self.pending_prompts)} prompt(s) while Motoko answers"
            return
        self.start_generation(text)

    def handle_command(self, text: str) -> None:
        try:
            if text in {"/", "/commands"}:
                self.append("system", self.compact_command_menu())
            elif text == "/help":
                self.append("system", format_help())
            elif text == "/exit":
                save_conversation(self.conv)
                self.running = False
            elif text == "/new" or text.startswith("/new "):
                title = text[len("/new") :].strip() or None
                save_conversation(self.conv)
                self.conv = new_conversation(title)
                save_conversation(self.conv)
                self.messages = self.seed_messages(self.conv)
                self.status = "new conversation"
                self.append("system", f"new conversation: {self.conv.get('title', 'Untitled')} [{self.conv.get('id', '')}]")
            elif text == "/stop":
                if self.generating:
                    self.cancel_event.set()
                    self.status = "stopping current answer"
                else:
                    self.append("system", "Motoko is not currently answering.")
            elif text == "/sources":
                self.append("system", format_sources(self.conv.get("last_sources", [])))
            elif text == "/status":
                self.append("system", format_status(self.conv))
            elif text == "/personality":
                self.append("system", self.capture_text(print_personality))
            elif text == "/profile":
                self.append("system", self.capture_text(print_profile))
            elif text == "/profile-refresh":
                self.run_blocking_command("Refreshing profile dossier...", refresh_profile_dossier)
                self.append("system", self.capture_text(print_profile))
            elif text == "/memories":
                self.append("system", self.capture_text(print_memories))
            elif text == "/indexes":
                self.append("system", self.capture_text(command_indexes_text))
            elif text == "/topics":
                self.append("system", self.capture_text(command_topics_text))
            elif text == "/topic-show" or text.startswith("/topic-show "):
                selector = text[len("/topic-show") :].strip() or None
                self.append("system", self.capture_text(lambda: print_topic(load_topic(selector), evidence=False)))
            elif text == "/dossiers":
                self.append("system", self.capture_text(command_dossiers_text))
            elif text == "/dossier-show" or text.startswith("/dossier-show "):
                selector = text[len("/dossier-show") :].strip() or None
                self.append("system", self.capture_text(lambda: print_dossier(load_dossier(selector), evidence=False)))
            elif text == "/study" or text.startswith("/study "):
                body = text[len("/study") :].strip()
                self.run_blocking_command("Studying context...", lambda: self.study_from_body(body))
            elif text.startswith("/memory search "):
                query = text[len("/memory search ") :]
                self.append("system", self.capture_text(lambda: print_memory_search(query)))
            elif text == "/memory review":
                self.append("system", self.capture_text(lambda: print_memories(verbose=True)))
            elif text.startswith("/title "):
                self.conv["title"] = text[len("/title ") :].strip() or self.conv["title"]
                self.conv["title_kind"] = "manual"
                self.conv.pop("title_generated", None)
                save_conversation(self.conv)
                self.append("system", f"title: {self.conv['title']}")
            elif text == "/resume" or text.startswith("/resume "):
                selector = text[len("/resume") :].strip() or None
                save_conversation(self.conv)
                self.conv = load_conversation(selector)
                self.messages = self.seed_messages(self.conv)
                self.status = "conversation resumed"
            elif text.startswith("/read "):
                item = context_item_from_file(text[len("/read ") :].strip())
                self.conv.setdefault("context_items", []).append(item)
                save_conversation(self.conv)
                self.append("system", f"attached: {item['path']}")
            elif text.startswith("/index-plan "):
                self.append("system", self.capture_text(lambda: print_index_plan(text[len("/index-plan ") :].strip())))
            elif text == "/attach-index" or text.startswith("/attach-index "):
                selector = text[len("/attach-index") :].strip() or None
                index = load_index(selector)
                self.conv.setdefault("context_items", []).append(context_item_from_index(index))
                save_conversation(self.conv)
                self.append("system", f"attached index: {index['id']}")
            elif text == "/attach-topic" or text.startswith("/attach-topic "):
                selector = text[len("/attach-topic") :].strip() or None
                topic = load_topic(selector)
                self.conv.setdefault("context_items", []).append(context_item_from_topic(topic))
                save_conversation(self.conv)
                self.append("system", f"attached topic: {topic['id']}")
            elif text == "/attach-dossier" or text.startswith("/attach-dossier "):
                selector = text[len("/attach-dossier") :].strip() or None
                dossier = load_dossier(selector)
                self.conv.setdefault("context_items", []).append(context_item_from_dossier(dossier))
                save_conversation(self.conv)
                self.append("system", f"attached dossier: {dossier['id']}")
            elif text.startswith("/remember "):
                add_memory(text[len("/remember ") :], source="manual-chat", conversation_id=self.conv["id"])
                self.append("system", "memory saved")
            elif text.startswith("/forget "):
                self.append("system", self.capture_text(lambda: forget_memory(text[len("/forget ") :].strip())))
            elif text.startswith("/memory edit "):
                parts = text.split(maxsplit=3)
                if len(parts) != 4:
                    self.append("system", "usage: /memory edit ID TEXT")
                else:
                    self.append("system", self.capture_text(lambda: edit_memory(parts[2], parts[3])))
            elif text.startswith("/memory importance "):
                parts = text.split(maxsplit=3)
                if len(parts) != 4:
                    self.append("system", "usage: /memory importance ID 1-5")
                else:
                    self.append("system", self.capture_text(lambda: set_memory_importance(parts[2], parts[3])))
            elif text.startswith("/memory pin "):
                self.append("system", self.capture_text(lambda: set_memory_pinned(text[len("/memory pin ") :].strip(), True)))
            elif text.startswith("/memory unpin "):
                self.append("system", self.capture_text(lambda: set_memory_pinned(text[len("/memory unpin ") :].strip(), False)))
            elif text == "/compact":
                self.run_blocking_command("Compacting conversation...", lambda: compact_conversation(self.conv))
            elif text == "/memorize":
                self.run_blocking_command("Running memory proposal...", lambda: memorize_conversation(self.conv))
            elif text.startswith("/index "):
                path = text[len("/index ") :].strip()
                self.run_blocking_command("Building document index...", lambda: self.attach_index_from_path(path))
            elif text == "/topic" or text.startswith("/topic "):
                body = text[len("/topic") :].strip()
                self.run_blocking_command("Building topic dossier...", lambda: self.attach_topic_from_body(body))
            elif text == "/deepen" or text.startswith("/deepen "):
                body = text[len("/deepen") :].strip()
                self.run_blocking_command("Building deep topic dossier...", lambda: self.attach_deep_topic_from_body(body))
            elif text == "/dossier" or text.startswith("/dossier "):
                body = text[len("/dossier") :].strip()
                self.run_blocking_command("Building memory dossier...", lambda: self.attach_dossier_from_body(body))
            else:
                self.append("system", "unknown command; type /help")
        except SystemExit as exc:
            self.append("error", str(exc))
        except Exception as exc:  # Defensive: keep the TUI alive.
            self.append("error", f"{type(exc).__name__}: {exc}")
        self.dirty = True

    def attach_index_from_path(self, path: str) -> None:
        if not path:
            raise SystemExit("usage: /index PATH")
        index = build_document_index(path, AUTO_INDEX_GLOB)
        self.conv.setdefault("context_items", []).append(context_item_from_index(index))
        save_conversation(self.conv)

    def attach_topic_from_body(self, body: str) -> None:
        topic = build_topic_from_chat(self.conv, body)
        self.conv.setdefault("context_items", []).append(context_item_from_topic(topic))
        save_conversation(self.conv)

    def attach_deep_topic_from_body(self, body: str) -> None:
        topic = deepen_topic_from_chat(self.conv, body)
        self.conv.setdefault("context_items", []).append(context_item_from_topic(topic))
        save_conversation(self.conv)

    def attach_dossier_from_body(self, body: str) -> None:
