def command_slot_cache(args) -> None:
    raw_args = list(getattr(args, "slot_cache_args", []) or [])
    command = "status"
    route = ""
    conversation_id = ""
    yes = False
    if raw_args and raw_args[0] in {"status", "gc", "clear", "erase"}:
        command = raw_args.pop(0)
    if command == "clear":
        idx = 0
        route_parts = []
        while idx < len(raw_args):
            item = raw_args[idx]
            if item == "--yes":
                yes = True
                idx += 1
                continue
            if item == "--conversation" and idx + 1 < len(raw_args):
                conversation_id = raw_args[idx + 1]
                idx += 2
                continue
            route_parts.append(item)
            idx += 1
        route = " ".join(route_parts).strip()
    elif raw_args:
        route = " ".join(raw_args).strip()
    if command == "status":
        print_report(format_slot_cache(route or None))
    elif command == "gc":
        if not route:
            raise SystemExit("usage: motoko slot-cache gc ROUTE")
        print_report(slot_cache_gc_text(route))
    elif command == "clear":
        print_report(slot_cache_clear_text(route or None, conversation_id=conversation_id, yes=yes))
    elif command == "erase":
        if not route:
            raise SystemExit("usage: motoko slot-cache erase ROUTE")
        print_report(slot_cache_erase_text(route))
    else:
        raise SystemExit("unknown slot-cache command")


