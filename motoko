        f"{topic.get('name', 'Untitled')} [{topic.get('id')}]",
        "",
        f"query> {topic.get('query', '')}",
        "",
        str(topic.get("summary", "")),
    ]
    if evidence:
        lines.extend(["", "Evidence:"])
        for item in topic.get("evidence", []):
            lines.extend(
                [
