def parse_org_headline(line: str) -> dict | None:
    match = re.match(r"^(\*+)\s+(.*)$", line.rstrip())
    if not match:
        return None
    body = match.group(2).strip()
    tags = []
    tag_match = re.search(r"\s+(:[A-Za-z0-9_@#%:]+:)\s*$", body)
    if tag_match:
        tags = [tag for tag in tag_match.group(1).strip(":").split(":") if tag]
        body = body[: tag_match.start()].rstrip()
    parts = body.split()
    todo = ""
    if parts and parts[0].upper() in ORG_TODO_KEYWORDS:
        todo = parts.pop(0).upper()
    priority = ""
    if parts and re.fullmatch(r"\[#([A-Za-z0-9])\]", parts[0]):
        priority = parts.pop(0)[2].upper()
    title = " ".join(parts).strip()
    if not title and not todo:
        return None
    return {
        "level": len(match.group(1)),
        "todo": todo,
        "priority": priority,
        "title": title,
        "tags": tags,
    }


def format_org_headline_signal(headline: dict) -> str:
    parts = []
    if headline.get("todo"):
        parts.append(headline["todo"])
    if headline.get("priority"):
        parts.append(f"[#{headline['priority']}]")
    if headline.get("title"):
        parts.append(headline["title"])
    if headline.get("tags"):
        parts.append(":" + ":".join(headline["tags"]) + ":")
    return f"{'*' * int(headline.get('level', 1) or 1)} {' '.join(parts)}".strip()


def org_timestamp_date(text: str) -> str:
    match = re.search(r"[<\[](\d{4}-\d{2}-\d{2})\b", text)
    return match.group(1) if match else ""


def active_org_todo(todo: str) -> bool:
    return bool(todo) and todo not in {"DONE", "CANCELLED", "CANCELED"}


def task_item_from_headline(headline: dict) -> dict:
    return clean_signal_dict(
        {
            "level": headline.get("level", 1),
            "todo": headline.get("todo", ""),
            "priority": headline.get("priority", ""),
            "title": headline.get("title", ""),
            "tags": headline.get("tags", []),
        }
    )


def append_task_item(items: list[dict], item: dict, limit: int) -> dict | None:
    if not item or len(items) >= limit:
        return None
    stored = dict(item)
    items.append(stored)
    return stored


def format_task_item(item: dict) -> str:
    parts = []
    if item.get("path"):
        parts.append(f"{item.get('path')}:")
    if item.get("todo"):
        parts.append(str(item["todo"]))
    if item.get("priority"):
        parts.append(f"[#{item['priority']}]")
    if item.get("title"):
        parts.append(str(item["title"]))
    if item.get("deadline"):
        parts.append(f"deadline {item['deadline_date'] or item['deadline']}")
    if item.get("scheduled"):
        parts.append(f"scheduled {item['scheduled_date'] or item['scheduled']}")
    if item.get("tags"):
        parts.append(":" + ":".join(item["tags"]) + ":")
    return " ".join(parts)


def clean_signal_dict(signals: dict) -> dict:
    return {
        key: value
        for key, value in signals.items()
        if value not in (None, "", 0, [], {})
    }


def extract_document_signals(path: pathlib.Path, text: str) -> dict:
    signals = {
        "format": "org" if path.suffix.lower() == ".org" else "",
        "headline_count": 0,
        "task_count": 0,
        "active_task_count": 0,
        "done_task_count": 0,
        "priorities": {},
        "headlines": [],
        "tasks": [],
        "task_items": [],
        "deadlines": [],
        "scheduled": [],
    }
    current_task = None
    for line in text.splitlines():
        stripped = line.strip()
        headline = parse_org_headline(stripped)
        if headline is not None:
            rendered = format_org_headline_signal(headline)
            signals["headline_count"] += 1
            append_limited(signals["headlines"], rendered, 40)
            current_task = None
            todo = headline.get("todo", "")
            if todo:
                signals["task_count"] += 1
                if active_org_todo(todo):
                    signals["active_task_count"] += 1
                else:
                    signals["done_task_count"] += 1
                priority = headline.get("priority", "")
                if priority:
                    signals["priorities"][priority] = signals["priorities"].get(priority, 0) + 1
                append_limited(signals["tasks"], rendered, 60)
                current_task = append_task_item(signals["task_items"], task_item_from_headline(headline), 80)
        if "DEADLINE:" in stripped:
            append_limited(signals["deadlines"], stripped, 30)
            if current_task is not None:
                current_task["deadline"] = stripped
                current_task["deadline_date"] = org_timestamp_date(stripped)
        if "SCHEDULED:" in stripped:
            append_limited(signals["scheduled"], stripped, 30)
            if current_task is not None:
                current_task["scheduled"] = stripped
                current_task["scheduled_date"] = org_timestamp_date(stripped)
    return clean_signal_dict(signals)


def merge_signal_sets(signal_sets: list[dict], *, limit: int = 80) -> dict:
    merged = {
        "headline_count": 0,
        "task_count": 0,
        "active_task_count": 0,
        "done_task_count": 0,
        "priorities": {},
        "headlines": [],
        "tasks": [],
        "task_items": [],
        "deadlines": [],
        "scheduled": [],
    }
    for signals in signal_sets:
        if not signals:
            continue
        for key in ["headline_count", "task_count", "active_task_count", "done_task_count"]:
            merged[key] += int(signals.get(key, 0) or 0)
        for priority, count in (signals.get("priorities") or {}).items():
            merged["priorities"][priority] = merged["priorities"].get(priority, 0) + int(count or 0)
        for key in ["headlines", "tasks", "deadlines", "scheduled"]:
            for value in signals.get(key, []) or []:
                append_limited(merged[key], value, limit)
        for item in signals.get("task_items", []) or []:
            if len(merged["task_items"]) < limit:
                merged["task_items"].append(dict(item))
    return clean_signal_dict(merged)


def file_signals_from_chunks(chunks: list[dict]) -> dict:
    return merge_signal_sets([chunk.get("signals") or {} for chunk in chunks])


def corpus_signals_from_files(files: list[dict]) -> dict:
    rows = []
    for file_item in files:
        signals = file_item.get("signals") or {}
        if not signals:
            continue
        path = file_item.get("path", "")
        prefixed = dict(signals)
        for key in ["headlines", "tasks", "deadlines", "scheduled"]:
            prefixed[key] = [f"{path}: {item}" for item in signals.get(key, []) or []]
        prefixed["task_items"] = [
            dict(item, path=path)
            for item in signals.get("task_items", []) or []
        ]
        rows.append(prefixed)
    return merge_signal_sets(rows, limit=120)


def format_signal_summary(signals: dict, *, limit: int = 20) -> str:
    if not signals:
        return ""
    lines = []
    task_bits = []
    if signals.get("active_task_count"):
        task_bits.append(f"{signals.get('active_task_count')} active")
    if signals.get("done_task_count"):
        task_bits.append(f"{signals.get('done_task_count')} done")
    if signals.get("task_count") and not task_bits:
        task_bits.append(f"{signals.get('task_count')} task(s)")
    if task_bits:
        lines.append("tasks: " + ", ".join(task_bits))
    priorities = signals.get("priorities") or {}
    if priorities:
        lines.append("priorities: " + ", ".join(f"{key}:{priorities[key]}" for key in sorted(priorities)))
    task_items = signals.get("task_items") or []
    if task_items:
        lines.append("task candidates:")
        lines.extend(f"- {format_task_item(item)}" for item in task_items[:limit])
        return "\n".join(lines)
    for label, key in [("deadlines", "deadlines"), ("scheduled", "scheduled"), ("task headlines", "tasks")]:
        values = signals.get(key) or []
        if values:
            lines.append(f"{label}:")
            lines.extend(f"- {value}" for value in values[:limit])
    return "\n".join(lines)


def task_signal_boost(query: str, signals: dict) -> int:
    if not query_wants_task_context(query) or not signals:
        return 0
    priorities = signals.get("priorities") or {}
    boost = int(signals.get("active_task_count", 0) or 0) * 3
    boost += len(signals.get("deadlines", []) or []) * 2
    boost += len(signals.get("scheduled", []) or [])
    boost += int(priorities.get("A", 0) or 0) * 4
    boost += int(priorities.get("B", 0) or 0) * 2
    return min(boost, 30)


def query_target_date(query: str) -> _dt.date | None:
    terms = set(token_counts(query))
    today = _dt.date.today()
    if "tomorrow" in terms:
        return today + _dt.timedelta(days=1)
    if "today" in terms:
        return today
    match = re.search(r"\b(\d{4}-\d{2}-\d{2})\b", query)
    if match:
        try:
            return _dt.date.fromisoformat(match.group(1))
        except ValueError:
            return None
    return None


def parse_iso_date(value: str) -> _dt.date | None:
    if not value:
        return None
    try:
        return _dt.date.fromisoformat(value)
    except ValueError:
        return None


def task_item_rank(item: dict, query: str) -> int:
    score = 0
    todo = str(item.get("todo", ""))
    if active_org_todo(todo):
        score += 30
    elif todo:
        score -= 20
    priority = str(item.get("priority", "")).upper()
    score += {"A": 40, "B": 24, "C": 10}.get(priority, 0)
    target = query_target_date(query)
    for key, exact_bonus, near_bonus in [
        ("deadline_date", 35, 18),
        ("scheduled_date", 25, 12),
    ]:
        date_value = parse_iso_date(str(item.get(key, "")))
        if date_value is None:
            continue
        if target is not None:
            delta = (date_value - target).days
            if delta == 0:
                score += exact_bonus
            elif -7 <= delta < 0:
                score += near_bonus
            elif 0 < delta <= 7:
                score += max(4, near_bonus // 2)
        else:
            score += 8
    score += score_text(token_counts(query), " ".join(str(item.get(key, "")) for key in ["title", "todo", "priority", "path"]))
    return score


def ranked_task_items_from_index(index: dict, query: str, *, limit: int = 20) -> list[tuple[int, dict]]:
    rows = []
    for file_item in index.get("files", []):
        path = file_item.get("path", "")
        for item in (file_item.get("signals") or {}).get("task_items", []) or []:
            row = dict(item)
            row.setdefault("path", path)
            rows.append((task_item_rank(row, query), row))
    rows.sort(key=lambda row: row[0], reverse=True)
    return [row for row in rows[:limit] if row[0] > -10]


def format_ranked_task_items(index: dict, query: str, *, limit: int = 16) -> str:
    rows = ranked_task_items_from_index(index, query, limit=limit)
    if not rows:
        return ""
    lines = []
    for _score, item in rows:
        lines.append(f"- {format_task_item(item)}")
    return "\n".join(lines)


def split_text(text: str, size: int = INDEX_CHUNK_CHARS) -> list[str]:
    chunks = []
    start = 0
    while start < len(text):
        end = min(len(text), start + size)
        if end < len(text):
            boundary = text.rfind("\n\n", start, end)
            if boundary > start + size // 2:
                end = boundary
        chunks.append(text[start:end].strip())
        start = end
    return [chunk for chunk in chunks if chunk]


def sha256_hex(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def sha256_file(path: pathlib.Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as fh:
        for chunk in iter(lambda: fh.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def source_fingerprint(path: pathlib.Path) -> dict:
    stat = path.stat()
    return {
        "size": stat.st_size,
        "mtime_ns": stat.st_mtime_ns,
        "sha256": sha256_file(path),
    }


def file_staleness(file_item: dict) -> tuple[str, list[str]]:
    path = pathlib.Path(file_item.get("path", "")).expanduser()
    expected = file_item.get("source_fingerprint") or {}
    if not expected:
        return "unknown", [f"{path}: no fingerprint stored; rebuild index to enable stale checks"]
    if not path.exists():
        return "stale", [f"{path}: missing"]
    try:
        current_stat = path.stat()
    except OSError as exc:
        return "stale", [f"{path}: cannot stat file: {exc}"]

    warnings = []
    if current_stat.st_size != expected.get("size"):
        warnings.append(
            f"{path}: size changed from {expected.get('size')} to {current_stat.st_size}"
        )
    if current_stat.st_mtime_ns != expected.get("mtime_ns"):
        warnings.append(f"{path}: mtime changed")
    if warnings:
        try:
            current_hash = sha256_file(path)
            if current_hash == expected.get("sha256"):
                return "mtime-only", [f"{path}: metadata changed but content hash still matches"]
            warnings.append(f"{path}: content hash changed")
        except OSError as exc:
            warnings.append(f"{path}: cannot hash current file: {exc}")
        return "stale", warnings
    return "fresh", []


def index_staleness(index: dict) -> tuple[str, list[str]]:
    statuses = []
    warnings = []
    for file_item in index.get("files", []):
        status, file_warnings = file_staleness(file_item)
        statuses.append(status)
        warnings.extend(file_warnings)
    if not statuses:
        return "empty", ["index has no files"]
    if "stale" in statuses:
        return "stale", warnings
    if "unknown" in statuses:
        return "unknown", warnings
    if "mtime-only" in statuses:
        return "metadata-changed", warnings
    artifact_warnings = index_artifact_warnings(index)
    if artifact_warnings:
        return "stale", warnings + artifact_warnings
    return "fresh", warnings


def quiet_model(
    messages: list[dict],
    *,
    temperature: float = 0.2,
    timeout: float = MODEL_TIMEOUT_SECONDS,
) -> str:
    return call_model(
        messages,
        temperature=temperature,
        stream=False,
        echo=False,
        timeout=timeout,
    ).strip()


def summarize_text(label: str, text: str, instruction: str) -> str:
    clipped = text[:SUMMARY_INPUT_CHARS]
    prompt = textwrap.dedent(
        f"""
        {instruction}

        Label: {label}

        Text:
        {clipped}
        """
    ).strip()
    return quiet_model(
        [
            {
                "role": "system",
                "content": "Create compact, faithful summaries for retrieval. Do not invent facts.",
            },
            {"role": "user", "content": prompt},
        ],
        temperature=0.2,
    )


def chunk_content_relpath(index_id: str, ordinal: int, chunk_idx: int) -> str:
    return f"{index_id}.chunks/{ordinal:06d}-{chunk_idx:06d}.txt"


def chunk_content_path(index: dict, chunk: dict) -> pathlib.Path | None:
    relpath = chunk.get("content_path")
    if not relpath:
        return None
    base = indexes_dir().resolve()
    candidate = (base / relpath).resolve()
    if candidate != base and not is_under(candidate, base):
        raise ValueError(f"chunk content path escapes Motoko index state: {relpath}")
    return candidate


def read_chunk_content(index: dict, chunk: dict) -> str:
    if "content" in chunk:
        return chunk.get("content", "")
    try:
        path = chunk_content_path(index, chunk)
    except ValueError:
        return ""
    if path is None:
        if chunk.get("duplicate_of_existing_index") and chunk.get("content_sha256"):
            return find_existing_chunk_content(chunk.get("content_sha256", ""), skip_index_id=index.get("id", ""))
        return ""
    try:
        return path.read_text(encoding="utf-8")
    except OSError:
        return ""


def direct_chunk_content(index: dict, chunk: dict) -> str:
    if "content" in chunk and not chunk.get("duplicate_of_existing_index"):
        return chunk.get("content", "")
    try:
        path = chunk_content_path(index, chunk)
    except ValueError:
        return ""
    if path is None:
        return ""
    try:
        return path.read_text(encoding="utf-8")
    except OSError:
        return ""


def find_existing_chunk_content(digest: str, *, skip_index_id: str = "") -> str:
    if not digest:
        return ""
    for index in list_indexes():
        if skip_index_id and index.get("id") == skip_index_id:
            continue
        for file_item in index.get("files", []):
            for chunk in file_item.get("chunks", []):
                if chunk.get("content_sha256") != digest:
                    continue
                text = direct_chunk_content(index, chunk)
                if text:
                    return text
    return ""


def existing_index_chunk_cache(root: pathlib.Path | None = None) -> dict[str, str]:
    cache = {}
    for index in list_indexes():
        if root is not None:
            try:
                index_root = pathlib.Path(index.get("root", "")).expanduser().resolve()
            except OSError:
                index_root = None
            if index_root is not None and index_root != root:
                continue
        cache.update(chunk_index_cache(index))
    return cache


def chunk_index_cache(index: dict) -> dict[str, str]:
    cache = {}
    for file_item in index.get("files", []):
        for chunk in file_item.get("chunks", []):
            digest = chunk.get("content_sha256")
            if not digest or digest in cache:
                continue
            text = direct_chunk_content(index, chunk)
            if text:
                cache[digest] = text
    return cache


def index_artifact_warnings(index: dict) -> list[str]:
    warnings = []
    for file_item in index.get("files", []):
        for chunk in file_item.get("chunks", []):
            if "content" in chunk:
                continue
            try:
                path = chunk_content_path(index, chunk)
            except ValueError as exc:
                warnings.append(str(exc))
                continue
            if path is None:
                if chunk.get("duplicate_of_existing_index") and find_existing_chunk_content(
                    chunk.get("content_sha256", ""),
                    skip_index_id=index.get("id", ""),
                ):
                    continue
                warnings.append(
                    f"{file_item.get('path', '')}: chunk {chunk.get('chunk')} has no stored content"
                )
            elif not path.exists():
                warnings.append(
                    f"{file_item.get('path', '')}: missing stored chunk {chunk.get('chunk')}"
                )
    return warnings


def reserve_index_bytes(
    budget: dict,
    next_bytes: int,
    *,
    path: pathlib.Path,
    chunk_idx: int,
) -> None:
    max_bytes = budget["max_bytes"]
    used = budget["used_bytes"]
    if used + next_bytes > max_bytes:
        raise SystemExit(
            "Motoko stopped before writing more derived index text: "
            f"budget {human_bytes(max_bytes)}, already written {human_bytes(used)}, "
            f"next chunk {human_bytes(next_bytes)} from {path} chunk {chunk_idx}. "
            "Narrow the index with --glob or set MOTOKO_MAX_DERIVED_INDEX_BYTES "
            "to a reviewed larger value."
        )
    budget["used_bytes"] = used + next_bytes


def write_index_chunk(
    index_id: str,
    ordinal: int,
    chunk_idx: int,
    content: str,
    budget: dict,
    source_path: pathlib.Path,
) -> tuple[str, int]:
    relpath = chunk_content_relpath(index_id, ordinal, chunk_idx)
    path = indexes_dir() / relpath
    content_bytes = len(content.encode("utf-8"))
    reserve_index_bytes(budget, content_bytes, path=source_path, chunk_idx=chunk_idx)
    ensure_private_dir(path.parent)
    atomic_write(path, content)
    return relpath, content_bytes


def dedup_chunk_from_existing(
    path: pathlib.Path,
    ordinal: int,
    chunk_idx: int,
    content: str,
    existing_chunks: dict[str, str],
) -> dict | None:
    digest = sha256_hex(content.encode("utf-8"))
    existing_content = existing_chunks.get(digest)
    if existing_content is None:
        return None
    print(f"  reusing duplicate chunk {path} chunk {chunk_idx}", flush=True)
    return {
        "id": f"{ordinal}.{chunk_idx}",
        "path": str(path),
        "chunk": chunk_idx,
        "summary": "Duplicate chunk already seen in a previous Motoko index; retrieval reuses the existing stored chunk text.",
        "duplicate_of_existing_index": True,
        "content_sha256": digest,
        "content_bytes": len(content.encode("utf-8")),
        "stored_content_bytes": 0,
    }


def summarize_and_store_chunk(
    path: pathlib.Path,
    index_id: str,
    ordinal: int,
    chunk_idx: int,
    content: str,
    budget: dict,
    existing_chunks: dict[str, str] | None = None,
    progress: dict | None = None,
    progress_callback=None,
) -> dict | None:
    content = content.strip()
    if not content:
        return None
    if existing_chunks:
        duplicate = dedup_chunk_from_existing(
            path,
            ordinal,
            chunk_idx,
            content,
            existing_chunks,
        )
        if duplicate is not None:
            return duplicate
    label = f"{path} chunk {chunk_idx}"
    print(f"  summarizing {label}", flush=True)
    if progress is not None:
        progress["current_chunk"] = chunk_idx
    index_progress_begin_model(progress, "summarizing chunk", label, progress_callback)
    summary = summarize_text(
        label,
        content[:SUMMARY_INPUT_CHARS],
        "Summarize this document chunk in 4-8 dense bullets. Preserve names, dates, decisions, obligations, and unusual details.",
    )
    index_progress_finish_model(progress, progress_callback, chunk_done=True)
    relpath, content_bytes = write_index_chunk(index_id, ordinal, chunk_idx, content, budget, path)
    item = {
        "id": f"{ordinal}.{chunk_idx}",
        "path": str(path),
        "chunk": chunk_idx,
        "summary": summary,
        "content_path": relpath,
        "content_bytes": content_bytes,
        "stored_content_bytes": content_bytes,
        "content_sha256": sha256_hex(content.encode("utf-8")),
    }
    signals = extract_document_signals(path, content)
    if signals:
        item["signals"] = signals
    return item


def stream_index_file(
    path: pathlib.Path,
    index_id: str,
    ordinal: int,
    budget: dict,
    existing_chunks: dict[str, str] | None = None,
    progress: dict | None = None,
    progress_callback=None,
) -> tuple[dict, list[dict], int]:
    stat = path.stat()
    digest = hashlib.sha256()
    decoder = codecs.getincrementaldecoder("utf-8")(errors="replace")
    buffer = ""
    indexed_chunks = []
    chunk_idx = 0
    derived_content_bytes = 0

    def emit(text: str) -> None:
        nonlocal chunk_idx, derived_content_bytes
        chunk = text.strip()
        if not chunk:
            return
        chunk_idx += 1
        item = summarize_and_store_chunk(
            path,
            index_id,
            ordinal,
            chunk_idx,
            chunk,
            budget,
            existing_chunks,
            progress,
            progress_callback,
        )
        if item is not None:
            derived_content_bytes += item.get("stored_content_bytes", item.get("content_bytes", 0))
            indexed_chunks.append(item)

    with path.open("rb") as fh:
        for raw in iter(lambda: fh.read(1024 * 1024), b""):
            digest.update(raw)
            buffer += decoder.decode(raw)
            while len(buffer) >= INDEX_CHUNK_CHARS:
                end = INDEX_CHUNK_CHARS
                boundary = buffer.rfind("\n\n", 0, end)
                if boundary > INDEX_CHUNK_CHARS // 2:
                    end = boundary + 2
                if end <= 0:
                    end = INDEX_CHUNK_CHARS
                emit(buffer[:end])
                buffer = buffer[end:]
    buffer += decoder.decode(b"", final=True)
    emit(buffer)

    fingerprint = {
        "size": stat.st_size,
        "mtime_ns": stat.st_mtime_ns,
        "sha256": digest.hexdigest(),
    }
    return fingerprint, indexed_chunks, derived_content_bytes


def chunk_blocks_by_chars(blocks: list[str], max_chars: int) -> list[list[str]]:
    batches = []
    current = []
    current_len = 0
    for block in blocks:
        block = block.strip()
        if not block:
            continue
        if len(block) > max_chars:
            block = block[:max_chars]
        next_len = current_len + len(block) + (2 if current else 0)
        if current and next_len > max_chars:
            batches.append(current)
            current = []
            current_len = 0
        current.append(block)
        current_len += len(block) + (2 if current_len else 0)
    if current:
        batches.append(current)
    return batches


def summarize_blocks(
    label: str,
    blocks: list[str],
    instruction: str,
    progress: dict | None = None,
    progress_callback=None,
    phase: str = "summarizing",
) -> str:
    pending = [block.strip() for block in blocks if block.strip()]
    if not pending:
        index_progress_begin_model(progress, phase, label, progress_callback)
        result = summarize_text(label, "", instruction)
        index_progress_finish_model(progress, progress_callback)
        return result

    def summarize_with_progress(model_label: str, text: str, model_instruction: str) -> str:
        index_progress_begin_model(progress, phase, model_label, progress_callback)
        result = summarize_text(model_label, text, model_instruction)
        index_progress_finish_model(progress, progress_callback)
        return result

    round_no = 1
    while True:
        combined = "\n\n".join(pending)
        if len(combined) <= SUMMARY_INPUT_CHARS or len(pending) == 1 or round_no > 8:
            return summarize_with_progress(label, combined, instruction)

        batches = chunk_blocks_by_chars(pending, SUMMARY_INPUT_CHARS)
        reduced = []
        for idx, batch in enumerate(batches, 1):
            batch_label = f"{label} summary batch {idx}/{len(batches)} round {round_no}"
            print(f"  reducing {batch_label}", flush=True)
            reduced.append(
                summarize_with_progress(
                    batch_label,
                    "\n\n".join(batch),
                    "Summarize this batch faithfully for a higher-level retrieval summary. Preserve names, dates, decisions, obligations, and unusual details.",
                )
            )
        if len(reduced) >= len(pending):
            return summarize_with_progress(label, "\n\n".join(reduced), instruction)
        pending = reduced
        round_no += 1


def index_file(
    path: pathlib.Path,
    index_id: str,
    ordinal: int,
    budget: dict,
    existing_chunks: dict[str, str] | None = None,
    progress: dict | None = None,
    progress_callback=None,
) -> dict:
    fingerprint, indexed_chunks, derived_content_bytes = stream_index_file(
        path,
        index_id,
        ordinal,
        budget,
        existing_chunks,
        progress,
        progress_callback,
    )

    print(f"  summarizing file {path}", flush=True)
    file_summary = summarize_blocks(
        str(path),
        [f"Chunk {chunk['chunk']}:\n{chunk['summary']}" for chunk in indexed_chunks]
        or [""],
        "Create a file-level summary from these chunk summaries. Include what the file is about and when to retrieve it.",
        progress,
        progress_callback,
        "summarizing file",
    )
    index_progress_finish_file(progress, progress_callback)
    item = {
        "path": str(path),
        "source_fingerprint": fingerprint,
        "indexed_sha256": fingerprint["sha256"],
        "bytes_indexed": fingerprint["size"],
        "bytes_omitted": 0,
        "truncated": False,
        "chunk_count": len(indexed_chunks),
        "duplicate_chunk_count": sum(
            1 for chunk in indexed_chunks if chunk.get("duplicate_of_existing_index")
        ),
        "content_storage": "motoko-state-chunks-v1",
        "derived_content_bytes": derived_content_bytes,
        "summary": file_summary,
        "chunks": indexed_chunks,
    }
    signals = file_signals_from_chunks(indexed_chunks)
    if signals:
        item["signals"] = signals
    return item


def build_document_index(
    path: str,
    pattern: str | None = AUTO_INDEX_GLOB,
    name: str | None = None,
    max_derived_bytes: str | None = None,
    progress_callback=None,
) -> dict:
    require_permission("index")
    root = pathlib.Path(path).expanduser().resolve()
    require_allowed(root)
    if not root.exists():
        raise SystemExit(f"not a file or directory: {root}")
    candidates = apply_index_limits(iter_index_candidates(root, pattern))
    if not candidates:
        raise SystemExit(f"no ingestible text files matched {pattern or AUTO_INDEX_GLOB} under {root}")

    index_id = _dt.datetime.now().strftime("%Y%m%d-%H%M%S") + "-" + uuid.uuid4().hex[:6]
    budget = {
        "max_bytes": max_derived_index_bytes(max_derived_bytes),
        "used_bytes": 0,
    }
    files = []
    print(f"Building document index {index_id} from {len(candidates)} file(s).")
    print(f"Derived index text budget: {human_bytes(budget['max_bytes'])}.")
    progress = begin_index_progress(index_id, root, pattern, name, candidates, progress_callback)
    existing_chunks = existing_index_chunk_cache(root)
    if existing_chunks:
        print(f"Duplicate-aware indexing: {len(existing_chunks)} existing chunk(s) available for reuse.")
    saved = False
    try:
        for idx, candidate in enumerate(candidates, 1):
            try:
                print(f"[{idx}/{len(candidates)}] indexing {candidate}", flush=True)
                index_progress_begin_file(progress, candidate, idx, progress_callback)
                files.append(
                    index_file(
                        candidate,
                        index_id,
                        idx,
                        budget,
                        existing_chunks,
                        progress,
                        progress_callback,
                    )
                )
            except OSError as exc:
                print(f"  skipped {candidate}: {exc}", file=sys.stderr)

        print("  summarizing corpus", flush=True)
        corpus_summary = summarize_blocks(
            str(root),
            [f"{item['path']}:\n{item['summary']}" for item in files],
            "Create a corpus-level map from these file summaries. Explain the main themes and which files matter for which questions.",
            progress,
            progress_callback,
            "summarizing corpus",
        )
        corpus_signals = corpus_signals_from_files(files)
        index = {
            "id": index_id,
            "name": name or root.name or str(root),
            "root": str(root),
            "glob": pattern or AUTO_INDEX_GLOB,
            "selection": "auto-text-v1" if (pattern or AUTO_INDEX_GLOB) == AUTO_INDEX_GLOB else "glob-text-v1",
            "created": now(),
            "technique": "hierarchical retrieval-augmented generation",
            "content_storage": "motoko-state-chunks-v1",
            "derived_content_budget_bytes": budget["max_bytes"],
            "derived_content_bytes": sum(item.get("derived_content_bytes", 0) for item in files),
            "duplicate_chunk_count": sum(item.get("duplicate_chunk_count", 0) for item in files),
            "corpus_summary": corpus_summary,
            "files": files,
        }
        if corpus_signals:
            index["signals"] = corpus_signals
            index["signal_summary"] = format_signal_summary(corpus_signals, limit=30)
        atomic_write(index_path(index_id), json.dumps(index, ensure_ascii=False, indent=2) + "\n")
        saved = True
        finish_index_progress(progress, "completed", progress_callback)
        print(f"index saved: {index_id}")
        return index
    except BaseException as exc:
        finish_index_progress(progress, "failed", progress_callback, error=f"{type(exc).__name__}: {exc}")
        raise
    finally:
        if not saved:
            shutil.rmtree(index_data_dir(index_id), ignore_errors=True)


def build_document_index_quiet(
    path: str,
    pattern: str | None = AUTO_INDEX_GLOB,
    name: str | None = None,
    max_derived_bytes: str | None = None,
    progress_callback=None,
) -> dict:
    buf = io.StringIO()
    with contextlib.redirect_stdout(buf), contextlib.redirect_stderr(buf):
        return build_document_index(path, pattern, name, max_derived_bytes, progress_callback)


def context_item_from_index(index: dict) -> dict:
    status, warnings = index_staleness(index)
    summary = index.get("corpus_summary", "")
    signal_summary = index.get("signal_summary", "")
    if signal_summary:
        summary = (summary + "\n\nStructured signals:\n" + signal_summary).strip()
    return {
        "kind": "index",
        "id": index["id"],
        "name": index.get("name", index["id"]),
        "root": index.get("root", ""),
        "status": status,
        "warnings": warnings[:5],
        "summary": summary,
    }


def context_item_from_topic(topic: dict) -> dict:
    return {
        "kind": "topic",
        "id": topic["id"],
        "name": topic.get("name", topic["id"]),
        "query": topic.get("query", ""),
        "summary": topic.get("summary", ""),
    }


def context_item_from_dossier(dossier: dict) -> dict:
    return {
        "kind": "dossier",
        "id": dossier["id"],
        "name": dossier.get("name", dossier["id"]),
        "query": dossier.get("query", ""),
        "summary": dossier.get("summary", ""),
    }


def ranked_index_chunks(index: dict, query: str) -> list[tuple[int, dict, dict, str]]:
    query_counts = token_counts(query)
    rows = []
    for file_item in index.get("files", []):
        file_signal_text = format_signal_summary(file_item.get("signals") or {}, limit=12)
        for chunk in file_item.get("chunks", []):
            content = read_chunk_content(index, chunk)
            chunk_signal_text = format_signal_summary(chunk.get("signals") or {}, limit=12)
            haystack = "\n".join(
                [
                    file_item.get("path", ""),
                    file_item.get("summary", ""),
                    file_signal_text,
                    chunk.get("summary", ""),
                    chunk_signal_text,
                    content[:4000],
                ]
            )
            score = score_text(query_counts, haystack)
            score += task_signal_boost(query, file_item.get("signals") or {})
            score += task_signal_boost(query, chunk.get("signals") or {})
            rows.append((score, file_item, chunk, content))
    rows.sort(key=lambda row: row[0], reverse=True)
    return rows


def wants_deep_context(query: str) -> bool:
    terms = set(token_counts(query))
    return bool(terms & DEEP_RETRIEVAL_TERMS)


def retrieval_limits(query: str) -> tuple[int, int, int]:
    if wants_deep_context(query):
        return RETRIEVAL_TOP_FILES * 2, RETRIEVAL_TOP_CHUNKS * 3, MAX_RETRIEVAL_CHARS * 2
    return RETRIEVAL_TOP_FILES, RETRIEVAL_TOP_CHUNKS, MAX_RETRIEVAL_CHARS


def build_topic_dossier(
    index_ids: list[str],
    query: str,
    *,
    name: str | None = None,
    max_chunks: int = TOPIC_DEFAULT_CHUNKS,
) -> dict:
    query = query.strip()
    if not query:
        raise SystemExit("topic query is empty")
    if not index_ids:
        raise SystemExit("topic dossier needs at least one document index")
    max_chunks = max(1, min(max_chunks, TOPIC_MAX_CHUNKS))

    selected_rows = []
    source_indexes = []
    for index_id in index_ids:
        index = load_index(index_id)
        status, warnings = index_staleness(index)
        source_indexes.append(
            {
                "id": index.get("id", index_id),
                "name": index.get("name", ""),
                "root": index.get("root", ""),
                "status_at_build": status,
                "warnings_at_build": warnings[:8],
            }
        )
        for score, file_item, chunk, content in ranked_index_chunks(index, query):
            selected_rows.append((score, index, file_item, chunk, content))

    selected_rows.sort(key=lambda row: row[0], reverse=True)
    positive_rows = [row for row in selected_rows if row[0] > 0]
    selected_rows = (positive_rows or selected_rows)[:max_chunks]
    if not selected_rows:
        raise SystemExit("no chunks available in the selected index(es)")

    topic_id = _dt.datetime.now().strftime("%Y%m%d-%H%M%S") + "-" + uuid.uuid4().hex[:6]
    evidence = []
    blocks = []
    for score, index, file_item, chunk, content in selected_rows:
        excerpt = content[:TOPIC_EXCERPT_CHARS]
        evidence_item = {
            "index": index.get("id", ""),
            "index_name": index.get("name", ""),
            "path": file_item.get("path", ""),
            "chunk": chunk.get("chunk"),
            "score": score,
            "chunk_summary": chunk.get("summary", ""),
            "file_summary": file_item.get("summary", ""),
            "excerpt": excerpt,
            "excerpt_sha256": sha256_hex(excerpt.encode("utf-8")),
        }
        evidence.append(evidence_item)
        blocks.append(
            textwrap.dedent(
                f"""
                Source: index={evidence_item['index']} file={evidence_item['path']} chunk={evidence_item['chunk']} score={score}
                File summary:
                {evidence_item['file_summary']}

                Chunk summary:
                {evidence_item['chunk_summary']}

                Excerpt:
                {excerpt}
                """
            ).strip()
        )

    print(f"Building topic dossier {topic_id} from {len(evidence)} chunk(s).")
    summary = summarize_blocks(
        f"topic dossier: {query}",
        blocks,
        textwrap.dedent(
            """
            Create a detailed topic dossier from these retrieved source chunks.
            Use headings: Overview, Detailed Findings, Source Map, Tensions Or
            Uncertainties, Follow-up Questions. Ground claims in the supplied
            excerpts and source paths. Do not invent facts.
            """
        ).strip(),
    )
    topic = {
        "id": topic_id,
        "name": name or slug_title(query),
        "query": query,
        "created": now(),
        "technique": "topic-focused hierarchical retrieval-augmented dossier",
        "source_indexes": source_indexes,
        "selected_chunk_count": len(evidence),
        "summary": summary,
        "evidence": evidence,
    }
    atomic_write(topic_path(topic_id), json.dumps(topic, ensure_ascii=False, indent=2) + "\n")
    print(f"topic saved: {topic_id}")
    return topic


def build_memory_dossier(query: str, *, name: str | None = None) -> dict:
    query = query.strip()
    if not query:
        raise SystemExit("dossier query is empty")

    seed_conv = {
        "id": "",
        "title": query,
        "summary": "",
        "messages": [{"role": "user", "content": query}],
    }
    memories = ranked_memories(
        conv=seed_conv,
        query=query,
        limit=MEMORY_DOSSIER_SOURCE_MEMORIES,
    )
    conversations = ranked_recent_conversations(seed_conv, query)[:MEMORY_DOSSIER_SOURCE_CONVERSATIONS]
    profile = load_profile_dossier()

    if not memories and not conversations and not profile:
        raise SystemExit("dossier needs saved memories, prior conversations, or a profile dossier")

    dossier_id = _dt.datetime.now().strftime("%Y%m%d-%H%M%S") + "-" + uuid.uuid4().hex[:6]
    source_memories = []
    source_conversations = []
    blocks = []
    used = 0

    if profile:
        profile_text = profile.get("text", "")[:MEMORY_DOSSIER_EXCERPT_CHARS]
        blocks.append(f"Profile dossier updated {profile.get('updated', '')}:\n{profile_text}")
        used += len(blocks[-1])

    for row in memories:
        if used >= MEMORY_DOSSIER_MAX_SOURCE_CHARS:
            break
        text = row.get("text", "")[:MEMORY_DOSSIER_EXCERPT_CHARS]
        item = {
            "id": row.get("id", ""),
            "source": row.get("source", "unknown"),
            "conversation_id": row.get("conversation_id", ""),
            "created": row.get("created", ""),
            "importance": row.get("importance", MEMORY_DEFAULT_IMPORTANCE),
            "pinned": bool(row.get("pinned")),
            "score": row.get("_score", 0),
            "matched_terms": row.get("_matched_terms", 0),
            "excerpt": text,
        }
        source_memories.append(item)
        block = (
            f"Memory {item['id']} importance={item['importance']} "
            f"score={item['score']} match={item['matched_terms']}:\n{text}"
        )
        blocks.append(block)
        used += len(block)

    for row in conversations:
        if used >= MEMORY_DOSSIER_MAX_SOURCE_CHARS:
            break
        recall = conversation_recall_text(row)[:MEMORY_DOSSIER_EXCERPT_CHARS]
        item = {
            "id": row.get("id", ""),
            "title": row.get("title", "Untitled"),
            "created": row.get("created", ""),
            "updated": row.get("updated", row.get("created", "")),
            "branch": row.get("branch", ""),
            "score": row.get("_recall_score", 0),
            "matched_terms": row.get("_matched_terms", 0),
            "selection": row.get("_selection_reasons", []),
            "excerpt": recall,
        }
        source_conversations.append(item)
        block = (
            f"Conversation {item['id']} title={item['title']} "
            f"updated={item['updated']} score={item['score']} "
            f"selection={','.join(item['selection']) or '-'}:\n{recall}"
        )
        blocks.append(block)
        used += len(block)

    print(
        f"Building memory dossier {dossier_id} from "
        f"{len(source_memories)} memor{'y' if len(source_memories) == 1 else 'ies'} "
        f"and {len(source_conversations)} conversation(s)."
    )
    summary = summarize_blocks(
        f"memory dossier: {query}",
        blocks,
        textwrap.dedent(
            """
            Create a query-focused private memory dossier from these supplied
            memories, profile notes, and conversation capsules. Use headings:
            Overview, Stable Facts, Relevant History, Tensions Or Uncertainties,
            Open Questions, Useful Next Context. Separate durable facts from
            tentative inferences. Do not invent facts.
            """
        ).strip(),
    )
    dossier = {
        "id": dossier_id,
        "name": name or slug_title(query),
        "query": query,
        "created": now(),
        "technique": "query-focused hierarchical retrieval over memories and conversations",
        "summary": summary,
        "profile_used": bool(profile),
        "source_memory_count": len(source_memories),
        "source_conversation_count": len(source_conversations),
        "source_memories": source_memories,
        "source_conversations": source_conversations,
    }
    atomic_write(dossier_path(dossier_id), json.dumps(dossier, ensure_ascii=False, indent=2) + "\n")
    print(f"dossier saved: {dossier_id}")
    return dossier


def attached_item_ids(conv: dict, kind: str) -> set[str]:
    return {
        item.get("id", "")
        for item in conv.get("context_items", [])
        if item.get("kind") == kind and item.get("id")
    }


def attach_context_item(conv: dict, item: dict) -> bool:
    existing = attached_item_ids(conv, item.get("kind", ""))
    if item.get("id") in existing:
        return False
    conv.setdefault("context_items", []).append(item)
    save_conversation(conv)
    return True


def replace_attached_index(conv: dict, old_index_id: str, new_index: dict) -> None:
    replacement = context_item_from_index(new_index)
    items = conv.setdefault("context_items", [])
    for idx, item in enumerate(items):
        if item.get("kind") == "index" and item.get("id") == old_index_id:
            items[idx] = replacement
            save_conversation(conv)
            return
    items.append(replacement)
    save_conversation(conv)


def read_heavy_study_state() -> dict:
    path = heavy_study_path()
    if not path.exists():
        return {"indexes": {}}
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return {"indexes": {}}
    return data if isinstance(data, dict) else {"indexes": {}}


def write_heavy_study_state(state: dict) -> None:
    state.setdefault("indexes", {})
    atomic_write(heavy_study_path(), json.dumps(state, ensure_ascii=False, indent=2) + "\n")
    heavy_study_path().chmod(0o600)


def heavy_index_key(index: dict) -> str:
    raw = "\0".join(
        [
            index.get("root", ""),
            index.get("glob", AUTO_INDEX_GLOB),
            index.get("name", ""),
        ]
    )
    return sha256_hex(raw.encode("utf-8"))[:16]


def heavy_index_cooldown_active(index: dict, state: dict) -> bool:
    key = heavy_index_key(index)
    record = state.get("indexes", {}).get(key, {})
    attempted = parse_timestamp(record.get("last_attempt", ""))
    if attempted is None:
        return False
    cooldown = env_seconds(
        "MOTOKO_BACKGROUND_HEAVY_INDEX_COOLDOWN",
        BACKGROUND_HEAVY_INDEX_COOLDOWN_SECONDS,
    )
    age = (_dt.datetime.now(_dt.timezone.utc).astimezone() - attempted.astimezone()).total_seconds()
    return age < cooldown


def mark_heavy_index_attempt(index: dict, state: dict, *, result: str, new_index_id: str = "") -> None:
    state.setdefault("indexes", {})[heavy_index_key(index)] = {
        "root": index.get("root", ""),
        "glob": index.get("glob", AUTO_INDEX_GLOB),
        "name": index.get("name", ""),
        "last_attempt": now(),
        "last_result": result,
        "new_index_id": new_index_id,
    }
    write_heavy_study_state(state)


def index_change_summary(index: dict) -> dict:
    status, warnings = index_staleness(index)
    root = pathlib.Path(index.get("root", "")).expanduser().resolve()
    pattern = index.get("glob") or AUTO_INDEX_GLOB
    known_paths = {
        str(pathlib.Path(file_item.get("path", "")).expanduser().resolve())
        for file_item in index.get("files", [])
        if file_item.get("path")
    }
    try:
        require_allowed(root)
        candidates = apply_index_limits(iter_index_candidates(root, pattern))
    except SystemExit as exc:
        return {
            "status": status,
            "warnings": warnings + [str(exc)],
            "new_files": [],
            "new_bytes": 0,
            "candidate_files": 0,
            "indexed_files": len(known_paths),
            "covered_files": 0,
            "missing_files": [],
            "coverage_score": 0,
        }
    current_paths = {str(candidate.resolve()): candidate for candidate in candidates}
    new_files = sorted(
        path for path_text, path in current_paths.items() if path_text not in known_paths
    )
    missing_paths = sorted(path_text for path_text in known_paths if path_text not in current_paths)
    covered_files = len(known_paths & set(current_paths))
    new_bytes = 0
    for path in new_files:
        try:
            new_bytes += path.stat().st_size
        except OSError:
            pass
    candidate_count = len(current_paths)
    indexed_count = len(known_paths)
    denominator = max(candidate_count, indexed_count, 1)
    coverage_score = int((covered_files / denominator) * 100)
    if status == "stale":
        coverage_score = min(coverage_score, 70)
    elif status in {"unknown", "empty"}:
        coverage_score = min(coverage_score, 40)
    return {
        "status": status,
        "warnings": warnings,
        "new_files": new_files,
        "new_bytes": new_bytes,
        "candidate_files": candidate_count,
        "indexed_files": indexed_count,
        "covered_files": covered_files,
        "missing_files": missing_paths,
        "coverage_score": coverage_score,
    }


def format_index_health(summary: dict) -> str:
    score = summary.get("coverage_score")
    if score is None:
        return "health ?"
    parts = [f"health {score}%"]
    new_files = len(summary.get("new_files", []) or [])
    missing_files = len(summary.get("missing_files", []) or [])
    if new_files:
        parts.append(f"new {new_files}")
    if missing_files:
        parts.append(f"missing {missing_files}")
    if summary.get("status") == "stale":
        parts.append("stale")
    return " ".join(parts)


def heavy_index_refresh_reason(summary: dict) -> str | None:
    if summary.get("status") == "stale":
        return "stale indexed source content"
    new_files = len(summary.get("new_files", []))
    new_bytes = int(summary.get("new_bytes", 0) or 0)
    min_files = env_int(
        "MOTOKO_BACKGROUND_HEAVY_INDEX_MIN_NEW_FILES",
        BACKGROUND_HEAVY_INDEX_MIN_NEW_FILES,
    )
    min_bytes = env_int(
        "MOTOKO_BACKGROUND_HEAVY_INDEX_MIN_NEW_BYTES",
        BACKGROUND_HEAVY_INDEX_MIN_NEW_BYTES,
    )
    if new_files >= min_files:
        return f"{new_files} new files"
    if new_bytes >= min_bytes:
        return f"{human_bytes(new_bytes)} of new files"
    return None


def refresh_heavy_attached_indexes(conv: dict, phase_callback=None) -> list[str]:
    if not env_flag("MOTOKO_BACKGROUND_HEAVY_INDEX", True):
        return []
    state = read_heavy_study_state()
    notes = []
    for item in list(conv.get("context_items", [])):
        if item.get("kind") != "index" or not item.get("id"):
            continue
        try:
            index = load_index(item.get("id"))
        except SystemExit as exc:
            notes.append(f"heavy index refresh skipped: {exc}")
            continue
        summary = index_change_summary(index)
        reason = heavy_index_refresh_reason(summary)
        if reason is None:
            new_files = len(summary.get("new_files", []))
            if new_files:
                name = index.get("name", index.get("id"))
                notes.append(f"{new_files} new file(s) below heavy index threshold for {name}")
            continue
        if heavy_index_cooldown_active(index, state):
            notes.append(f"heavy index refresh on cooldown for {index.get('name', index.get('id'))}")
            continue
        mark_heavy_index_attempt(index, state, result=f"started: {reason}")
        if phase_callback is not None:
            phase_callback("bg-heavy: indexing(model)")
        def on_progress(progress: dict) -> None:
            if phase_callback is not None:
                phase_callback(format_index_progress_status(progress))

        try:
            refreshed = build_document_index_quiet(
                index.get("root", ""),
                index.get("glob") or AUTO_INDEX_GLOB,
                index.get("name", ""),
                progress_callback=on_progress,
            )
            replace_attached_index(conv, index.get("id", ""), refreshed)
        except SystemExit as exc:
            mark_heavy_index_attempt(index, state, result=f"failed: {exc}")
            notes.append(f"heavy index refresh failed for {index.get('name', index.get('id'))}: {exc}")
            continue
        except Exception as exc:
            mark_heavy_index_attempt(index, state, result=f"failed: {type(exc).__name__}: {exc}")
            notes.append(f"heavy index refresh failed for {index.get('name', index.get('id'))}: {exc}")
            continue
        mark_heavy_index_attempt(index, state, result="refreshed", new_index_id=refreshed.get("id", ""))
        notes.append(
            f"heavy index refreshed {index.get('id')} -> {refreshed.get('id')} ({reason})"
        )
        break
    return notes


def cwd_learning_key(root: pathlib.Path, pattern: str = AUTO_INDEX_GLOB) -> str:
    raw = f"{root}\0{pattern or AUTO_INDEX_GLOB}"
