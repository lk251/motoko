    return "\n".join(lines)


def vector_plan_indexes(index_id: str | None = None) -> list[dict]:
    if index_id:
        return [load_index_exact(index_id)]
    return latest_indexes_by_family()


def index_vector_stats(indexes: list[dict]) -> dict:
    chunk_count = 0
    file_count = 0
    unique_digests: set[str] = set()
    duplicate_refs = 0
    chunk_summaries = 0
    file_summaries = 0
    logical_bytes = 0
    raw_embedding_rows = 0
    evidence_rows = 0
    input_chars = embedding_input_chars_limit()
    max_parts = embedding_max_parts_per_chunk()
    estimated_body_budget = max(120, int(input_chars * 0.55))
    for index in indexes:
        files = index.get("files", [])
        file_count += len(files)
        for file_item in files:
            if str(file_item.get("summary", "")).strip():
                file_summaries += 1
            for chunk in file_item.get("chunks", []):
                chunk_count += 1
                digest = str(chunk.get("content_sha256", "")).strip()
                if digest:
                    unique_digests.add(digest)
                if chunk.get("duplicate_of_existing_index"):
                    duplicate_refs += 1
                if str(chunk.get("summary", "")).strip():
                    chunk_summaries += 1
                content_bytes = safe_int(chunk.get("content_bytes"))
                logical_bytes += content_bytes
                estimated_rows = (max(content_bytes, 1) + estimated_body_budget - 1) // estimated_body_budget
                raw_embedding_rows += max(1, min(max_parts, estimated_rows))
                with contextlib.suppress(Exception):
                    evidence_rows += len(evidence_objects_for_chunk(index, file_item, chunk))
    return {
        "index_count": len(indexes),
        "file_count": file_count,
        "chunk_count": chunk_count,
        "unique_chunk_bodies": len(unique_digests) or chunk_count,
        "duplicate_reference_chunks": duplicate_refs,
        "raw_embedding_row_estimate": raw_embedding_rows,
        "evidence_row_estimate": evidence_rows,
        "chunk_summary_count": chunk_summaries,
        "file_summary_count": file_summaries,
        "logical_content_bytes": logical_bytes,
    }


def vector_row_plan(kind: str, rows: int, dims: int, *, source: str, invalidates_on: list[str]) -> dict:
    rows = max(0, int(rows or 0))
    dims = max(1, int(dims or DEFAULT_VECTOR_DIMS))
    vector_bytes = rows * dims * 4
    metadata_bytes = rows * 768
    return {
        "kind": kind,
        "rows": rows,
        "dims": dims,
        "vector_bytes": vector_bytes,
        "metadata_bytes": metadata_bytes,
        "estimated_bytes": vector_bytes + metadata_bytes,
        "source": source,
        "invalidates_on": invalidates_on,
    }


def vector_plan(index_id: str | None = None, *, dims: int = DEFAULT_VECTOR_DIMS, include_eval: bool = True) -> dict:
    dims = max(1, int(dims or DEFAULT_VECTOR_DIMS))
    indexes = vector_plan_indexes(index_id)
    stats = index_vector_stats(indexes)
    memories = read_memory_rows()
    conversations = list_conversations()
    topics = list_topics()
    dossiers = list_dossiers()
    row_plans = [
        vector_row_plan(
            "raw_chunk_embedding",
            stats["raw_embedding_row_estimate"],
            dims,
            source="bounded source-linked chunk/subchunk embedding rows",
            invalidates_on=["content_sha256", "embedding_model", "embedding_input_schema", "embedding_split_policy", "source_realm"],
        ),
        vector_row_plan(
            "evidence_embedding",
            stats["evidence_row_estimate"],
            dims,
            source="hierarchical evidence objects: Org days, tasks, headings, paragraphs, and source windows",
            invalidates_on=["evidence_schema", "evidence_input_schema", "content_sha256", "source_fingerprint", "embedding_model"],
        ),
        vector_row_plan(
            "chunk_summary_embedding",
            stats["chunk_summary_count"],
            dims,
            source="model-derived chunk summaries",
            invalidates_on=["artifact_schema", "summary_prompt_version", "source_fingerprint", "embedding_model"],
        ),
        vector_row_plan(
            "file_summary_embedding",
            stats["file_summary_count"],
            dims,
            source="model-derived file summaries",
            invalidates_on=["artifact_schema", "source_fingerprint", "embedding_model"],
        ),
        vector_row_plan(
            "file_label_embedding",
            stats["file_count"],
            dims,
            source="file paths, labels, roles, and deterministic signals",
            invalidates_on=["file_path", "signal_schema", "label_schema", "embedding_model"],
        ),
        vector_row_plan(
            "memory_embedding",
            len(memories),
            dims,
            source="durable memories in this Motoko realm",
            invalidates_on=["memory_id", "memory_updated", "embedding_model", "source_realm"],
        ),
        vector_row_plan(
            "conversation_summary_embedding",
            len(conversations),
            dims,
            source="saved conversation summaries and titles",
            invalidates_on=["conversation_id", "conversation_updated", "summary_schema", "embedding_model"],
        ),
        vector_row_plan(
            "topic_dossier_embedding",
            len(topics),
            dims,
            source="topic dossiers over indexed evidence",
            invalidates_on=["topic_id", "topic_schema", "source_fingerprint", "embedding_model"],
        ),
        vector_row_plan(
            "memory_dossier_embedding",
            len(dossiers),
            dims,
            source="memory/conversation dossiers",
            invalidates_on=["dossier_id", "dossier_schema", "memory_updated", "conversation_updated", "embedding_model"],
        ),
    ]
    storage_audit = index_storage_audit()
    retrieval_eval = run_retrieval_eval() if include_eval else {}
    embedding_routes = local_model_routes_for_capability(
        kind="embedding",
        tasks=EMBEDDING_TASKS,
        endpoint_path="/v1/embeddings",
    )
    reranker_routes = local_model_routes_for_capability(
        kind="reranker",
        tasks=RERANKER_TASKS,
        endpoint_path="/v1/rerank",
    )
    gates = [
        {
            "name": "retrieval_eval",
            "status": retrieval_eval.get("status", "not-run") if retrieval_eval else "not-run",
            "detail": f"{retrieval_eval.get('passed', 0)}/{retrieval_eval.get('total', 0)} synthetic fixtures pass"
            if retrieval_eval
            else "not run for this report",
        },
        {
            "name": "index_storage_audit",
            "status": "pass"
            if not storage_audit.get("missing_duplicate_target_count") and not storage_audit.get("missing_stored_chunk_count")
            else "warn",
            "detail": (
                f"{storage_audit.get('missing_duplicate_target_count', 0)} missing duplicate target(s), "
                f"{storage_audit.get('missing_stored_chunk_count', 0)} missing stored chunk(s)"
            ),
        },
        {
            "name": "embedding_route",
            "status": "available" if embedding_routes else "not-configured",
            "detail": ", ".join(
                f"{row.get('route', '')} dims={row.get('embedding_dimensions') or '?'} paths={','.join(row.get('endpoint_paths', [])) or '-'}"
                for row in embedding_routes
            )
            or "no catalog route advertises embedding tasks yet",
        },
        {
            "name": "reranker_route",
            "status": "available" if reranker_routes else "not-configured",
            "detail": ", ".join(
                f"{row.get('route', '')} paths={','.join(row.get('endpoint_paths', [])) or '-'}"
                for row in reranker_routes
            )
            or "no catalog route advertises reranker tasks yet",
        },
        {
            "name": "privacy_boundary",
            "status": "pass",
            "detail": f"store remains realm-local under {identity_realm()} Motoko state",
        },
    ]
    return {
        "schema": VECTOR_PLAN_SCHEMA_VERSION,
        "target_vector_schema": VECTOR_STORE_SCHEMA_VERSION,
        "created": now(),
