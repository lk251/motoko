        CWD_LEARN_DECLINE_COOLDOWN_SECONDS,
    )
    age = (_dt.datetime.now(_dt.timezone.utc).astimezone() - declined.astimezone()).total_seconds()
    return age < cooldown


def record_cwd_learning_decline(root: pathlib.Path, pattern: str = AUTO_INDEX_GLOB) -> None:
