def prepare_route_residency_for_request(route_info: dict, *, phase_callback=None) -> list[str]:
    if route_is_large_chat(route_info):
        return prepare_chat_route_residency(route_info, phase_callback=phase_callback)
    notes = prepare_declared_exclusive_lane_residency(route_info, phase_callback=phase_callback)
    notes.extend(prepare_worker_route_residency(route_info, phase_callback=phase_callback))
    return notes


@contextlib.contextmanager
def open_model_response(
    route_info: dict,
    payload: dict,
    *,
    timeout: float,
    cancel_event=None,
    on_connection=None,
    on_response=None,
    socket_activation_min_timeout: float | None = None,
    prepare_residency: bool = True,
):
    if prepare_residency:
        prepare_route_residency_for_request(route_info)
    with open_model_response_core(
        route_info,
        payload,
        timeout=timeout,
        unix_request_path=LOCAL_MODEL_UNIX_REQUEST_PATH,
        socket_activation_min_timeout=(
            SOCKET_ACTIVATION_MIN_TIMEOUT_SECONDS
            if socket_activation_min_timeout is None
            else socket_activation_min_timeout
        ),
        model_loading_retry_seconds=MODEL_LOADING_RETRY_SECONDS,
        cancel_event=cancel_event,
        on_connection=on_connection,
        on_response=on_response,
    ) as resp:
        yield resp


def call_model(
    messages: list[dict],
    *,
    temperature: float = 0.7,
    stream: bool = True,
    echo: bool = True,
    timeout: float = MODEL_TIMEOUT_SECONDS,
    route: str = MODEL_ROUTE_CHAT,
    source_count: int | None = None,
    sampling_preset: str | None = None,
    json_schema=None,
    grammar: str | None = None,
    reasoning_preset: str | None = None,
    thinking_budget_tokens: int | None = None,
    enable_thinking: bool | None = None,
    max_tokens: int | None = None,
    slot_cache_context: dict | None = None,
    cancel_event=None,
) -> str:
    route_info, governor = model_route_for_request(route, messages)
    effective_sampling_preset = selected_sampling_preset(
        route_info,
        route_info.get("route", route),
        explicit=sampling_preset,
        structured=json_schema is not None or bool(grammar),
    )
    effective_reasoning_preset = selected_reasoning_preset(
        route_info,
        route_info.get("route", route),
        explicit=reasoning_preset,
    )
    payload = chat_completion_payload(
        route_info,
        messages,
        temperature=temperature,
        stream=stream,
        sampling_preset=effective_sampling_preset,
        json_schema=json_schema,
        grammar=grammar,
        reasoning_preset=effective_reasoning_preset,
        thinking_budget_tokens=thinking_budget_tokens,
        enable_thinking=enable_thinking,
        max_tokens=max_tokens,
    )
    reasoning = {}
    if not effective_reasoning_preset:
        reasoning = apply_chat_reasoning_payload(payload, route_info)
    try:
        raise_if_cancelled(cancel_event)
        prepare_route_residency_for_request(route_info)
    except RouteResidencyBusy as exc:
        raise SystemExit(f"model request deferred: {exc}") from exc
    slot_context = None
    if slot_cache_context:
        slot_context = prepare_slot_cache_for_request(
            route_info,
            payload,
            conversation_id=str(slot_cache_context.get("conversation_id") or ""),
            client_namespace=str(slot_cache_context.get("client_namespace") or CHAT_SLOT_CACHE_NAMESPACE_VERSION),
        )
    request_metadata = model_request_metadata(
        route_info,
        payload,
        sampling_preset=effective_sampling_preset,
        reasoning_preset=effective_reasoning_preset,
        json_schema=json_schema,
        grammar=grammar,
    )
    started = time.monotonic()
    record = model_call_started_record(
        route_info,
        governor,
        source_count=source_count,
        stream=stream,
        temperature=temperature,
        request_metadata=request_metadata,
    )
    add_reasoning_to_model_call_record(record, reasoning)
    add_slot_cache_to_model_call_record(record, slot_context)
    write_last_model_call(record)
    spinner = ThinkingSpinner(enabled=echo)
    try:
        spinner.start()
        with open_model_response(
            route_info,
            payload,
            timeout=timeout,
            cancel_event=cancel_event,
            prepare_residency=False,
        ) as resp:
            if stream:
                reply = read_streaming_response(resp, echo=echo, spinner=spinner, cancel_event=cancel_event)
                if slot_context is not None:
                    slot_context = save_slot_cache_after_request_with_service_gc(route_info, slot_context)
                    add_slot_cache_to_model_call_record(record, slot_context)
                finish_model_call_record(record, started=started, completion_text=reply)
                return reply
            spinner.stop()
            raise_if_cancelled(cancel_event)
            reply = read_json_response(resp)
            raise_if_cancelled(cancel_event)
            if slot_context is not None:
                slot_context = save_slot_cache_after_request_with_service_gc(route_info, slot_context)
                add_slot_cache_to_model_call_record(record, slot_context)
            finish_model_call_record(record, started=started, completion_text=reply)
            return reply
    except (urllib.error.URLError, TimeoutError, OSError, http.client.HTTPException) as exc:
        finish_model_call_record(record, started=started, error=exc)
        if cancel_event is not None and cancel_event.is_set():
            raise RuntimeError("__motoko_stopped__") from exc
        hint = local_model_verify_hint(route_info)
        raise SystemExit(model_request_failure_detail("model request failed", exc, hint)) from exc
    except BaseException as exc:
        finish_model_call_record(record, started=started, error=exc)
        raise
    finally:
        spinner.stop()


def run_with_wall_timeout(label: str, wall_timeout: float, func, *args, **kwargs):
    result: list[object] = []
    errors: list[BaseException] = []

    def target() -> None:
        try:
            result.append(func(*args, **kwargs))
        except BaseException as exc:  # Preserve the original exception type.
            errors.append(exc)

    thread = threading.Thread(target=target, daemon=True)
    thread.start()
    thread.join(wall_timeout)
    if thread.is_alive():
        raise TimeoutError(f"{label} timed out after {int(wall_timeout)}s")
    if errors:
        raise errors[0]
    return result[0] if result else None


def motoko_program_path() -> str:
    source = pathlib.Path(__file__).resolve()
    if source.exists():
        return str(source)
    return sys.argv[0]


def memory_proposal_helper_timeout(timeout: float) -> float:
    try:
        route_info = model_route(MODEL_ROUTE_MEMORY)
        effective = model_request_timeout(route_info, timeout)
    except Exception:
        effective = timeout
    return max(float(timeout) + 5, float(effective) + 15)


def read_memory_proposal_queue() -> list[dict]:
    rows = []
    for row in read_jsonl(memory_proposal_queue_path()):
        if not isinstance(row, dict):
            continue
        if str(row.get("artifact_schema", "")) not in {"", MEMORY_PROPOSAL_QUEUE_SCHEMA_VERSION}:
            continue
        rows.append(dict(row))
    return rows


def write_memory_proposal_queue(rows: list[dict]) -> None:
    active = [row for row in rows if row.get("status") not in {"completed", "skipped"}]
    inactive = [row for row in rows if row.get("status") in {"completed", "skipped"}][-50:]
    kept = active + inactive
    path = memory_proposal_queue_path()
    if not kept:
        with contextlib.suppress(FileNotFoundError):
            path.unlink()
        return
    atomic_write(path, "".join(json.dumps(row, ensure_ascii=False) + "\n" for row in kept))


def memory_proposal_queue_retry_statuses() -> set[str]:
    return {"pending", "running", "failed"}


def queued_memory_proposal_count() -> int:
    return sum(
        1
        for row in read_memory_proposal_queue()
        if str(row.get("status", "pending")) in memory_proposal_queue_retry_statuses()
    )


def load_conversation_exact(conversation_id: str) -> dict | None:
    value = safe_load_json(conversation_path(conversation_id))
    return value if isinstance(value, dict) else None


def enqueue_memory_proposal(conv: dict, *, message_count: int, reason: str = "auto-maintenance") -> dict:
    conversation_id = str(conv.get("id", "")).strip()
    if not conversation_id:
        raise ValueError("conversation has no id")
    rows = read_memory_proposal_queue()
    for row in rows:
        if (
            str(row.get("conversation_id", "")) == conversation_id
            and str(row.get("status", "pending")) in memory_proposal_queue_retry_statuses()
        ):
            row["due_message_count"] = max(int(row.get("due_message_count", 0) or 0), int(message_count))
            row["conversation_title"] = conv.get("title", "Untitled")
            row["status"] = "pending"
            row["updated"] = now()
            row.setdefault("reasons", [])
            if reason not in row["reasons"]:
                row["reasons"].append(reason)
            write_memory_proposal_queue(rows)
            return row
    row = {
        "artifact_schema": MEMORY_PROPOSAL_QUEUE_SCHEMA_VERSION,
        "id": "memprop-" + uuid.uuid4().hex[:10],
        "status": "pending",
        "created": now(),
        "updated": now(),
        "conversation_id": conversation_id,
        "conversation_title": conv.get("title", "Untitled"),
        "due_message_count": int(message_count),
        "attempts": 0,
        "reasons": [reason],
    }
    rows.append(row)
    write_memory_proposal_queue(rows)
    return row


def save_memory_proposals_from_conversation(conv: dict, proposals: list[str]) -> int:
    saved = 0
    for text in proposals or []:
        add_memory(
            text,
            source="auto-model-proposed",
            conversation_id=conv["id"],
            derived_from="auto-memory",
        )
        saved += 1
    return saved


def run_queued_memory_proposals(
    *,
    current_conv: dict | None = None,
    limit: int = MEMORY_PROPOSAL_QUEUE_DRAIN_LIMIT,
    phase_callback=None,
) -> list[str]:
    rows = read_memory_proposal_queue()
    if not rows:
        return []
    notes = []
    processed = 0
    retry_statuses = memory_proposal_queue_retry_statuses()
    for row in rows:
        if processed >= limit:
            break
        if str(row.get("status", "pending")) not in retry_statuses:
            continue
        conversation_id = str(row.get("conversation_id", ""))
        memory_route_info = model_route(MODEL_ROUTE_MEMORY)
        memory_route_name = local_model_helper_route(memory_route_info)
        if phase_callback is not None:
            phase_callback(f"memory: proposing({memory_route_name})")
        row["status"] = "running"
        row["attempts"] = int(row.get("attempts", 0) or 0) + 1
        row["updated"] = now()
        write_memory_proposal_queue(rows)
        if current_conv is not None and str(current_conv.get("id", "")) == conversation_id:
            conv = current_conv
        else:
            conv = load_conversation_exact(conversation_id)
        if conv is None:
            row["status"] = "skipped"
            row["updated"] = now()
            row["last_error"] = "conversation no longer exists"
            notes.append("dropped queued memory proposal for deleted conversation")
            write_memory_proposal_queue(rows)
            processed += 1
            continue
        try:
            prepare_route_residency_for_request(
                memory_route_info,
                phase_callback=(lambda phase: phase_callback(f"memory: {phase}")) if phase_callback else None,
            )
            if phase_callback is not None:
                phase_callback(f"memory: proposing({memory_route_name})")
            proposals = propose_memories_bounded(
                conv,
                timeout=MAINTENANCE_MODEL_TIMEOUT_SECONDS,
            )
        except RouteResidencyBusy as exc:
            row["status"] = "pending"
            row["updated"] = now()
            row["last_error"] = str(exc)
            if "recent chat route" in str(exc):
                notes.append("memory proposal waiting for recent chat route")
            elif "active chat route" in str(exc):
                notes.append("memory proposal queued behind active chat route")
            else:
                notes.append("memory proposal queued behind model residency")
            write_memory_proposal_queue(rows)
            processed += 1
            continue
        except (Exception, SystemExit) as exc:
            row["status"] = "pending"
            row["updated"] = now()
            row["last_error"] = f"{type(exc).__name__}: {exc}"
            notes.append("memory proposal queued for retry")
            write_memory_proposal_queue(rows)
            processed += 1
            continue
        if phase_callback is not None:
            phase_callback("memory: saving")
        saved = save_memory_proposals_from_conversation(conv, proposals)
        conv["last_auto_memory_message_count"] = max(
            int(conv.get("last_auto_memory_message_count", 0) or 0),
            int(row.get("due_message_count", 0) or 0),
        )
        save_conversation(conv)
        row["status"] = "completed"
        row["updated"] = now()
        row["completed"] = now()
        row["saved_count"] = saved
        row.pop("last_error", None)
        notes.append(
            f"saved {saved} queued durable memor{'y' if saved == 1 else 'ies'}"
            if saved
            else "queued memory proposal completed with no durable memory"
        )
        write_memory_proposal_queue(rows)
        processed += 1
    return notes


def propose_memories_subprocess(conv: dict, *, timeout: float = MAINTENANCE_MODEL_TIMEOUT_SECONDS) -> list[str]:
    payload = json.dumps({"conversation": conv, "timeout": timeout}, ensure_ascii=False)
    env = dict(os.environ)
    env["MOTOKO_INTERNAL"] = "1"
    wall_timeout = memory_proposal_helper_timeout(timeout)
    try:
        result = subprocess.run(
            [sys.executable, motoko_program_path(), "__internal-propose-memories"],
            input=payload,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            env=env,
            timeout=wall_timeout,
            check=False,
        )
    except subprocess.TimeoutExpired as exc:
        raise TimeoutError(
            f"memory proposal helper timed out after {int(wall_timeout)}s; helper process was terminated"
        ) from exc
    if result.returncode != 0:
        detail = (result.stderr or result.stdout).strip()
        raise RuntimeError(f"memory proposal helper failed: {detail or 'no diagnostic'}")
    try:
        data = json.loads(result.stdout or "[]")
    except json.JSONDecodeError as exc:
        raise RuntimeError("memory proposal helper returned invalid JSON") from exc
    if not isinstance(data, list):
        raise RuntimeError("memory proposal helper returned a non-list result")
    return [str(item).strip() for item in data if str(item).strip()]


def propose_memories_bounded(
    conv: dict,
    *,
    timeout: float = MAINTENANCE_MODEL_TIMEOUT_SECONDS,
) -> list[str]:
    if os.environ.get("MOTOKO_INTERNAL") == "1":
        return propose_memories(conv, timeout=timeout)
    if env_flag("MOTOKO_MEMORY_PROPOSAL_HELPER", True):
        return propose_memories_subprocess(conv, timeout=timeout)
    return run_with_wall_timeout(
        "memory proposal",
        timeout,
        propose_memories,
        conv,
        timeout=timeout,
    )


def command_internal_propose_memories() -> int:
    try:
        payload = json.loads(sys.stdin.read() or "{}")
        conv = payload.get("conversation") or {}
        timeout = float(payload.get("timeout") or MAINTENANCE_MODEL_TIMEOUT_SECONDS)
        proposals = propose_memories(conv, timeout=timeout)
    except BaseException as exc:
        print(f"{type(exc).__name__}: {exc}", file=sys.stderr)
        return 1
    print(json.dumps(proposals, ensure_ascii=False))
    return 0


def call_model_with_callback(
    messages: list[dict],
    *,
    on_token,
    on_reasoning=None,
    temperature: float = 0.7,
    timeout: float = MODEL_TIMEOUT_SECONDS,
    route: str = MODEL_ROUTE_CHAT,
    cancel_event=None,
    on_connection=None,
    on_response=None,
    source_count: int | None = None,
    sampling_preset: str | None = None,
    json_schema=None,
    grammar: str | None = None,
    reasoning_preset: str | None = None,
    thinking_budget_tokens: int | None = None,
    enable_thinking: bool | None = None,
    max_tokens: int | None = None,
    slot_cache_context: dict | None = None,
) -> str:
    route_info, governor = model_route_for_request(route, messages)
    effective_sampling_preset = selected_sampling_preset(
        route_info,
        route_info.get("route", route),
        explicit=sampling_preset,
        structured=json_schema is not None or bool(grammar),
    )
    effective_reasoning_preset = selected_reasoning_preset(
        route_info,
        route_info.get("route", route),
        explicit=reasoning_preset,
    )
    payload = chat_completion_payload(
        route_info,
        messages,
        temperature=temperature,
        stream=True,
        sampling_preset=effective_sampling_preset,
        json_schema=json_schema,
        grammar=grammar,
        reasoning_preset=effective_reasoning_preset,
        thinking_budget_tokens=thinking_budget_tokens,
        enable_thinking=enable_thinking,
        max_tokens=max_tokens,
    )
    reasoning = {}
    if not effective_reasoning_preset:
        reasoning = apply_chat_reasoning_payload(payload, route_info)
    try:
        prepare_route_residency_for_request(route_info)
    except RouteResidencyBusy as exc:
        raise SystemExit(f"model request deferred: {exc}") from exc
    slot_context = None
    if slot_cache_context:
        slot_context = prepare_slot_cache_for_request(
            route_info,
            payload,
            conversation_id=str(slot_cache_context.get("conversation_id") or ""),
            client_namespace=str(slot_cache_context.get("client_namespace") or CHAT_SLOT_CACHE_NAMESPACE_VERSION),
        )
    request_metadata = model_request_metadata(
        route_info,
        payload,
        sampling_preset=effective_sampling_preset,
        reasoning_preset=effective_reasoning_preset,
        json_schema=json_schema,
        grammar=grammar,
    )
    collected = []
    first_token_at = 0.0
    started = time.monotonic()
    record = model_call_started_record(
        route_info,
        governor,
        source_count=source_count,
        stream=True,
        temperature=temperature,
        request_metadata=request_metadata,
    )
    add_reasoning_to_model_call_record(record, reasoning)
    add_slot_cache_to_model_call_record(record, slot_context)
    write_last_model_call(record)
    try:
        raise_if_cancelled(cancel_event)
        with open_model_response(
            route_info,
            payload,
            timeout=timeout,
            cancel_event=cancel_event,
            on_connection=on_connection,
            on_response=on_response,
            prepare_residency=False,
        ) as resp:
            for raw in iter_cancelable_response_lines(resp, cancel_event):
                raise_if_cancelled(cancel_event)
                done, content, reasoning_delta = parse_openai_stream_line_parts(raw)
                if done:
                    break
                if reasoning_delta:
                    if on_reasoning is not None:
                        on_reasoning(reasoning_delta)
                if content:
                    if not first_token_at:
                        first_token_at = time.monotonic()
                    collected.append(content)
                    on_token(content)
    except (urllib.error.URLError, TimeoutError, OSError, http.client.HTTPException) as exc:
        finish_model_call_record(
            record,
            started=started,
            first_token_at=first_token_at,
            completion_text="".join(collected),
            error=exc,
        )
        if cancel_event is not None and cancel_event.is_set():
            raise RuntimeError("__motoko_stopped__") from exc
        hint = local_model_verify_hint(route_info)
        raise SystemExit(model_request_failure_detail("model request failed", exc, hint)) from exc
    except BaseException as exc:
        finish_model_call_record(
            record,
            started=started,
            first_token_at=first_token_at,
            completion_text="".join(collected),
            error=exc,
        )
        raise
    try:
        raise_if_cancelled(cancel_event)
    except BaseException as exc:
        finish_model_call_record(
            record,
            started=started,
            first_token_at=first_token_at,
            completion_text="".join(collected),
            error=exc,
        )
        raise
    reply = "".join(collected)
    if slot_context is not None:
        slot_context = save_slot_cache_after_request_with_service_gc(route_info, slot_context)
        add_slot_cache_to_model_call_record(record, slot_context)
    finish_model_call_record(
        record,
        started=started,
        first_token_at=first_token_at,
        completion_text=reply,
    )
    return reply


def read_streaming_response(
    resp,
    *,
    echo: bool = True,
    spinner: ThinkingSpinner | None = None,
    cancel_event=None,
) -> str:
    collected = []
    for raw in iter_cancelable_response_lines(resp, cancel_event):
        done, content = parse_openai_stream_line(raw)
        if done:
            break
        if content:
            if spinner is not None:
                spinner.stop()
            if echo:
                print(content, end="", flush=True)
            collected.append(content)
    if echo:
        print()
    return "".join(collected)


