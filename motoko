def model_score_evidence_spans(query: str, spans: list[dict]) -> tuple[list[dict], list[str]]:
    warnings = []
    rows = [dict(row) for row in spans]
    if not rows:
        return rows, warnings
    by_parent = {}
    for row in rows:
        key = (
            int(row.get("start", 0) or 0),
            int(row.get("end", 0) or 0),
            str(row.get("kind", "")),
            str(row.get("label", "")),
        )
        by_parent[key] = row
    model_query = span_model_text({"kind": "query", "label": "query", "text": query})
    if env_flag("MOTOKO_SPAN_EMBEDDING", True) and local_model_routes_for_capability(
        kind="embedding",
        tasks=EMBEDDING_TASKS,
        endpoint_path="/v1/embeddings",
    ):
        embed_rows = model_span_rows_for_candidates(
            rows,
            limit=SPAN_SELECTION_EMBED_CANDIDATES,
            max_subspans=SPAN_SELECTION_EMBED_SUBSPANS,
        )
        try:
            vectors, route_info = embed_texts_for_retrieval(
                [model_query] + [str(row.get("model_text", "")) for row in embed_rows]
            )
        except SystemExit as exc:
            warnings.append(f"span embedding skipped: {str(exc).splitlines()[0][:220]}")
        else:
            query_vector = vectors[0] if vectors else []
            for row, vector in zip(embed_rows, vectors[1:]):
                vector_score = vector_similarity(query_vector, vector)
                row["span_vector_score"] = round(vector_score, 6)
                row["span_embedding_route"] = route_info.get("catalog_route") or route_info.get("route", "")
                row["score"] = float(row.get("score", 0) or 0) + (vector_score * 1000)
                parent_key = (
                    int(row.get("parent_start", row.get("start", 0)) or 0),
                    int(row.get("parent_end", row.get("end", 0)) or 0),
                    str(row.get("parent_kind", row.get("kind", "")) or ""),
                    str(row.get("parent_label", row.get("label", "")) or ""),
                )
                parent = by_parent.get(parent_key)
                if parent is not None and float(row.get("score", 0) or 0) > float(parent.get("score", 0) or 0):
                    parent["score"] = row["score"]
                    parent["span_vector_score"] = row["span_vector_score"]
                    parent["span_embedding_route"] = row["span_embedding_route"]
                    parent["selected_sub_start"] = row.get("sub_start")
                    parent["selected_sub_end"] = row.get("sub_end")
                    parent["selected_subspan_text"] = row.get("text")
    rows.sort(key=lambda row: float(row.get("score", 0) or 0), reverse=True)
    if env_flag("MOTOKO_SPAN_RERANK", True) and local_model_routes_for_capability(
        kind="reranker",
        tasks=RERANKER_TASKS,
        endpoint_path="/v1/rerank",
    ):
        rerank_rows = model_span_rows_for_candidates(
            rows,
            limit=SPAN_SELECTION_RERANK_CANDIDATES,
            max_subspans=SPAN_SELECTION_RERANK_SUBSPANS,
        )
        try:
            scores, route_info = rerank_documents_for_retrieval(
                model_query,
                [str(row.get("model_text", "")) for row in rerank_rows],
            )
        except SystemExit as exc:
            warnings.append(f"span rerank skipped: {str(exc).splitlines()[0][:220]}")
        else:
            for row, score in zip(rerank_rows, scores):
                row["span_rerank_score"] = round(float(score), 6)
                row["span_rerank_route"] = route_info.get("catalog_route") or route_info.get("route", "")
                row["score"] = (float(row.get("score", 0) or 0) * 0.2) + (float(score) * 1000)
                parent_key = (
                    int(row.get("parent_start", row.get("start", 0)) or 0),
                    int(row.get("parent_end", row.get("end", 0)) or 0),
                    str(row.get("parent_kind", row.get("kind", "")) or ""),
                    str(row.get("parent_label", row.get("label", "")) or ""),
                )
                parent = by_parent.get(parent_key)
                if parent is not None and float(row.get("score", 0) or 0) > float(parent.get("score", 0) or 0):
                    parent["score"] = row["score"]
                    parent["span_rerank_score"] = row["span_rerank_score"]
                    parent["span_rerank_route"] = row["span_rerank_route"]
                    parent["selected_sub_start"] = row.get("sub_start")
                    parent["selected_sub_end"] = row.get("sub_end")
                    parent["selected_subspan_text"] = row.get("text")
    rows.sort(key=lambda row: float(row.get("score", 0) or 0), reverse=True)
    return rows, warnings


