    def capture_text(self, func) -> str:
        class Capture:
            def __init__(self) -> None:
                self.parts: list[str] = []

            def write(self, text: str) -> int:
                self.parts.append(text)
                return len(text)

            def flush(self) -> None:
                return None

            def getvalue(self) -> str:
                return "".join(self.parts)

        buf = Capture()
        old_stdout = sys.stdout
        try:
            sys.stdout = buf
            func()
        finally:
            sys.stdout = old_stdout
        return buf.getvalue().strip() or "(no output)"

    def run_blocking_command(self, label: str, func) -> None:
        if self.generating:
            self.append("system", "Finish or wait for the current answer before running this blocking command.")
            return
        self.restore_for_blocking()
        try:
            print()
            print(style(label, "turquoise", "bold"))
            func()
            print(style("Done. Returning to Motoko TUI.", "green"))
        except SystemExit as exc:
            print(style(str(exc), "red"))
        finally:
            self.reenter_after_blocking()
        self.messages = self.seed_messages(self.conv)
        self.dirty = True

    def restore_for_blocking(self) -> None:
        if self.old_termios is not None:
            termios.tcsetattr(self.stdin_fd, termios.TCSADRAIN, self.old_termios)
        self.write("\033[?7h\033[?25h\033[0m\033[2J\033[H")

    def reenter_after_blocking(self) -> None:
        tty.setcbreak(self.stdin_fd)
        self.write("\033[?25l\033[?7l")

