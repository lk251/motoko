def atomic_write(path: pathlib.Path, text: str) -> None:
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(text, encoding="utf-8")
    tmp.chmod(0o600)
    tmp.replace(path)


def public_progress_state(progress: dict) -> dict:
    return {
        key: value
        for key, value in progress.items()
        if not key.startswith("_")
    }


def estimate_file_chunks(path: pathlib.Path) -> int:
    try:
        size = path.stat().st_size
    except OSError:
        return 1
    return max(1, (max(1, size) + INDEX_CHUNK_CHARS - 1) // INDEX_CHUNK_CHARS)


def estimate_corpus_summary_calls(total_files: int) -> int:
    if total_files <= 0:
        return 1
    approx_summary_chars = total_files * 700
    return max(1, (approx_summary_chars + SUMMARY_INPUT_CHARS - 1) // SUMMARY_INPUT_CHARS)


def write_index_progress(progress: dict) -> None:
    index_id = str(progress.get("id", "")).strip()
    if not index_id:
        return
    atomic_write(
        index_progress_path(index_id),
        json.dumps(public_progress_state(progress), ensure_ascii=False, indent=2) + "\n",
    )


def read_index_progress(index_id: str) -> dict | None:
    try:
        return json.loads(index_progress_path(index_id).read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return None


def list_index_progress() -> list[dict]:
    rows = []
    for path in sorted(indexes_dir().glob("*.progress.json"), reverse=True):
        try:
            row = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            continue
        if isinstance(row, dict):
            rows.append(row)
    rows.sort(key=lambda row: row.get("updated", row.get("started", "")), reverse=True)
    return rows


def active_index_progress() -> list[dict]:
    rows = []
    for row in list_index_progress():
        status = row.get("status")
        if status not in {"completed", "failed"}:
            rows.append(row)
            continue
        if status == "completed" and not index_path(str(row.get("id", ""))).exists():
            rows.append(row)
    return rows


def index_progress_percent(progress: dict) -> int | None:
    if progress.get("status") == "completed":
        return 100
    total = int(progress.get("estimated_model_calls", 0) or 0)
    done = int(progress.get("completed_model_calls", 0) or 0)
    if total <= 0:
        return None
    return min(99, max(0, int((done / total) * 100)))


def update_index_progress_estimates(progress: dict) -> None:
    started = progress.get("_started_monotonic")
    if started is not None:
        progress["elapsed_seconds"] = int(time.monotonic() - started)
    done = int(progress.get("completed_model_calls", 0) or 0)
    total = int(progress.get("estimated_model_calls", 0) or 0)
    remaining = max(0, total - done)
    if started is not None and done > 0 and remaining > 0:
        rate = progress["elapsed_seconds"] / done
        progress["eta_seconds"] = int(rate * remaining)
    else:
        progress["eta_seconds"] = None
    progress["percent"] = index_progress_percent(progress)


def emit_index_progress(progress: dict, callback=None) -> None:
    progress["updated"] = now()
    update_index_progress_estimates(progress)
    write_index_progress(progress)
    if callback is not None:
        callback(public_progress_state(progress))


def begin_index_progress(
    index_id: str,
    root: pathlib.Path,
    pattern: str | None,
    name: str | None,
    candidates: list[pathlib.Path],
    callback=None,
) -> dict:
    chunk_estimates = {str(path): estimate_file_chunks(path) for path in candidates}
    estimated_chunks = sum(chunk_estimates.values())
    progress = {
        "id": index_id,
        "kind": "index",
        "status": "running",
        "phase": "starting",
        "root": str(root),
        "glob": pattern or AUTO_INDEX_GLOB,
        "name": name or root.name or str(root),
        "started": now(),
        "updated": now(),
        "elapsed_seconds": 0,
        "eta_seconds": None,
        "percent": 0,
        "total_files": len(candidates),
        "completed_files": 0,
        "current_file": "",
        "current_file_index": 0,
        "current_file_estimated_chunks": 0,
        "estimated_chunks": estimated_chunks,
        "completed_chunks": 0,
        "current_chunk": 0,
        "estimated_model_calls": estimated_chunks + len(candidates) + estimate_corpus_summary_calls(len(candidates)),
        "completed_model_calls": 0,
        "last_model_label": "",
        "_started_monotonic": time.monotonic(),
        "_chunk_estimates": chunk_estimates,
    }
    emit_index_progress(progress, callback)
    return progress


def index_progress_begin_file(progress: dict | None, path: pathlib.Path, ordinal: int, callback=None) -> None:
    if progress is None:
        return
    progress["phase"] = "indexing file"
    progress["current_file"] = str(path)
    progress["current_file_index"] = ordinal
    progress["current_file_estimated_chunks"] = progress.get("_chunk_estimates", {}).get(str(path), 1)
    progress["current_chunk"] = 0
    emit_index_progress(progress, callback)


def index_progress_begin_model(progress: dict | None, phase: str, label: str, callback=None) -> None:
    if progress is None:
        return
    progress["phase"] = phase
    progress["last_model_label"] = label
    emit_index_progress(progress, callback)


def index_progress_finish_model(progress: dict | None, callback=None, *, chunk_done: bool = False) -> None:
    if progress is None:
        return
    progress["completed_model_calls"] = int(progress.get("completed_model_calls", 0) or 0) + 1
    if chunk_done:
        progress["completed_chunks"] = int(progress.get("completed_chunks", 0) or 0) + 1
    emit_index_progress(progress, callback)


def index_progress_finish_file(progress: dict | None, callback=None) -> None:
    if progress is None:
        return
    progress["completed_files"] = int(progress.get("completed_files", 0) or 0) + 1
    progress["phase"] = "file indexed"
    emit_index_progress(progress, callback)


def finish_index_progress(progress: dict | None, status: str, callback=None, *, error: str = "") -> None:
    if progress is None:
        return
    progress["status"] = status
    progress["phase"] = "completed" if status == "completed" else "failed"
    if error:
        progress["error"] = error
    emit_index_progress(progress, callback)


def format_index_progress_status(progress: dict) -> str:
    phase = str(progress.get("phase") or "indexing")
    status = str(progress.get("status") or "running")
    if status == "completed":
        return "bg-heavy: index complete"
    if status == "failed":
        return "bg-heavy: index failed"
    current = int(progress.get("current_file_index", 0) or 0)
    total = int(progress.get("total_files", 0) or 0)
    files = f"file {current}/{total}" if total else "files"
    chunks_done = int(progress.get("completed_chunks", 0) or 0)
    chunks_total = int(progress.get("estimated_chunks", 0) or 0)
    chunks = f"chunk {chunks_done}/{chunks_total}" if chunks_total else ""
    percent = progress.get("percent")
    pct = f"{percent}%" if percent is not None else ""
    eta = progress.get("eta_seconds")
    eta_text = f"eta {human_duration(eta)}" if eta is not None else "eta ?"
    parts = ["bg-heavy:", phase, files, chunks, pct, eta_text]
    return " ".join(part for part in parts if part)


def format_index_progress_line(progress: dict) -> str:
    updated = relative_time(str(progress.get("updated", "")))
    elapsed = human_duration(progress.get("elapsed_seconds"))
    return (
        f"{progress.get('id', '')}  {progress.get('status', 'unknown')}  "
        f"{format_index_progress_status(progress)}  elapsed {elapsed}  "
        f"updated {updated}  {progress.get('root', '')}"
    )


def config_path() -> pathlib.Path:
    root = ensure_private_dir(config_root())
    return root / "config.json"


def default_config() -> dict:
    return {
        "identity": {
            "name": "Motoko",
            "realm": "personal",
            "description": "Private local assistant for Javier's personal realm.",
        },
        "permissions": {
            "mode": DEFAULT_PERMISSION_MODE,
        },
        "index": {
            "max_derived_bytes": None,
            "max_files": None,
            "max_file_bytes": None,
        },
    }


def merged_config(data: dict | None) -> dict:
    merged = default_config()
    if not isinstance(data, dict):
        return merged
    identity = data.get("identity")
    if isinstance(identity, dict):
        for key in ("name", "realm", "description"):
            value = identity.get(key)
            if isinstance(value, str) and value.strip():
                merged["identity"][key] = value.strip()[:1000]
    permissions = data.get("permissions")
    if isinstance(permissions, dict):
        mode = permissions.get("mode")
        if isinstance(mode, str) and mode in PERMISSION_MODE_DESCRIPTIONS:
            merged["permissions"]["mode"] = mode
    index = data.get("index")
    if isinstance(index, dict):
        for key in ("max_derived_bytes", "max_files", "max_file_bytes"):
            if key in index:
                merged["index"][key] = index[key]
    return merged


def load_config() -> dict:
    path = config_path()
    if not path.exists():
        return default_config()
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except json.JSONDecodeError as exc:
        raise SystemExit(f"invalid Motoko config JSON at {path}: {exc}") from exc
    except OSError as exc:
        raise SystemExit(f"cannot read Motoko config at {path}: {exc}") from exc
    if not isinstance(data, dict):
        raise SystemExit(f"invalid Motoko config at {path}: top-level value must be an object")
    return merged_config(data)


def save_config(config: dict) -> None:
    path = config_path()
    atomic_write(path, json.dumps(merged_config(config), ensure_ascii=False, indent=2) + "\n")


def config_index_value(key: str):
