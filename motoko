def current_git_branch() -> str:
    try:
        result = subprocess.run(
            ["git", "branch", "--show-current"],
            check=False,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=0.2,
        )
    except (OSError, subprocess.TimeoutExpired):
        return "-"
    branch = result.stdout.strip()
    return branch or "-"


def current_project_root_record(path: str | None = None) -> dict:
    base = pathlib.Path(path or os.getcwd()).expanduser().resolve()
    try:
        result = subprocess.run(
            ["git", "-C", str(base), "rev-parse", "--show-toplevel"],
            check=False,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=0.2,
        )
    except (OSError, subprocess.TimeoutExpired):
        result = None
    if result is not None and result.returncode == 0 and result.stdout.strip():
        return {"kind": "git", "root": str(pathlib.Path(result.stdout.strip()).resolve())}
    return {"kind": "directory", "root": str(base)}


def project_root_matches(root: str, project_roots: set[str]) -> bool:
    root_text = str(root or "").strip()
    if not root_text or not project_roots:
        return False
    try:
        root_path = pathlib.Path(root_text).expanduser().resolve()
    except OSError:
        return root_text in project_roots
    for project_root in project_roots:
        try:
            project_path = pathlib.Path(project_root).expanduser().resolve()
        except OSError:
            if root_text == project_root:
                return True
            continue
        if root_path == project_path:
            return True
        with contextlib.suppress(ValueError):
            root_path.relative_to(project_path)
            return True
        with contextlib.suppress(ValueError):
            project_path.relative_to(root_path)
            return True
    return False


def conversation_project_roots(conv: dict | None) -> set[str]:
    roots: set[str] = set()
    if not isinstance(conv, dict):
        return roots
    project = conv.get("project") if isinstance(conv.get("project"), dict) else {}
    root = str(project.get("root", "") or "").strip()
    if root:
        roots.add(str(pathlib.Path(root).expanduser().resolve()))
    for item in conv.get("context_items", []) or []:
        if not isinstance(item, dict):
            continue
        kind = item.get("kind")
        if kind == "index" and item.get("id"):
            index = load_index_if_exists(str(item.get("id", "")))
            if index is None:
                continue
            index_root = str(index.get("root", "") or "").strip()
            if index_root:
                roots.add(str(pathlib.Path(index_root).expanduser().resolve()))
        elif kind == "repo" and item.get("root"):
            roots.add(str(pathlib.Path(str(item.get("root"))).expanduser().resolve()))
    return roots


def project_scope_for_request(conv: dict | None = None, query: str = "", path: str | None = None) -> dict:
    root_record = current_project_root_record(path)
    root = str(root_record.get("root", "") or "").strip()
    roots = [str(pathlib.Path(root).expanduser().resolve())] if root else []
    return {
        "schema": PROJECT_SCOPE_SCHEMA_VERSION,
        "mode": "current-project",
        "project": root_record,
        "roots": roots,
        "conversation_id": str(conv.get("id", "") if isinstance(conv, dict) else ""),
        "query_sha256": sha256_hex(str(query or "").encode("utf-8")) if query else "",
    }


def project_scope_roots(project_scope: dict | None) -> set[str]:
    if not isinstance(project_scope, dict):
        return set()
    roots: set[str] = set()
    for root in project_scope.get("roots", []) or []:
        root_text = str(root or "").strip()
        if root_text:
            roots.add(str(pathlib.Path(root_text).expanduser().resolve()))
    project = project_scope.get("project") if isinstance(project_scope.get("project"), dict) else {}
    root = str(project.get("root", "") or "").strip()
    if root:
        roots.add(str(pathlib.Path(root).expanduser().resolve()))
    return roots


def project_scope_source(project_scope: dict, **extra) -> dict:
    roots = sorted(project_scope_roots(project_scope))
    source = {
        "kind": "project-scope",
        "schema": PROJECT_SCOPE_SCHEMA_VERSION,
        "mode": project_scope.get("mode", "current-project"),
        "roots": roots,
        "root": roots[0] if roots else "",
    }
    source.update(extra)
    return source


def project_scope_note(project_scope: dict, lines: list[str]) -> str:
    roots = sorted(project_scope_roots(project_scope))
    text = [f"Project scope: current project root={roots[0] if roots else '(unknown)'}"]
    text.extend(line for line in lines if line)
    return "\n".join(text)


def active_project_roots(conv: dict | None = None) -> set[str]:
    return project_scope_roots(project_scope_for_request(conv))


def topic_project_roots(topic: dict | None) -> set[str]:
    roots: set[str] = set()
    if not isinstance(topic, dict):
        return roots
    for source in topic.get("source_indexes", []) or []:
        root = str(source.get("root", "") or "").strip()
        if root:
            roots.add(str(pathlib.Path(root).expanduser().resolve()))
    for evidence in topic.get("evidence", []) or []:
        path = str(evidence.get("path", "") or "").strip()
        if path:
            roots.add(str(pathlib.Path(path).expanduser().resolve().parent))
    return roots


def dossier_project_roots(dossier: dict | None) -> set[str]:
    roots: set[str] = set()
    if not isinstance(dossier, dict):
        return roots
    for item in dossier.get("source_conversations", []) or []:
        conv_id = str(item.get("id", "") or "").strip()
        if not conv_id:
            continue
        conv = load_conversation_if_exists(conv_id)
        if conv is not None:
            roots.update(conversation_project_roots(conv))
    return roots


def context_item_project_roots(item: dict) -> set[str]:
    kind = item.get("kind")
    roots: set[str] = set()
    if kind == "index" and item.get("id"):
        index = load_index_if_exists(str(item.get("id", "")))
        if index is not None:
            root = str(index.get("root", "") or "").strip()
            if root:
                roots.add(str(pathlib.Path(root).expanduser().resolve()))
    elif kind == "file" and item.get("path"):
        roots.add(str(pathlib.Path(str(item.get("path"))).expanduser().resolve().parent))
    elif kind == "repo" and item.get("root"):
        roots.add(str(pathlib.Path(str(item.get("root"))).expanduser().resolve()))
    elif kind == "topic" and item.get("id"):
        topic = load_topic_if_exists(str(item.get("id", "")))
        if topic is not None:
            roots.update(topic_project_roots(topic))
    elif kind == "dossier" and item.get("id"):
        dossier = load_dossier_if_exists(str(item.get("id", "")))
        if dossier is not None:
            roots.update(dossier_project_roots(dossier))
    return roots


def roots_match_project(roots: set[str], project_roots: set[str]) -> bool:
    return bool(roots) and any(project_root_matches(root, project_roots) for root in roots)


def context_item_matches_project(item: dict, project_roots: set[str]) -> bool:
    if not project_roots:
        return True
    return roots_match_project(context_item_project_roots(item), project_roots)


def scoped_context_items(items: list[dict], project_roots: set[str]) -> list[dict]:
    if not project_roots:
        return items
    return [
        item
        for item in items
        if isinstance(item, dict) and context_item_matches_project(item, project_roots)
    ]


def app_revision() -> str:
    env_revision = os.environ.get("MOTOKO_REVISION", "").strip()
    if env_revision:
        return env_revision
    source = pathlib.Path(__file__).resolve()
    try:
        result = subprocess.run(
            ["git", "-C", str(source.parent), "rev-parse", "--short=12", "HEAD"],
            check=False,
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            timeout=0.2,
        )
    except (OSError, subprocess.TimeoutExpired):
        return "-"
    revision = result.stdout.strip()
    return revision or "-"


def max_derived_index_bytes(override: str | None = None) -> int:
    raw = (
        override
        or os.environ.get("MOTOKO_MAX_DERIVED_INDEX_BYTES")
        or config_index_value("max_derived_bytes")
    )
    if not raw:
        return DEFAULT_MAX_DERIVED_INDEX_BYTES
    try:
        return parse_config_byte_count(raw, "index.max_derived_bytes")
    except ValueError as exc:
        raise SystemExit(str(exc)) from exc


def spinner_frames() -> list[str]:
    mode = os.environ.get("MOTOKO_SPINNER", "off").strip().lower()
    if mode in {"0", "false", "no", "none", "off"}:
        return []
    if mode == "auto":
        return ["/", "|", "\\", "-"]
    if mode == "ascii":
        return ["/", "|", "\\", "-"]
    if mode in {"block", "blink", "square"}:
        return ["■", " "]
    if mode == "braille":
        return ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"]

    custom = os.environ.get("MOTOKO_SPINNER_CHARS", "").strip()
    if custom:
        return list(custom)

    return ["/", "|", "\\", "-"]


class ThinkingSpinner:
    def __init__(self, *, enabled: bool) -> None:
        self.frames = spinner_frames() if enabled and sys.stdout.isatty() else []
        self._stop = threading.Event()
        self._thread: threading.Thread | None = None
        self._active = False

    def start(self) -> None:
        if not self.frames:
            return
        self._active = True
        self._thread = threading.Thread(target=self._run, daemon=True)
        self._thread.start()

    def stop(self) -> None:
        if not self._active:
            return
        self._stop.set()
        if self._thread is not None:
            self._thread.join(timeout=0.4)
        self._active = False

    def _run(self) -> None:
        idx = 0
        while not self._stop.is_set():
            sys.stdout.write(self.frames[idx % len(self.frames)])
            sys.stdout.flush()
            self._stop.wait(0.12)
            sys.stdout.write("\b \b")
            sys.stdout.flush()
            idx += 1
            self._stop.wait(0.04)


def public_progress_state(progress: dict) -> dict:
    return {
        key: value
        for key, value in progress.items()
        if not key.startswith("_")
    }


def estimate_file_chunks(path: pathlib.Path) -> int:
    try:
        size = path.stat().st_size
    except OSError:
        return 1
    return max(1, (max(1, size) + INDEX_CHUNK_CHARS - 1) // INDEX_CHUNK_CHARS)


def estimate_corpus_summary_calls(total_files: int) -> int:
    if total_files <= 0:
        return 1
    approx_summary_chars = total_files * 700
    return max(1, (approx_summary_chars + SUMMARY_INPUT_CHARS - 1) // SUMMARY_INPUT_CHARS)


def estimate_summary_block_calls(blocks: list[str], max_chars: int = SUMMARY_INPUT_CHARS) -> int:
    pending = [block.strip() for block in blocks if block.strip()]
    if not pending:
        return 1
    calls = 0
    round_no = 1
    while True:
        combined = "\n\n".join(pending)
        if len(combined) <= max_chars or len(pending) == 1 or round_no > 8:
            return calls + 1
        batches = chunk_blocks_by_chars(pending, max_chars)
        calls += len(batches)
        # Model reduction output length is not known yet. Use a conservative
        # summary-size proxy so the plan can adapt before the extra calls start.
        pending = ["x" * 900 for _batch in batches]
        round_no += 1


def estimate_summary_calls_for_block_count(block_count: int, approx_block_chars: int = 700) -> int:
    count = max(0, int(block_count or 0))
    if count <= 0:
        return 1
    return estimate_summary_block_calls(["x" * max(1, approx_block_chars) for _idx in range(count)])


