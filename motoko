def prepare_worker_route_residency(route_info: dict, *, phase_callback=None) -> list[str]:
    if not route_needs_large_chat_release(route_info):
        return []
    target_route = local_model_helper_route(route_info)
    notes = []
    seen = set()
    for chat_info in chat_route_candidates():
        chat_route = local_model_helper_route(chat_info)
        if not chat_route or chat_route == target_route or chat_route in seen:
            continue
        seen.add(chat_route)
        if not endpoint_is_unix(str(chat_info.get("endpoint") or "")) or not route_is_large_chat(chat_info):
            continue
        status_text = local_model_status_text(chat_info)
        values = parse_local_model_status(status_text)
        backend = values.get("backend", "").strip().lower()
        proxy = values.get("proxy", "").strip().lower()
        if backend not in {"active", "activating"} and proxy not in {"active", "activating"}:
            continue
        if local_model_status_busy(status_text):
            raise RouteResidencyBusy(f"worker route {target_route} queued behind active chat route {chat_route}")
        remaining = recent_large_chat_grace_remaining(chat_info)
        if remaining > 0:
            raise RouteResidencyBusy(
                f"worker route {target_route} waiting {remaining}s for recent chat route {chat_route}"
            )
        if phase_callback is not None:
            phase_callback(f"releasing({chat_route})")
        try:
            run_local_model_helper("stop", chat_info)
        except (OSError, RuntimeError, subprocess.TimeoutExpired) as exc:
            notes.append(f"could not release {chat_route}: {type(exc).__name__}")
            continue
        notes.append(f"released {chat_route}")
    return notes


def prepare_declared_exclusive_lane_residency(route_info: dict, *, phase_callback=None) -> list[str]:
    lane = route_declared_exclusive_lane(route_info)
    if not lane:
        return []
    target_route = local_model_helper_route(route_info)
    notes = []
    seen = {target_route}
    for info in local_model_catalog_route_infos(logical_route=MODEL_ROUTE_CHAT):
        route_name = local_model_helper_route(info)
        if not route_name or route_name in seen:
            continue
        seen.add(route_name)
        if not endpoint_is_unix(str(info.get("endpoint") or "")):
            continue
        if route_declared_exclusive_lane(info) != lane:
            continue
        status_text = local_model_status_text(info)
        if not local_route_status_active(status_text):
            continue
        if local_model_status_busy(status_text):
            raise RouteResidencyBusy(
                f"route {target_route} queued behind active route {route_name} in exclusive lane {lane}"
            )
        if phase_callback is not None:
            phase_callback(f"releasing({route_name})")
        try:
            run_local_model_helper("stop", info)
        except (OSError, RuntimeError, subprocess.TimeoutExpired) as exc:
            notes.append(f"could not release {route_name}: {type(exc).__name__}")
            continue
        notes.append(f"released {route_name}")
    return notes


def prepare_chat_route_residency(route_info: dict, *, phase_callback=None) -> list[str]:
    if not endpoint_is_unix(str(route_info.get("endpoint") or "")) or not route_is_large_chat(route_info):
