        f"created: {report.get('created', '')}",
        f"mode: {'dry-run' if report.get('dry_run') else 'apply'}",
        f"index: {index.get('id', '')} {index.get('name', '')} {index.get('root', '')}".rstrip(),
        f"index status: {index.get('status', '')}",
        f"replacement: {replacement.get('id') or '-'} ({'ready' if replacement.get('ready') else 'not ready'})",
        f"replacement reason: {replacement.get('reason', '')}",
        f"plan: {plan.get('status', '')} -> {plan.get('recommended_action', '')}",
        f"apply: {plan.get('apply_status', '')} ({plan.get('apply_reason', '')})",
    ]
    source_counts = plan.get("source_counts") or {}
    if source_counts:
        lines.append("sources: " + ", ".join(f"{key}:{source_counts[key]}" for key in sorted(source_counts)))
    else:
        lines.append("sources: fresh")
    for source in report.get("source_lifecycle", [])[:20]:
        lines.append(
            f"- {source.get('status', '')}: {source.get('path', '')} "
            f"({source.get('recommended_action', '')})"
        )
    if plan.get("affected_artifacts"):
        lines.append("affected artifacts:")
        for item in plan.get("affected_artifacts", []):
            bytes_part = f", {human_bytes(item.get('bytes', 0))}" if item.get("bytes") else ""
            lines.append(
                f"- {item.get('kind', '')}: {item.get('count', 0)} "
                f"policy={item.get('policy', '')}{bytes_part}"
            )
    else:
        lines.append("affected artifacts: none")
    manual = plan.get("manual_review_artifact_count", 0)
    if manual:
        lines.append(
            f"manual review: {manual} durable artifact(s) may mention these sources; "
            "Motoko will not delete memories, conversations, profile, or raw feedback automatically."
        )
    applied = report.get("applied")
    if applied:
        lines.append(f"applied: {applied.get('status', '')}")
        if applied.get("reason"):
            lines.append(f"reason: {applied.get('reason')}")
        deleted = applied.get("deleted") or {}
        if deleted:
            extras = []
            for key, label in [
                ("vector_stores_deleted", "vector"),
                ("evidence_stores_deleted", "evidence"),
                ("topics_deleted", "topics"),
                ("dossiers_deleted", "dossiers"),
                ("retrieval_debug_deleted", "retrieval-debug"),
                ("retrieval_evals_deleted", "retrieval-evals"),
                ("feedback_evals_deleted", "feedback-evals"),
            ]:
                if deleted.get(key):
                    extras.append(f"{label}:{deleted.get(key)}")
            lines.append(
                "deleted: "
                f"index={deleted.get('index_deleted')} chunks={deleted.get('chunk_dir_deleted')} "
                + (", ".join(extras) if extras else "derived=0")
            )
    elif plan.get("apply_status") == "ready" and report.get("dry_run"):
        lines.append("next: run motoko source-lifecycle INDEX --apply --yes after reviewing this report")
    elif plan.get("apply_status") == "blocked":
        lines.append("next: rebuild/refresh the corpus first, then rerun source-lifecycle")
    return "\n".join(lines)


def index_storage_scan_record(
    record: dict,
    *,
    record_kind: str,
    referenced_paths: set[pathlib.Path],
    stored_by_digest: dict[str, list[dict]],
    unique_digest_bytes: dict[str, int],
    duplicate_refs: list[dict],
) -> dict:
    row = {
        "id": record.get("id", ""),
        "kind": record_kind,
        "name": record.get("name", ""),
        "root": record.get("root", ""),
        "chunks": 0,
        "stored_chunks": 0,
        "duplicate_reference_chunks": 0,
        "logical_content_bytes": 0,
        "stored_content_bytes": 0,
        "duplicate_reference_bytes": 0,
        "missing_stored_chunks": 0,
        "chunks_missing_digest": 0,
        "warnings": [],
    }
    for file_item in record.get("files", []):
        for chunk in file_item.get("chunks", []):
            row["chunks"] += 1
            digest = str(chunk.get("content_sha256", "")).strip()
            logical_bytes = safe_int(chunk.get("content_bytes"))
            if not logical_bytes and isinstance(chunk.get("content"), str):
                logical_bytes = len(chunk.get("content", "").encode("utf-8"))
            row["logical_content_bytes"] += logical_bytes
            if not digest:
                row["chunks_missing_digest"] += 1
            if chunk.get("duplicate_of_existing_index"):
                row["duplicate_reference_chunks"] += 1
                row["duplicate_reference_bytes"] += logical_bytes
                duplicate_refs.append(
                    {
                        "index_id": record.get("id", ""),
                        "path": file_item.get("path", ""),
                        "chunk": chunk.get("chunk", ""),
                        "content_sha256": digest,
                        "logical_content_bytes": logical_bytes,
                    }
                )
                continue
            content_bytes = safe_int(chunk.get("stored_content_bytes"))
            if "content" in chunk:
                text = str(chunk.get("content", ""))
                content_bytes = len(text.encode("utf-8"))
                row["stored_chunks"] += 1
                row["stored_content_bytes"] += content_bytes
                if digest:
                    stored_by_digest.setdefault(digest, []).append(
                        {
                            "index_id": record.get("id", ""),
                            "kind": record_kind,
                            "path": file_item.get("path", ""),
                            "chunk": chunk.get("chunk", ""),
                            "storage": "inline",
                            "bytes": content_bytes,
                        }
                    )
                    unique_digest_bytes.setdefault(digest, content_bytes)
                continue
            try:
                content_path = chunk_content_path(record, chunk)
            except ValueError as exc:
                row["warnings"].append(str(exc))
                row["missing_stored_chunks"] += 1
                continue
            if content_path is None:
                row["missing_stored_chunks"] += 1
                continue
            try:
                resolved = content_path.resolve()
            except OSError:
                resolved = content_path
            referenced_paths.add(resolved)
            if not content_path.exists():
                row["missing_stored_chunks"] += 1
                continue
            if not content_bytes:
                content_bytes = path_size(content_path)
            row["stored_chunks"] += 1
            row["stored_content_bytes"] += content_bytes
            if digest:
                stored_by_digest.setdefault(digest, []).append(
                    {
                        "index_id": record.get("id", ""),
                        "kind": record_kind,
                        "path": file_item.get("path", ""),
                        "chunk": chunk.get("chunk", ""),
                        "storage": str(content_path),
                        "bytes": content_bytes,
                    }
                )
                unique_digest_bytes.setdefault(digest, content_bytes)
    return row


def index_storage_audit() -> dict:
    indexes = list_indexes()
    partials = list_partial_indexes()
    resumable_partial_ids = {partial.get("id", "") for partial in list_resumable_partial_indexes()}
    superseded_partials = list_superseded_partial_indexes()
    latest_ids = {index.get("id", "") for index in latest_indexes_by_family(indexes)}
    referenced_paths: set[pathlib.Path] = set()
    stored_by_digest: dict[str, list[dict]] = {}
    unique_digest_bytes: dict[str, int] = {}
    duplicate_refs: list[dict] = []
    rows = []
    for index in indexes:
        row = index_storage_scan_record(
            index,
            record_kind="index",
            referenced_paths=referenced_paths,
            stored_by_digest=stored_by_digest,
            unique_digest_bytes=unique_digest_bytes,
            duplicate_refs=duplicate_refs,
        )
        row["latest_for_family"] = index.get("id", "") in latest_ids
        rows.append(row)
    for partial in partials:
        row = index_storage_scan_record(
            partial,
            record_kind="partial",
            referenced_paths=referenced_paths,
            stored_by_digest=stored_by_digest,
            unique_digest_bytes=unique_digest_bytes,
            duplicate_refs=duplicate_refs,
        )
        row["resumable"] = partial.get("id", "") in resumable_partial_ids
        row["superseded"] = partial_index_superseded(partial, indexes)
        rows.append(row)

    missing_duplicate_refs = []
    duplicate_reference_bytes_with_target = 0
    for ref in duplicate_refs:
        digest = ref.get("content_sha256", "")
        targets = [
            target
            for target in stored_by_digest.get(digest, [])
            if target.get("index_id") != ref.get("index_id")
            and target.get("kind") == "index"
        ]
        if targets:
            duplicate_reference_bytes_with_target += safe_int(ref.get("logical_content_bytes"))
        else:
            missing_duplicate_refs.append(ref)

    orphan_files = []
    for data_dir in indexes_dir().glob("*.chunks"):
        if not data_dir.is_dir():
            continue
        for path in data_dir.rglob("*.txt"):
            try:
                resolved = path.resolve()
            except OSError:
                resolved = path
            if resolved in referenced_paths:
                continue
            orphan_files.append({"path": str(path), "bytes": path_size(path)})

    completed_rows = [row for row in rows if row.get("kind") == "index"]
    logical_bytes = sum(safe_int(row.get("logical_content_bytes")) for row in completed_rows)
    physical_bytes = sum(safe_int(row.get("stored_content_bytes")) for row in rows)
    unique_stored_bytes = sum(unique_digest_bytes.values())
    stored_body_duplicates = sum(max(0, len(locations) - 1) for locations in stored_by_digest.values())
    older_indexes = [index for index in indexes if index.get("id", "") not in latest_ids]
    stale_superseded_indexes = index_cleanup_candidates(indexes)
    source_lifecycle_plans = []
    for index in indexes:
        summary = index_change_summary(index)
        plan = summary.get("artifact_lifecycle_plan") or {}
        if plan.get("status") != "needs-work":
            continue
        source_lifecycle_plans.append(
            {
                "index": index.get("id", ""),
                "name": index.get("name", ""),
                "root": index.get("root", ""),
                "source_counts": plan.get("source_counts", {}),
                "recommended_action": plan.get("recommended_action", ""),
                "affected_artifacts": plan.get("affected_artifacts", []),
            }
        )
    safe_cleanup = []
    if stale_superseded_indexes:
        safe_cleanup.append(
            {
                "kind": "stale-superseded-indexes",
                "count": len(stale_superseded_indexes),
                "bytes": sum(safe_int(item.get("bytes")) for item in stale_superseded_indexes),
                "safety": "candidate",
                "action": "run motoko index-cleanup --yes after reviewing that the newer family index is attached/fresh",
            }
        )
    if superseded_partials:
        safe_cleanup.append(
            {
                "kind": "superseded-partials",
                "count": len(superseded_partials),
                "bytes": sum(partial_index_cleanup_bytes(partial) for partial in superseded_partials),
                "safety": "candidate",
                "action": "review and later remove only superseded partial checkpoints/chunk dirs",
            }
        )
    if orphan_files:
        safe_cleanup.append(
            {
                "kind": "orphan-chunk-files",
                "count": len(orphan_files),
                "bytes": sum(item.get("bytes", 0) for item in orphan_files),
                "safety": "candidate",
                "action": "review and later remove chunk files no index or partial references",
            }
        )
    blocked_cleanup = []
    blocked_older_count = max(0, len(older_indexes) - len(stale_superseded_indexes))
    if blocked_older_count:
        blocked_cleanup.append(
            {
                "kind": "older-complete-indexes",
                "count": blocked_older_count,
                "safety": "blocked",
                "reason": "fresh or unsuperseded older indexes may still hold duplicate-reference targets; cleanup only deletes stale snapshots after materializing the newer replacement",
            }
        )
    if missing_duplicate_refs:
        blocked_cleanup.append(
            {
                "kind": "missing-duplicate-targets",
                "count": len(missing_duplicate_refs),
                "safety": "repair-first",
                "reason": "some duplicate references cannot find stored chunk text in another index",
            }
        )
    if source_lifecycle_plans:
        blocked_cleanup.append(
            {
                "kind": "source-lifecycle-work",
                "count": len(source_lifecycle_plans),
                "safety": "rebuild-first",
                "reason": "changed, deleted, or newly ignored source files need index refresh before derived-artifact cleanup",
            }
        )
    return {
        "schema": INDEX_STORAGE_AUDIT_SCHEMA_VERSION,
        "created": now(),
        "index_count": len(indexes),
        "latest_index_families": len(latest_ids),
        "older_complete_indexes": len(older_indexes),
        "partial_count": len(partials),
        "resumable_partial_count": len(resumable_partial_ids),
        "superseded_partial_count": len(superseded_partials),
        "total_chunks": sum(safe_int(row.get("chunks")) for row in completed_rows),
        "stored_chunks": sum(safe_int(row.get("stored_chunks")) for row in completed_rows),
        "duplicate_reference_chunks": sum(safe_int(row.get("duplicate_reference_chunks")) for row in completed_rows),
        "stored_body_duplicates": stored_body_duplicates,
        "unique_stored_bodies": len(unique_digest_bytes),
        "logical_content_bytes": logical_bytes,
        "physical_stored_content_bytes": physical_bytes,
        "unique_stored_content_bytes": unique_stored_bytes,
        "duplicate_reference_bytes": sum(safe_int(row.get("duplicate_reference_bytes")) for row in completed_rows),
        "duplicate_reference_bytes_with_target": duplicate_reference_bytes_with_target,
        "estimated_dedup_saved_bytes": duplicate_reference_bytes_with_target,
        "missing_duplicate_target_count": len(missing_duplicate_refs),
        "missing_stored_chunk_count": sum(safe_int(row.get("missing_stored_chunks")) for row in rows),
        "orphan_chunk_file_count": len(orphan_files),
        "orphan_chunk_file_bytes": sum(item.get("bytes", 0) for item in orphan_files),
        "rows": rows,
        "missing_duplicate_targets": missing_duplicate_refs[:50],
        "orphan_chunk_files": orphan_files[:50],
        "source_lifecycle_plans": source_lifecycle_plans[:50],
        "safe_cleanup": safe_cleanup,
        "blocked_cleanup": blocked_cleanup,
    }


def index_is_persisted(index: dict) -> bool:
    index_id = str(index.get("id", ""))
    return bool(re.fullmatch(r"\d{8}-\d{6}-[0-9a-f]{6}", index_id) and index_path(index_id).exists())


def evidence_store_source_fingerprint(index: dict) -> str:
    items = [
        {
            "id": index.get("id", ""),
            "root": index.get("root", ""),
            "created": index.get("created", ""),
            "schema": EVIDENCE_INPUT_SCHEMA_VERSION,
        }
    ]
    for file_item in index.get("files", []):
        chunks = []
        for chunk in file_item.get("chunks", []):
            chunks.append(
                {
                    "chunk": chunk.get("chunk", ""),
                    "content_sha256": chunk.get("content_sha256", ""),
                    "signals_sha256": sha256_hex(json.dumps(chunk.get("signals", {}), sort_keys=True).encode("utf-8")),
                }
            )
        items.append(
            {
                "path": file_item.get("path", ""),
                "signals_sha256": sha256_hex(json.dumps(file_item.get("signals", {}), sort_keys=True).encode("utf-8")),
                "chunks": chunks,
            }
        )
    return sha256_hex(json.dumps(items, sort_keys=True, ensure_ascii=False).encode("utf-8"))


def org_heading_metadata(title: str) -> dict:
    title = title.strip()
    tags = []
    tag_match = re.search(r"\s+(:[A-Za-z0-9_@#%:]+:)\s*$", title)
    if tag_match:
        tags = [tag for tag in tag_match.group(1).strip(":").split(":") if tag]
        title = title[: tag_match.start()].rstrip()
    parts = title.split()
    todo = ""
    priority = ""
    if parts and parts[0].upper() in ORG_TODO_KEYWORDS:
        todo = parts.pop(0).upper()
    if parts and re.fullmatch(r"\[#([A-Z])\]", parts[0]):
        priority = parts.pop(0)[2]
    clean_title = " ".join(parts).strip() or title
    return {
        "title": clean_title,
        "todo": todo,
        "priority": priority,
        "date": org_date_from_line(title),
        "tags": tags,
    }


def org_heading_sections(content: str) -> list[dict]:
    headings = []
    stack = []
    offset = 0
    for line in content.splitlines(keepends=True):
        stripped = line.rstrip()
        match = re.match(r"^(\*+)\s+(.*)$", stripped)
        if match:
            level = len(match.group(1))
            raw_title = match.group(2).strip()
            meta = org_heading_metadata(raw_title)
            while stack and int(stack[-1].get("level", 0) or 0) >= level:
                stack.pop()
            parent_titles = [str(row.get("title", "")) for row in stack if row.get("title")]
            inherited_tags = []
            for row in stack:
                for tag in row.get("tags", []) or []:
                    if tag not in inherited_tags:
                        inherited_tags.append(tag)
            local_tags = [str(tag) for tag in meta.get("tags", []) if str(tag).strip()]
            all_tags = list(inherited_tags)
            for tag in local_tags:
                if tag not in all_tags:
                    all_tags.append(tag)
            heading = {
                "start": offset,
                "level": level,
                "raw_title": raw_title,
                "title": meta.get("title", raw_title),
                "todo": meta.get("todo", ""),
                "priority": meta.get("priority", ""),
                "date": meta.get("date", ""),
                "tags": all_tags,
                "local_tags": local_tags,
                "inherited_tags": [tag for tag in inherited_tags if tag not in local_tags],
                "parent_titles": parent_titles,
            }
            headings.append(heading)
            stack.append(heading)
        offset += len(line)
    sections = []
    for idx, heading in enumerate(headings):
        level = int(heading.get("level", 1) or 1)
        end = len(content)
        for next_heading in headings[idx + 1 :]:
            if int(next_heading.get("level", 1) or 1) <= level:
                end = int(next_heading.get("start", end))
                break
        row = dict(heading)
        row["end"] = end
        row["text"] = content[int(row["start"]) : end].strip()
        if row["text"]:
            sections.append(row)
    return sections


def markdown_heading_sections(content: str) -> list[dict]:
    headings = []
    stack = []
    offset = 0
    for line in content.splitlines(keepends=True):
        stripped = line.rstrip()
        match = re.match(r"^(#{1,6})\s+(.+)$", stripped)
        if match:
            level = len(match.group(1))
            title = match.group(2).strip()
            while stack and int(stack[-1].get("level", 0) or 0) >= level:
                stack.pop()
            heading = {
                "start": offset,
                "level": level,
                "title": title,
                "parent_titles": [str(row.get("title", "")) for row in stack if row.get("title")],
            }
            headings.append(heading)
            stack.append(heading)
        offset += len(line)
    sections = []
    for idx, heading in enumerate(headings):
        level = int(heading.get("level", 1) or 1)
        end = len(content)
        for next_heading in headings[idx + 1 :]:
            if int(next_heading.get("level", 1) or 1) <= level:
                end = int(next_heading.get("start", end))
                break
        row = dict(heading)
        row["end"] = end
        row["text"] = content[int(row["start"]) : end].strip()
        if row["text"]:
            sections.append(row)
    return sections


def paragraph_spans(content: str, *, limit: int = EVIDENCE_PARAGRAPH_LIMIT_PER_CHUNK) -> list[dict]:
    rows = []
    for match in re.finditer(r"\S(?:.*?\S)?(?=\n\s*\n|\Z)", content, flags=re.DOTALL):
        text = match.group(0).strip()
        if not text:
            continue
        rows.append({"start": match.start(), "end": match.end(), "text": text})
        if len(rows) >= limit:
            break
    return rows


def evidence_window_spans(content: str, *, window_chars: int = EVIDENCE_WINDOW_CHARS) -> list[dict]:
    if len(content.strip()) <= window_chars:
        return []
    rows = []
    step = max(1, int(window_chars * 0.75))
    start = 0
    while start < len(content) and len(rows) < EVIDENCE_WINDOW_LIMIT_PER_CHUNK:
        end = min(len(content), start + window_chars)
        boundary = content.rfind("\n\n", start, end)
        if boundary > start + window_chars // 2:
            end = boundary
        text = content[start:end].strip()
        if text:
            rows.append({"start": start, "end": end, "text": text})
        if end >= len(content):
            break
        start = max(start + step, end - window_chars // 4)
    if rows and int(rows[-1].get("end", 0) or 0) < len(content):
        tail_start = max(0, len(content) - window_chars)
        rows.append({"start": tail_start, "end": len(content), "text": content[tail_start:].strip()})
    return rows


def evidence_row_id(index: dict, file_item: dict, chunk: dict, kind: str, start: int, end: int, text: str) -> str:
    payload = "|".join(
        [
            str(index.get("id", "")),
            str(file_item.get("path", "")),
            str(chunk.get("chunk", "")),
            kind,
            str(start),
            str(end),
            sha256_hex(text.encode("utf-8")),
        ]
    )
    return "ev-" + sha256_hex(payload.encode("utf-8"))[:24]


def make_evidence_object(
    index: dict,
    file_item: dict,
    chunk: dict,
    *,
    kind: str,
    start: int,
    end: int,
    text: str,
    title: str = "",
    level: int = 0,
    parent_titles: list[str] | None = None,
    todo: str = "",
    priority: str = "",
    date: str = "",
    tags: list[str] | None = None,
    local_tags: list[str] | None = None,
    inherited_tags: list[str] | None = None,
) -> dict:
    text = text.strip()
    if not text:
        return {}
    start = max(0, int(start or 0))
    end = max(start, int(end or start))
    row = {
        "id": evidence_row_id(index, file_item, chunk, kind, start, end, text),
        "kind": kind,
        "index": index.get("id", ""),
        "path": file_item.get("path", ""),
        "chunk": chunk.get("chunk", ""),
        "content_sha256": chunk.get("content_sha256", ""),
        "source_fingerprint": chunk.get("content_sha256", ""),
        "source_span": {"start": start, "end": end},
        "start": start,
        "end": end,
        "title": compact_text(title, 180),
        "level": level,
        "parent_titles": [compact_text(item, 120) for item in (parent_titles or []) if str(item).strip()],
        "todo": todo,
        "priority": priority,
        "date": date,
        "tags": [compact_text(str(tag), 80) for tag in (tags or []) if str(tag).strip()],
        "local_tags": [compact_text(str(tag), 80) for tag in (local_tags or []) if str(tag).strip()],
        "inherited_tags": [compact_text(str(tag), 80) for tag in (inherited_tags or []) if str(tag).strip()],
        "text": compact_source_text_middle(text, EVIDENCE_TEXT_LIMIT),
        "text_sha256": sha256_hex(text.encode("utf-8")),
        "text_chars": len(text),
    }
    return {key: value for key, value in row.items() if value not in ("", [], {}, None)}


def evidence_objects_for_chunk(index: dict, file_item: dict, chunk: dict) -> list[dict]:
    content = read_chunk_content(index, chunk)
    if not content.strip():
        return []
    rows = []
    path = str(file_item.get("path", "")).lower()
    if path.endswith(".org") or re.search(r"(?m)^\*+\s+", content):
        for section in org_heading_sections(content):
            kind = "org_heading"
            if section.get("date"):
                kind = "org_day"
            if section.get("todo"):
                kind = "org_task"
            row = make_evidence_object(
                index,
                file_item,
                chunk,
                kind=kind,
                start=int(section.get("start", 0)),
                end=int(section.get("end", 0)),
                text=str(section.get("text", "")),
                title=str(section.get("title", "")),
                level=int(section.get("level", 0) or 0),
                parent_titles=section.get("parent_titles", []),
                todo=str(section.get("todo", "")),
                priority=str(section.get("priority", "")),
                date=str(section.get("date", "")),
                tags=section.get("tags", []),
                local_tags=section.get("local_tags", []),
                inherited_tags=section.get("inherited_tags", []),
            )
            if row:
                rows.append(row)
    if path.endswith((".md", ".markdown")) or re.search(r"(?m)^#{1,6}\s+", content):
        for section in markdown_heading_sections(content):
            row = make_evidence_object(
                index,
                file_item,
                chunk,
                kind="markdown_heading",
                start=int(section.get("start", 0)),
                end=int(section.get("end", 0)),
                text=str(section.get("text", "")),
                title=str(section.get("title", "")),
                level=int(section.get("level", 0) or 0),
                parent_titles=section.get("parent_titles", []),
            )
            if row:
                rows.append(row)
    for span in paragraph_spans(content):
        row = make_evidence_object(
            index,
            file_item,
            chunk,
            kind="paragraph",
            start=int(span.get("start", 0)),
            end=int(span.get("end", 0)),
            text=str(span.get("text", "")),
        )
        if row:
            rows.append(row)
    for idx, span in enumerate(evidence_window_spans(content), 1):
        row = make_evidence_object(
            index,
            file_item,
            chunk,
            kind="text_window",
            start=int(span.get("start", 0)),
            end=int(span.get("end", 0)),
            text=str(span.get("text", "")),
            title=f"window {idx}",
        )
        if row:
            rows.append(row)
    deduped = []
    seen = set()
    for row in rows:
        key = (row.get("kind"), row.get("path"), str(row.get("chunk", "")), row.get("start"), row.get("end"), row.get("text_sha256"))
        if key in seen:
            continue
        seen.add(key)
        deduped.append(row)
    return deduped


def build_evidence_store_from_index(index: dict, *, store_id: str | None = None, write: bool = True) -> dict:
    store_id = store_id or _dt.datetime.now().strftime("%Y%m%d-%H%M%S") + "-" + uuid.uuid4().hex[:6]
    source_fingerprint = evidence_store_source_fingerprint(index)
    rows = []
    for file_item in index.get("files", []):
        for chunk in file_item.get("chunks", []):
            rows.extend(evidence_objects_for_chunk(index, file_item, chunk))
    kind_counts = dict(collections.Counter(row.get("kind", "unknown") for row in rows))
    store = {
        "schema": EVIDENCE_STORE_SCHEMA_VERSION,
        "id": store_id,
        "created": now(),
        "realm": identity_realm(),
        "evidence_input_schema": EVIDENCE_INPUT_SCHEMA_VERSION,
        "source_index": {
            "id": index.get("id", ""),
            "name": index.get("name", ""),
            "root": index.get("root", ""),
            "created": index.get("created", ""),
            "glob": index.get("glob") or AUTO_INDEX_GLOB,
            "family_key": index_family_key(index),
            "fingerprint": source_fingerprint,
        },
        "provenance": artifact_provenance(
            "evidence-store",
            EVIDENCE_STORE_SCHEMA_VERSION,
            deterministic=True,
            source_sha256=source_fingerprint,
        ),
        "rows": rows,
        "row_count": len(rows),
        "kind_counts": kind_counts,
        "note": "Deterministic hierarchical evidence objects for retrieval, vectorization, and source-grounding audits.",
    }
    store["provenance"].update(
        {
            "source_realm": identity_realm(),
            "security_context": permission_mode(),
            "input_hash": source_fingerprint,
            "source_fingerprint": {"sha256": source_fingerprint},
        }
    )
    if write:
        path = evidence_store_path(store_id)
        store["path"] = str(path)
        atomic_write(path, json.dumps(store, ensure_ascii=False, indent=2) + "\n")
    return store


def list_evidence_stores() -> list[dict]:
    rows = []
    root = evidence_stores_dir()
    if not root.exists():
        return []
    for path in sorted(root.glob("*.json"), reverse=True):
        try:
            store = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            continue
        if isinstance(store, dict):
            store.setdefault("path", str(path))
            rows.append(store)
    return rows


def evidence_store_label(store: dict) -> str:
    source = store.get("source_index") if isinstance(store.get("source_index"), dict) else {}
    return (
        f"{store.get('id', '')}  "
        f"{store.get('row_count', len(store.get('rows', [])))} row(s)  "
        f"{source.get('name', '')} {source.get('root', '')}"
    )


def load_evidence_store(store_id: str | None = None) -> dict:
    return prompt_for_selection(
        list_evidence_stores(),
        kind="evidence store",
        label_func=evidence_store_label,
        selector=store_id,
    )


def latest_evidence_store() -> dict:
    rows = list_evidence_stores()
    if not rows:
        raise SystemExit("No evidence stores yet. Run 'motoko evidence-build [INDEX_ID]' first.")
    return rows[0]


def evidence_store_matches_index(store: dict, index: dict) -> bool:
    source = store.get("source_index") if isinstance(store.get("source_index"), dict) else {}
    return source.get("id") == index.get("id")


def evidence_store_freshness(store: dict) -> tuple[str, list[str]]:
    if str(store.get("schema") or "") != EVIDENCE_STORE_SCHEMA_VERSION:
        return "stale", [f"evidence store schema is {store.get('schema') or 'missing'}; rebuild for {EVIDENCE_STORE_SCHEMA_VERSION}"]
    if str(store.get("evidence_input_schema") or "") != EVIDENCE_INPUT_SCHEMA_VERSION:
        return "stale", [f"evidence input schema is {store.get('evidence_input_schema') or 'missing'}; rebuild for {EVIDENCE_INPUT_SCHEMA_VERSION}"]
    source = store.get("source_index") if isinstance(store.get("source_index"), dict) else {}
    index_id = str(source.get("id", ""))
    if not index_id:
        return "unknown", ["store has no source index id"]
    try:
        index = load_index_exact(index_id)
    except SystemExit as exc:
        return "stale", [f"source index unavailable: {exc}"]
    index_status, index_warnings = index_staleness(index)
    if index_status == "stale":
        return "stale", [f"source index is stale: {warning}" for warning in index_warnings[:4]] or ["source index is stale"]
    if index_status in {"unknown", "metadata-changed"}:
        return index_status, index_warnings[:4]
    current = evidence_store_source_fingerprint(index)
    if current != source.get("fingerprint"):
        return "stale", ["source index fingerprint changed; rebuild this evidence store"]
    return "fresh", []


def latest_evidence_store_for_index(index: dict, *, fresh_only: bool = True) -> dict | None:
    for store in list_evidence_stores():
        if not evidence_store_matches_index(store, index):
            continue
        if fresh_only:
            freshness, _warnings = evidence_store_freshness(store)
            if freshness != "fresh":
                continue
        return store
    return None


def evidence_store_for_retrieval(index: dict) -> dict:
    store = latest_evidence_store_for_index(index, fresh_only=True)
    if store is not None:
        return store
    return build_evidence_store_from_index(index, write=False)


def evidence_store_due(index: dict) -> tuple[bool, str]:
    store = latest_evidence_store_for_index(index, fresh_only=False)
    if store is None:
        return True, "missing"
    freshness, warnings = evidence_store_freshness(store)
    if freshness != "fresh":
        detail = "; ".join(warnings[:2]) if warnings else freshness
        return True, detail or "stale"
    return False, "fresh"


def evidence_refresh_candidates(*, index_id: str | None = None, force: bool = False) -> list[tuple[dict, str]]:
    indexes = [load_index(index_id)] if index_id else latest_indexes_by_family()
    rows = []
    for index in indexes:
        status, _warnings = index_staleness(index)
        if status == "stale":
            rows.append((index, "skip: source index stale"))
            continue
        due, reason = evidence_store_due(index)
        if due or force:
            rows.append((index, reason if due else "force"))
    return rows


def refresh_evidence_stores(*, index_id: str | None = None, force: bool = False, limit: int = 1) -> dict:
    limit = max(1, int(limit or 1))
    report = {
        "schema": "evidence-refresh-v1",
        "created": now(),
        "limit": limit,
        "items": [],
    }
    built = 0
    for index, reason in evidence_refresh_candidates(index_id=index_id, force=force):
        if built >= limit:
            break
        item = {
            "index": index.get("id", ""),
            "name": index.get("name", ""),
            "root": index.get("root", ""),
            "reason": reason,
        }
        if reason.startswith("skip:"):
            item["status"] = "skipped"
            report["items"].append(item)
            continue
        try:
            store = build_evidence_store_from_index(index, write=True)
        except SystemExit as exc:
            item["status"] = "failed"
            item["error"] = str(exc)
        else:
            item["status"] = "built"
            item["store_id"] = store.get("id", "")
            item["rows"] = store.get("row_count", 0)
            item["path"] = store.get("path", "")
            built += 1
        report["items"].append(item)
    report["built"] = built
    report["status"] = "built" if built else ("empty" if not report["items"] else "no-build")
    return report


def format_evidence_refresh_report(report: dict) -> str:
    lines = [
        f"evidence refresh: {report.get('status', 'unknown')} built={report.get('built', 0)}",
        f"created: {report.get('created', '')}",
    ]
    if not report.get("items"):
        lines.append("no evidence refresh candidates")
        return "\n".join(lines)
    for item in report.get("items", []):
        lines.append(
            f"- {item.get('status', 'unknown')}: {item.get('index', '')} "
            f"{item.get('name', '')} ({item.get('reason', '')})"
        )
        if item.get("store_id"):
            lines.append(f"  store: {item.get('store_id', '')} rows={item.get('rows', 0)}")
        if item.get("error"):
            lines.append(f"  error: {item.get('error', '')}")
    return "\n".join(lines)


def evidence_row_haystack(row: dict) -> str:
    return "\n".join(
        part
        for part in [
            row.get("path", ""),
            row.get("kind", ""),
            row.get("title", ""),
            " ".join(row.get("parent_titles", []) or []),
            row.get("todo", ""),
            row.get("priority", ""),
            row.get("date", ""),
            " ".join(row.get("tags", []) or []),
            " ".join(f":{tag}:" for tag in row.get("tags", []) or []),
            row.get("text", ""),
        ]
        if str(part).strip()
    )


def evidence_recent_dates(store: dict, count: int) -> set[str]:
    dates = sorted({str(row.get("date", "")) for row in store.get("rows", []) if row.get("date")})
    return set(dates[-max(1, min(count, len(dates))) :]) if dates else set()


def evidence_score_parts(store: dict, query: str, query_counts: collections.Counter, row: dict) -> dict:
    lexical = score_text(query_counts, evidence_row_haystack(row))
    path_boost = query_path_match_boost(query, row.get("path", ""))
    structured = 0
    kind = str(row.get("kind", ""))
    if kind in {"org_day", "org_task"}:
        structured += 30
    if kind == "org_task" and query_wants_task_context(query):
        structured += 80
    if row.get("priority"):
        structured += {"A": 40, "B": 20, "C": 10}.get(str(row.get("priority")), 5)
    exact_dates = set(query_date_mentions(query))
    if exact_dates and row.get("date") in exact_dates:
        structured += 4000
    recent_count = query_requested_recent_section_count(query)
    if recent_count and row.get("date") in evidence_recent_dates(store, recent_count):
        structured += 3500
    matched_terms = retrieval_haystack_terms(query_counts, evidence_row_haystack(row))
    total = lexical + path_boost + structured
    return {
        "total": total,
        "lexical": lexical,
        "path_boost": path_boost,
        "structured": structured,
        "matched_terms": matched_terms[:16],
    }


def query_evidence_store(store: dict, query: str, *, limit: int = EVIDENCE_QUERY_LIMIT) -> dict:
    query = query.strip()
    if not query:
        raise SystemExit("usage: evidence-query QUERY")
    limit = max(1, min(int(limit or EVIDENCE_QUERY_LIMIT), 100))
    query_counts = token_counts(query)
    rows = []
    for row in store.get("rows", []):
        if not isinstance(row, dict):
            continue
        parts = evidence_score_parts(store, query, query_counts, row)
        if parts.get("total", 0) <= 0:
            continue
        item = dict(row)
        item.update(parts)
        rows.append(item)
    rows.sort(
        key=lambda item: (
            float(item.get("total", 0) or 0),
            float(item.get("structured", 0) or 0),
            -int(item.get("text_chars", 0) or 0),
        ),
        reverse=True,
    )
    freshness, warnings = evidence_store_freshness(store) if store.get("path") else ("not-persisted", [])
    return {
        "schema": EVIDENCE_QUERY_SCHEMA_VERSION,
        "created": now(),
        "query": query,
        "store_id": store.get("id", ""),
        "source_index": store.get("source_index", {}),
        "freshness": freshness,
        "warnings": warnings,
        "rows": rows[:limit],
    }


def format_evidence_store(store: dict) -> str:
    source = store.get("source_index") if isinstance(store.get("source_index"), dict) else {}
    freshness, warnings = evidence_store_freshness(store) if store.get("path") else ("not-persisted", [])
    lines = [
        f"evidence store: {store.get('id', '')}",
