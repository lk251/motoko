def format_tool_catalog() -> str:
    rows = all_skill_tool_rows()
    if not rows:
        return "tool catalog: no skill tools declared"
    lines = [f"tool catalog: {len(rows)} declared skill tool(s)"]
    for row in rows:
        if row.get("valid") is not True:
            lines.append(f"- {row.get('skill', '')}/{row.get('name', '')}: invalid")
            lines.append(f"  error: {row.get('error', '')}")
            continue
        approval = core_format_tool_rows([row], approval_path=tool_approvals_path(), realm=identity_realm()).splitlines()[1:]
        lines.append(f"- {row.get('skill', '')}/{row.get('name', '')}")
        for line in approval:
            lines.append("  " + line.strip())
    return "\n".join(lines)


def _action_plan_terms(text: str) -> set[str]:
    return set(re.findall(r"[a-z0-9_.-]{3,}", str(text or "").lower()))


def _query_integer_hint(query: str) -> int | None:
    match = re.search(r"\b([1-9][0-9]{0,3})\b", str(query or ""))
    if match:
        return int(match.group(1))
    words = {
        "one": 1,
        "two": 2,
        "three": 3,
        "four": 4,
        "five": 5,
        "six": 6,
        "seven": 7,
        "eight": 8,
        "nine": 9,
        "ten": 10,
    }
    lowered = str(query or "").lower()
    for word, value in words.items():
        if re.search(rf"\b{re.escape(word)}\b", lowered):
            return value
    return None


def infer_action_arguments(tool: dict, query: str) -> tuple[dict, list[str]]:
    schema = tool.get("argument_schema") or {"type": "object", "properties": {}, "required": []}
    props = schema.get("properties") if isinstance(schema, dict) else {}
    required = schema.get("required") if isinstance(schema, dict) else []
    props = props if isinstance(props, dict) else {}
    required = required if isinstance(required, list) else []
    path_mentions = query_path_mentions(query)
    number_hint = _query_integer_hint(query)
    arguments = {}
    for key, spec in props.items():
        spec = spec if isinstance(spec, dict) else {}
        key_l = str(key).lower()
        value_type = spec.get("type", "string")
        if value_type == "string" and any(marker in key_l for marker in ("path", "file", "dir")) and path_mentions:
            arguments[key] = path_mentions[0]
        elif value_type == "integer" and number_hint is not None and key_l in {"count", "limit", "n", "days"}:
            arguments[key] = number_hint
        elif value_type == "boolean" and key_l in {"dry_run", "preview"}:
            arguments[key] = True
    missing = [str(key) for key in required if key not in arguments]
    return arguments, missing


def format_action_plan(query: str, *, limit: int = 5) -> str:
    query = str(query or "").strip()
    if not query:
        return "usage: /action plan QUERY"
    query_terms = _action_plan_terms(query)
    candidates = []
    for skill in active_skills():
        skill_text = "\n".join([skill.get("name", ""), skill.get("description", ""), skill.get("body", "")[:3000]])
        skill_terms = _action_plan_terms(skill_text)
        for tool in core_list_skill_tools(skill):
            if tool.get("valid") is not True:
                continue
            tool_text = "\n".join(
                [
                    tool.get("name", ""),
                    tool.get("description", ""),
                    tool.get("metadata_relpath", ""),
                    tool.get("script_relpath", ""),
                    ", ".join(tool.get("allowed_effects", [])),
                ]
            )
            terms = skill_terms | _action_plan_terms(tool_text)
            overlap = query_terms & terms
            if not overlap:
                continue
            score = len(overlap) * 10
            if any(term in _action_plan_terms(tool.get("name", "")) for term in query_terms):
                score += 20
            if any(term in _action_plan_terms(skill.get("name", "")) for term in query_terms):
                score += 10
            arguments, missing = infer_action_arguments(tool, query)
            action = {
                "schema": "motoko-action-v1",
                "kind": "skill_tool_run",
                "skill": tool.get("skill", ""),
                "tool": tool.get("name", ""),
                "arguments": arguments,
                "reason": f"Matched query terms: {', '.join(sorted(overlap)[:12])}",
            }
            validation = None
            if not missing:
                try:
                    validation = core_validate_action_record(
                        action,
                        skill_resolver=lambda name: core_load_skill(skills_dir(), name),
                        approval_path=tool_approvals_path(),
                        realm=identity_realm(),
                        path_checker=action_path_checker,
                        preview=True,
                    )
                except AgenticValidationError as exc:
                    validation = {
                        "status": "rejected",
                        "approval": "not-applicable",
                        "reason": str(exc),
                    }
            candidates.append(
                {
                    "score": score,
                    "skill": tool.get("skill", ""),
                    "tool": tool.get("name", ""),
                    "description": tool.get("description", ""),
                    "effects": tool.get("allowed_effects", []),
                    "matched_terms": sorted(overlap),
                    "missing": missing,
                    "action": action,
                    "validation": validation,
                }
            )
    candidates.sort(key=lambda row: (row["score"], row["skill"], row["tool"]), reverse=True)
    lines = [
        f"action plan: {query}",
        "model calls: none",
        "candidate tools:",
    ]
    if not candidates:
        lines.append("- none")
        return "\n".join(lines)
    for row in candidates[: max(1, min(20, int(limit or 5)))]:
        status = "needs_arguments" if row["missing"] else (row["validation"] or {}).get("status", "unknown")
        approval = "not-checked" if row["missing"] else (row["validation"] or {}).get("approval", "")
        lines.append(f"- {row['skill']}/{row['tool']}  score={row['score']}  status={status}  approval={approval}")
        lines.append(f"  effects: {', '.join(row['effects'])}")
        lines.append(f"  matched: {', '.join(row['matched_terms'][:12])}")
        if row["missing"]:
            lines.append(f"  missing required args: {', '.join(row['missing'])}")
        if row["description"]:
            lines.append(f"  description: {row['description']}")
        lines.append("  suggested action:")
        for action_line in json.dumps(row["action"], ensure_ascii=False, indent=2).splitlines():
            lines.append("    " + action_line)
    return "\n".join(lines)


