def finish_model_call_record(
    record: dict,
    *,
    started: float,
    first_token_at: float = 0.0,
    completion_text: str = "",
    error: BaseException | None = None,
) -> None:
    record = dict(record)
    duration = max(0.0, time.monotonic() - started)
    record["finished"] = now()
    record["duration_seconds"] = round(duration, 3)
    record["completion_tokens_estimate"] = estimate_text_tokens(completion_text)
    if first_token_at:
        record["time_to_first_token_seconds"] = round(max(0.0, first_token_at - started), 3)
    if duration > 0 and record.get("completion_tokens_estimate"):
        record["generation_tokens_per_second_estimate"] = round(
            float(record["completion_tokens_estimate"]) / duration,
            3,
        )
    if error is not None:
        record["status"] = "failed"
        record["error_type"] = type(error).__name__
    else:
        record["status"] = "completed"
    write_last_model_call(record)


