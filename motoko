def tui_enabled() -> bool:
    raw = os.environ.get("MOTOKO_TUI", "1").strip().lower()
    if raw in {"0", "false", "no", "off", "line"}:
        return False
    return sys.stdin.isatty() and sys.stdout.isatty() and os.environ.get("TERM", "") != "dumb"


def strip_ansi(text: str) -> str:
    return re.sub(r"\x1b\[[0-9;?]*[A-Za-z]", "", text)


def cell_width(char: str) -> int:
    if not char:
        return 0
    category = unicodedata.category(char)
    if category in {"Cc", "Cf"} or unicodedata.combining(char):
        return 0
    if unicodedata.east_asian_width(char) in {"F", "W"}:
        return 2
    return 1


def display_width(text: str) -> int:
    return sum(cell_width(char) for char in strip_ansi(text))


def split_cells(text: str, width: int) -> list[tuple[str, int, int]]:
    width = max(1, width)
    if not text:
        return [("", 0, 0)]
    segments: list[tuple[str, int, int]] = []
    start = 0
    current: list[str] = []
    current_width = 0
    for idx, char in enumerate(text):
        char_width = cell_width(char)
        if current and current_width + char_width > width:
            segments.append(("".join(current), start, idx))
            start = idx
            current = []
            current_width = 0
        current.append(char)
        current_width += char_width
    segments.append(("".join(current), start, len(text)))
    return segments


def cursor_segment_index(segments: list[tuple[str, int, int]], cursor: int) -> int:
    if cursor <= 0:
        return 0
    if cursor >= segments[-1][2]:
        return len(segments) - 1
    for idx, (_text, start, end) in enumerate(segments):
        if start <= cursor < end:
            return idx
        if cursor == end and idx + 1 < len(segments) and segments[idx + 1][1] == cursor:
            return idx + 1
    return len(segments) - 1


def wrap_display_line(text: str, width: int) -> list[str]:
    if width <= 4:
        return [strip_ansi(text)[:width]]
    if not text:
        return [""]
    chunks = []
    ansi_re = re.compile(r"\x1b\[[0-9;?]*[A-Za-z]")
    for part in str(text).splitlines() or [""]:
        line = ""
        line_width = 0
        active_sgr = ""
        idx = 0
        while idx < len(part):
            match = ansi_re.match(part, idx)
            if match:
                escape = match.group(0)
                line += escape
                if escape.endswith("m"):
                    active_sgr = "" if escape == "\033[0m" else escape
                idx = match.end()
                continue
            char = part[idx]
            char_width = cell_width(char)
            if line and line_width + char_width > width:
                if active_sgr:
                    line += "\033[0m"
                chunks.append(line)
                line = active_sgr
                line_width = 0
            line += char
            line_width += char_width
            idx += 1
        if active_sgr and not line.endswith("\033[0m"):
            line += "\033[0m"
        chunks.append(line)
    return chunks or [""]


def fixed_prompt_input_display(
    input_buffer: str,
    cursor: int,
    width: int,
    *,
    prompt: str = "> ",
    max_rows: int = 4,
) -> tuple[list[str], int, int]:
    prompt_width = display_width(prompt)
    usable = max(10, width - prompt_width)
    cursor = max(0, min(cursor, len(input_buffer)))
    segments = split_cells(input_buffer, usable)
    if (
        cursor == len(input_buffer)
        and segments
        and display_width(segments[-1][0]) >= usable
    ):
        segments.append(("", cursor, cursor))

    cursor_row = cursor_segment_index(segments, cursor)
    shown_start = min(
        max(0, cursor_row - max_rows + 1),
        max(0, len(segments) - max_rows),
    )
    shown = segments[shown_start : shown_start + max_rows]
    cursor_row_offset = max(0, cursor_row - shown_start)
    _current_line, start, _end = segments[cursor_row]
    cursor_col = prompt_width + display_width(input_buffer[start:cursor]) + 1

    rows = []
    for offset, (line, _start, _end) in enumerate(shown):
        segment_index = shown_start + offset
        prefix = style(prompt, "turquoise", "bold") if segment_index == 0 else " " * prompt_width
        rows.append(prefix + line)
    return rows, cursor_row_offset, cursor_col


def utf8_key_from_first_byte(fd: int, first: bytes) -> str:
    if not first:
        return ""
    value = first[0]
    if value < 0x80:
        return first.decode("utf-8", errors="replace")
    if 0xC0 <= value <= 0xDF:
        needed = 2
    elif 0xE0 <= value <= 0xEF:
        needed = 3
    elif 0xF0 <= value <= 0xF7:
        needed = 4
    else:
        return first.decode("utf-8", errors="replace")
    seq = bytearray(first)
    while len(seq) < needed:
        readable, _writeable, _errors = select.select([fd], [], [], 0.02)
        if not readable:
            break
        seq.extend(os.read(fd, 1))
    return bytes(seq).decode("utf-8", errors="replace")


class MotokoTui:
    def __init__(self, conv: dict) -> None:
        self.conv = conv
        self.stdin_fd = sys.stdin.fileno()
        self.stdout_fd = sys.stdout.fileno()
        self.old_termios = None
        self.running = True
        self.dirty = True
        self.status = "ready"
        self.maintenance_status = ""
        self.maintenance_phase_started = time.monotonic()
        self.input_buffer = ""
        self.cursor = 0
        self.kill_ring = ""
        self.history: list[str] = []
        self.history_index: int | None = None
        self.scroll = 0
        self.dropdown_index = 0
        self.events: collections.deque[tuple] = collections.deque()
        self.events_lock = threading.Lock()
        self.generating = False
        self.maintaining = False
        self.study_running = False
        self.study_status = "study: starting"
        self.study_last_note = ""
        self.study_phase_started = time.monotonic()
        self.last_input_at = time.monotonic()
        self.cancel_event = threading.Event()
        self.pending_prompts: collections.deque[str] = collections.deque()
        self.answer_entry: dict | None = None
        self.last_render = 0.0
        self.tui_spinner_frames = spinner_frames() or ["*"]
        self.tui_spinner_index = 0
        self.overlay_title: str | None = None
        self.overlay_lines: list[str] | None = None
        self.overlay_scroll = 0
        self.cwd_index_offer: dict | None = None
        self.cwd_indexing = False
        self.index_progress: dict | None = None
        self.messages = self.seed_messages(conv)
        self.resume_maintenance_on_start, resume_note = resume_interrupted_maintenance(conv)
        if resume_note:
            self.append("system", resume_note)
        self.maybe_offer_cwd_learning()

    def seed_messages(self, conv: dict) -> list[dict]:
        rows = [
            {
                "role": "system",
                "content": f"Motoko conversation: {conv.get('title', 'Untitled')} [{conv.get('id', '')}]",
            },
            {
                "role": "system",
                "content": "Type / for commands. Use arrows to select menu entries. Ctrl+C exits.",
            },
        ]
        if conv.get("summary"):
            rows.append({"role": "summary", "content": conv.get("summary", "")})
        for msg in conv.get("messages", [])[-MAX_RECENT_MESSAGES:]:
            rows.append({"role": msg.get("role", "?"), "content": msg.get("content", "")})
        return rows

    def append(self, role: str, content: str) -> dict:
        row = {"role": role, "content": content}
        self.messages.append(row)
        self.scroll = 0
        self.dirty = True
        return row

    def run(self) -> None:
        old_winch = signal.getsignal(signal.SIGWINCH)

        def on_winch(_signum, _frame):
            self.dirty = True

        try:
            self.old_termios = termios.tcgetattr(self.stdin_fd)
            tty.setcbreak(self.stdin_fd)
            signal.signal(signal.SIGWINCH, on_winch)
            self.write("\033[?25l\033[?7l")
            self.render(force=True)
            self.start_study_loop()
            if self.resume_maintenance_on_start:
                self.resume_maintenance_on_start = False
                self.start_maintenance(resumed=True)
            while self.running:
                self.drain_events()
                timeout = 0.04 if self.generating or self.maintaining or self.study_running else 0.12
                readable, _writeable, _errors = select.select([self.stdin_fd], [], [], timeout)
                if readable:
                    self.last_input_at = time.monotonic()
                    self.handle_key(self.read_key())
                now_ts = time.monotonic()
                if self.dirty or ((self.generating or self.maintaining or self.study_running) and now_ts - self.last_render > 0.08):
                    self.render()
        finally:
            signal.signal(signal.SIGWINCH, old_winch)
            self.restore_terminal()

    def restore_terminal(self) -> None:
        if self.old_termios is not None:
            termios.tcsetattr(self.stdin_fd, termios.TCSADRAIN, self.old_termios)
            self.old_termios = None
        self.write("\033[?7h\033[?25h\033[0m\n")

    def write(self, text: str) -> None:
        os.write(self.stdout_fd, text.encode("utf-8", errors="replace"))

    def read_key(self) -> str:
        first = os.read(self.stdin_fd, 1)
        if not first:
            return ""
        if first != b"\x1b":
            return utf8_key_from_first_byte(self.stdin_fd, first)
        seq = bytearray(first)
        while True:
            readable, _writeable, _errors = select.select([self.stdin_fd], [], [], 0.01)
            if not readable:
                break
            nxt = os.read(self.stdin_fd, 1)
            if not nxt:
                break
            seq.extend(nxt)
            if nxt.isalpha() or nxt == b"~":
                break
        text = bytes(seq).decode("utf-8", errors="replace")
        keymap = {
            "\x1b[A": "up",
            "\x1b[B": "down",
            "\x1b[C": "right",
            "\x1b[D": "left",
            "\x1b[H": "home",
            "\x1b[F": "end",
            "\x1b[1~": "home",
            "\x1b[4~": "end",
            "\x1b[3~": "delete",
            "\x1b[5~": "pageup",
            "\x1b[6~": "pagedown",
            "\x1bb": "word-left",
            "\x1bf": "word-right",
            "\x1bB": "word-left",
            "\x1bF": "word-right",
        }
        return keymap.get(text, "escape")

    def handle_key(self, key: str) -> None:
        if key == "\x03":
            save_conversation(self.conv)
            self.running = False
            return
        if key == "\x04":  # Ctrl+D
            if self.input_buffer and self.cursor < len(self.input_buffer):
                self.input_buffer = self.input_buffer[: self.cursor] + self.input_buffer[self.cursor + 1 :]
                self.dropdown_index = 0
                self.dirty = True
            elif not self.input_buffer:
                save_conversation(self.conv)
                self.running = False
            return
        if self.overlay_lines is not None:
            if key in {"escape", "q", "Q"}:
                self.close_overlay()
                return
            if key == "up":
                self.overlay_scroll = max(0, self.overlay_scroll - 1)
                self.dirty = True
                return
            if key == "down":
                self.overlay_scroll += 1
                self.dirty = True
                return
            if key == "pageup":
                self.overlay_scroll = max(0, self.overlay_scroll - 8)
                self.dirty = True
                return
            if key == "pagedown":
                self.overlay_scroll += 8
                self.dirty = True
                return
            return
        if key in {"\r", "\n"}:
            self.handle_enter()
            return
        if key in {"\x7f", "\b"}:
            if self.cursor > 0:
                self.input_buffer = self.input_buffer[: self.cursor - 1] + self.input_buffer[self.cursor :]
                self.cursor -= 1
                self.dropdown_index = 0
                self.dirty = True
            return
        if key == "\x15":  # Ctrl+U
            self.kill_ring = self.input_buffer[: self.cursor]
            self.input_buffer = self.input_buffer[self.cursor :]
            self.cursor = 0
            self.dropdown_index = 0
            self.dirty = True
            return
        if key == "\x17":  # Ctrl+W
            left = self.input_buffer[: self.cursor].rstrip()
            cut = left.rfind(" ") + 1
            self.kill_ring = self.input_buffer[cut : self.cursor]
            self.input_buffer = self.input_buffer[:cut] + self.input_buffer[self.cursor :]
            self.cursor = cut
            self.dropdown_index = 0
            self.dirty = True
            return
        if key == "\x0b":  # Ctrl+K
            self.kill_ring = self.input_buffer[self.cursor :]
            self.input_buffer = self.input_buffer[: self.cursor]
            self.dropdown_index = 0
            self.dirty = True
            return
        if key == "\x19":  # Ctrl+Y
            if self.kill_ring:
                self.input_buffer = (
                    self.input_buffer[: self.cursor]
                    + self.kill_ring
                    + self.input_buffer[self.cursor :]
                )
                self.cursor += len(self.kill_ring)
                self.dropdown_index = 0
                self.dirty = True
            return
        if key == "\x01":  # Ctrl+A
            self.cursor = 0
            self.dirty = True
            return
        if key == "\x05":  # Ctrl+E
            self.cursor = len(self.input_buffer)
            self.dirty = True
            return
        if key == "\x02":  # Ctrl+B
            self.cursor = max(0, self.cursor - 1)
            self.dirty = True
            return
        if key == "\x06":  # Ctrl+F
            self.cursor = min(len(self.input_buffer), self.cursor + 1)
            self.dirty = True
            return
        if key == "\x10":  # Ctrl+P
            if self.dropdown_options():
                self.dropdown_index = max(0, self.dropdown_index - 1)
            else:
                self.history_up()
            self.dirty = True
            return
        if key == "\x0e":  # Ctrl+N
            if self.dropdown_options():
                self.dropdown_index = min(len(self.dropdown_options()) - 1, self.dropdown_index + 1)
            else:
                self.history_down()
            self.dirty = True
            return
        if key == "\x0c":
            self.dirty = True
            return
        if key == "left":
            self.cursor = max(0, self.cursor - 1)
            self.dirty = True
            return
        if key == "right":
            self.cursor = min(len(self.input_buffer), self.cursor + 1)
            self.dirty = True
            return
        if key == "word-left":
            self.move_word_left()
            self.dirty = True
            return
        if key == "word-right":
            self.move_word_right()
            self.dirty = True
            return
        if key == "home":
            self.cursor = 0
            self.dirty = True
            return
        if key == "end":
            self.cursor = len(self.input_buffer)
            self.dirty = True
            return
        if key == "delete":
            if self.cursor < len(self.input_buffer):
                self.input_buffer = self.input_buffer[: self.cursor] + self.input_buffer[self.cursor + 1 :]
                self.dirty = True
            return
        if key == "up":
            if self.dropdown_options():
                self.dropdown_index = max(0, self.dropdown_index - 1)
            else:
                self.history_up()
            self.dirty = True
            return
        if key == "down":
            if self.dropdown_options():
                self.dropdown_index = min(len(self.dropdown_options()) - 1, self.dropdown_index + 1)
            else:
                self.history_down()
            self.dirty = True
            return
        if key == "pageup":
            self.scroll += 8
            self.dirty = True
            return
        if key == "pagedown":
            self.scroll = max(0, self.scroll - 8)
            self.dirty = True
            return
        if key == "escape":
            self.dropdown_index = 0
            self.dirty = True
            return
        if key == "\t":
            options = self.dropdown_options()
            if options:
                self.apply_dropdown(options[self.dropdown_index])
            return
        if len(key) == 1 and key >= " ":
            self.input_buffer = self.input_buffer[: self.cursor] + key + self.input_buffer[self.cursor :]
            self.cursor += 1
            self.dropdown_index = min(self.dropdown_index, max(0, len(self.dropdown_options()) - 1))
            self.dirty = True

    def move_word_left(self) -> None:
        idx = self.cursor
        while idx > 0 and self.input_buffer[idx - 1].isspace():
            idx -= 1
        while idx > 0 and not self.input_buffer[idx - 1].isspace():
            idx -= 1
        self.cursor = idx

    def move_word_right(self) -> None:
        idx = self.cursor
        length = len(self.input_buffer)
        while idx < length and self.input_buffer[idx].isspace():
            idx += 1
        while idx < length and not self.input_buffer[idx].isspace():
            idx += 1
        self.cursor = idx

    def history_up(self) -> None:
        if not self.history:
            return
        if self.history_index is None:
            self.history_index = len(self.history) - 1
        else:
            self.history_index = max(0, self.history_index - 1)
        self.input_buffer = self.history[self.history_index]
        self.cursor = len(self.input_buffer)

    def history_down(self) -> None:
        if self.history_index is None:
            return
        self.history_index += 1
        if self.history_index >= len(self.history):
            self.history_index = None
            self.input_buffer = ""
        else:
            self.input_buffer = self.history[self.history_index]
        self.cursor = len(self.input_buffer)

    def handle_enter(self) -> None:
        options = self.dropdown_options()
        if options:
            self.apply_dropdown(options[self.dropdown_index])
            return
        text = self.input_buffer.strip()
        self.input_buffer = ""
        self.cursor = 0
        self.history_index = None
        self.dropdown_index = 0
        if not text:
            self.dirty = True
            return
        self.history.append(text)
        self.submit_text(text)

    def submit_text(self, text: str) -> None:
        if text.startswith("/"):
            self.handle_command(text)
            return
        if self.cwd_index_offer is not None and text.strip().lower() in {"y", "yes", "n", "no"}:
            self.handle_cwd_index_answer(text)
            return
        if self.cwd_indexing or (self.study_running and self.study_status.startswith("bg-heavy:")):
            self.pending_prompts.append(text)
            self.append("queued", text)
            self.status = f"queued {len(self.pending_prompts)} prompt(s) while Motoko is deep-indexing"
            return
        if self.generating:
            self.pending_prompts.append(text)
            self.append("queued", text)
            self.status = f"queued {len(self.pending_prompts)} prompt(s) while Motoko answers"
            return
        self.start_generation(text)

