def summarize_text(
    label: str,
    text: str,
    instruction: str,
    *,
    timeout: float = MODEL_TIMEOUT_SECONDS,
    route: str = MODEL_ROUTE_CHAT,
    prompt_version: str = "summary-v1",
    cancel_event=None,
) -> str:
    raise_if_cancelled(cancel_event)
    clipped = text[:SUMMARY_INPUT_CHARS]
    prompt = textwrap.dedent(
        f"""
        {instruction}

        Label: {label}

        Text:
        {clipped}
        """
    ).strip()
    messages = [
        {
            "role": "system",
            "content": "Create compact, faithful summaries for retrieval. Do not invent facts.",
        },
        {"role": "user", "content": prompt},
    ]
    route_info = model_route(route)
    sampling_preset = selected_sampling_preset(route_info, route_info["route"])
    request_options = {"sampling_preset": sampling_preset} if sampling_preset else {}
    if model_output_cache_enabled(route_info["route"]):
        cache_key, input_sha256 = model_output_cache_key(
            messages,
            route_info=route_info,
            temperature=0.2,
            prompt_version=prompt_version,
            request_options=request_options,
        )
        cached = read_model_output_cache(cache_key, route_info=route_info, prompt_version=prompt_version)
        if cached is not None:
            return cached
    else:
        cache_key = ""
        input_sha256 = ""

    result = quiet_model(
        messages,
        temperature=0.2,
        timeout=timeout,
        route=route_info["route"],
        sampling_preset=sampling_preset,
        cancel_event=cancel_event,
    )
    if cache_key:
        write_model_output_cache(
            cache_key,
            route_info=route_info,
            temperature=0.2,
            prompt_version=prompt_version,
            input_sha256=input_sha256,
            label=label,
            output=result,
            request_options=request_options,
        )
    return result


def chunk_content_relpath(index_id: str, ordinal: int, chunk_idx: int) -> str:
    return f"{index_id}.chunks/{ordinal:06d}-{chunk_idx:06d}.txt"


def remove_index_file_chunks(index_id: str, ordinal: int) -> None:
    for path in index_data_dir(index_id).glob(f"{ordinal:06d}-*.txt"):
        try:
            path.unlink()
        except OSError:
            pass


def index_file_ordinals(files: list[dict]) -> set[int]:
    ordinals = set()
    for file_item in files:
        raw = file_item.get("index_ordinal")
        try:
            ordinal = int(raw)
        except (TypeError, ValueError):
            ordinal = 0
        if ordinal > 0:
            ordinals.add(ordinal)
            continue
        for chunk in file_item.get("chunks", []):
            chunk_id = str(chunk.get("id", ""))
            prefix, _sep, _suffix = chunk_id.partition(".")
            try:
                ordinal = int(prefix)
            except ValueError:
                ordinal = 0
            if ordinal > 0:
                ordinals.add(ordinal)
                break
    return ordinals


def next_index_file_ordinal(used_ordinals: set[int]) -> int:
    ordinal = max(used_ordinals or {0}) + 1
    used_ordinals.add(ordinal)
    return ordinal


def chunk_content_path(index: dict, chunk: dict) -> pathlib.Path | None:
    relpath = chunk.get("content_path")
    if not relpath:
        return None
    base = indexes_dir().resolve()
    candidate = (base / relpath).resolve()
    if candidate != base and not is_under(candidate, base):
        raise ValueError(f"chunk content path escapes Motoko index state: {relpath}")
    return candidate


def read_chunk_content(index: dict, chunk: dict) -> str:
    if "content" in chunk:
        return chunk.get("content", "")
    try:
        path = chunk_content_path(index, chunk)
    except ValueError:
        return ""
    if path is None:
        if chunk.get("duplicate_of_existing_index") and chunk.get("content_sha256"):
            return find_existing_chunk_content(chunk.get("content_sha256", ""), skip_index_id=index.get("id", ""))
        return ""
    try:
        return path.read_text(encoding="utf-8")
    except OSError:
        return ""


def direct_chunk_content(index: dict, chunk: dict) -> str:
    if "content" in chunk and not chunk.get("duplicate_of_existing_index"):
        return chunk.get("content", "")
    try:
        path = chunk_content_path(index, chunk)
    except ValueError:
        return ""
    if path is None:
        return ""
    try:
        return path.read_text(encoding="utf-8")
    except OSError:
        return ""


def find_existing_chunk_content(digest: str, *, skip_index_id: str = "") -> str:
    if not digest:
        return ""
    for index in list_indexes():
        if skip_index_id and index.get("id") == skip_index_id:
            continue
        for file_item in index.get("files", []):
            for chunk in file_item.get("chunks", []):
                if chunk.get("content_sha256") != digest:
                    continue
                text = direct_chunk_content(index, chunk)
                if text:
                    return text
    return ""


def existing_index_chunk_cache(root: pathlib.Path | None = None) -> dict[str, str]:
    cache = {}
    for index in list_indexes():
        if root is not None:
            try:
                index_root = pathlib.Path(index.get("root", "")).expanduser().resolve()
            except OSError:
                index_root = None
            if index_root is not None and index_root != root:
                continue
        cache.update(chunk_index_cache(index))
    return cache


def chunk_index_cache(index: dict) -> dict[str, str]:
    cache = {}
    for file_item in index.get("files", []):
        for chunk in file_item.get("chunks", []):
            digest = chunk.get("content_sha256")
            if not digest or digest in cache:
                continue
            text = direct_chunk_content(index, chunk)
            if text:
                cache[digest] = text
    return cache


def index_artifact_warnings(index: dict) -> list[str]:
    warnings = []
    for file_item in index.get("files", []):
        for chunk in file_item.get("chunks", []):
            if "content" in chunk:
                continue
            try:
                path = chunk_content_path(index, chunk)
            except ValueError as exc:
                warnings.append(str(exc))
                continue
            if path is None:
                if chunk.get("duplicate_of_existing_index") and find_existing_chunk_content(
                    chunk.get("content_sha256", ""),
                    skip_index_id=index.get("id", ""),
                ):
                    continue
                warnings.append(
                    f"{file_item.get('path', '')}: chunk {chunk.get('chunk')} has no stored content"
                )
            elif not path.exists():
                warnings.append(
                    f"{file_item.get('path', '')}: missing stored chunk {chunk.get('chunk')}"
                )
    return warnings


def safe_int(value, default: int = 0) -> int:
    try:
        return int(value)
    except (TypeError, ValueError):
        return default


def path_size(path: pathlib.Path) -> int:
    try:
        return path.stat().st_size
    except OSError:
        return 0


def tree_size(path: pathlib.Path) -> int:
    total = 0
    if not path.exists():
        return 0
    for item in path.rglob("*"):
        if item.is_file():
            total += path_size(item)
    return total


def partial_index_cleanup_bytes(partial: dict) -> int:
    index_id = str(partial.get("id", ""))
    return path_size(index_partial_path(index_id)) + tree_size(indexes_dir() / f"{index_id}.chunks")


def index_chunk_ordinal(file_item: dict, chunk: dict, fallback: int) -> int:
    ordinal = safe_int(file_item.get("index_ordinal"))
    if ordinal > 0:
        return ordinal
    chunk_id = str(chunk.get("id", ""))
    prefix, _sep, _suffix = chunk_id.partition(".")
    ordinal = safe_int(prefix)
    return ordinal if ordinal > 0 else fallback


def materialize_duplicate_chunks(index: dict) -> dict:
    index_id = str(index.get("id", "")).strip()
    report = {
        "index": index_id,
        "materialized_chunks": 0,
        "materialized_bytes": 0,
        "missing_chunks": 0,
        "changed": False,
    }
    if not index_id:
        return report
    changed = False
    for file_pos, file_item in enumerate(index.get("files", []), 1):
        if not isinstance(file_item, dict):
            continue
        file_materialized = 0
        file_bytes = 0
        chunks = file_item.get("chunks", [])
        for chunk_pos, chunk in enumerate(chunks, 1):
            if not isinstance(chunk, dict) or not chunk.get("duplicate_of_existing_index"):
                continue
            digest = str(chunk.get("content_sha256", "")).strip()
            text = find_existing_chunk_content(digest, skip_index_id=index_id)
            if not text:
                report["missing_chunks"] += 1
                continue
            ordinal = index_chunk_ordinal(file_item, chunk, file_pos)
            chunk_number = safe_int(chunk.get("chunk"), chunk_pos)
            relpath = chunk_content_relpath(index_id, ordinal, chunk_number)
            path = indexes_dir() / relpath
            ensure_private_dir(path.parent)
            atomic_write(path, text)
            content_bytes = len(text.encode("utf-8"))
            chunk["content_path"] = relpath
            chunk["stored_content_bytes"] = content_bytes
            chunk["content_bytes"] = safe_int(chunk.get("content_bytes"), content_bytes) or content_bytes
            chunk["materialized_from_duplicate"] = True
            chunk["materialized_at"] = now()
            chunk.pop("duplicate_of_existing_index", None)
            report["materialized_chunks"] += 1
            report["materialized_bytes"] += content_bytes
            file_materialized += 1
            file_bytes += content_bytes
            changed = True
        if file_materialized:
            file_item["duplicate_chunk_count"] = sum(
                1 for chunk in chunks if isinstance(chunk, dict) and chunk.get("duplicate_of_existing_index")
            )
            file_item["derived_content_bytes"] = safe_int(file_item.get("derived_content_bytes")) + file_bytes
    if changed:
        index["derived_content_bytes"] = safe_int(index.get("derived_content_bytes")) + safe_int(report.get("materialized_bytes"))
        atomic_write(index_path(index_id), json.dumps(index, ensure_ascii=False, indent=2) + "\n")
        report["changed"] = True
    return report


def json_references_index(value, index_id: str) -> bool:
    if not index_id:
        return False
    if isinstance(value, dict):
        for key, item in value.items():
            if key in {
                "index",
                "index_id",
                "source_index",
                "source_index_id",
                "created_by_index_id",
                "source_fingerprint_index",
            }:
                if str(item) == index_id:
                    return True
                if isinstance(item, dict) and str(item.get("id", "")) == index_id:
                    return True
            if key in {"indexes", "index_ids", "source_indexes", "source_index_ids"} and isinstance(item, list):
                if any(
                    str(row) == index_id or (isinstance(row, dict) and str(row.get("id", "")) == index_id)
                    for row in item
                ):
                    return True
            if key == "context_items" and isinstance(item, list):
                if any(isinstance(row, dict) and row.get("kind") == "index" and str(row.get("id", "")) == index_id for row in item):
                    return True
            if json_references_index(item, index_id):
                return True
        return False
    if isinstance(value, list):
        return any(json_references_index(item, index_id) for item in value)
    return False


