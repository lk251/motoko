                f"score={row.get('score', 0)}"
            )
    lines.append("model calls: none")
    return "\n".join(lines)


def parse_skill_learn_args(raw: str) -> dict:
    usage = "usage: /skill learn NAME --description DESC --body TEXT [--replace]"
    try:
        tokens = shlex.split(raw)
    except ValueError as exc:
        raise SystemExit(f"{usage}\nerror: {exc}") from exc
    if not tokens:
        raise SystemExit(usage)
    name = tokens[0]
    description = ""
    body = ""
    replace = False
    idx = 1
    while idx < len(tokens):
        token = tokens[idx]
        if token in {"--replace", "-r"}:
            replace = True
            idx += 1
            continue
        if token in {"--description", "-d"}:
            if idx + 1 >= len(tokens):
                raise SystemExit(usage)
            description = tokens[idx + 1]
            idx += 2
            continue
        if token in {"--body", "-b"}:
            if idx + 1 >= len(tokens):
                raise SystemExit(usage)
            body = tokens[idx + 1]
            idx += 2
            continue
        raise SystemExit(f"{usage}\nunknown argument: {token}")
    if not description or not body:
        raise SystemExit(usage)
    return {"name": name, "description": description, "body": body, "replace": replace}


def learn_skill_from_command(raw: str) -> str:
    args = parse_skill_learn_args(raw)
    return learn_skill_text(
