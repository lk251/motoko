def format_action_proposals(selector: str) -> str:
    try:
        data, actions = _tool_proposed_actions(selector)
    except AgenticValidationError as exc:
        return f"action proposals:\nstatus: rejected\nerror: {exc}"
    validations = core_summarize_tool_proposed_actions(
        data.get("output_json"),
