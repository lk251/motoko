def profile_source_material() -> tuple[str, list[str], list[str]]:
    memories = load_memories(limit=PROFILE_SOURCE_MEMORIES)
    conversations = [
        conv
        for conv in list_conversations()[:PROFILE_SOURCE_CONVERSATIONS]
        if conversation_recall_text(conv).strip()
    ]
    memory_lines = [
        f"- [{row.get('id', '')}; i{row.get('importance', MEMORY_DEFAULT_IMPORTANCE)}] {row.get('text', '')}"
        for row in memories
    ]
    conversation_blocks = []
    for conv in conversations:
        title = conv.get("title") or "Untitled"
        conversation_blocks.append(
            f"--- conversation:{conv.get('id', '')} title:{title} updated:{conv.get('updated', '')} ---\n"
            f"{compact_text(conversation_recall_text(conv), 2500)}"
        )
    text = textwrap.dedent(
        f"""
        Durable memories:
        {chr(10).join(memory_lines) if memory_lines else "(none)"}

        Recent conversation material:
        {chr(10).join(conversation_blocks) if conversation_blocks else "(none)"}
        """
    ).strip()
    return (
        text,
        [row.get("id", "") for row in memories if row.get("id")],
        [conv.get("id", "") for conv in conversations if conv.get("id")],
    )


def refresh_profile_dossier() -> dict:
    source_text, memory_ids, conversation_ids = profile_source_material()
    if not memory_ids and not conversation_ids:
        raise SystemExit("no memories or conversations available for a profile dossier yet")
    prompt = textwrap.dedent(
        f"""
        Build a compact profile dossier for future private conversations with Javier.

        Use only the source material below. Do not invent facts.
        Prefer stable, recurring, useful context over transient task details.
        Preserve uncertainty when the sources are ambiguous.

        Organize the dossier with these headings:
        - Stable preferences
        - Goals and projects
        - Working style
        - Personal context
        - Constraints and sensitivities
        - Open questions

        Keep it under {MAX_PROFILE_DOSSIER_CHARS} characters.

        Source material:
        {source_text}
        """
    ).strip()
    text = quiet_model(
        [
            {
                "role": "system",
                "content": "Create faithful personal context dossiers from supplied sources only.",
            },
            {"role": "user", "content": prompt},
        ],
        temperature=0.2,
