def model_badge() -> str:
    raw = model_name()
    lower = raw.lower()
    pieces = []
    if "qwen" in lower:
        match = re.search(r"qwen[0-9.]*", lower)
        pieces.append(match.group(0) if match else "qwen")
    if "27b" in lower:
        pieces.append("27b")
    if "mtp" in lower:
        pieces.append("mtp")
    if not pieces:
        pieces.append(raw[:28])
    endpoint_text = endpoint()
    port = ""
    match = re.search(r":(\d+)(?:/|$)", endpoint_text)
    if match:
        port = f":{match.group(1)}"
    return "-".join(pieces) + port


def env_flag(name: str, default: bool = True) -> bool:
    raw = os.environ.get(name)
    if raw is None:
