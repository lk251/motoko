    def bottom_area_frame(self, width: int, height: int) -> tuple[list[str], int, int]:
        options = self.dropdown_options()
        if options:
            self.dropdown_index = min(self.dropdown_index, len(options) - 1)
        else:
            self.dropdown_index = 0
        input_lines, cursor_row_offset, cursor_col = self.input_display(width)
        dropdown_lines = self.dropdown_display(width, options)
        status_lines = self.status_display(width)
        live_lines = self.live_answer_display(width)
        return render_bottom_area_frame(
            live_lines=live_lines,
            dropdown_lines=dropdown_lines,
            input_lines=input_lines,
            status_lines=status_lines,
            input_cursor_row_offset=cursor_row_offset,
            input_cursor_col=cursor_col,
            width=width,
            height=height,
            truncation_marker="…",
        )

    def draw_bottom_area(
        self,
        width: int,
        height: int,
        *,
        force: bool = False,
        frame: tuple[list[str], int, int] | None = None,
    ) -> None:
        lines, cursor_row, cursor_col = frame if frame is not None else self.bottom_area_frame(width, height)
        frame_key = (width, height, tuple(lines), cursor_row, cursor_col)
        if not force and frame_key == getattr(self, "bottom_frame_key", None):
            return
        previous_rows = int(getattr(self, "bottom_rows_rendered", 0) or 0)
        restore_lines = []
        if previous_rows > len(lines):
            restore_lines = self.transcript_tail_lines(width, previous_rows - len(lines))
        self.write(
            render_bottom_area_absolute_sequence(
                lines,
                cursor_row=cursor_row,
                cursor_col=cursor_col,
                height=height,
                previous_rows=previous_rows,
                restore_lines=restore_lines,
            )
        )
        self.bottom_rows_rendered = len(lines)
        self.bottom_cursor_row_offset = cursor_row
        self.bottom_frame_key = frame_key

    def transcript_tail_lines(self, width: int, count: int) -> list[str]:
        count = max(0, int(count or 0))
        if not count:
            return []
        rows = []
        for entry in getattr(self, "messages", []):
            if entry is self.answer_entry and self.generating:
                continue
            rows.extend(self.message_display_lines(entry, width))
        if not rows:
            return [""] * count
        return ([""] * count + rows)[-count:]

    def sync_transcript(self, width: int, height: int, *, reserved_rows: int = 1) -> None:
        if not hasattr(self, "rendered_message_ids"):
            self.rendered_message_ids = set()
        rows = []
        for entry in getattr(self, "messages", []):
            if entry is self.answer_entry and self.generating:
                continue
            ident = id(entry)
            if ident in self.rendered_message_ids:
                continue
            rows.extend(self.message_display_lines(entry, width))
            self.rendered_message_ids.add(ident)
        if not rows:
            return
        self.clear_bottom_area()
        self.write(render_transcript_append_sequence(rows, height=height, reserved_rows=reserved_rows))

    def sync_active_answer_transcript(
        self,
        width: int,
        height: int,
        *,
        reserved_rows: int = 1,
        final: bool = False,
    ) -> None:
        if self.answer_entry is None or not str(self.answer_entry.get("content", "")):
            return
        lines = self.message_display_lines(self.answer_entry, width, active_answer=False)
        target_count = len(lines) if final else max(0, len(lines) - 2)
        if self.answer_stream_width and self.answer_stream_width != width:
            self.answer_stream_emitted_lines = min(self.answer_stream_emitted_lines, target_count)
        self.answer_stream_width = width
        start = max(0, min(self.answer_stream_emitted_lines, target_count))
        rows = lines[start:target_count]
        if rows:
            self.clear_bottom_area()
            self.write(render_transcript_append_sequence(rows, height=height, reserved_rows=reserved_rows))
            self.answer_stream_emitted_lines = target_count
        if final:
            self.rendered_message_ids.add(id(self.answer_entry))

    def flush_active_answer_transcript(self, content: str | None = None) -> None:
        if self.answer_entry is None:
            return
        if not hasattr(self, "stdout_fd"):
            return
        if content is not None:
            self.answer_entry["content"] = content
        size = self.terminal_size()
        width = max(40, size.columns)
        height = max(12, size.lines)
        content_width = max(20, width - 1)
        bottom_frame = self.bottom_area_frame(content_width, height)
        self.sync_active_answer_transcript(
            content_width,
            height,
            reserved_rows=len(bottom_frame[0]),
            final=True,
        )

    def live_answer_display(self, width: int) -> list[str]:
        if self.answer_entry is None or not self.generating:
            return []
        phase_started = self.answer_phase_started_monotonic or self.answer_started_monotonic or time.monotonic()
        status_entry = dict(self.answer_entry)
        status_entry["content"] = ""
        return render_live_answer_display_lines(
            status_entry,
            width,
            assistant_color=assistant_color(),
            answer_phase=getattr(self, "answer_phase", ""),
            answer_phase_elapsed=time.monotonic() - phase_started,
            answer_reasoning=self.active_answer_reasoning(),
        )

    def render_overlay_page(self, width: int, height: int) -> None:
        self.clear_bottom_area()
        if not getattr(self, "overlay_screen_active", False):
            self.write("\033[?1049h")
            self.overlay_screen_active = True
        body_lines = self.overlay_display(width)
        rows, self.overlay_scroll = render_overlay_page_frame(body_lines, height, self.overlay_scroll)
        self.write(render_overlay_page_sequence(rows, height))

    def study_status_label(self) -> str:
        study_status = str(getattr(self, "study_status", "study: idle"))
        updated_elapsed = int(time.monotonic() - getattr(self, "study_phase_updated", time.monotonic()))
        if study_status.startswith("bg-heavy: vectorizing") and updated_elapsed >= SAFE_PROGRESS_STALE_SECONDS:
            return f"bg-heavy: vectorizing stalled? last progress {human_duration(updated_elapsed)} ago"
        if study_status.startswith("bg-heavy: vectorizing"):
            return sanitize_background_phase(study_status)
        return study_status_label_core(
            study_status,
            getattr(self, "index_progress", None),
            progress_formatter=format_index_progress_status,
        )

    def message_display_lines(self, entry: dict, width: int, *, active_answer: bool = False) -> list[str]:
        phase_elapsed = 0.0
        if active_answer:
            phase_started = self.answer_phase_started_monotonic or self.answer_started_monotonic or time.monotonic()
            phase_elapsed = time.monotonic() - phase_started
        return render_message_display_lines(
            entry,
            width,
            assistant_color=assistant_color(),
            active_answer=active_answer,
            answer_phase=getattr(self, "answer_phase", ""),
            answer_phase_elapsed=phase_elapsed,
            answer_reasoning=self.active_answer_reasoning() if active_answer else "",
        )

    def body_display(self, width: int) -> list[str]:
        lines = []
        for entry in self.messages:
            lines.extend(
                self.message_display_lines(
                    entry,
                    width,
                    active_answer=bool(entry is self.answer_entry and self.generating),
                )
            )
        return lines or [""]

    def overlay_display(self, width: int) -> list[str]:
        return overlay_display_lines(self.overlay_title or "help", self.overlay_lines or [], width)

    def dropdown_display(self, width: int, options: list[dict]) -> list[str]:
        return dropdown_display_lines(options, self.dropdown_index, width)

    def input_display(self, width: int) -> tuple[list[str], int, int]:
        return fixed_prompt_input_display(self.input_buffer, self.cursor, width)

    def terminal_size(self) -> os.terminal_size:
        fd = getattr(self, "stdout_fd", None)
        try:
            if fd is not None:
                return os.get_terminal_size(fd)
        except OSError:
            pass
        try:
            return shutil.get_terminal_size((80, 24))
        except OSError:
            return os.terminal_size((80, 24))


def chat_loop(conv: dict) -> None:
    if tui_enabled():
        try:
            MotokoTui(conv).run()
            return
        except Exception as exc:
            print(f"Motoko TUI failed; falling back to line mode: {exc}", file=sys.stderr)
    setup_readline_completion()
    print(format_conversation_banner(conv))
    print("sys " + startup_tips_text().replace("\n", "\nsys "))
    resume_maintenance, resume_note = resume_interrupted_maintenance(conv)
    if resume_note:
        print(f"sys {resume_note}")
    elif queued_memory_proposal_count():
        resume_maintenance = True
        print(f"sys resuming {queued_memory_proposal_count()} queued memory proposal(s)")
    if resume_maintenance:
        print("sys resuming memory maintenance")
        state = begin_maintenance_state(conv, resumed=True)
        try:
            notes = auto_maintain_conversation(
                conv,
                phase_callback=lambda phase: print(f"sys {phase}"),
                state=state,
            )
            clear_maintenance_state(state.get("job_id"))
            if notes:
                print(f"sys {'; '.join(notes)}")
        except Exception as exc:
            update_maintenance_state(
                state,
                "memory: failed",
                status="failed",
                error=f"{type(exc).__name__}: {exc}",
            )
            print(f"sys memory maintenance failed: {type(exc).__name__}: {exc}")
    while True:
        try:
            user_text = motoko_input("\n> ").strip()
        except (EOFError, KeyboardInterrupt):
            print()
            close_conversation(conv)
            return
        if not user_text:
            continue
        if user_text in {"/", "/commands"}:
            print_command_menu()
            continue
        if user_text == "/exit":
            close_conversation(conv)
            return
        if user_text == "/stop":
            print("no active streamed answer in line mode")
            continue
        if user_text == "/clear-queue":
            print("no queued prompts in line mode")
            continue
        if user_text == "/pause":
            command_pause(None)
            continue
        command_request = shared_command_request(user_text, conv)
        if command_request is not None:
            _label, func = command_request
            try:
                print_report(func())
            except SystemExit as exc:
                print(exc)
            continue
        if user_text == "/new" or user_text.startswith("/new "):
            title = user_text[len("/new") :].strip() or None
            conv = start_new_conversation_from_current(conv, title)
            print(format_conversation_banner(conv))
            continue
        if user_text == "/resume" or user_text.startswith("/resume "):
            selector = user_text[len("/resume") :].strip() or None
            conv = resume_conversation_from_current(conv, selector)
            print(format_conversation_banner(conv))
            continue
        if user_text == "/delete" or user_text.startswith("/delete "):
            answer = user_text[len("/delete") :].strip().lower()
            if answer not in {"yes", "confirm"}:
                answer = input(f"Delete conversation {conv.get('id', '')}? Type yes to confirm: ").strip().lower()
            if answer in {"yes", "confirm"}:
                conv, report = delete_conversation_then_new(conv)
                print(format_conversation_delete_report(report))
                print(format_conversation_banner(conv))
            else:
                print("not deleted")
            continue
        blocking_request = blocking_command_request(user_text, conv)
        if blocking_request is not None:
            _label, func = blocking_request
            try:
                result = func()
                if result:
                    print_report(str(result))
            except SystemExit as exc:
                print(exc)
            continue
        if user_text.startswith("/"):
            print("unknown command; type /help")
            continue

        maybe_set_title(conv, user_text)
        project_scope = project_scope_for_request(conv, user_text)
        topic = maybe_attach_relevant_existing_topic(conv, user_text, project_scope=project_scope)
        if topic:
            print(f"sys auto-attached topic dossier: {topic.get('id')} ({topic.get('name', '')})")
        dossier = maybe_attach_relevant_existing_dossier(conv, user_text, project_scope=project_scope)
        if dossier:
            print(f"sys auto-attached memory dossier: {dossier.get('id')} ({dossier.get('name', '')})")
        conv.setdefault("messages", []).append({"role": "user", "content": user_text})
        explicit_saved = save_explicit_user_memories(user_text, conv["id"])
        if explicit_saved:
            print(f"sys memory saved from this prompt ({explicit_saved})")
        print("\n" + assistant_label("Motoko "), end="", flush=True)
        messages, sources = build_messages(conv, user_text, project_scope=project_scope)
        reply = call_model(
            messages,
            source_count=len(sources),
            slot_cache_context={
                "conversation_id": conv.get("id", ""),
                "client_namespace": CHAT_SLOT_CACHE_NAMESPACE_VERSION,
            },
        )
        conv["last_sources"] = sources_with_answer_audit(user_text, reply, sources)
        conv["messages"].append({"role": "assistant", "content": reply})
        save_conversation(conv)
        state = begin_maintenance_state(conv)
        try:
            auto_maintain_conversation(conv, state=state)
            clear_maintenance_state(state.get("job_id"))
        except Exception as exc:
            update_maintenance_state(
                state,
                "memory: failed",
                status="failed",
                error=f"{type(exc).__name__}: {exc}",
            )
            print(f"sys memory maintenance failed: {type(exc).__name__}: {exc}")


def compact_conversation(
    conv: dict,
    *,
    quiet: bool = False,
    timeout: float = MODEL_TIMEOUT_SECONDS,
) -> bool:
    messages = conv.get("messages", [])
    if len(messages) <= COMPACT_KEEP_MESSAGES:
        if not quiet:
            print("conversation is already compact enough")
        return False

    older = messages[:-COMPACT_KEEP_MESSAGES]
    recent = messages[-COMPACT_KEEP_MESSAGES:]
    transcript = []
    for msg in older:
        role = msg.get("role", "?")
        content = msg.get("content", "")
        transcript.append(f"{role}: {content}")
    older_text = "\n\n".join(transcript)
    prompt = textwrap.dedent(
        f"""
        Existing compacted summary:
        {conv.get('summary', '').strip() or '(none)'}

        Older transcript to merge:
        {older_text}

        Create a dense but readable conversation summary for future turns.
        Preserve Javier's durable preferences, commitments, open questions,
        named people/projects/files, and any conclusions already reached.
        Do not invent facts. Keep it under {MAX_CONVERSATION_SUMMARY_CHARS} characters.
        """
    ).strip()
    if not quiet:
        print("Compacting older conversation context...")
    summary = quiet_model(
        [
            {
                "role": "system",
                "content": "You summarize conversations into faithful compact context for later retrieval.",
            },
            {"role": "user", "content": prompt},
        ],
        temperature=0.2,
        timeout=timeout,
        route=MODEL_ROUTE_MEMORY,
    )
    conv["summary"] = summary[:MAX_CONVERSATION_SUMMARY_CHARS]
    conv["summary_artifact"] = artifact_provenance(
        "conversation-summary",
        CONVERSATION_SUMMARY_SCHEMA_VERSION,
        route=MODEL_ROUTE_MEMORY,
        prompt_version=CONVERSATION_SUMMARY_SCHEMA_VERSION,
        source_sha256=sha256_hex(older_text.encode("utf-8")),
    )
    conv["messages"] = recent
    conv["last_auto_compact_message_count"] = len(recent)
    save_conversation(conv)
    if not quiet:
        print(f"compacted {len(older)} older message(s); kept {len(recent)} recent message(s)")
    return True


def propose_memories(
    conv: dict,
    *,
    timeout: float = MODEL_TIMEOUT_SECONDS,
) -> list[str]:
    if not conv.get("messages"):
        return []
    prompt = textwrap.dedent(
        """
        Extract durable personal memories from this conversation.
        Return only lines in this exact form:

        MEMORY: short durable fact

        Include only
        stable facts, preferences, commitments, recurring projects, named
        relationships, or long-lived goals likely useful in future
        conversations. Avoid transient task state, guesses, and anything
        already contradicted later in the conversation. If there are no durable
        memories, say exactly: NO_MEMORY
        """
    ).strip()
    schema = {
        "type": "object",
        "additionalProperties": False,
        "properties": {
            "memories": {
                "type": "array",
                "items": {"type": "string"},
            }
        },
        "required": ["memories"],
    }
    transcript = conversation_transcript_for_model(conv)
    messages = [
        {"role": "system", "content": prompt},
        {"role": "user", "content": f"Conversation transcript:\n{transcript}"},
    ]
    proposal = call_model(
        messages,
        temperature=0.2,
        stream=False,
        echo=False,
        timeout=timeout,
        route=MODEL_ROUTE_MEMORY,
        sampling_preset="deterministic",
        json_schema=schema,
    ).strip()
    parsed, _json_error = extract_json_object(proposal)
    if parsed is not None and isinstance(parsed.get("memories"), list):
        return [
            str(item).strip()
            for item in parsed.get("memories", [])[:AUTO_MEMORY_MAX_PROPOSALS]
            if str(item).strip()
        ]
    if proposal == "NO_MEMORY":
        return []
    memories = []
    for line in proposal.splitlines():
        text = line.strip()
        if text.upper() == "NO_MEMORY":
            continue
        if text.upper().startswith("MEMORY:"):
            text = text.split(":", 1)[1].strip()
        else:
            if not re.match(r"^([-*]|\d+[.)])\s+", text):
                continue
            text = text.lstrip("-*0123456789.) ").strip()
        if text:
            memories.append(text)
        if len(memories) >= AUTO_MEMORY_MAX_PROPOSALS:
            break
    return memories


def _coerce_skill_suggestion_items(data) -> list[dict]:
    if isinstance(data, dict):
        if isinstance(data.get("suggestions"), list):
            return [item for item in data.get("suggestions", []) if isinstance(item, dict)]
        return [data]
    if isinstance(data, list):
        return [item for item in data if isinstance(item, dict)]
    return []


def parse_skill_suggestion_output(text: str) -> list[dict]:
    value = str(text or "").strip()
    if not value or value.upper() == "NO_SKILL":
        return []
    json_text = value
    if "```" in json_text:
        blocks = re.findall(r"```(?:json)?\s*(.*?)```", json_text, flags=re.IGNORECASE | re.DOTALL)
        if blocks:
            json_text = blocks[0].strip()
    else:
        start = json_text.find("{")
        end = json_text.rfind("}")
        if start >= 0 and end > start:
            json_text = json_text[start : end + 1]
    try:
        data = json.loads(json_text)
    except json.JSONDecodeError:
        data = None
    items = _coerce_skill_suggestion_items(data)
    suggestions = []
    for item in items:
        action = item.get("action") or item.get("skill_action") or "create"
        name = item.get("name") or item.get("slug") or item.get("title") or ""
        body = item.get("body") or item.get("procedure") or item.get("skill_body") or ""
        description = item.get("description") or item.get("summary") or ""
        target_skill = item.get("target_skill") or item.get("target") or item.get("skill") or ""
        if action != "create" and not name:
            name = target_skill
        if not description:
            description = f"{action} skill proposal for {target_skill or name}".strip()
        if action == "create" and (not name or not description or not body):
            continue
        if action == "patch" and not (target_skill or name):
            continue
        if action == "write_file" and not (target_skill or name):
            continue
        suggestions.append(
            normalize_skill_suggestion(
                {
                    "action": action,
                    "name": name,
                    "target_skill": target_skill,
                    "description": description,
                    "body": body,
                    "kind": item.get("kind") or DEFAULT_SKILL_KIND,
                    "handler": item.get("handler") or DEFAULT_SKILL_HANDLER,
                    "allowed_effects": item.get("allowed_effects") or list(DEFAULT_SKILL_EFFECTS),
                    "triggers": item.get("triggers") or [],
                    "signals": item.get("signals") or [],
                    "reason": item.get("reason") or "",
                    "file_path": item.get("file_path") or "",
                    "file_content": item.get("file_content") or "",
                    "old_string": item.get("old_string") or "",
                    "new_string": item.get("new_string") or "",
                    "replace_all": item.get("replace_all") or False,
                    "security": item.get("security") or "prompt-only suggested skill; no script execution",
                }
            )
        )
        if len(suggestions) >= AUTO_SKILL_MAX_PROPOSALS:
            break
    return suggestions


def propose_skill_suggestions(
    conv: dict,
    *,
    timeout: float = MODEL_TIMEOUT_SECONDS,
    review_reasons: list[str] | None = None,
) -> list[dict]:
    if not conv.get("messages"):
        return []
    catalog_lines = []
    for row in active_skills()[:40]:
        triggers = ", ".join(row.get("triggers", [])[:4])
        catalog_lines.append(
            f"- {row.get('slug', '')}: {row.get('description', '')} "
            f"[{row.get('kind', DEFAULT_SKILL_KIND)}; {row.get('handler', DEFAULT_SKILL_HANDLER)}]"
            + (f" triggers={triggers}" if triggers else "")
        )
    catalog = "\n".join(catalog_lines) if catalog_lines else "(no learned skills yet)"
    loaded_skill_context = format_loaded_skill_review_context(conv)
    review_reasons = review_reasons if review_reasons is not None else skill_review_triggers(conv)
    review_reason_text = ", ".join(review_reasons) if review_reasons else "manual review"
    prompt = textwrap.dedent(
        """
        Review the conversation and decide whether it revealed reusable
        procedural knowledge that should become a Motoko skill_manage proposal.
        You cannot mutate files directly. You may only propose review-first
        skill_manage actions that a user may later accept.

        Motoko's local decision heuristic:
        Would this skill action save tokens, reduce errors, improve
        reliability, or encode project-specific craft for future sessions?

        Skill-worthy signals:
        - the user corrected workflow, sequence, style, or approach;
        - a non-trivial debugging path, workaround, tool-use pattern, or
          repeatable technique emerged;
        - a loaded/consulted skill was wrong, incomplete, or stale;
        - the learning is class-level and likely useful again.

        Preference order:
        1. Prefer action="patch" when an existing skill covers the class of
           work. Patch SKILL.md with a small exact old_string/new_string.
           If a recently loaded skill appears below and covers the learning,
           patch that loaded skill first.
        2. Prefer action="write_file" under an existing umbrella when the
           learning is useful as supporting material. file_path must start with
           references/, templates/, or scripts/. Scripts are stored text only;
           Motoko does not execute arbitrary skill scripts.
        3. Use action="create" only when no existing skill fits. The skill name
           must be class-level, not today's incident, commit id, branch name,
           exact error string, or one-off project milestone.

        Do not propose a skill for one-off task progress, transient environment
        failures, missing packages, fresh install quirks, commit ids, exact
        dates that will soon be stale, or anything that only makes sense for
        today's single task.

        Return exactly NO_SKILL if no suggestion is warranted.
        Otherwise return compact JSON:
        {
          "suggestions": [
            {
              "name": "class-level-skill-name",
              "target_skill": "existing-skill-name-for-patch-or-write-file",
              "action": "create|patch|write_file",
              "description": "one short sentence",
              "kind": "workflow",
              "handler": "prompt_only",
              "allowed_effects": ["prompt_context"],
              "triggers": ["when to use it"],
              "signals": ["why it was suggested"],
              "reason": "why this will save tokens, reduce errors, improve reliability, or encode craft",
              "body": "durable procedure for create actions",
              "file_path": "references/example.md for write_file actions",
              "file_content": "support file text for write_file actions",
              "old_string": "exact text to replace for patch actions",
              "new_string": "replacement text for patch actions",
              "replace_all": false
            }
          ]
        }
        """
    ).strip()
    transcript = conversation_transcript_for_model(conv, limit=MAX_RECENT_MESSAGES, max_chars=16000)
    reply = call_model(
        [
            {"role": "system", "content": prompt},
            {
                "role": "user",
                "content": (
                    f"Review trigger(s): {review_reason_text}\n\n"
                    f"Recently loaded/consulted skills:\n{loaded_skill_context}\n\n"
                    f"Existing skill catalog:\n{catalog}\n\n"
                    f"Conversation transcript:\n{transcript}"
                ),
            },
        ],
        temperature=0.1,
        stream=False,
        echo=False,
        timeout=timeout,
        route=MODEL_ROUTE_MEMORY,
    ).strip()
    return parse_skill_suggestion_output(reply)


def title_candidate_messages(conv: dict) -> list[dict]:
    return [
        msg
        for msg in conv.get("messages", [])
        if msg.get("role") in {"user", "assistant"} and msg.get("content", "").strip()
    ]


def should_generate_conversation_title(conv: dict) -> bool:
    if conv.get("title_generated"):
        return False
    title = (conv.get("title") or "Untitled").strip()
    title_kind = conv.get("title_kind")
    if title_kind == "manual":
        return False
    if title_kind not in {"unset", "provisional", None} and title != "Untitled":
        return False
    return len(title_candidate_messages(conv)) >= TITLE_MIN_MESSAGES


def sanitize_generated_title(text: str) -> str:
    line = next((row.strip() for row in text.splitlines() if row.strip()), "")
    line = re.sub(r"^(title|conversation)\s*:\s*", "", line, flags=re.IGNORECASE)
    line = line.strip(" \t\r\n\"'`*_")
    line = re.sub(r"\s+", " ", line)
    line = re.sub(r"[\x00-\x1f\x7f]", "", line)
    if not line:
        return ""
    return line[:TITLE_MAX_CHARS].rstrip(" .,:;-")


def generate_conversation_title(
    conv: dict,
    *,
    timeout: float = TITLE_MODEL_TIMEOUT_SECONDS,
) -> str:
    transcript = []
    if conv.get("summary"):
        transcript.append(f"summary: {conv.get('summary', '')[:1200]}")
    for msg in title_candidate_messages(conv)[-8:]:
        transcript.append(f"{msg.get('role')}: {compact_text(msg.get('content', ''), 900)}")
    prompt = textwrap.dedent(
        f"""
        Create a compact title for this conversation.
        Return only the title, no quotes, no prefix, no punctuation-only flourish.
        Use at most {TITLE_MAX_CHARS} characters.

        Transcript:
        {chr(10).join(transcript)}
        """
    ).strip()
    title = quiet_model(
        [
            {
                "role": "system",
                "content": "You name private conversations with short, faithful, specific titles.",
            },
            {"role": "user", "content": prompt},
        ],
        temperature=0.2,
        timeout=timeout,
        route=MODEL_ROUTE_TITLE,
    )
    return sanitize_generated_title(title)


def maybe_generate_conversation_title(
    conv: dict,
    *,
    timeout: float = TITLE_MODEL_TIMEOUT_SECONDS,
) -> str | None:
    if not should_generate_conversation_title(conv):
        return None
    title = generate_conversation_title(conv, timeout=timeout)
    if not title:
        return None
    conv["title"] = title
    conv["title_kind"] = "model"
    conv["title_generated"] = now()
    save_conversation(conv)
    return title


