def bounded_output(text: str, max_chars: int = REPO_COMMAND_OUTPUT_CHARS) -> str:
    text = text.rstrip()
    if len(text) <= max_chars:
        return text
    return text[:max_chars].rstrip() + f"\n... truncated after {max_chars} characters ..."


def repo_root_for_path(path: str | None = None) -> pathlib.Path:
    require_permission("repo-read")
    base = pathlib.Path(path or os.getcwd()).expanduser().resolve()
    if not base.exists():
        raise SystemExit(f"repo path does not exist: {base}")
    require_allowed(base)
    workdir = base.parent if base.is_file() else base
    try:
        result = subprocess.run(
            ["git", "-C", str(workdir), "rev-parse", "--show-toplevel"],
            check=False,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=5,
        )
    except FileNotFoundError as exc:
        raise SystemExit("git is not available in PATH") from exc
    except subprocess.TimeoutExpired as exc:
        raise SystemExit(f"git repo discovery timed out under {workdir}") from exc
    if result.returncode != 0:
        raise SystemExit(result.stderr.strip() or f"not a Git repository: {workdir}")
    root = pathlib.Path(result.stdout.strip()).resolve()
    require_allowed(root)
    return root


def run_git_readonly(repo: pathlib.Path, args: list[str], *, timeout: int = 20) -> str:
    try:
        result = subprocess.run(
            ["git", "-C", str(repo), *args],
            check=False,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            timeout=timeout,
        )
    except subprocess.TimeoutExpired as exc:
        raise SystemExit(f"git {' '.join(args)} timed out in {repo}") from exc
    output = result.stdout.rstrip()
    errors = result.stderr.strip()
    if result.returncode != 0:
        raise SystemExit(errors or f"git {' '.join(args)} failed with exit {result.returncode}")
    if errors:
        return (output + "\n" + errors).strip()
    return output


def format_command_section(title: str, body: str) -> str:
    return f"== {title} ==\n{body.strip() or '(no output)'}"


def repo_status_report(path: str | None = None) -> tuple[pathlib.Path, str]:
    repo = repo_root_for_path(path)
    status = run_git_readonly(repo, ["status", "--short", "--branch"])
    return repo, "\n\n".join(
        [
            f"repo: {repo}",
            format_command_section("git status --short --branch", status),
        ]
    )


def repo_diff_report(path: str | None = None) -> tuple[pathlib.Path, str]:
    repo = repo_root_for_path(path)
    sections = [
        f"repo: {repo}",
        format_command_section("git diff --stat", run_git_readonly(repo, ["diff", "--stat"])),
        format_command_section("git diff --name-status", run_git_readonly(repo, ["diff", "--name-status"])),
        format_command_section("git diff --cached --stat", run_git_readonly(repo, ["diff", "--cached", "--stat"])),
        format_command_section("git diff --cached --name-status", run_git_readonly(repo, ["diff", "--cached", "--name-status"])),
    ]
    return repo, "\n\n".join(sections)


def repo_log_report(path: str | None = None) -> tuple[pathlib.Path, str]:
    repo = repo_root_for_path(path)
    log = run_git_readonly(repo, ["log", "--oneline", "--decorate", "-n", "12"])
    return repo, "\n\n".join(
        [
            f"repo: {repo}",
            format_command_section("git log --oneline --decorate -n 12", log),
        ]
    )


def repo_review_report(path: str | None = None) -> tuple[pathlib.Path, str]:
    repo = repo_root_for_path(path)
    sections = [
        f"repo: {repo}",
        format_command_section("git status --short --branch", run_git_readonly(repo, ["status", "--short", "--branch"])),
        format_command_section("git diff --stat", run_git_readonly(repo, ["diff", "--stat"])),
        format_command_section("git diff --name-status", run_git_readonly(repo, ["diff", "--name-status"])),
        format_command_section("git log --oneline --decorate -n 12", run_git_readonly(repo, ["log", "--oneline", "--decorate", "-n", "12"])),
    ]
    review_gate = repo / "scripts" / "nixos-review-gate"
    if review_gate.exists() and os.access(review_gate, os.X_OK):
        try:
            result = subprocess.run(
                [str(review_gate)],
                cwd=str(repo),
                check=False,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                text=True,
                timeout=45,
            )
        except subprocess.TimeoutExpired:
            sections.append(format_command_section("scripts/nixos-review-gate", "timed out after 45 seconds"))
        else:
            sections.append(
                format_command_section(
                    f"scripts/nixos-review-gate (exit {result.returncode})",
                    result.stdout,
                )
            )
    else:
        sections.append(format_command_section("review gate", "no executable scripts/nixos-review-gate in this repo"))
    return repo, "\n\n".join(sections)


def repo_report(command: str, path: str | None = None) -> tuple[pathlib.Path, str]:
    if command == "status":
        return repo_status_report(path)
    if command == "diff":
        return repo_diff_report(path)
    if command == "log":
        return repo_log_report(path)
    if command == "review":
        return repo_review_report(path)
    raise SystemExit("usage: repo status|diff|log|review [PATH]")


def context_item_from_repo_report(command: str, repo: pathlib.Path, report: str) -> dict:
    content = bounded_output(report)
    return {
        "kind": "repo",
        "command": command,
        "root": str(repo),
        "created": now(),
        "bytes": len(content.encode("utf-8")),
        "content": content,
    }


