def route_chat_capable(route_id: str, raw: dict) -> bool:
    profile = route_profile_value(raw)
    if profile:
        return True
    tasks = {str(item) for item in raw.get("tasks", [])} if isinstance(raw.get("tasks"), list) else set()
    if CHAT_CONTEXT_ROUTE_TASKS & tasks:
        return True
    # Backward compatibility for catalogs that predate explicit chat profiles.
    return "qwen36" in str(route_id).lower()


def chat_route_candidates() -> list[dict]:
    candidates: list[dict] = []
    base = model_route(MODEL_ROUTE_CHAT)
    if base.get("endpoint") and base.get("model"):
        base = dict(base)
        base["governor_source"] = "logical-chat"
        candidates.append(base)
    if (
        os.environ.get("MOTOKO_ENDPOINT")
        or os.environ.get("MOTOKO_MODEL")
        or os.environ.get(model_route_env_key(MODEL_ROUTE_CHAT, "endpoint"))
        or os.environ.get(model_route_env_key(MODEL_ROUTE_CHAT, "model"))
    ):
        return candidates
    catalog = load_local_model_catalog()
    for route_id, raw in local_model_catalog_routes(catalog).items():
        if not isinstance(route_id, str):
            continue
        if route_id == base.get("catalog_route"):
            continue
        raw_dict = raw if isinstance(raw, dict) else {}
        if not route_chat_capable(route_id, raw_dict):
            continue
        info = catalog_route_info(route_id, logical_route=MODEL_ROUTE_CHAT)
        if not info:
            continue
        info["governor_source"] = "catalog"
        candidates.append(info)
    deduped = []
    seen = set()
    for info in candidates:
        key = (info.get("catalog_route"), info.get("endpoint"), info.get("model"))
        if key in seen:
            continue
        seen.add(key)
        deduped.append(info)
    return deduped


def route_context_limit(info: dict) -> int:
    try:
        value = int(info.get("ctx_size") or 0)
    except (TypeError, ValueError):
        value = 0
    return value if value > 0 else CHAT_CONTEXT_MAX_SOFT_TOKENS


def route_governor_tier(info: dict) -> str:
    profile = route_profile(info)
    if profile:
        return f"chat_{profile}"
    tasks = route_tasks(info)
    if tasks & {"max_context", "max_context_chat"}:
        return "chat_max"
    if tasks & {"quality_chat", "short_context_chat"}:
        return "chat_quality"
    if tasks & {"long_context_chat"}:
        return "chat_deep"
    limit = route_context_limit(info)
    if limit >= CHAT_CONTEXT_MAX_SOFT_TOKENS:
        return "chat_max"
    if limit >= CHAT_CONTEXT_DEEP_SOFT_TOKENS:
        return "chat_deep"
    return "chat_default"


def route_governor_rank(info: dict, preferred_tier: str) -> tuple:
    tier = route_governor_tier(info)
    route_id = str(info.get("catalog_route") or info.get("route", ""))
    fallback_order = {
        "chat_default": ["chat_default", "chat_quality", "chat_deep", "chat_max"],
        "chat_quality": ["chat_quality", "chat_default", "chat_deep", "chat_max"],
        "chat_deep": ["chat_deep", "chat_default", "chat_quality", "chat_max"],
        "chat_max": ["chat_max", "chat_deep", "chat_default", "chat_quality"],
    }.get(preferred_tier, ["chat_default", "chat_quality", "chat_deep", "chat_max"])
    preferred_rank = fallback_order.index(tier) if tier in fallback_order else len(fallback_order)
    context_limit = route_context_limit(info)
    context_rank = -context_limit if preferred_tier == "chat_max" else context_limit
    return (
        preferred_rank,
        0 if preferred_tier == "chat_default" and route_selection_default_value(info) else 1,
        -route_selection_priority_value(info),
        context_rank,
        route_id,
    )


def preferred_chat_tier(prompt_tokens: int, mode: str) -> str:
    if mode == "max":
        return "chat_max"
    if mode == "deep":
        return "chat_deep"
    if mode == "quality":
        return "chat_quality"
    if mode == "default":
        return "chat_default"
    if prompt_tokens > CHAT_CONTEXT_DEEP_SOFT_TOKENS:
        return "chat_max"
    if prompt_tokens > CHAT_CONTEXT_DEFAULT_SOFT_TOKENS:
        return "chat_deep"
    return "chat_default"


def select_chat_route(messages: list[dict], *, mode: str | None = None) -> tuple[dict, dict]:
    prompt_tokens = estimate_messages_tokens(messages)
    mode = mode or chat_context_mode()
    preferred_tier = preferred_chat_tier(prompt_tokens, mode)
    candidates = chat_route_candidates() or [model_route(MODEL_ROUTE_CHAT)]
    viable = [row for row in candidates if route_context_limit(row) >= prompt_tokens]
    pool = viable or candidates
    if preferred_tier == "chat_max" and not any(route_governor_tier(row) == "chat_max" for row in pool):
        pool = sorted(pool, key=lambda row: (-route_context_limit(row), str(row.get("catalog_route") or "")))
    else:
        pool = sorted(pool, key=lambda row: route_governor_rank(row, preferred_tier))
    selected = dict(pool[0])
    selected_tier = route_governor_tier(selected)
    reason = f"{mode}:{preferred_tier}"
    if preferred_tier == "chat_max" and selected_tier != "chat_max":
        reason += "; max route unavailable, using largest declared chat route"
    if not viable:
        reason += "; prompt estimate exceeds declared context"
    return selected, {
        "schema": CONTEXT_GOVERNOR_SCHEMA_VERSION,
        "mode": mode,
        "preferred_tier": preferred_tier,
        "selected_tier": selected_tier,
        "reason": reason,
        "prompt_tokens_estimate": prompt_tokens,
        "candidate_count": len(candidates),
        "max_route_available": any(route_governor_tier(row) == "chat_max" for row in candidates),
    }


def model_route_for_request(route: str, messages: list[dict]) -> tuple[dict, dict]:
    route = normalize_model_route(route)
    if route != MODEL_ROUTE_CHAT:
        return model_route(route), {
            "schema": CONTEXT_GOVERNOR_SCHEMA_VERSION,
            "mode": "fixed",
            "preferred_tier": route,
            "selected_tier": route,
            "reason": "non-chat route uses configured logical route",
            "prompt_tokens_estimate": estimate_messages_tokens(messages),
            "candidate_count": 1,
            "max_route_available": False,
        }
    return select_chat_route(messages)


def route_policy_section(route_info: dict, *keys: str) -> dict:
    policy = route_info.get("request_policy") if isinstance(route_info.get("request_policy"), dict) else {}
    for key in keys:
        value = policy.get(key)
        if isinstance(value, dict):
            return value
    return {}


def route_sampling_presets(route_info: dict) -> dict:
    return route_policy_section(route_info, "sampling_presets", "samplingPresets")


def route_reasoning_policy(route_info: dict) -> dict:
    return route_policy_section(route_info, "reasoning")


def sampling_preset_declared(route_info: dict, preset: str) -> bool:
    return bool(preset) and preset in route_sampling_presets(route_info)


def reasoning_preset_declared(route_info: dict, preset: str) -> bool:
    presets = route_reasoning_policy(route_info).get("presets")
    return bool(preset) and isinstance(presets, dict) and preset in presets


def default_sampling_preset_for_route(route_info: dict, route: str, *, structured: bool = False) -> str:
    route = normalize_model_route(route)
    if structured or route in {
        MODEL_ROUTE_INDEX_CHUNK,
        MODEL_ROUTE_INDEX_FILE,
        MODEL_ROUTE_INDEX_CORPUS,
        MODEL_ROUTE_INDEX_LABEL,
        MODEL_ROUTE_MEMORY,
        MODEL_ROUTE_TITLE,
    }:
        candidate = "deterministic"
    elif route in {MODEL_ROUTE_CHAT, MODEL_ROUTE_TOPIC, MODEL_ROUTE_PROFILE, MODEL_ROUTE_AUDIT}:
        candidate = "balanced"
    else:
        candidate = ""
    return candidate if sampling_preset_declared(route_info, candidate) else ""


def selected_sampling_preset(
    route_info: dict,
    route: str,
    *,
    explicit: str | None = None,
    structured: bool = False,
) -> str:
    if explicit is not None:
        explicit = explicit.strip()
        return explicit if sampling_preset_declared(route_info, explicit) else ""
    return default_sampling_preset_for_route(route_info, route, structured=structured)


def selected_reasoning_preset(route_info: dict, route: str, *, explicit: str | None = None) -> str:
    policy = route_reasoning_policy(route_info)
    if not policy.get("supported"):
        return ""
    if explicit is None:
        env_value = os.environ.get("MOTOKO_REASONING_PRESET")
        if env_value is not None:
            explicit = env_value.strip()
        elif normalize_model_route(route) == MODEL_ROUTE_CHAT:
            explicit = str(policy.get("default_preset") or policy.get("defaultPreset") or "default")
        else:
            explicit = ""
    if explicit.lower() in {"", "off", "none", "0", "false", "no"}:
        return ""
    return explicit if reasoning_preset_declared(route_info, explicit) else ""


def model_request_metadata(
    route_info: dict,
    payload: dict,
    *,
    sampling_preset: str,
    reasoning_preset: str,
    json_schema=None,
    grammar: str | None = None,
) -> dict:
    metadata = request_policy_metadata(
        route_info,
        payload,
        sampling_preset=sampling_preset,
        json_schema=json_schema,
        grammar=grammar,
        reasoning_preset=reasoning_preset,
    )
    metadata["request_temperature"] = payload.get("temperature")
    metadata["route_idle_seconds"] = route_info.get("idle_seconds")
    metadata["route_max_parallel"] = route_info.get("max_parallel")
    return metadata


