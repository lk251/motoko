def find_goal_run_record(selector: str) -> dict:
    selector = str(selector or "").strip()
    if not selector:
        raise GoalLoopValidationError("goal run selector is empty")
    candidates = []
    direct = pathlib.Path(selector).expanduser()
    if direct.exists():
        candidates.append(direct)
    exact = goal_run_path(selector)
    if exact.exists():
        candidates.append(exact)
    for path in goal_runs_dir().glob("*.json"):
        stem = path.stem
        if stem == selector or stem.startswith(selector):
            candidates.append(path)
    unique = []
    seen = set()
    for path in candidates:
        key = str(path.resolve(strict=False))
        if key not in seen:
            seen.add(key)
            unique.append(path)
    if not unique:
        raise GoalLoopValidationError(f"goal run not found: {selector}")
    if len(unique) > 1:
        raise GoalLoopValidationError(f"ambiguous goal run selector: {selector}")
    data = safe_load_json(unique[0])
    if not isinstance(data, dict) or data.get("schema") != GOAL_RUN_SCHEMA_VERSION:
        raise GoalLoopValidationError(f"not a goal run record: {unique[0]}")
    return data


