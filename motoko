def index_cleanup_candidates(indexes: list[dict] | None = None) -> list[dict]:
    all_indexes = indexes if indexes is not None else list_indexes()
    latest_by_key = {index_family_key(index): index for index in latest_indexes_by_family(all_indexes)}
    candidates = []
    for index in all_indexes:
        index_id = str(index.get("id", "")).strip()
        latest = latest_by_key.get(index_family_key(index))
        if not index_id or latest is None or latest.get("id") == index_id:
            continue
        status, warnings = index_staleness(index)
        if status != "stale":
            continue
        candidates.append(
            {
                "index": index,
                "latest": latest,
                "status": status,
                "warnings": warnings,
                "bytes": path_size(index_path(index_id)) + tree_size(indexes_dir() / f"{index_id}.chunks"),
            }
        )
    candidates.sort(key=lambda row: stored_record_sort_key(row.get("index", {})))
    return candidates


def delete_index_snapshot(index: dict) -> dict:
    index_id = str(index.get("id", "")).strip()
    report = {
        "index": index_id,
        "index_deleted": False,
        "chunk_dir_deleted": False,
        "progress_deleted": False,
        "partial_deleted": False,
        "vector_stores_deleted": 0,
        "evidence_stores_deleted": 0,
        "vector_progress_deleted": 0,
        "topics_deleted": 0,
        "dossiers_deleted": 0,
        "retrieval_debug_deleted": 0,
        "retrieval_evals_deleted": 0,
        "feedback_evals_deleted": 0,
        "bytes": path_size(index_path(index_id)) + tree_size(indexes_dir() / f"{index_id}.chunks"),
    }
    if not index_id:
        return report
    for key, path in [
        ("index_deleted", index_path(index_id)),
        ("progress_deleted", index_progress_path(index_id)),
        ("partial_deleted", index_partial_path(index_id)),
    ]:
        with contextlib.suppress(FileNotFoundError):
            path.unlink()
            report[key] = True
    chunk_dir = indexes_dir() / f"{index_id}.chunks"
    if chunk_dir.exists():
        shutil.rmtree(chunk_dir, ignore_errors=True)
        report["chunk_dir_deleted"] = True
    for path in stores_referencing_index(vector_stores_dir(), index_id):
        with contextlib.suppress(FileNotFoundError):
            path.unlink()
            report["vector_stores_deleted"] += 1
    for path in stores_referencing_index(evidence_stores_dir(), index_id):
        with contextlib.suppress(FileNotFoundError):
            path.unlink()
            report["evidence_stores_deleted"] += 1
    for path in vector_progress_referencing_index(index_id):
        with contextlib.suppress(FileNotFoundError):
            path.unlink()
            report["vector_progress_deleted"] += 1
    report["topics_deleted"] = delete_json_artifacts_referencing_index(topics_dir(), index_id)
    report["dossiers_deleted"] = delete_json_artifacts_referencing_index(dossiers_dir(), index_id)
    report["retrieval_debug_deleted"] = delete_json_artifacts_referencing_index(retrieval_debug_dir(), index_id)
    report["retrieval_evals_deleted"] = delete_json_artifacts_referencing_index(retrieval_evals_dir(), index_id)
    report["feedback_evals_deleted"] = delete_json_artifacts_referencing_index(feedback_evals_dir(), index_id)
    return report


