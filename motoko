def update_slot_context_from_budget_report(context: dict, report: dict) -> None:
    context["budget"] = report.get("status")
    context["budget_profile"] = report.get("budget_profile")
    context["budget_bytes"] = report.get("budget_bytes")
    context["cache_bytes"] = report.get("bytes_after")
    context["budget_records_removed"] = report.get("records_removed", 0)
    context["budget_files_deleted"] = report.get("files_deleted", 0)
    context["budget_delete_failures"] = report.get("delete_failures", 0)
    context["budget_protected_evicted"] = report.get("protected_evicted", 0)
    context["budget_service_gc_required"] = bool(report.get("service_gc_required"))
    context["budget_service_owned_records"] = report.get("service_owned_records", 0)


def slot_cache_record_protect_key(context: dict) -> tuple:
    return (context.get("route_fingerprint"), context.get("conversation_id"), context.get("filename"))


def maybe_run_slot_cache_service_gc(route_info: dict, context: dict) -> dict:
    if not context.get("budget_service_gc_required"):
        return context
    route_name = local_model_helper_route(route_info)
    try:
        slot_cache_service_helper("slot-cache-gc", route_info)
    except (OSError, RuntimeError, subprocess.TimeoutExpired) as exc:
        context["budget_service_gc"] = "failed"
        context["budget_service_gc_error_type"] = type(exc).__name__
        return context
    context["budget_service_gc"] = "completed"
    status_text = slot_cache_service_status_text(route_info)
    status_values = parse_local_model_status(status_text)
    needs_gc = str(status_values.get("slot_cache_needs_gc", "")).strip().lower() in {"1", "true", "yes", "on"}
    if status_values and not needs_gc:
        context["budget"] = "within-budget"
        context["cache_bytes"] = int(status_values.get("slot_cache_total_bytes") or 0)
        context["budget_service_gc_required"] = False
    else:
        report = enforce_slot_cache_budget(route_info, protect_key=slot_cache_record_protect_key(context))
        update_slot_context_from_budget_report(context, report)
    context["budget_service_gc_route"] = route_name
    return context


