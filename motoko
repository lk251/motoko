def route_declared_exclusive_lane(route_info: dict) -> str:
    scheduling = route_info.get("scheduling") if isinstance(route_info.get("scheduling"), dict) else {}
    selection = route_info.get("selection") if isinstance(route_info.get("selection"), dict) else {}
    value = (
        scheduling.get("exclusiveLane")
        or scheduling.get("exclusive_lane")
        or selection.get("exclusiveLane")
        or selection.get("exclusive_lane")
    )
    return str(value or "").strip().lower().replace("_", "-")


def route_is_large_chat(route_info: dict) -> bool:
    route_name = str(route_info.get("catalog_route") or route_info.get("route", "")).lower()
