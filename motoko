def build_topic_from_chat(conv: dict, text: str) -> dict:
    body = text.strip()
    if not body and sys.stdin.isatty():
        index = load_index(None)
        query = input(style("topic query> ", "turquoise")).strip()
        return build_topic_dossier([index["id"]], query)
    if not body:
        raise SystemExit("usage: /topic [INDEX_ID] QUERY")
    parts = body.split(maxsplit=1)
    if len(parts) == 2:
        try:
            load_index(parts[0])
        except SystemExit:
            pass
        else:
            return build_topic_dossier([parts[0]], parts[1])

    index_ids = attached_index_ids(conv)
    if not index_ids:
        raise SystemExit("attach an index first or use: /topic INDEX_ID QUERY")
    return build_topic_dossier(index_ids, body)


def deepen_topic_from_chat(conv: dict, text: str) -> dict:
    body = text.strip()
    if not body:
        raise SystemExit("usage: /deepen [INDEX_ID] QUERY")
    parts = body.split(maxsplit=1)
    if len(parts) == 2:
        try:
            load_index(parts[0])
        except SystemExit:
            pass
        else:
            return build_topic_dossier([parts[0]], parts[1], max_chunks=TOPIC_MAX_CHUNKS)
    index_ids = attached_index_ids(conv)
    if not index_ids:
        raise SystemExit("attach an index first or use: /deepen INDEX_ID QUERY")
    return build_topic_dossier(index_ids, body, max_chunks=TOPIC_MAX_CHUNKS)


