def conversation_for_retrieval_preview(query: str, *, conversation_id: str | None = None, index_ids: list[str] | None = None) -> dict:
    if conversation_id:
        conv = load_conversation(conversation_id)
        conv = dict(conv)
        conv["context_items"] = list(conv.get("context_items", []))
    else:
        conv = new_conversation(f"retrieval preview: {slug_title(query)}")
    for index_id in index_ids or []:
        conv.setdefault("context_items", []).append(context_item_from_index(load_index_exact(index_id)))
    if not conv.get("context_items"):
        best = best_relevant_index(query, project_scope=project_scope_for_request(conv, query))
        if best is not None:
            conv.setdefault("context_items", []).append(context_item_from_index(best))
    return conv


