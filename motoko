    def handle_cwd_index_answer(self, text: str) -> None:
        plan = self.cwd_index_offer
        self.cwd_index_offer = None
        if plan is None:
            return
        answer = text.strip().lower()
        if answer in {"n", "no"}:
            record_cwd_learning_decline(plan["root"], plan["glob"])
            self.append("system", f"not learning {plan['root']} now")
            return
        self.append("system", f"learning corpus: {plan['root']}")
        self.start_cwd_indexing(plan)

