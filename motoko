def current_runtime_context() -> dict:
    routes = []
    for route in configured_model_routes():
        info = model_route(route)
        info = dict(info)
        info["lane"] = model_route_lane(route)
        routes.append(info)
    context = make_runtime_context(
        realm=identity_realm(),
        identity=identity_name(),
        app_version=APP_VERSION,
        revision=app_revision(),
        permissions=permission_mode(),
        paths=RuntimePaths(
            state_root=state_root(),
            config_root=config_root(),
            conversations_dir=conversations_dir(),
            indexes_dir=indexes_dir(),
            vector_stores_dir=vector_stores_dir(),
            evidence_stores_dir=evidence_stores_dir(),
        ),
        routes=routes,
    )
    return context.content_free_dict()


