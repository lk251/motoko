def skill_scan_report(name: str | None = None) -> dict:
    if name:
        rows = [core_load_skill(skills_dir(), name)]
    else:
        rows = active_skills()
    scans = []
    for row in rows:
        scan_name = str(row.get("slug") or row.get("name") or "")
        scans.append(scan_skill_package(row, read_file=_read_skill_support_for_scan(scan_name)))
    severity_counts = {
        "block": sum(int(scan.get("severity_counts", {}).get("block", 0) or 0) for scan in scans),
        "warn": sum(int(scan.get("severity_counts", {}).get("warn", 0) or 0) for scan in scans),
        "info": sum(int(scan.get("severity_counts", {}).get("info", 0) or 0) for scan in scans),
    }
    return {
        "schema": "motoko-skill-scan-suite-v1",
        "skill": name or "",
        "status": "blocked" if severity_counts["block"] else ("review" if severity_counts["warn"] else "pass"),
        "severity_counts": severity_counts,
        "scans": scans,
    }


def format_skill_scan(name: str | None = None) -> str:
    report = skill_scan_report(name)
    scans = report.get("scans", [])
    if name and len(scans) == 1:
        return format_skill_scan_report(scans[0])
    counts = report.get("severity_counts", {})
    lines = [
        "skill scan suite",
        f"schema: {report.get('schema', '')}",
        f"status: {report.get('status', '')}",
        f"skills: {len(scans)}",
        f"findings: block={counts.get('block', 0)} warn={counts.get('warn', 0)} info={counts.get('info', 0)}",
    ]
    for scan in scans:
        scan_counts = scan.get("severity_counts", {})
        lines.append(
            f"- {scan.get('skill', '')}: {scan.get('status', '')} "
            f"block={scan_counts.get('block', 0)} warn={scan_counts.get('warn', 0)} info={scan_counts.get('info', 0)}"
        )
        for finding in scan.get("findings", [])[:3]:
            lines.append(
                f"  {finding.get('severity', '')} {finding.get('rule', '')} "
                f"{finding.get('path', '')}:{finding.get('line', '')}"
            )
    lines.append("policy: report first; scanner findings do not approve or execute scripts")
    return "\n".join(lines)


