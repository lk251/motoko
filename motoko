def attached_context_sources(conv: dict) -> list[dict]:
    project_roots = active_project_roots(conv)
    result = make_retrieval_service().render_attached_context(
        scoped_context_items(conv.get("context_items", []), project_roots),
        "",
    )
    return result.sources


def format_conversation_sources(conv: dict) -> str:
    sources = conv.get("last_sources", [])
    if sources:
        return format_sources(sources)
    attached = attached_context_sources(conv)
    if attached:
        return "No recorded sources for the last answer yet. Attached context:\n" + format_sources(attached)
    return format_sources([])


def print_sources(conv: dict) -> None:
    print_report(format_conversation_sources(conv))


def format_status(conv: dict | None = None) -> str:
    memories = load_memories(limit=500)
    pinned = sum(1 for row in memories if row.get("pinned"))
    skills = list_skills()
    indexes = list_indexes()
    current_indexes = latest_indexes_by_family(indexes)
    index_files = sum(len(index.get("files", [])) for index in indexes)
    index_chunks = sum(
        len(file_item.get("chunks", []))
        for index in indexes
        for file_item in index.get("files", [])
    )
    duplicate_chunks = sum(int(index.get("duplicate_chunk_count", 0) or 0) for index in indexes)
    derived_bytes = sum(int(index.get("derived_content_bytes", 0) or 0) for index in indexes)
    index_upgrades = sum(1 for index in current_indexes if index_needs_artifact_upgrade(index))
    index_repairs = sum(
        1
        for index in current_indexes
        if index_staleness(index)[0] != "stale" and index_quality_gate(index).get("status") != "pass"
    )
    topics = list_topics()
    dossiers = list_dossiers()
    conversations = list_conversations()
    profile = load_profile_dossier()
    maintenance = read_maintenance_state()
    queued_memory = queued_memory_proposal_count()
    study_state = read_study_state()
    study_jobs = read_study_jobs(limit=1)
    index_jobs = active_index_progress()
    partial_indexes = list_resumable_partial_indexes()
