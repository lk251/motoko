def setup_readline_completion() -> None:
    if readline is None or not sys.stdin.isatty():
        return

    slash_names = sorted({slash_command_value(command) for command, _description in SLASH_COMMANDS})

    def complete(text: str, state: int):
        buffer = readline.get_line_buffer()
        stripped = buffer.lstrip()
        matches: list[str] = []
        if stripped.startswith("/"):
            parts = stripped.split()
            if len(parts) <= 1 and not stripped.endswith(" "):
                matches = [name for name in slash_names if name.startswith(text or "/")]
            elif parts and parts[0] == "/memory" and len(parts) <= 2:
                subcommands = [
                    slash_command_value(command).split(maxsplit=1)[1]
                    for command, _description in SLASH_COMMANDS
                    if command.startswith("/memory ")
                ]
                matches = [item for item in sorted(set(subcommands)) if item.startswith(text)]
            elif parts and parts[0] in {"/resume"}:
                matches = [item for item in completion_ids("conversation") if item.startswith(text)]
            elif parts and parts[0] in {"/attach-index", "/topic", "/deepen"}:
                matches = [item for item in completion_ids("index") if item.startswith(text)]
            elif parts and parts[0] in {"/attach-topic", "/topic-show"}:
                matches = [item for item in completion_ids("topic") if item.startswith(text)]
            elif parts and parts[0] in {"/attach-dossier", "/dossier-show"}:
                matches = [item for item in completion_ids("dossier") if item.startswith(text)]
        else:
            matches = [name for name in SHELL_COMMANDS if name.startswith(text)]
        try:
            return matches[state]
        except IndexError:
            return None

    readline.set_completer(complete)
    readline.set_completer_delims(" \t\n")
    for binding in [
        "set editing-mode emacs",
        "tab: complete",
        '"\\C-a": beginning-of-line',
        '"\\C-e": end-of-line',
        '"\\C-b": backward-char',
        '"\\C-f": forward-char',
        '"\\C-k": kill-line',
        '"\\C-y": yank',
        "set show-all-if-ambiguous on",
        "set completion-ignore-case on",
    ]:
        try:
            readline.parse_and_bind(binding)
        except Exception:
            pass


def motoko_input(prompt: str) -> str:
