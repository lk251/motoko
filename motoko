def start_new_conversation_from_current(current: dict, title: str | None = None) -> dict:
    close_conversation(current)
    conv = new_conversation(title)
    save_conversation(conv)
    return conv


def resume_conversation_from_current(current: dict, selector: str | None = None) -> dict:
    close_conversation(current)
    return load_conversation(selector)


def delete_conversation_then_new(conv: dict) -> tuple[dict, dict]:
    report = delete_conversation_and_artifacts(conv)
    return new_conversation(), report


def delete_conversation_and_artifacts(conv: dict) -> dict:
    conversation_id = str(conv.get("id", "")).strip()
    if not conversation_id:
        raise SystemExit("conversation has no id")
    report = {
        "conversation_id": conversation_id,
        "conversation_deleted": False,
        "memories_deleted": 0,
        "memory_proposals_deleted": 0,
        "feedback_deleted": 0,
        "study_job_events_deleted": 0,
        "topics_deleted": 0,
        "dossiers_deleted": 0,
        "feedback_evals_deleted": 0,
        "profile_deleted": False,
        "maintenance_deleted": False,
        "study_state_deleted": False,
        "context_catalog_deleted": False,
    }

    rows = [normalize_memory_row(row, idx) for idx, row in enumerate(read_memory_rows(), 1)]
    kept_memories, report["memories_deleted"] = filter_json_rows_without_conversation(rows, conversation_id)
    if report["memories_deleted"]:
        write_memory_rows(kept_memories)

    report["feedback_deleted"] = rewrite_jsonl_without_conversation(response_feedback_path(), conversation_id)
    report["memory_proposals_deleted"] = rewrite_jsonl_without_conversation(
        memory_proposal_queue_path(),
        conversation_id,
    )
    report["study_job_events_deleted"] = rewrite_jsonl_without_conversation(study_jobs_path(), conversation_id)
    report["topics_deleted"] = delete_json_artifacts_referencing_conversation(topics_dir(), conversation_id)
    report["dossiers_deleted"] = delete_json_artifacts_referencing_conversation(dossiers_dir(), conversation_id)
    report["feedback_evals_deleted"] = delete_json_artifacts_referencing_conversation(feedback_evals_dir(), conversation_id)

    profile = safe_load_json(profile_path())
    if profile is not None and json_references_conversation(profile, conversation_id):
        with contextlib.suppress(FileNotFoundError):
            profile_path().unlink()
            report["profile_deleted"] = True

    maintenance = read_maintenance_state()
    if maintenance is not None and json_references_conversation(maintenance, conversation_id):
        clear_maintenance_state(maintenance.get("job_id"))
        report["maintenance_deleted"] = True

    study_state = read_study_state()
    if study_state is not None and json_references_conversation(study_state, conversation_id):
        with contextlib.suppress(FileNotFoundError):
            study_state_path().unlink()
            report["study_state_deleted"] = True

    with contextlib.suppress(FileNotFoundError):
        context_catalog_path().unlink()
        report["context_catalog_deleted"] = True

    with contextlib.suppress(FileNotFoundError):
        conversation_path(conversation_id).unlink()
        report["conversation_deleted"] = True
    return report


def route_args_ctx_size(args) -> int | None:
    if not isinstance(args, list):
        return None
    for idx, item in enumerate(args):
        if str(item) != "--ctx-size" or idx + 1 >= len(args):
            continue
        try:
            value = int(args[idx + 1])
        except (TypeError, ValueError):
            continue
        if value > 0:
            return value
    return None


def route_context_size(raw: dict) -> int | None:
    return (
        route_int_value(raw, "ctx_size", "ctxSize")
        or route_int_value(raw, "context_size", "contextSize")
        or route_int_value(raw, "context_tokens", "contextTokens")
        or route_args_ctx_size(raw.get("args"))
    )


def route_quant_label(raw: dict) -> str:
    for key in ("quant", "model_quant", "modelQuant"):
        value = raw.get(key)
        if isinstance(value, str) and value.strip():
            return value.strip()
    haystack = " ".join(
        str(raw.get(key, ""))
        for key in ("model", "modelId", "model_id", "displayName", "file", "model_path", "modelPath")
    ).lower()
    for pattern in ("ud-q5", "ud-q4", "q8_0", "q6_k", "q5_k", "q4_k"):
        if pattern in haystack:
            return pattern.upper().replace("_", "-")
    return ""


