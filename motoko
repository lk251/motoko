    conversations = [
        conv
        for conv in list_conversations()[:PROFILE_SOURCE_CONVERSATIONS]
        if conversation_recall_text(conv).strip()
    ]
    memory_lines = [
        f"- [{row.get('id', '')}; i{row.get('importance', MEMORY_DEFAULT_IMPORTANCE)}] {row.get('text', '')}"
        for row in memories
    ]
    conversation_blocks = []
    for conv in conversations:
        title = conv.get("title") or "Untitled"
        conversation_blocks.append(
            f"--- conversation:{conv.get('id', '')} title:{title} updated:{conv.get('updated', '')} ---\n"
            f"{compact_text(conversation_recall_text(conv), 2500)}"
        )
    text = textwrap.dedent(
        f"""
