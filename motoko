        return False
    return not route_is_large_chat(route_info)


def local_model_status_busy(status_text: str) -> bool:
    values = parse_local_model_status(status_text)
    for key in (
        "active_requests",
        "requests_active",
        "inflight_requests",
        "busy_requests",
        "slots_processing",
        "slot_processing",
    ):
        raw = values.get(key)
        if raw is None:
            continue
        try:
            if int(raw) > 0:
                return True
        except ValueError:
            if raw.strip().lower() in {"true", "yes", "busy", "active"}:
                return True
    for key in ("busy", "serving", "request_active"):
        if values.get(key, "").strip().lower() in {"1", "true", "yes", "busy", "active"}:
            return True
    return False


def local_route_status_active(status_text: str) -> bool:
    values = parse_local_model_status(status_text)
    backend = values.get("backend", "").strip().lower()
    proxy = values.get("proxy", "").strip().lower()
    return backend in {"active", "activating"} or proxy in {"active", "activating"}


def route_residency_grace_seconds(route_info: dict) -> int:
    scheduling = route_info.get("scheduling") if isinstance(route_info.get("scheduling"), dict) else {}
    for key in (
        "residencyGraceSeconds",
        "residency_grace_seconds",
        "releaseGraceSeconds",
        "release_grace_seconds",
        "chatGraceSeconds",
        "chat_grace_seconds",
    ):
        value = scheduling.get(key)
        try:
            seconds = int(value)
        except (TypeError, ValueError):
            continue
        if seconds >= 0:
            return min(seconds, 900)
    try:
        seconds = int(route_info.get("idle_seconds") or 0)
    except (TypeError, ValueError):
        seconds = 0
    if seconds > 0:
        return min(seconds, 900)
    return MODEL_RESIDENCY_DEFAULT_CHAT_GRACE_SECONDS


def recent_large_chat_grace_remaining(route_info: dict) -> int:
    route_name = local_model_helper_route(route_info)
    record = read_last_model_call()
    if str(record.get("status") or "") != "completed":
        return 0
    if str(record.get("catalog_route") or "") != route_name:
        return 0
    if normalize_model_route(str(record.get("route") or ""), strict=False) != MODEL_ROUTE_CHAT:
        return 0
    finished = parse_timestamp(str(record.get("finished") or ""))
    if finished is None:
        return 0
    elapsed = (_dt.datetime.now(_dt.timezone.utc).astimezone() - finished.astimezone()).total_seconds()
    remaining = route_residency_grace_seconds(route_info) - int(max(0, elapsed))
    return max(0, remaining)


