        haystack = "\n".join(str(item.get(field, "")) for field in fields)
        row = dict(item)
        row["_score"] = score_text(query_counts, haystack)
        ranked.append(row)
    ranked.sort(key=lambda row: row.get("_score", 0), reverse=True)
    return ranked


