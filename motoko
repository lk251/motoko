def review_skill_suggestions_text(conv: dict, *, source: str = "manual-skill-review") -> str:
    if not conv.get("messages"):
        return "skill review: no conversation messages to review"
    suggestions = propose_skill_suggestions(conv, timeout=MAINTENANCE_MODEL_TIMEOUT_SECONDS)
    if not suggestions:
        return "skill review: no reusable procedure found"
    added = add_skill_suggestions(suggestions, conversation_id=conv.get("id", ""), source=source)
    if not added:
        return "skill review: no new suggestions; proposed skills were duplicates or already learned"
    lines = [f"skill review: {len(added)} pending suggestion(s)"]
    for row in added:
        lines.append(f"- {row.get('id', '')}  {row.get('slug', '')}: {row.get('description', '')}")
        if row.get("reason"):
            lines.append(f"  reason: {row.get('reason', '')}")
        lines.append(f"  show: motoko skill suggestion {row.get('id', '')}")
    return "\n".join(lines)


