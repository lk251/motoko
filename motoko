    def start_generation(self, user_text: str) -> None:
        maybe_set_title(self.conv, user_text)
        topic = maybe_attach_relevant_existing_topic(self.conv, user_text)
        if topic:
            self.append("system", f"auto-attached topic dossier: {topic.get('id')} ({topic.get('name', '')})")
        dossier = maybe_attach_relevant_existing_dossier(self.conv, user_text)
        if dossier:
            self.append("system", f"auto-attached memory dossier: {dossier.get('id')} ({dossier.get('name', '')})")
        self.conv.setdefault("messages", []).append({"role": "user", "content": user_text})
        self.append("user", user_text)
        explicit_saved = save_explicit_user_memories(user_text, self.conv["id"])
        if explicit_saved:
            self.append("system", f"memory saved from this prompt ({explicit_saved})")
        self.answer_entry = self.append("assistant", "")
        self.status = "Motoko is thinking; you can type the next prompt below"
        self.generating = True
        self.cancel_event = threading.Event()
        messages, sources = build_messages(self.conv, user_text)
        cancel_event = self.cancel_event

        def worker() -> None:
            try:
                def on_token(token: str) -> None:
                    if cancel_event.is_set():
                        raise RuntimeError("__motoko_stopped__")
                    self.put_event(("token", token))

                reply = call_model_with_callback(
                    messages,
                    temperature=0.7,
                    on_token=on_token,
                )
                self.put_event(("done", reply, sources))
            except RuntimeError as exc:
                if str(exc) == "__motoko_stopped__":
                    self.put_event(("stopped",))
                else:
                    self.put_event(("error", f"{type(exc).__name__}: {exc}"))
            except SystemExit as exc:
                self.put_event(("error", str(exc)))
            except Exception as exc:  # Defensive: preserve terminal session.
                self.put_event(("error", f"{type(exc).__name__}: {exc}"))

        threading.Thread(target=worker, daemon=True).start()

    def put_event(self, event: tuple) -> None:
        with self.events_lock:
            self.events.append(event)

    def drain_events(self) -> None:
        changed = False
        while True:
            with self.events_lock:
                if not self.events:
                    break
                event = self.events.popleft()
            kind = event[0]
            if kind == "token":
                if self.answer_entry is not None:
                    self.answer_entry["content"] += event[1]
                    changed = True
            elif kind == "done":
                reply, sources = event[1], event[2]
                self.conv["last_sources"] = sources
                self.conv["messages"].append({"role": "assistant", "content": reply})
                save_conversation(self.conv)
                self.generating = False
                self.answer_entry = None
                self.status = "ready"
                changed = True
                if self.pending_prompts:
                    next_prompt = self.pending_prompts.popleft()
                    self.start_generation(next_prompt)
                else:
                    self.start_maintenance()
            elif kind == "stopped":
                partial = ""
                if self.answer_entry is not None:
                    partial = self.answer_entry.get("content", "")
                    if partial:
                        self.answer_entry["content"] = partial.rstrip() + "\n\n[stopped]"
                if partial:
                    self.conv["messages"].append(
                        {"role": "assistant", "content": partial.rstrip() + "\n\n[stopped]"}
                    )
                save_conversation(self.conv)
                self.generating = False
                self.answer_entry = None
                self.status = "answer stopped"
                changed = True
            elif kind == "error":
                self.generating = False
                self.answer_entry = None
                self.append("error", event[1])
                self.status = "ready"
                changed = True
            elif kind == "maintenance_done":
                self.maintaining = False
                notes = event[1]
                self.status = "ready"
                self.maintenance_status = ""
                if notes:
                    self.messages = self.seed_messages(self.conv)
                    self.append("system", "; ".join(notes))
                changed = True
            elif kind == "maintenance_error":
                self.maintaining = False
                self.maintenance_status = ""
                self.status = "ready"
                self.append("system", f"memory maintenance failed: {event[1]}")
                changed = True
            elif kind == "maintenance_phase":
                self.maintenance_status = event[1]
                self.maintenance_phase_started = time.monotonic()
                self.status = event[1]
                changed = True
            elif kind == "study_phase":
                if self.cwd_indexing:
                    continue
                self.study_running = True
                self.study_status = event[1]
                self.study_phase_started = time.monotonic()
                changed = True
            elif kind == "study_done":
                if self.cwd_indexing:
                    continue
                self.study_running = False
                notes = event[1]
                self.study_last_note = "; ".join(notes) if notes else "catalog fresh"
                self.study_status = "study: idle"
                if self.pending_prompts and not self.generating and not self.maintaining:
                    next_prompt = self.pending_prompts.popleft()
                    self.start_generation(next_prompt)
                changed = True
            elif kind == "study_error":
                if self.cwd_indexing:
                    continue
                self.study_running = False
                self.study_status = "study: idle"
                self.study_last_note = f"study failed: {event[1]}"
                changed = True
            elif kind == "cwd_index_progress":
                self.index_progress = event[1]
                self.study_running = True
                self.cwd_indexing = True
                self.study_status = format_index_progress_status(self.index_progress)
                changed = True
            elif kind == "cwd_index_done":
                self.cwd_indexing = False
                self.study_running = False
                self.index_progress = None
                index_id = event[1]
                self.study_last_note = f"learned corpus index {index_id}"
                self.study_status = "study: idle"
                self.append("system", f"learned corpus index: {index_id}")
                if self.pending_prompts and not self.generating and not self.maintaining:
                    next_prompt = self.pending_prompts.popleft()
                    self.start_generation(next_prompt)
                changed = True
            elif kind == "cwd_index_error":
                self.cwd_indexing = False
                self.study_running = False
                self.index_progress = None
                self.study_status = "study: idle"
                self.study_last_note = f"corpus learning failed: {event[1]}"
                self.append("error", f"corpus learning failed: {event[1]}")
                changed = True
            elif kind == "system_note":
                self.append("system", event[1])
                changed = True
        if changed:
            self.dirty = True

    def start_study_loop(self) -> None:
        if not env_flag("MOTOKO_BACKGROUND_STUDY", True):
            self.study_status = "study: off"
            return
        interval = env_seconds("MOTOKO_BACKGROUND_STUDY_INTERVAL", BACKGROUND_STUDY_INTERVAL_SECONDS)
        idle_grace = env_seconds("MOTOKO_BACKGROUND_STUDY_IDLE_GRACE", BACKGROUND_STUDY_IDLE_GRACE_SECONDS)

        def worker() -> None:
            next_run = time.monotonic() + 1
            while self.running:
                time.sleep(1)
                now_ts = time.monotonic()
                if now_ts < next_run:
                    continue
                if self.generating or self.maintaining or self.study_running or self.pending_prompts:
                    next_run = now_ts + min(5, interval)
                    continue
                if now_ts - self.last_input_at < idle_grace:
                    next_run = now_ts + 1
                    continue
                next_run = now_ts + interval
                self.put_event(("study_phase", "study: scanning"))
                try:
                    notes = background_study_step(
                        self.conv,
                        phase_callback=lambda phase: self.put_event(("study_phase", phase)),
                    )
                except Exception as exc:  # Background study must not break chat.
                    self.put_event(("study_error", f"{type(exc).__name__}: {exc}"))
                else:
                    self.put_event(("study_done", notes))

        threading.Thread(target=worker, daemon=True).start()

    def start_maintenance(self, *, resumed: bool = False) -> None:
        if self.maintaining or self.generating:
            return
        self.maintaining = True
        self.maintenance_status = "memory: checking"
        self.maintenance_phase_started = time.monotonic()
        self.status = self.maintenance_status
        state = begin_maintenance_state(self.conv, resumed=resumed)

        def worker() -> None:
            try:
                def on_phase(phase: str) -> None:
                    self.put_event(("maintenance_phase", phase))

                notes = auto_maintain_conversation(
                    self.conv,
                    phase_callback=on_phase,
                    state=state,
                )
                clear_maintenance_state(state.get("job_id"))
                self.put_event(("maintenance_done", notes))
            except Exception as exc:  # Keep hidden maintenance from breaking chat.
                update_maintenance_state(
                    state,
                    "memory: failed",
                    status="failed",
                    error=f"{type(exc).__name__}: {exc}",
                )
                self.put_event(("maintenance_error", f"{type(exc).__name__}: {exc}"))

        threading.Thread(target=worker, daemon=True).start()

