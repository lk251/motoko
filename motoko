    def apply_dropdown(self, option: dict) -> None:
        kind = option["kind"]
        value = option["value"]
        if kind == "command":
            if value in SIMPLE_SLASH_COMMANDS:
                self.input_buffer = ""
                self.cursor = 0
                self.submit_text(value)
                return
            self.input_buffer = value + " "
            self.cursor = len(self.input_buffer)
            self.dropdown_index = 0
            self.dirty = True
            return
        first = self.input_buffer.lstrip().split()[0] if self.input_buffer.lstrip().split() else ""
        if kind == "conversation":
            self.input_buffer = f"/resume {value}"
            self.cursor = len(self.input_buffer)
            self.submit_text(self.input_buffer)
            self.input_buffer = ""
            self.cursor = 0
            return
        if kind == "index":
            if first in {"/topic", "/deepen"}:
                self.input_buffer = f"/topic {value} "
                if first == "/deepen":
                    self.input_buffer = f"/deepen {value} "
                self.cursor = len(self.input_buffer)
            else:
                self.input_buffer = f"{first} {value}"
                self.cursor = len(self.input_buffer)
                self.submit_text(self.input_buffer)
                self.input_buffer = ""
                self.cursor = 0
            self.dropdown_index = 0
            self.dirty = True
            return
        if kind == "partial-index":
            self.input_buffer = f"{first} {value}"
            self.cursor = len(self.input_buffer)
            self.submit_text(self.input_buffer)
            self.input_buffer = ""
            self.cursor = 0
            return
        if kind == "topic":
            if first == "/topic-show":
                self.input_buffer = f"/topic-show {value}"
            else:
                self.input_buffer = f"/attach-topic {value}"
            self.cursor = len(self.input_buffer)
            self.submit_text(self.input_buffer)
            self.input_buffer = ""
            self.cursor = 0
        if kind == "dossier":
            if first == "/dossier-show":
                self.input_buffer = f"/dossier-show {value}"
            else:
                self.input_buffer = f"/attach-dossier {value}"
            self.cursor = len(self.input_buffer)
            self.submit_text(self.input_buffer)
            self.input_buffer = ""
            self.cursor = 0
        if kind == "skill":
            parts = self.input_buffer.lstrip().split()
            subcommand = parts[1] if len(parts) > 1 else "show"
            self.input_buffer = f"/skill {subcommand} {value}"
            self.cursor = len(self.input_buffer)
            if subcommand == "show":
                self.submit_text(self.input_buffer)
                self.input_buffer = ""
                self.cursor = 0
            else:
                self.dropdown_index = 0
                self.dirty = True
        if kind == "model-route":
            self.input_buffer = f"{first} {value}"
            self.cursor = len(self.input_buffer)
            self.dropdown_index = 0
            self.dirty = True

    def render(self, *, force: bool = False) -> None:
        self.drain_events()
        size = self.terminal_size()
        width, height = size.columns, size.lines
        width = max(40, width)
        height = max(12, height)
        content_width = max(20, width - 1)
        if self.overlay_lines is not None:
            self.render_overlay_page(content_width, height)
        else:
            bottom_frame = self.bottom_area_frame(content_width, height)
            self.sync_transcript(content_width, height, reserved_rows=len(bottom_frame[0]))
            if self.generating:
                self.sync_active_answer_transcript(content_width, height, reserved_rows=len(bottom_frame[0]))
            self.draw_bottom_area(content_width, height, force=force, frame=bottom_frame)
        self.last_render = time.monotonic()
        self.dirty = False

