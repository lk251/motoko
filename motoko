def build_goal_readonly_context(run: dict) -> tuple[str, list[dict], dict]:
    objective = str(run.get("objective", "") or "")
    project_scope = goal_readonly_project_scope(run)
    conv = {
        "id": str(run.get("id", "")),
        "title": objective[:80] or "Goal loop",
        "messages": [],
        "context_items": [],
        "project": project_scope.get("project", {}),
    }
    try:
        indexes = select_retrieval_debug_indexes(objective, conv=None, limit=2, project_scope=project_scope)
    except SystemExit:
        indexes = []
    for index in indexes[:2]:
        with contextlib.suppress(Exception):
            conv.setdefault("context_items", []).append(context_item_from_index(index))
    context_package, _context_values = build_prompt_context_package(conv, objective, project_scope=project_scope)
    parts = []
    used = 0
    for lane in context_package.lanes:
        if not str(lane.text or "").strip():
            continue
        header = f"## {lane.lane}\n"
        remaining = GOAL_READONLY_CONTEXT_CHARS - used - len(header)
        if remaining <= 0:
            break
        body = str(lane.text or "")[:remaining].rstrip()
        if body:
            parts.append(header + body)
            used += len(header) + len(body)
    context_text = "\n\n".join(parts)
    return context_text, list(context_package.sources), project_scope


def goal_readonly_messages(run: dict, context_text: str) -> list[dict]:
    budgets = run.get("budgets") if isinstance(run.get("budgets"), dict) else {}
    mutating = run.get("planner") == GOAL_LOOP_PLANNER_MODEL_CONFIRMED
    if mutating:
        prompt = textwrap.dedent(
            """
            You are Motoko's model planner for a user-confirmed goal loop.

            Plan toward the objective using only the context in this prompt.
            You may propose typed motoko-action-v1 records for later explicit
            user confirmation. Do not claim any action has already been applied.
            Motoko code will validate every action and will stop for review
            before mutation.

            Supported mutating action kinds:
            - project_file_write: absolute allowlisted path, mode create or
              overwrite, content string, expected_sha256 required for overwrite.
            - git_worktree_create: repo, path, branch, base. Use this when the
              user asks to isolate work in a new worktree.
            - git_commit: repo, paths, message. Use explicit paths only.
            - git_worktree_merge: repo, branch, target_branch, optional path.
              This is intended for explicit merge requests and uses safe Git
              checks before applying.
            - git_worktree_remove: path, optional repo, optional force.

            If the objective requests work in a new branch/worktree, propose
            git_worktree_create first, then target project_file_write and
            git_commit actions at paths inside that worktree. Do not propose
            merge or remove unless the objective explicitly asks for that.

            Return strict JSON with:
            - plan: short ordered planning steps
            - retrieval_assessment: whether the retrieved context is enough
            - observations: source-grounded findings from the context
            - proposed_actions: zero or more typed motoko-action-v1 records
            - audit: self-check for grounding, uncertainty, and safety
            - next_steps: concise user-review next steps
            """
        ).strip()
    else:
        prompt = textwrap.dedent(
            """
            You are Motoko's read-only goal planner.

            Plan toward the objective using only the context in this prompt. Do
            not claim to have edited files, run tools, restarted services,
            pushed code, or mutated state. You may propose typed Motoko actions
            for later human review, but you must not ask for them to be applied
            inside this loop.

            Return strict JSON with:
            - plan: short ordered planning steps
            - retrieval_assessment: whether the retrieved context is enough
            - observations: source-grounded findings from the context
            - proposed_actions: zero or more typed motoko-action-v1 records
              that a later user could review; leave empty when no action is
              justified
            - audit: self-check for grounding, uncertainty, and safety
            - next_steps: concise user-review next steps
            """
        ).strip()
    user = textwrap.dedent(
        f"""
        Objective:
        {run.get('objective', '')}

        Scope:
        {', '.join(run.get('scope', []) or []) or 'current project'}

        Budgets:
        steps={budgets.get('max_steps')} model_calls={budgets.get('max_model_calls')}
        tool_calls={budgets.get('max_tool_calls')} minutes={budgets.get('max_minutes')}

        Retrieved context:
        {context_text or 'No context was retrieved.'}
        """
    ).strip()
    return [{"role": "system", "content": prompt}, {"role": "user", "content": user}]


def planned_worktree_roots_from_actions(actions: list[dict]) -> list[pathlib.Path]:
    roots: list[pathlib.Path] = []
    base = managed_git_worktrees_root().resolve(strict=False)
    for action in actions:
        if not isinstance(action, dict) or action.get("kind") != "git_worktree_create":
            continue
        raw = str(action.get("path") or "").strip()
        if not raw:
            continue
        path = pathlib.Path(raw).expanduser().resolve(strict=False)
        try:
            path.relative_to(base)
        except ValueError:
            continue
        if path not in roots:
            roots.append(path)
    return roots


def path_under_roots(path: pathlib.Path, roots: list[pathlib.Path]) -> pathlib.Path | None:
    resolved = path.expanduser().resolve(strict=False)
    for root in roots:
        root_resolved = root.expanduser().resolve(strict=False)
        if resolved == root_resolved or is_under(resolved, root_resolved):
            return root_resolved
    return None


def goal_action_path_checker(planned_roots: list[pathlib.Path]):
    def checker(_key: str, value: str, *, write: bool = False) -> None:
        raw = str(value or "").strip()
        if not raw:
            return
        candidate = pathlib.Path(raw).expanduser()
        if not candidate.is_absolute():
            candidate = pathlib.Path.cwd() / candidate
        planned = path_under_roots(candidate, planned_roots)
        if planned is not None:
            require_not_cross_home(candidate)
            text = str(candidate).replace("\\", "/")
            if "\x00" in text or any(part in {"", ".."} for part in pathlib.PurePosixPath(text).parts):
                raise AgenticValidationError("planned worktree path must not contain traversal")
            if any(part in SKIP_INDEX_DIR_NAMES for part in candidate.parts):
                raise AgenticValidationError("planned worktree action may not target cache/VCS directories")
            if write and candidate.name == MOTOKO_IGNORE_FILE:
                raise AgenticValidationError("planned worktree action may not modify .motokoignore")
            return
        action_path_checker(_key, value, write=write)

    return checker


def goal_proposed_action_validations(run: dict, parsed: dict) -> list[dict]:
    proposed = parsed.get("proposed_actions") if isinstance(parsed.get("proposed_actions"), list) else []
    if proposed and "propose_project_changes" not in set(run.get("allowed_effects", [])):
        raise AgenticValidationError("goal proposed_actions require propose_project_changes in allowed_effects")
    path_checker = action_path_checker
    if run.get("planner") == GOAL_LOOP_PLANNER_MODEL_CONFIRMED:
        path_checker = goal_action_path_checker(planned_worktree_roots_from_actions(proposed))
    return core_summarize_tool_proposed_actions(
        {"proposed_actions": proposed},
        skill_resolver=lambda name: core_load_skill(skills_dir(), name),
        approval_path=tool_approvals_path(),
        realm=identity_realm(),
        path_checker=path_checker,
    )


def finish_goal_readonly_run(run: dict, *, status: str, error: str = "") -> None:
    run["status"] = status
    run["cursor"] = len(run.get("planner_steps", []) or [])
    if error:
        run["error"] = error
    elif status in {"completed", "awaiting_confirmation", "applied"}:
        run.pop("error", None)
    write_goal_run_record(run)


def execute_goal_readonly_run_record(run: dict, *, yes: bool, cancel_event=None) -> str:
    if not yes:
        return "goal run:\nstatus: refused\nerror: refusing to run a goal loop without --yes"
    allowed_effects = set(run.get("allowed_effects", []))
    readonly_effects = {"read_context", "read_allowed_files", "write_motoko_state", "propose_project_changes"}
    confirmed_effects = readonly_effects | {"write_allowed_project"}
    is_confirmed = run.get("planner") == GOAL_LOOP_PLANNER_MODEL_CONFIRMED
    permitted_effects = confirmed_effects if is_confirmed else readonly_effects
    if not allowed_effects <= permitted_effects:
        return (
            "goal run:\n"
            "status: refused\n"
            f"error: {run.get('planner')} goal loops requested unsupported effects"
        )
    budgets = run.get("budgets") if isinstance(run.get("budgets"), dict) else {}
    if int(budgets.get("max_model_calls") or 0) < 1 or int(budgets.get("max_steps") or 0) < 3:
        return "goal run:\nstatus: refused\nerror: model_readonly goal loops require at least 3 steps and 1 model call"
    if run.get("status") in {"completed", "awaiting_confirmation", "applied"}:
        return format_goal_run_result(run)
    lines = [
        "goal run:",
        f"id: {run.get('id', '')}",
        f"planner: {run.get('planner', '')}",
        f"objective: {run.get('objective', '')}",
    ]
    if work_pause_requested():
        run["status"] = "paused"
        run["note"] = "paused before model planning"
        write_goal_run_record(run)
        clear_work_pause_request()
        lines.append("paused: before model planning")
        lines.append("status: paused")
        lines.append(f"record: {goal_run_path(str(run.get('id', '')))}")
        return "\n".join(lines)
    if cancellation_requested(cancel_event):
        finish_goal_readonly_run(run, status="interrupted", error="interrupted before model planning")
        lines.append("status: interrupted")
        lines.append("error: interrupted before model planning")
        lines.append(f"record: {goal_run_path(str(run.get('id', '')))}")
        return "\n".join(lines)

    run["status"] = "running"
    run["planner_steps"] = []
    write_goal_run_record(run)
    started = time.monotonic()
    try:
        context_text, sources, project_scope = build_goal_readonly_context(run)
        run["planner_steps"].append(
            {
                "phase": "retrieve",
                "status": "completed",
                "source_count": len(sources),
                "project_roots": sorted(project_scope_roots(project_scope)),
            }
        )
        write_goal_run_record(run)
        if cancellation_requested(cancel_event):
            finish_goal_readonly_run(run, status="interrupted", error="interrupted after retrieval")
            lines.append("status: interrupted")
            lines.append("error: interrupted after retrieval")
            lines.append(f"record: {goal_run_path(str(run.get('id', '')))}")
            return "\n".join(lines)
        reply = call_model(
            goal_readonly_messages(run, context_text),
            temperature=0.2,
            stream=False,
            echo=False,
            route=MODEL_ROUTE_AUDIT,
            source_count=len(sources),
            sampling_preset="deterministic",
            json_schema=GOAL_READONLY_OUTPUT_SCHEMA,
            max_tokens=GOAL_READONLY_MAX_MODEL_OUTPUT_TOKENS,
        ).strip()
        parsed, json_error = extract_json_object(reply)
        if parsed is None:
            raise AgenticValidationError(json_error or "read-only planner returned invalid JSON")
        validations = goal_proposed_action_validations(run, parsed)
        run["planner_steps"].append(
            {
                "phase": "plan_audit",
                "status": "completed",
                "model_route": MODEL_ROUTE_AUDIT,
                "duration_ms": int((time.monotonic() - started) * 1000),
            }
        )
        result_key = "model_result" if is_confirmed else "readonly_result"
        run[result_key] = {
            "schema": GOAL_MODEL_RESULT_SCHEMA_VERSION if is_confirmed else GOAL_READONLY_RESULT_SCHEMA_VERSION,
            "created": now(),
            "model_route": MODEL_ROUTE_AUDIT,
            "source_count": len(sources),
            "sources": sources[:40],
            "plan": [str(item) for item in parsed.get("plan", [])[:20]],
            "retrieval_assessment": str(parsed.get("retrieval_assessment", "")),
            "observations": [str(item) for item in parsed.get("observations", [])[:40]],
            "audit": str(parsed.get("audit", "")),
            "next_steps": [str(item) for item in parsed.get("next_steps", [])[:20]],
            "proposed_actions": parsed.get("proposed_actions", [])[:20],
            "proposed_action_validations": validations,
        }
        run["model_calls"] = int(run.get("model_calls", 0) or 0) + 1
        finish_goal_readonly_run(
            run,
            status="awaiting_confirmation" if is_confirmed and parsed.get("proposed_actions") else "completed",
        )
    except SystemExit as exc:
        finish_goal_readonly_run(run, status="stopped", error=str(exc))
    except AgenticValidationError as exc:
        finish_goal_readonly_run(run, status="stopped", error=str(exc))
    lines.append(f"status: {run.get('status', '')}")
    if run.get("error"):
        lines.append(f"error: {run.get('error')}")
    result_key = "model_result" if is_confirmed else "readonly_result"
    result = run.get(result_key) if isinstance(run.get(result_key), dict) else {}
    if result:
        lines.append(f"sources: {result.get('source_count', 0)}")
        lines.append(f"proposed actions: {len(result.get('proposed_actions', []) or [])}")
        if result.get("retrieval_assessment"):
            lines.append(f"retrieval: {compact_text(str(result.get('retrieval_assessment', '')), 240)}")
        if result.get("audit"):
            lines.append(f"audit: {compact_text(str(result.get('audit', '')), 240)}")
    lines.append(f"record: {goal_run_path(str(run.get('id', '')))}")
    return "\n".join(lines)


def interrupt_goal_run(
    run: dict,
    *,
    cursor: int,
    lines: list[str],
    action_index: int | None = None,
    kind: str = "",
    validation_id: str = "",
    tool_run_id: str = "",
    error: str = "interrupted by request",
) -> str:
    actions = run.get("actions") if isinstance(run.get("actions"), list) else []
    run["status"] = "interrupted"
    run["cursor"] = max(0, min(len(actions), int(cursor or 0)))
    run["error"] = error
    if action_index is not None and 0 <= action_index < len(run.get("action_results", []) or []):
        run["action_results"][action_index] = {
            "index": action_index + 1,
            "kind": kind or str(actions[action_index].get("kind", "")),
            "status": "interrupted",
            "validation_id": validation_id,
            "tool_run_id": tool_run_id,
            "error": error,
        }
    write_goal_run_record(run)
    completed = sum(1 for row in run.get("action_results", []) if row.get("status") == "completed")
    lines.append(f"interrupted: {error}")
    lines.append(f"completed: {completed}/{len(actions)}")
    lines.append("status: interrupted")
    lines.append(f"record: {goal_run_path(str(run.get('id', '')))}")
    return "\n".join(lines)


def execute_goal_run_record(run: dict, *, yes: bool, cancel_event=None) -> str:
    if run.get("planner") in {GOAL_LOOP_PLANNER_MODEL_READONLY, GOAL_LOOP_PLANNER_MODEL_CONFIRMED}:
        return execute_goal_readonly_run_record(run, yes=yes, cancel_event=cancel_event)
    if not yes:
        return "goal run:\nstatus: refused\nerror: refusing to run a goal loop without --yes"
    actions = run.get("actions") if isinstance(run.get("actions"), list) else []
    if not actions:
        return "goal run:\nstatus: refused\nerror: goal loop has no explicit actions"
    if run.get("status") == "completed":
        return format_goal_run_result(run)
    budgets = run.get("budgets") if isinstance(run.get("budgets"), dict) else {}
    max_steps = int(budgets.get("max_steps") or 1)
    max_tool_calls = int(budgets.get("max_tool_calls") or 1)
    if len(actions) > min(max_steps, max_tool_calls):
        run["status"] = "refused"
        run["error"] = (
            f"{len(actions)} action(s) exceed step/tool budget "
            f"({max_steps} steps, {max_tool_calls} tool calls)"
        )
        write_goal_run_record(run)
        return (
            "goal run:\n"
            "status: refused\n"
            f"error: {run['error']}"
        )
    allowed_effects = set(run.get("allowed_effects", []))
    allowed_tools = set(run.get("allowed_tools", []))
    if not isinstance(run.get("action_results"), list) or len(run.get("action_results", [])) != len(actions):
        run["action_results"] = [
            {"index": idx + 1, "status": "pending", "kind": str(action.get("kind", ""))}
            for idx, action in enumerate(actions)
        ]
    cursor = max(0, min(len(actions), int(run.get("cursor", 0) or 0)))
    lines = [
        "goal run:",
        f"id: {run.get('id', '')}",
        f"objective: {run.get('objective', '')}",
        f"actions: {len(actions)}",
        f"cursor: {cursor}",
    ]
    completed = sum(1 for row in run.get("action_results", []) if row.get("status") == "completed")
    if work_pause_requested():
        run["status"] = "paused"
        run["cursor"] = cursor
        run["note"] = "paused before next action"
        write_goal_run_record(run)
        clear_work_pause_request()
        lines.append("paused: before next action")
        lines.append(f"completed: {completed}/{len(actions)}")
        lines.append("status: paused")
        lines.append(f"record: {goal_run_path(str(run.get('id', '')))}")
        return "\n".join(lines)
    run["status"] = "running"
    write_goal_run_record(run)
    for idx0 in range(cursor, len(actions)):
        idx = idx0 + 1
        action = actions[idx0]
        if work_pause_requested():
            run["status"] = "paused"
            run["cursor"] = idx0
            run["note"] = "paused before next action"
            write_goal_run_record(run)
            clear_work_pause_request()
            lines.append(f"paused: before action {idx}")
            break
        try:
            preview = preview_action_record(action)
        except AgenticValidationError as exc:
            lines.append(f"- action {idx}: rejected before run: {exc}")
            run["status"] = "stopped"
            run["error"] = str(exc)
            run["action_results"][idx0] = {
                "index": idx,
                "kind": str(action.get("kind", "")),
                "status": "rejected",
                "error": str(exc),
            }
            write_goal_run_record(run)
            break
        effects = set(preview.get("allowed_effects", []))
        if not effects <= allowed_effects:
            error = (
                f"effects {','.join(sorted(effects)) or 'none'} exceed goal allowed effects "
                f"{','.join(sorted(allowed_effects)) or 'none'}"
            )
            lines.append(
                f"- action {idx}: refused; {error}"
            )
            run["status"] = "stopped"
            run["error"] = error
            run["action_results"][idx0] = {
                "index": idx,
                "kind": preview.get("kind", ""),
                "status": "refused",
                "error": error,
            }
            write_goal_run_record(run)
            break
        if allowed_tools and preview.get("kind") == "skill_tool_run":
            selector = f"{preview.get('skill', '')}/{preview.get('tool', '')}"
            if selector not in allowed_tools and preview.get("tool", "") not in allowed_tools:
                error = f"tool {selector} is not in goal allowed_tools"
                lines.append(f"- action {idx}: refused; {error}")
                run["status"] = "stopped"
                run["error"] = error
                run["action_results"][idx0] = {
                    "index": idx,
                    "kind": preview.get("kind", ""),
                    "status": "refused",
                    "error": error,
                }
                write_goal_run_record(run)
                break
        if cancellation_requested(cancel_event):
            return interrupt_goal_run(
                run,
                cursor=idx0,
                lines=lines,
                error="interrupted before action execution",
            )
        try:
            validation, result = execute_action_record(action, yes=yes, cancel_event=cancel_event)
        except KeyboardInterrupt:
            return interrupt_goal_run(
                run,
                cursor=idx0,
                lines=lines,
                action_index=idx0,
                kind=str(action.get("kind", "")),
                error="interrupted by keyboard",
            )
        status = result.get("status") if result else validation.get("status")
        lines.append(f"- action {idx}: {validation.get('kind', '')} {status}")
        if result and result.get("tool_run_id"):
            lines.append(f"  run: {result.get('tool_run_id')}")
        if result and result.get("error"):
            lines.append(f"  error: {result.get('error')}")
        run["action_results"][idx0] = {
            "index": idx,
            "kind": validation.get("kind", ""),
            "status": status,
            "validation_id": validation.get("id", ""),
            "tool_run_id": result.get("tool_run_id", "") if result else "",
            "error": result.get("error", "") if result else validation.get("reason", ""),
        }
        if status == "interrupted":
            run["status"] = "interrupted"
            run["cursor"] = idx0
            run["error"] = result.get("error", "interrupted") if result else "interrupted"
            write_goal_run_record(run)
            break
        if status != "completed":
            run["status"] = "stopped"
            run["cursor"] = idx0
            write_goal_run_record(run)
            break
        completed += 1
        run["cursor"] = idx
        write_goal_run_record(run)
        if cancellation_requested(cancel_event):
            return interrupt_goal_run(
                run,
                cursor=idx,
                lines=lines,
                error="interrupted after action checkpoint",
            )
    if completed == len(actions):
        run["status"] = "completed"
        run["cursor"] = len(actions)
        run.pop("error", None)
        run.pop("note", None)
        write_goal_run_record(run)
    lines.append(f"completed: {completed}/{len(actions)}")
    lines.append(f"status: {run.get('status', 'stopped')}")
    lines.append(f"record: {goal_run_path(str(run.get('id', '')))}")
    return "\n".join(lines)


def format_goal_run_result(run: dict) -> str:
    if run.get("planner") in {GOAL_LOOP_PLANNER_MODEL_READONLY, GOAL_LOOP_PLANNER_MODEL_CONFIRMED}:
        result_key = "model_result" if run.get("planner") == GOAL_LOOP_PLANNER_MODEL_CONFIRMED else "readonly_result"
        result = run.get(result_key) if isinstance(run.get(result_key), dict) else {}
        lines = [
            "goal run:",
            f"id: {run.get('id', '')}",
            f"status: {run.get('status', '')}",
            f"planner: {run.get('planner', '')}",
            f"objective: {run.get('objective', '')}",
            f"sources: {result.get('source_count', 0) if result else 0}",
            f"proposed actions: {len(result.get('proposed_actions', []) or []) if result else 0}",
        ]
        if run.get("error"):
            lines.append(f"error: {run.get('error')}")
        if result.get("retrieval_assessment"):
            lines.append(f"retrieval: {compact_text(str(result.get('retrieval_assessment', '')), 360)}")
        if result.get("plan"):
            lines.append("plan:")
            for item in result.get("plan", [])[:8]:
                lines.append(f"- {item}")
        if result.get("observations"):
            lines.append("observations:")
            for item in result.get("observations", [])[:8]:
                lines.append(f"- {item}")
        if result.get("audit"):
            lines.append(f"audit: {compact_text(str(result.get('audit', '')), 360)}")
        if result.get("next_steps"):
            lines.append("next steps:")
            for item in result.get("next_steps", [])[:8]:
                lines.append(f"- {item}")
        if result.get("proposed_action_validations"):
            lines.append("proposal validations:")
            for row in result.get("proposed_action_validations", [])[:12]:
                lines.append(
                    f"- [{row.get('index')}] {row.get('kind', '')} {row.get('status', '')} "
                    f"approval={row.get('approval', '')}"
                )
                if row.get("reason"):
                    lines.append(f"  reason: {row.get('reason')}")
        if run.get("planner") == GOAL_LOOP_PLANNER_MODEL_CONFIRMED and run.get("status") == "awaiting_confirmation":
            lines.append(f"apply: motoko goal apply {run.get('id', '')} --yes")
        if run.get("apply_results"):
            lines.append("apply results:")
            for row in run.get("apply_results", [])[:20]:
                lines.append(f"- action {row.get('index')}: {row.get('kind', '')} {row.get('status', '')}")
                if row.get("error"):
                    lines.append(f"  error: {row.get('error')}")
        lines.append(f"record: {goal_run_path(str(run.get('id', '')))}")
        return "\n".join(lines)
    actions = run.get("actions") if isinstance(run.get("actions"), list) else []
    completed = sum(1 for row in run.get("action_results", []) if row.get("status") == "completed")
    lines = [
        "goal run:",
        f"id: {run.get('id', '')}",
        f"status: {run.get('status', '')}",
        f"objective: {run.get('objective', '')}",
        f"cursor: {run.get('cursor', 0)}/{len(actions)}",
        f"completed: {completed}/{len(actions)}",
    ]
    if run.get("error"):
        lines.append(f"error: {run.get('error')}")
    for row in run.get("action_results", []):
        lines.append(f"- action {row.get('index')}: {row.get('kind', '')} {row.get('status', '')}")
        if row.get("tool_run_id"):
            lines.append(f"  run: {row.get('tool_run_id')}")
        if row.get("error"):
            lines.append(f"  error: {row.get('error')}")
    lines.append(f"record: {goal_run_path(str(run.get('id', '')))}")
    return "\n".join(lines)


def run_goal_text(path_text: str, *, yes: bool = False, cancel_event=None) -> str:
    if not yes:
        return "goal run:\nstatus: refused\nerror: refusing to run a goal loop without --yes"
    if not path_text:
        return "usage: motoko goal run FILE --yes"
    source_path = pathlib.Path(path_text).expanduser()
    try:
        record = core_read_goal_loop(source_path, path_checker=goal_loop_path_checker)
    except (OSError, GoalLoopValidationError) as exc:
        return f"goal run:\nstatus: rejected\nerror: {exc}"
    if record.get("status") == GOAL_LOOP_STATUS_REJECTED:
        return f"goal run:\nstatus: rejected\nerror: {record.get('error', 'goal loop rejected')}"
    run = make_goal_run_record(record, source_path=source_path)
    write_goal_run_record(run)
    return execute_goal_run_record(run, yes=yes, cancel_event=cancel_event)


def resume_goal_run_text(selector: str, *, yes: bool = False, cancel_event=None) -> str:
    try:
        run = find_goal_run_record(selector)
    except GoalLoopValidationError as exc:
        return f"goal run:\nstatus: rejected\nerror: {exc}"
    return execute_goal_run_record(run, yes=yes, cancel_event=cancel_event)


def format_goal_proposals(selector: str, *, private: bool = False) -> str:
    try:
        run = find_goal_run_record(selector)
    except GoalLoopValidationError as exc:
        return f"goal proposals:\nstatus: rejected\nerror: {exc}"
    result = {}
    for key in ("model_result", "readonly_result"):
        if isinstance(run.get(key), dict):
            result = run.get(key)
            break
    actions = result.get("proposed_actions") if isinstance(result.get("proposed_actions"), list) else []
    validations = result.get("proposed_action_validations") if isinstance(result.get("proposed_action_validations"), list) else []
    lines = [
        "goal proposals:",
        f"run: {run.get('id', '')}",
        f"status: {run.get('status', '')}",
        f"objective: {run.get('objective', '')}",
        f"count: {len(actions)}",
    ]
    if not actions:
        lines.append("status: empty")
        return "\n".join(lines)
    for row in validations:
        lines.append(
            f"- [{row.get('index')}] {row.get('kind', '')} {row.get('status', '')} "
            f"approval={row.get('approval', '')}"
        )
        if row.get("mode"):
            lines.append(f"  mode: {row.get('mode')}")
        if row.get("content_bytes") is not None:
            lines.append(f"  content bytes: {row.get('content_bytes')}")
        if row.get("content_sha256"):
            lines.append(f"  content sha256: {row.get('content_sha256')}")
        if row.get("target_path_sha256"):
            lines.append(f"  target path sha256: {row.get('target_path_sha256')}")
        if row.get("repo_path_sha256"):
            lines.append(f"  repo path sha256: {row.get('repo_path_sha256')}")
        if row.get("worktree_path_sha256"):
            lines.append(f"  worktree path sha256: {row.get('worktree_path_sha256')}")
        if row.get("branch"):
            lines.append(f"  branch: {row.get('branch')}")
        if row.get("base"):
            lines.append(f"  base: {row.get('base')}")
        if row.get("target_branch"):
            lines.append(f"  target branch: {row.get('target_branch')}")
        if row.get("path_count"):
            lines.append(f"  path count: {row.get('path_count')}")
        if row.get("reason"):
            lines.append(f"  reason: {row.get('reason')}")
    if private:
        lines.append("private proposed action JSON:")
        lines.append(json.dumps(actions, ensure_ascii=False, indent=2))
    else:
        lines.append("private content: hidden (use --private in this user account to inspect action JSON)")
    return "\n".join(lines)


def goal_result_actions(run: dict) -> list[dict]:
    for key in ("model_result", "readonly_result"):
        result = run.get(key) if isinstance(run.get(key), dict) else {}
        actions = result.get("proposed_actions") if isinstance(result.get("proposed_actions"), list) else []
        if actions:
            return actions
    return []


def apply_goal_proposals_text(selector: str, *, yes: bool = False, cancel_event=None) -> str:
    if not yes:
        return "goal apply:\nstatus: refused\nerror: refusing to apply goal proposals without --yes"
    try:
        run = find_goal_run_record(selector)
    except GoalLoopValidationError as exc:
        return f"goal apply:\nstatus: rejected\nerror: {exc}"
    if run.get("planner") != GOAL_LOOP_PLANNER_MODEL_CONFIRMED:
        return "goal apply:\nstatus: rejected\nerror: only model_confirmed goal runs can apply proposals"
    if run.get("status") in {"completed", "applied"}:
        return format_goal_run_result(run)
    actions = goal_result_actions(run)
    if not actions:
        return "goal apply:\nstatus: rejected\nerror: goal run has no proposed actions"
    budgets = run.get("budgets") if isinstance(run.get("budgets"), dict) else {}
    max_steps = int(budgets.get("max_steps") or len(actions))
    max_tool_calls = int(budgets.get("max_tool_calls") or len(actions))
    if len(actions) > min(max_steps, max_tool_calls):
        return (
            "goal apply:\n"
            "status: refused\n"
            f"error: {len(actions)} proposed action(s) exceed step/tool budget "
            f"({max_steps} steps, {max_tool_calls} tool calls)"
        )
    allowed_effects = set(run.get("allowed_effects", []))
    if "write_allowed_project" not in allowed_effects:
        return "goal apply:\nstatus: refused\nerror: goal does not allow write_allowed_project"
    if not isinstance(run.get("apply_results"), list) or len(run.get("apply_results", [])) != len(actions):
        run["apply_results"] = [
            {"index": idx + 1, "status": "pending", "kind": str(action.get("kind", ""))}
            for idx, action in enumerate(actions)
        ]
    cursor = max(0, min(len(actions), int(run.get("apply_cursor", 0) or 0)))
    lines = [
        "goal apply:",
        f"id: {run.get('id', '')}",
        f"objective: {run.get('objective', '')}",
        f"actions: {len(actions)}",
        f"cursor: {cursor}",
    ]
    if work_pause_requested():
        run["status"] = "paused"
        run["apply_cursor"] = cursor
        run["note"] = "paused before next goal proposal"
        write_goal_run_record(run)
        clear_work_pause_request()
        lines.append("paused: before next proposal")
        lines.append("status: paused")
        lines.append(f"record: {goal_run_path(str(run.get('id', '')))}")
        return "\n".join(lines)
    run["status"] = "applying"
    write_goal_run_record(run)
    completed = sum(1 for row in run.get("apply_results", []) if row.get("status") == "completed")
    for idx0 in range(cursor, len(actions)):
        idx = idx0 + 1
        action = actions[idx0]
        if action.get("kind") not in {
            "project_file_write",
            "git_worktree_create",
            "git_commit",
            "git_worktree_merge",
            "git_worktree_remove",
        }:
            run["status"] = "stopped"
            run["apply_cursor"] = idx0
            run["error"] = f"unsupported model-confirmed action kind: {action.get('kind', '')}"
            write_goal_run_record(run)
            lines.append(f"- action {idx}: refused")
            lines.append(f"  error: {run['error']}")
            break
        try:
            preview = preview_action_record(action)
        except AgenticValidationError as exc:
            run["status"] = "stopped"
            run["apply_cursor"] = idx0
            run["error"] = str(exc)
            write_goal_run_record(run)
            lines.append(f"- action {idx}: rejected before apply")
            lines.append(f"  error: {exc}")
            break
        effects = set(preview.get("allowed_effects", []))
        if not effects <= allowed_effects:
            run["status"] = "stopped"
            run["apply_cursor"] = idx0
            run["error"] = (
                f"effects {','.join(sorted(effects)) or 'none'} exceed goal allowed effects "
                f"{','.join(sorted(allowed_effects)) or 'none'}"
            )
            write_goal_run_record(run)
            lines.append(f"- action {idx}: refused")
            lines.append(f"  error: {run['error']}")
            break
        if cancellation_requested(cancel_event):
            run["status"] = "interrupted"
            run["apply_cursor"] = idx0
            run["error"] = "interrupted before goal proposal execution"
            write_goal_run_record(run)
            lines.append("status: interrupted")
            lines.append("error: interrupted before goal proposal execution")
            lines.append(f"record: {goal_run_path(str(run.get('id', '')))}")
            return "\n".join(lines)
        validation, result = execute_action_record(action, yes=True, cancel_event=cancel_event)
        status = result.get("status") if result else validation.get("status")
        lines.append(f"- action {idx}: {validation.get('kind', '')} {status}")
        if result and result.get("error"):
            lines.append(f"  error: {result.get('error')}")
        run["apply_results"][idx0] = {
            "index": idx,
            "kind": validation.get("kind", ""),
            "status": status,
            "validation_id": validation.get("id", ""),
            "tool_run_id": result.get("tool_run_id", "") if result else "",
            "error": result.get("error", "") if result else validation.get("reason", ""),
        }
        if status != "completed":
            run["status"] = "stopped"
            run["apply_cursor"] = idx0
            run["error"] = result.get("error", "") if result else validation.get("reason", "")
            write_goal_run_record(run)
            break
        completed += 1
        run["apply_cursor"] = idx
        write_goal_run_record(run)
    if completed == len(actions):
        run["status"] = "completed"
        run["apply_cursor"] = len(actions)
        run.pop("error", None)
        run.pop("note", None)
        write_goal_run_record(run)
    lines.append(f"completed: {completed}/{len(actions)}")
    lines.append(f"status: {run.get('status', '')}")
    lines.append(f"record: {goal_run_path(str(run.get('id', '')))}")
    return "\n".join(lines)


def format_git_worktrees(limit: int = 50) -> str:
    rows = managed_git_worktree_records(include_removed=True)
    rows.sort(key=lambda row: (row.get("updated", ""), row.get("id", "")), reverse=True)
    if not rows:
        return "git worktrees: none"
    lines = [f"git worktrees: {min(len(rows), limit)} shown"]
    for row in rows[: max(1, min(200, int(limit or 50)))]:
        lines.append(
            f"- {row.get('id', '')}  {row.get('status', '')}  "
            f"branch={row.get('branch', '')}  path={row.get('path', '')}"
        )
    return "\n".join(lines)


def git_worktree_action_from_command(command: str, args) -> dict:
    if command == "create":
        repo = pathlib.Path(args.repo or pathlib.Path.cwd()).expanduser()
        if not repo.is_absolute():
            repo = pathlib.Path.cwd() / repo
        path = pathlib.Path(args.path).expanduser() if args.path else default_git_worktree_path(repo, args.branch)
        return {
            "schema": "motoko-action-v1",
            "kind": "git_worktree_create",
            "repo": str(repo),
            "path": str(path),
            "branch": args.branch,
            "base": args.base,
            "reason": "Create an isolated Motoko-managed Git worktree.",
        }
    if command == "merge":
        repo = pathlib.Path(args.repo or pathlib.Path.cwd()).expanduser()
        if not repo.is_absolute():
            repo = pathlib.Path.cwd() / repo
        return {
            "schema": "motoko-action-v1",
            "kind": "git_worktree_merge",
            "repo": str(repo),
            "path": args.path or "",
            "branch": args.branch,
            "target_branch": args.target,
            "ff_only": True,
            "reason": "Merge a Motoko-managed worktree branch into the target branch.",
        }
    if command == "remove":
        return {
            "schema": "motoko-action-v1",
            "kind": "git_worktree_remove",
            "repo": args.repo or "",
            "path": args.path,
            "force": bool(args.force),
            "reason": "Remove an obsolete Motoko-managed Git worktree.",
        }
    raise AgenticValidationError(f"unknown worktree command: {command}")


def run_git_worktree_command(command: str, args, *, yes: bool = False) -> str:
    if command == "list":
        return format_git_worktrees(limit=getattr(args, "limit", 50))
    action = git_worktree_action_from_command(command, args)
    return run_action_text_from_record(action, yes=yes)


@contextlib.contextmanager
def temporary_motoko_state_env(state_dir: pathlib.Path, config_dir: pathlib.Path):
    old_state = os.environ.get("MOTOKO_STATE_HOME")
    old_config = os.environ.get("MOTOKO_CONFIG_HOME")
    os.environ["MOTOKO_STATE_HOME"] = str(state_dir)
    os.environ["MOTOKO_CONFIG_HOME"] = str(config_dir)
    try:
        yield
    finally:
        if old_state is None:
            os.environ.pop("MOTOKO_STATE_HOME", None)
        else:
            os.environ["MOTOKO_STATE_HOME"] = old_state
        if old_config is None:
            os.environ.pop("MOTOKO_CONFIG_HOME", None)
        else:
            os.environ["MOTOKO_CONFIG_HOME"] = old_config


