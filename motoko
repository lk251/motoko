            f"{row.get('slug', '')}: {row.get('description', '')}"
        )
        if row.get("target_skill"):
            target = row.get("target_skill", "")
            suffix = f" ({row.get('file_path', '')})" if row.get("file_path") else ""
            lines.append(f"  target: {target}{suffix}")
