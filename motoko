def compact_conversation(
    conv: dict,
    *,
    quiet: bool = False,
    timeout: float = MODEL_TIMEOUT_SECONDS,
) -> bool:
    messages = conv.get("messages", [])
    if len(messages) <= COMPACT_KEEP_MESSAGES:
        if not quiet:
            print("conversation is already compact enough")
        return False

    older = messages[:-COMPACT_KEEP_MESSAGES]
    recent = messages[-COMPACT_KEEP_MESSAGES:]
    transcript = []
    for msg in older:
        role = msg.get("role", "?")
        content = msg.get("content", "")
        transcript.append(f"{role}: {content}")
    older_text = "\n\n".join(transcript)
    prompt = textwrap.dedent(
        f"""
        Existing compacted summary:
        {conv.get('summary', '').strip() or '(none)'}

        Older transcript to merge:
        {older_text}

        Create a dense but readable conversation summary for future turns.
        Preserve Javier's durable preferences, commitments, open questions,
        named people/projects/files, and any conclusions already reached.
        Do not invent facts. Keep it under {MAX_CONVERSATION_SUMMARY_CHARS} characters.
        """
    ).strip()
    if not quiet:
        print("Compacting older conversation context...")
    summary = quiet_model(
        [
            {
                "role": "system",
                "content": "You summarize conversations into faithful compact context for later retrieval.",
            },
            {"role": "user", "content": prompt},
        ],
        temperature=0.2,
        timeout=timeout,
    )
    conv["summary"] = summary[:MAX_CONVERSATION_SUMMARY_CHARS]
    conv["messages"] = recent
    conv["last_auto_compact_message_count"] = len(recent)
    save_conversation(conv)
    if not quiet:
        print(f"compacted {len(older)} older message(s); kept {len(recent)} recent message(s)")
    return True


def propose_memories(
    conv: dict,
    *,
    timeout: float = MODEL_TIMEOUT_SECONDS,
) -> list[str]:
    if not conv.get("messages"):
        return []
    prompt = textwrap.dedent(
        """
        Extract durable personal memories from this conversation.
        Return only lines in this exact form:

        MEMORY: short durable fact

        Include only
        stable facts, preferences, commitments, recurring projects, named
        relationships, or long-lived goals likely useful in future
        conversations. Avoid transient task state, guesses, and anything
        already contradicted later in the conversation. If there are no durable
        memories, say exactly: NO_MEMORY
        """
    ).strip()
    messages = [
        {"role": "system", "content": prompt},
        *conv.get("messages", [])[-MAX_RECENT_MESSAGES:],
    ]
    proposal = call_model(
        messages,
        temperature=0.2,
        stream=False,
        echo=False,
        timeout=timeout,
    ).strip()
    if proposal == "NO_MEMORY":
        return []
    memories = []
    for line in proposal.splitlines():
        text = line.strip()
        if text.upper() == "NO_MEMORY":
            continue
        if text.upper().startswith("MEMORY:"):
            text = text.split(":", 1)[1].strip()
        else:
            if not re.match(r"^([-*]|\d+[.)])\s+", text):
                continue
            text = text.lstrip("-*0123456789.) ").strip()
        if text:
            memories.append(text)
        if len(memories) >= AUTO_MEMORY_MAX_PROPOSALS:
            break
    return memories


def title_candidate_messages(conv: dict) -> list[dict]:
    return [
        msg
        for msg in conv.get("messages", [])
        if msg.get("role") in {"user", "assistant"} and msg.get("content", "").strip()
    ]


def should_generate_conversation_title(conv: dict) -> bool:
    if conv.get("title_generated"):
        return False
    title = (conv.get("title") or "Untitled").strip()
    title_kind = conv.get("title_kind")
    if title_kind == "manual":
        return False
    if title_kind not in {"unset", "provisional", None} and title != "Untitled":
        return False
    return len(title_candidate_messages(conv)) >= TITLE_MIN_MESSAGES


def sanitize_generated_title(text: str) -> str:
    line = next((row.strip() for row in text.splitlines() if row.strip()), "")
    line = re.sub(r"^(title|conversation)\s*:\s*", "", line, flags=re.IGNORECASE)
    line = line.strip(" \t\r\n\"'`*_")
    line = re.sub(r"\s+", " ", line)
    line = re.sub(r"[\x00-\x1f\x7f]", "", line)
    if not line:
        return ""
    return line[:TITLE_MAX_CHARS].rstrip(" .,:;-")


def generate_conversation_title(
    conv: dict,
    *,
    timeout: float = TITLE_MODEL_TIMEOUT_SECONDS,
) -> str:
    transcript = []
    if conv.get("summary"):
        transcript.append(f"summary: {conv.get('summary', '')[:1200]}")
    for msg in title_candidate_messages(conv)[-8:]:
        transcript.append(f"{msg.get('role')}: {compact_text(msg.get('content', ''), 900)}")
    prompt = textwrap.dedent(
        f"""
        Create a compact title for this conversation.
        Return only the title, no quotes, no prefix, no punctuation-only flourish.
        Use at most {TITLE_MAX_CHARS} characters.

        Transcript:
        {chr(10).join(transcript)}
        """
    ).strip()
    title = quiet_model(
        [
            {
                "role": "system",
                "content": "You name private conversations with short, faithful, specific titles.",
            },
            {"role": "user", "content": prompt},
        ],
        temperature=0.2,
        timeout=timeout,
    )
    return sanitize_generated_title(title)


def maybe_generate_conversation_title(
    conv: dict,
    *,
    timeout: float = TITLE_MODEL_TIMEOUT_SECONDS,
) -> str | None:
    if not should_generate_conversation_title(conv):
        return None
    title = generate_conversation_title(conv, timeout=timeout)
    if not title:
        return None
    conv["title"] = title
    conv["title_kind"] = "model"
    conv["title_generated"] = now()
    save_conversation(conv)
    return title


