def run_worker_model_eval(routes: list[str] | None = None, *, timeout: float = MODEL_TIMEOUT_SECONDS) -> dict:
    selected = [normalize_model_route(route) for route in (routes or MODEL_WORKER_EVAL_DEFAULT_ROUTES)]
    selected_set = set(selected)
    fixtures = [fixture for fixture in worker_model_eval_fixtures() if fixture.get("route") in selected_set]
    if not fixtures:
        raise SystemExit("no worker-model eval fixtures matched the requested routes")

    report = {
        "schema": MODEL_WORKER_EVAL_SCHEMA_VERSION,
        "id": _dt.datetime.now().strftime("%Y%m%d-%H%M%S") + "-" + uuid.uuid4().hex[:6],
        "created": now(),
        "prompt_version": MODEL_WORKER_EVAL_PROMPT_VERSION,
        "routes_requested": selected,
        "fixtures": [],
        "route_summaries": {},
    }
    for fixture in fixtures:
        route = normalize_model_route(fixture.get("route"))
        route_info = model_route(route)
        started = time.monotonic()
        output = ""
        error = ""
        try:
            output = quiet_model(
                worker_eval_messages(fixture),
                temperature=0.0,
                timeout=timeout,
                route=route,
            )
        except Exception as exc:
            error = f"{type(exc).__name__}: {exc}"
        elapsed = round(time.monotonic() - started, 3)
        score = score_worker_eval_output(fixture, output, error=error)
        report["fixtures"].append(
            {
                "id": fixture.get("id", ""),
                "role": fixture.get("role", ""),
                "route": route,
                "model": route_info["model"],
                "endpoint": route_info["endpoint"],
                "elapsed_seconds": elapsed,
                "output_chars": len(output),
                "output_excerpt": compact_text(output, 900),
                **score,
            }
        )

    for route in selected:
        rows = [fixture for fixture in report["fixtures"] if fixture.get("route") == route]
        if not rows:
            continue
        route_info = model_route(route)
        passed = sum(1 for row in rows if row.get("status") == "pass")
        avg_score = sum(float(row.get("score", 0.0)) for row in rows) / len(rows)
        report["route_summaries"][route] = {
            "route": route,
            "model": route_info["model"],
            "endpoint": route_info["endpoint"],
            "lane": model_route_lane(route),
            "passed": passed,
            "total": len(rows),
            "average_score": round(avg_score, 1),
        }
    total = len(report["fixtures"])
    passed = sum(1 for row in report["fixtures"] if row.get("status") == "pass")
    report["status"] = "pass" if passed == total else "fail"
    report["passed"] = passed
    report["total"] = total
    report["average_score"] = round(
        sum(float(row.get("score", 0.0)) for row in report["fixtures"]) / max(1, total),
        1,
    )
    return report


