def archive_skill_text(name: str, *, yes: bool = False) -> str:
    if not yes:
        return "refusing to archive skill without --yes"
    row = core_load_skill(skills_dir(), name)
    if row.get("builtin"):
        return f"cannot archive built-in skill: {row.get('slug', name)}"
    record = skill_lifecycle_record(read_skill_lifecycle_state(), row.get("slug", name))
    if record.get("pinned"):
        return f"cannot archive pinned skill: {row.get('slug', name)}"
    state = record_skill_lifecycle(row.get("slug", name), "archive", note="manual archive")
    archived = core_apply_skill_lifecycle([row], state)[0]
    return f"skill archived: {archived.get('slug', '')}\nrestore: motoko skill restore {archived.get('slug', '')}"


