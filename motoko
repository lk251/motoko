def maybe_prompt_cwd_learning_for_line_chat(conv: dict) -> None:
    if tui_enabled() or conv.get("context_items") or not sys.stdin.isatty():
        return
    plan = cwd_learning_plan()
    if plan is None:
        return
    existing = attach_best_cwd_index(conv, plan)
    if existing is not None:
        status, _warnings = index_staleness(existing)
        print(f"sys attached corpus index for {plan['root']}: {existing.get('id')} ({status})")
        return
    if cwd_learning_declined_recently(plan["root"], plan["glob"]):
        return
    print("sys " + cwd_learning_offer_text(plan))
    answer = input("Learn this corpus now? [y/N] ").strip().lower()
    if answer not in {"y", "yes"}:
        record_cwd_learning_decline(plan["root"], plan["glob"])
        print(f"sys not learning {plan['root']} now")
        return
    index = build_document_index(str(plan["root"]), plan["glob"], plan["root"].name or str(plan["root"]))
    attach_context_item(conv, context_item_from_index(index))


