def recent_skill_review_signal(conv: dict, *, max_messages: int = 8) -> str:
    texts = []
    for msg in conv.get("messages", [])[-max_messages:]:
        if msg.get("role") not in {"user", "assistant"}:
            continue
        texts.append(str(msg.get("content", "")))
    haystack = "\n".join(texts).lower()
    for pattern in SKILL_REVIEW_SIGNAL_PATTERNS:
        if pattern in haystack:
            return pattern
    return ""


def last_loaded_skill_sources(conv: dict) -> list[dict]:
    rows = []
    seen = set()
    for source in conv.get("last_sources", []) or []:
        if source.get("kind") not in {"skill", "skill-support"}:
            continue
        name = source.get("name", "")
        key = (source.get("kind", ""), name, source.get("support_file", ""))
        if not name or key in seen:
            continue
        seen.add(key)
        rows.append(
            {
                "kind": source.get("kind", ""),
                "name": name,
                "description": source.get("description", ""),
                "handler": source.get("handler", ""),
                "support_file": source.get("support_file", ""),
                "matched_terms": source.get("matched_terms", [])[:8],
                "score": source.get("score", 0),
            }
        )
    return rows


def format_loaded_skill_review_context(conv: dict) -> str:
    rows = last_loaded_skill_sources(conv)
    if not rows:
        return "(none)"
    lines = []
    for row in rows[:8]:
        support = f" support={row.get('support_file', '')}" if row.get("support_file") else ""
        matched = ", ".join(row.get("matched_terms", [])[:6])
        lines.append(
            f"- {row.get('kind', '')}:{row.get('name', '')}{support} "
            f"handler={row.get('handler', '')} score={row.get('score', 0)} "
            f"matched={matched or '-'} description={row.get('description', '')}"
        )
    return "\n".join(lines)


def skill_review_triggers(conv: dict, *, message_count: int | None = None, last_skill: int | None = None) -> list[str]:
    message_count = len(conv.get("messages", [])) if message_count is None else int(message_count or 0)
    last_skill = int(conv.get("last_auto_skill_message_count", 0) or 0) if last_skill is None else int(last_skill or 0)
    if message_count <= last_skill:
        return []
    reasons = []
    if message_count >= AUTO_SKILL_MIN_MESSAGES and message_count - last_skill >= AUTO_SKILL_INTERVAL_MESSAGES:
        reasons.append("interval")
    signal = recent_skill_review_signal(conv)
    if signal and message_count >= 2:
        reasons.append(f"explicit-signal:{signal}")
    if last_loaded_skill_sources(conv) and message_count - last_skill >= AUTO_SKILL_LOADED_INTERVAL_MESSAGES:
        reasons.append("loaded-skill")
    return reasons


def render_skills_with_sources(query: str, *, record_usage: bool = True) -> tuple[str, list[dict]]:
    state = read_skill_lifecycle_state()
    text, sources = core_render_skills_with_sources(skills_dir(), query, lifecycle_state=state)
    selected = []
    for source in sources:
        if source.get("kind") == "skill":
            selected.append(source.get("name") or source.get("slug") or "")
    for slug in sorted({item for item in selected if item}) if record_usage else []:
        state = record_skill_lifecycle_event(state, slug, "selected", note=compact_text(query, 160))
    if selected and record_usage:
        write_skill_lifecycle_state(state)
    return text, sources


