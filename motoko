        "row_count": len(rows),
        "note": "Semantic embedding vector store built from the NixOS-declared realm-local embedding route.",
    }
    if write:
        path = vector_store_path(store_id)
        store["path"] = str(path)
        atomic_write(path, json.dumps(store, ensure_ascii=False, indent=2) + "\n")
        with contextlib.suppress(OSError):
            progress_path.unlink()
    return store


def list_vector_stores() -> list[dict]:
    rows = []
    root = vector_stores_dir()
    if not root.exists():
        return []
    for path in sorted(root.glob("*.json"), reverse=True):
        try:
            store = json.loads(path.read_text(encoding="utf-8"))
        except (OSError, json.JSONDecodeError):
            continue
        if isinstance(store, dict):
            store.setdefault("path", str(path))
            rows.append(store)
    return rows


def vector_store_label(store: dict) -> str:
    source = store.get("source_index") if isinstance(store.get("source_index"), dict) else {}
    return (
        f"{store.get('id', '')}  {store.get('method', '')}  "
        f"{store.get('row_count', len(store.get('rows', [])))} row(s)  "
        f"{source.get('name', '')} {source.get('root', '')}"
    )


def load_vector_store(store_id: str | None = None) -> dict:
    return prompt_for_selection(
        list_vector_stores(),
        kind="vector store",
        label_func=vector_store_label,
        selector=store_id,
    )


def latest_vector_store() -> dict:
    rows = list_vector_stores()
    if not rows:
        raise SystemExit("No vector stores yet. Run 'motoko vector-build [INDEX_ID]' first.")
    return rows[0]


def vector_store_matches_index(store: dict, index: dict, *, method: str | None = None) -> bool:
    source = store.get("source_index") if isinstance(store.get("source_index"), dict) else {}
    if source.get("id") != index.get("id"):
        return False
    if method and store.get("method") != method:
        return False
    return True


def latest_vector_store_for_index(
    index: dict,
    *,
    method: str | None = EMBEDDING_VECTOR_METHOD,
    fresh_only: bool = True,
) -> dict | None:
    for store in list_vector_stores():
        if not vector_store_matches_index(store, index, method=method):
            continue
        if fresh_only:
            freshness, _warnings = vector_store_freshness(store)
            if freshness != "fresh":
                continue
        return store
    return None


def vector_store_due(index: dict, *, method: str = EMBEDDING_VECTOR_METHOD) -> tuple[bool, str]:
    store = latest_vector_store_for_index(index, method=method, fresh_only=False)
    if store is None:
        if method == EMBEDDING_VECTOR_METHOD:
            with contextlib.suppress(SystemExit):
                reusable = latest_reusable_embedding_vector_store(index, embedding_route_info())
                if reusable is not None:
                    return True, "missing for current index; reusable family vector store available"
        return True, "missing"
    freshness, warnings = vector_store_freshness(store)
    if freshness != "fresh":
        detail = "; ".join(warnings[:2]) if warnings else freshness
        return True, detail or "stale"
    return False, "fresh"


def vector_store_freshness(store: dict) -> tuple[str, list[str]]:
    schema = str(store.get("schema") or "")
    if schema != VECTOR_STORE_SCHEMA_VERSION:
        return "stale", [f"vector store schema is {schema or 'missing'}; rebuild for {VECTOR_STORE_SCHEMA_VERSION}"]
    method = str(store.get("method") or "")
    if method not in {LEXICAL_VECTOR_METHOD, EMBEDDING_VECTOR_METHOD}:
        return "stale", [f"vector store method is {method or 'missing'}; rebuild this vector store"]
    if method == EMBEDDING_VECTOR_METHOD:
        stored_route = store.get("embedding_route") if isinstance(store.get("embedding_route"), dict) else {}
        stored_route_id = str(stored_route.get("catalog_route") or stored_route.get("route") or "")
        if not stored_route_id:
            return "stale", ["embedding route metadata missing; rebuild this vector store"]
        try:
            current_route = embedding_route_info(stored_route_id)
        except SystemExit as exc:
            return "stale", [f"embedding route unavailable: {exc}"]
        current_route_id = str(current_route.get("catalog_route") or current_route.get("route") or "")
        if stored_route_id != current_route_id:
            return "stale", [f"embedding route changed from {stored_route_id} to {current_route_id}; rebuild this vector store"]
        stored_model = str(stored_route.get("model") or "")
        current_model = str(current_route.get("model") or "")
        if stored_model != current_model:
            return "stale", [f"embedding model changed from {stored_model or 'unknown'} to {current_model or 'unknown'}; rebuild this vector store"]

        def int_or_zero(value) -> int:
            try:
                return int(value or 0)
            except (TypeError, ValueError):
                return 0

        current_dims = int_or_zero(current_route.get("embedding_dimensions"))
        stored_route_dims = int_or_zero(stored_route.get("embedding_dimensions"))
        store_dims = int_or_zero(store.get("dims"))
        if current_dims and stored_route_dims and current_dims != stored_route_dims:
            return "stale", [f"embedding dimensions changed from {stored_route_dims} to {current_dims}; rebuild this vector store"]
        if current_dims and store_dims and current_dims != store_dims:
            return "stale", [f"vector dimensions are {store_dims}, embedding route expects {current_dims}; rebuild this vector store"]
        stored_input_schema = str(store.get("embedding_input_schema") or "")
        if stored_input_schema != EMBEDDING_INPUT_SCHEMA_VERSION:
            return "stale", [
                f"embedding input schema is {stored_input_schema or 'missing'}; rebuild for {EMBEDDING_INPUT_SCHEMA_VERSION}"
            ]
        stored_row_id_schema = str(store.get("vector_row_id_schema") or "")
        if stored_row_id_schema != VECTOR_ROW_ID_SCHEMA_VERSION:
            return "stale", [
                f"vector row id schema is {stored_row_id_schema or 'missing'}; refresh for {VECTOR_ROW_ID_SCHEMA_VERSION}"
            ]
        stored_input_chars = int_or_zero(store.get("embedding_input_chars"))
        current_input_chars = embedding_input_chars_limit()
        if stored_input_chars != current_input_chars:
            return "stale", [
                f"embedding input size changed from {stored_input_chars or 'missing'} to {current_input_chars}; rebuild this vector store"
            ]
        stored_max_parts = int_or_zero(store.get("embedding_max_parts_per_chunk"))
        current_max_parts = embedding_max_parts_per_chunk()
        if stored_max_parts != current_max_parts:
            return "stale", [
                f"embedding chunk split policy changed from {stored_max_parts or 'missing'} to {current_max_parts}; rebuild this vector store"
            ]
    source = store.get("source_index") if isinstance(store.get("source_index"), dict) else {}
    index_id = str(source.get("id", ""))
    if not index_id:
        return "unknown", ["store has no source index id"]
    try:
        index = load_index_exact(index_id)
    except SystemExit as exc:
        return "stale", [f"source index unavailable: {exc}"]
    index_status, index_warnings = index_staleness(index)
    if index_status == "stale":
        return "stale", [f"source index is stale: {warning}" for warning in index_warnings[:4]] or ["source index is stale"]
    if index_status in {"unknown", "metadata-changed"}:
        return index_status, index_warnings[:4]
    current = vector_store_source_fingerprint(index)
    if current != source.get("fingerprint"):
        return "stale", ["source index fingerprint changed; rebuild this vector store"]
    return "fresh", []


def vector_store_chunk_lookup(store: dict) -> tuple[dict | None, dict]:
    source = store.get("source_index") if isinstance(store.get("source_index"), dict) else {}
    index_id = str(source.get("id", ""))
    if not index_id:
        return None, {}
    try:
        index = load_index_exact(index_id)
    except SystemExit:
        return None, {}
    lookup: dict[tuple[str, str], tuple[dict, dict]] = {}
    for file_item in index.get("files", []):
        if not isinstance(file_item, dict):
            continue
        path = str(file_item.get("path", ""))
        for chunk in file_item.get("chunks", []):
            if isinstance(chunk, dict):
                lookup[(path, str(chunk.get("chunk", "")))] = (file_item, chunk)
    return index, lookup


def vector_query_document_text(index: dict | None, lookup: dict, row: dict, query: str = "") -> str:
    if row.get("evidence_excerpt"):
        return "\n".join(
            part
            for part in [
                row.get("path", ""),
                f"chunk {row.get('chunk', '')}",
                f"evidence {row.get('evidence_kind', '')} {row.get('evidence_title', '')}".strip(),
                "tags: :" + ":".join(row.get("evidence_tags", []) or []) + ":" if row.get("evidence_tags") else "",
                str(row.get("evidence_excerpt", "")),
            ]
            if str(part).strip()
        )
    path = str(row.get("path", ""))
    chunk_id = str(row.get("chunk", ""))
    if index and lookup:
        found = lookup.get((path, chunk_id))
        if found:
            file_item, chunk = found
            content = read_chunk_content(index, chunk)
            text = retrieval_chunk_haystack(file_item, chunk, content, query=query)
            if text.strip():
                return compact_text(text, 6000)
    return "\n".join(
        part
        for part in [path, f"chunk {chunk_id}" if chunk_id else "", str(row.get("summary", ""))]
        if part
    )


def query_vector_store(
    store: dict,
    query: str,
    *,
    limit: int = VECTOR_QUERY_LIMIT,
    check_freshness: bool = True,
    rerank: bool = False,
    model_timeout: float = MODEL_TIMEOUT_SECONDS,
    socket_activation_min_timeout: float | None = None,
) -> dict:
    query = query.strip()
    if not query:
        raise SystemExit("usage: vector-query QUERY")
    limit = max(1, min(int(limit or VECTOR_QUERY_LIMIT), 50))
    method = str(store.get("method") or LEXICAL_VECTOR_METHOD)
    if method == EMBEDDING_VECTOR_METHOD:
        route = store.get("embedding_route") if isinstance(store.get("embedding_route"), dict) else {}
        query_vectors, _route_info = embed_texts(
            [query],
            route_id=route.get("catalog_route") or None,
            timeout=model_timeout,
            socket_activation_min_timeout=socket_activation_min_timeout,
        )
        query_vector = query_vectors[0] if query_vectors else []
    else:
        dims = int(store.get("dims", DEFAULT_LEXICAL_VECTOR_DIMS) or DEFAULT_LEXICAL_VECTOR_DIMS)
        query_vector = lexical_sparse_vector(query, dims=dims)
    query_counts = token_counts(query)
    rows = []
    for row in store.get("rows", []):
        if not isinstance(row, dict):
            continue
        vector_score = vector_similarity(query_vector, row.get("vector"))
        lexical = score_text(
            query_counts,
            "\n".join(
                [
                    row.get("path", ""),
                    row.get("summary", ""),
                    row.get("evidence_kind", ""),
                    row.get("evidence_title", ""),
                    row.get("evidence_date", ""),
                    row.get("evidence_todo", ""),
                    row.get("evidence_priority", ""),
                    row.get("evidence_excerpt", ""),
                ]
            ),
        )
        path_boost = query_path_match_boost(query, row.get("path", ""))
        total = round(vector_score * 1000) + lexical + path_boost
        if total <= 0:
            continue
        rows.append(
            {
                "score": total,
                "vector_score": round(vector_score, 6),
                "lexical": lexical,
                "path_boost": path_boost,
                "row_id": row.get("id", ""),
                "embedding_kind": row.get("embedding_kind", ""),
                "embedding_part": row.get("embedding_part", 1),
                "embedding_part_count": row.get("embedding_part_count", 1),
                "path": row.get("path", ""),
                "chunk": row.get("chunk", ""),
                "content_sha256": row.get("content_sha256", ""),
                "summary": row.get("summary", ""),
                "evidence_id": row.get("evidence_id", ""),
                "evidence_kind": row.get("evidence_kind", ""),
                "evidence_title": row.get("evidence_title", ""),
                "evidence_date": row.get("evidence_date", ""),
                "evidence_start": row.get("evidence_start"),
                "evidence_end": row.get("evidence_end"),
                "evidence_excerpt": row.get("evidence_excerpt", ""),
            }
        )
    deduped_rows: dict[tuple[str, str], dict] = {}
    for row in rows:
        key = (str(row.get("path", "")), str(row.get("chunk", "")))
        previous = deduped_rows.get(key)
        if previous is None or row.get("score", 0) > previous.get("score", 0):
            new_row = dict(row)
            new_row["vector_hit_count"] = (
                1 if previous is None else previous.get("vector_hit_count", 1) + 1
            )
            deduped_rows[key] = new_row
        elif previous is not None:
            previous["vector_hit_count"] = previous.get("vector_hit_count", 1) + 1
    rows = list(deduped_rows.values())
    rows.sort(key=lambda item: item.get("score", 0), reverse=True)
    rerank_route = {}
    if rerank and rows:
        candidates = rows[: min(len(rows), max(limit, RERANK_CANDIDATE_LIMIT))]
        source_index, lookup = vector_store_chunk_lookup(store)
        documents = [vector_query_document_text(source_index, lookup, row, query=query) for row in candidates]
        rerank_scores, rerank_route = rerank_documents(
            query,
            documents,
            timeout=model_timeout,
            socket_activation_min_timeout=socket_activation_min_timeout,
        )
        for row, rerank_score in zip(candidates, rerank_scores):
            row["rerank_score"] = round(rerank_score, 6)
            row["score"] = round((float(row.get("score", 0)) * 0.2) + (float(rerank_score) * 1000))
        candidates.sort(key=lambda item: (item.get("rerank_score", 0.0), item.get("score", 0)), reverse=True)
        rows = candidates + rows[len(candidates) :]
    if check_freshness:
        freshness, warnings = vector_store_freshness(store)
    else:
        freshness, warnings = "not-checked", []
    return {
        "schema": "vector-query-v1",
        "created": now(),
        "query": query,
        "store_id": store.get("id", ""),
        "method": store.get("method", ""),
        "rerank": bool(rerank),
        "rerank_route": {
            "catalog_route": rerank_route.get("catalog_route") or rerank_route.get("route", ""),
            "model": rerank_route.get("model", ""),
        }
        if rerank_route
        else {},
        "freshness": freshness,
        "warnings": warnings,
        "rows": rows[:limit],
    }


def query_vector_store_for_retrieval(
    store: dict,
    query: str,
    *,
    limit: int,
    check_freshness: bool = False,
    rerank: bool | None = None,
) -> dict:
    rerank = env_flag("MOTOKO_VECTOR_RERANK", True) if rerank is None else bool(rerank)
    model_timeout, socket_timeout = retrieval_model_socket_timeout()
    if rerank and not local_model_routes_for_capability(
        kind="reranker",
        tasks=RERANKER_TASKS,
        endpoint_path="/v1/rerank",
    ):
        fallback = query_vector_store(
            store,
            query,
            limit=limit,
            check_freshness=check_freshness,
            rerank=False,
            model_timeout=model_timeout,
            socket_activation_min_timeout=socket_timeout,
        )
        fallback["rerank_fallback"] = True
        fallback["warnings"] = ["rerank fallback: no configured /v1/rerank route"] + list(
            fallback.get("warnings", [])
        )
        return fallback
    try:
        return query_vector_store(
            store,
            query,
            limit=limit,
            check_freshness=check_freshness,
            rerank=rerank,
            model_timeout=model_timeout,
            socket_activation_min_timeout=socket_timeout,
        )
    except SystemExit as exc:
        if not rerank:
            raise
        fallback = query_vector_store(
            store,
            query,
            limit=limit,
            check_freshness=check_freshness,
            rerank=False,
            model_timeout=model_timeout,
            socket_activation_min_timeout=socket_timeout,
        )
        warning = f"rerank fallback: {str(exc).splitlines()[0][:220]}"
        fallback["rerank_fallback"] = True
        fallback["warnings"] = [warning] + list(fallback.get("warnings", []))
        return fallback


def format_vector_store(store: dict) -> str:
    source = store.get("source_index") if isinstance(store.get("source_index"), dict) else {}
    freshness, warnings = vector_store_freshness(store)
    lines = [
        f"vector store: {store.get('id', '')}",
        f"schema: {store.get('schema', '')}",
        f"method: {store.get('method', '')} ({store.get('vector_format', '')})",
        f"status: {freshness}",
        f"created: {store.get('created', '')}",
        f"realm: {store.get('realm', '')}",
        f"source index: {source.get('id', '')}  {source.get('name', '')}  {source.get('root', '')}",
        f"rows: {store.get('row_count', len(store.get('rows', [])))}  dims: {store.get('dims', '')}",
        f"embedding batches: {store.get('embedding_batch_count', 0)}  "
        f"batch size: {store.get('embedding_batch_size', '')}  "
        f"parallel: {store.get('embedding_parallelism', '')}  "
        f"requested: {store.get('embedding_requested_parallelism', store.get('embedding_parallelism', ''))}  "
        f"fallbacks: {len(store.get('embedding_parallel_fallbacks', []) or [])}",
        f"path: {store.get('path', '')}",
        f"note: {store.get('note', '')}",
    ]
    for warning in warnings:
        lines.append(f"warning: {warning}")
    return "\n".join(lines)


def vector_embedding_candidate_counts(index: dict) -> dict:
    raw_rows = 0
    evidence_rows = 0
    chunk_count = 0
    file_count = 0
    for file_item in index.get("files", []):
        file_count += 1
        for chunk in file_item.get("chunks", []):
            chunk_count += 1
            raw_rows += len(vector_embedding_input_rows(index, file_item, chunk))
            evidence_rows += len(evidence_vector_embedding_input_rows(index, file_item, chunk))
    return {
        "files": file_count,
        "chunks": chunk_count,
        "raw_rows": raw_rows,
        "evidence_rows": evidence_rows,
        "total_rows": raw_rows + evidence_rows,
    }


def format_vector_doctor(index_id: str | None = None, conv: dict | None = None) -> str:
    route_info = embedding_route_info()
    index = load_index(index_id) if index_id else default_vector_index(conv)
    counts = vector_embedding_candidate_counts(index)
    total_rows = int(counts.get("total_rows", 0) or 0)
    batch_size = embedding_batch_size(route_info, total_rows)
    batch_count = (total_rows + batch_size - 1) // batch_size if total_rows else 0
    configured_cap = embedding_parallel_limit(route_info)
    requested_parallelism = embedding_parallelism(route_info, batch_count)
    route_cap = route_max_parallel(route_info, default=1, maximum=32)
    store = latest_vector_store_for_index(index, method=EMBEDDING_VECTOR_METHOD, fresh_only=False)
    store_freshness = "missing"
    store_warnings: list[str] = []
    if store is not None:
        store_freshness, store_warnings = vector_store_freshness(store)
    env_rows = [
        ("MOTOKO_EMBEDDING_PARALLEL", os.environ.get("MOTOKO_EMBEDDING_PARALLEL", "")),
        ("MOTOKO_EMBEDDING_BATCH_SIZE", os.environ.get("MOTOKO_EMBEDDING_BATCH_SIZE", "")),
        ("MOTOKO_EMBEDDING_BATCHES_PER_WORKER", os.environ.get("MOTOKO_EMBEDDING_BATCHES_PER_WORKER", "")),
        ("MOTOKO_EMBEDDING_INPUT_CHARS", os.environ.get("MOTOKO_EMBEDDING_INPUT_CHARS", "")),
        ("MOTOKO_EMBEDDING_MAX_PARTS_PER_CHUNK", os.environ.get("MOTOKO_EMBEDDING_MAX_PARTS_PER_CHUNK", "")),
    ]
    env_text = ", ".join(f"{key}={value or 'default'}" for key, value in env_rows)
    lines = [
        "vector doctor: embedding refresh throughput",
        f"route: {route_info.get('catalog_route') or route_info.get('route', '')}",
        f"model: {route_info.get('model', '')}",
        f"dims: {route_info.get('embedding_dimensions', '')}",
        f"declared maxParallel: {route_info.get('max_parallel', '')}  Motoko cap: {configured_cap}  route cap: {route_cap}",
        f"index: {index.get('id', '')}  files={counts.get('files', 0)} chunks={counts.get('chunks', 0)}",
        f"candidate rows: raw={counts.get('raw_rows', 0)} evidence={counts.get('evidence_rows', 0)} total={total_rows}",
        f"planned batches: {batch_count}  batch size: {batch_size}  requested parallel: {requested_parallelism}",
        f"input policy: chars={embedding_input_chars_limit()} max_parts_per_chunk={embedding_max_parts_per_chunk()}",
        f"env overrides: {env_text}",
    ]
    if store is not None:
        lines.extend(
            [
                "",
                "latest store:",
                f"id: {store.get('id', '')}  status: {store_freshness}  rows={store.get('row_count', len(store.get('rows', [])))}",
                f"batches={store.get('embedding_batch_count', 0)} batch_size={store.get('embedding_batch_size', '')} "
                f"parallel={store.get('embedding_parallelism', '')} requested={store.get('embedding_requested_parallelism', '')} "
                f"fallbacks={len(store.get('embedding_parallel_fallbacks', []) or [])}",
                f"incremental: reused={store.get('embedding_reused_rows', 0)} "
                f"embedded={store.get('embedding_embedded_rows', store.get('row_count', 0))} "
                f"superseded={store.get('embedding_superseded_rows', 0)}",
            ]
        )
        for warning in store_warnings[:3]:
            lines.append(f"warning: {warning}")
    lines.extend(["", "interpretation:"])
    if total_rows <= 0:
        lines.append("- there are no embedding candidate rows for this index")
    elif batch_count < configured_cap:
        lines.append(
            "- this index has fewer batches than the configured parallel cap, so Motoko cannot fill every route slot for this run"
        )
    elif requested_parallelism >= min(configured_cap, route_cap):
        lines.append(
            "- Motoko is already planning to fill the declared embedding route parallelism; raising Motoko parallelism alone should not help"
        )
    else:
        lines.append(
            "- Motoko is not filling the route cap; check env overrides or batch count before blaming llama.cpp"
        )
    lines.extend(
        [
            "- about 963 MiB VRAM can be normal for a 0.6B Q8 embedding model; low VRAM alone is not evidence of underuse",
            "- low watts during vectorizing usually means the run is reusing rows, finalizing JSON/checkpoints, waiting on HTTP/CPU overhead, or the tiny embedding model is not compute-bound",
            "- if rows stop changing for more than the stale-progress window, treat it as a stall; otherwise prefer row/sec and batch progress over VRAM size as the health signal",
        ]
    )
    return "\n".join(lines)


def run_vector_eval(
    *,
    dims: int = DEFAULT_LEXICAL_VECTOR_DIMS,
    method: str = LEXICAL_VECTOR_METHOD,
) -> dict:
    method = resolve_vector_method(method)
    report = {
        "schema": VECTOR_EVAL_SCHEMA_VERSION,
        "id": _dt.datetime.now().strftime("%Y%m%d-%H%M%S") + "-" + uuid.uuid4().hex[:6],
        "created": now(),
        "method": method,
        "dims": max(8, int(dims or DEFAULT_LEXICAL_VECTOR_DIMS)),
        "fixtures": [],
    }
    for fixture in retrieval_eval_fixtures():
        index = synthetic_retrieval_eval_index(fixture)
        query = str(fixture.get("query", ""))
        store = build_vector_store_from_index(
            index,
            dims=report["dims"],
            method=method,
            store_id=f"vector-eval-{fixture.get('id', 'fixture')}",
            write=False,
        )
        result = query_vector_store(store, query, limit=8, check_freshness=False)
        selected_paths = [row.get("path", "") for row in result.get("rows", []) if row.get("path")]
        missing_paths = [
            expected
            for expected in fixture.get("expected_paths", []) or []
            if not retrieval_eval_path_matches(selected_paths, str(expected))
        ]
        status = "pass" if not missing_paths and selected_paths else "fail"
        report["fixtures"].append(
            {
                "id": fixture.get("id", ""),
                "status": status,
                "query": query,
                "selected_paths": selected_paths[:8],
                "missing_paths": missing_paths,
                "top_score": result.get("rows", [{}])[0].get("score", 0) if result.get("rows") else 0,
            }
        )
    total = len(report["fixtures"])
    passed = sum(1 for row in report["fixtures"] if row.get("status") == "pass")
    report["status"] = "pass" if passed == total else "fail"
    report["passed"] = passed
    report["total"] = total
    return report


def reserve_index_bytes(
    budget: dict,
    next_bytes: int,
    *,
    path: pathlib.Path,
    chunk_idx: int,
) -> None:
    max_bytes = budget["max_bytes"]
    used = budget["used_bytes"]
    if used + next_bytes > max_bytes:
        raise SystemExit(
            "Motoko stopped before writing more derived index text: "
            f"budget {human_bytes(max_bytes)}, already written {human_bytes(used)}, "
            f"next chunk {human_bytes(next_bytes)} from {path} chunk {chunk_idx}. "
            "Narrow the index with --glob or set MOTOKO_MAX_DERIVED_INDEX_BYTES "
            "to a reviewed larger value."
        )
    budget["used_bytes"] = used + next_bytes


def write_index_chunk(
    index_id: str,
    ordinal: int,
    chunk_idx: int,
    content: str,
    budget: dict,
    source_path: pathlib.Path,
) -> tuple[str, int]:
    relpath = chunk_content_relpath(index_id, ordinal, chunk_idx)
    path = indexes_dir() / relpath
    content_bytes = len(content.encode("utf-8"))
    reserve_index_bytes(budget, content_bytes, path=source_path, chunk_idx=chunk_idx)
    ensure_private_dir(path.parent)
    atomic_write(path, content)
    return relpath, content_bytes


def dedup_chunk_from_existing(
    path: pathlib.Path,
    ordinal: int,
    chunk_idx: int,
    content: str,
    existing_chunks: dict[str, str],
    digest: str | None = None,
) -> dict | None:
    digest = digest or sha256_hex(content.encode("utf-8"))
    existing_content = existing_chunks.get(digest)
    if existing_content is None:
        return None
    print(f"  reusing duplicate chunk {path} chunk {chunk_idx}", flush=True)
    item = {
        "id": f"{ordinal}.{chunk_idx}",
        "path": str(path),
        "chunk": chunk_idx,
        "summary": "Duplicate chunk already seen in a previous Motoko index; retrieval reuses the existing stored chunk text.",
        "duplicate_of_existing_index": True,
        "content_sha256": digest,
        "content_bytes": len(content.encode("utf-8")),
        "stored_content_bytes": 0,
        "summary_artifact": artifact_provenance(
            "chunk-summary",
            CHUNK_SUMMARY_SCHEMA_VERSION,
            deterministic=True,
            prompt_version="duplicate-chunk-reuse-v1",
            source_sha256=digest,
        ),
    }
    signals = extract_document_signals(path, content)
    if signals or path_supports_structured_signals(path):
        item["signals"] = signals
    return item


def summarize_and_store_chunk(
    path: pathlib.Path,
    index_id: str,
    ordinal: int,
    chunk_idx: int,
    content: str,
    budget: dict,
    existing_chunks: dict[str, str] | None = None,
    progress: dict | None = None,
    progress_callback=None,
    model_timeout: float = MODEL_TIMEOUT_SECONDS,
    cancel_event=None,
) -> dict | None:
    raise_if_work_cancelled(cancel_event, "indexing interrupted by request", work_kind="index")
    content = content.strip()
    if not content:
        return None
    content_digest = sha256_hex(content.encode("utf-8"))
    if existing_chunks:
        duplicate = dedup_chunk_from_existing(
            path,
            ordinal,
            chunk_idx,
            content,
            existing_chunks,
            content_digest,
        )
        if duplicate is not None:
            return duplicate
    label = f"{path} chunk {chunk_idx}"
    print(f"  summarizing {label}", flush=True)
    if progress is not None:
        progress["current_chunk"] = chunk_idx
    index_progress_begin_model(progress, "summarizing chunk", label, progress_callback, route=MODEL_ROUTE_INDEX_CHUNK)
    try:
        summary = summarize_text(
            label,
            content[:SUMMARY_INPUT_CHARS],
            "Summarize this document chunk in 4-8 dense bullets. Preserve names, dates, decisions, obligations, and unusual details.",
            timeout=model_timeout,
            route=MODEL_ROUTE_INDEX_CHUNK,
            prompt_version=CHUNK_SUMMARY_SCHEMA_VERSION,
            cancel_event=cancel_event,
        )
    except RuntimeError as exc:
        paused = work_cancelled_from_model(exc, "indexing interrupted by request", work_kind="index")
        if paused is not None:
            raise paused
        raise
    index_progress_finish_model(progress, progress_callback, chunk_done=True)
    relpath, content_bytes = write_index_chunk(index_id, ordinal, chunk_idx, content, budget, path)
    item = {
        "id": f"{ordinal}.{chunk_idx}",
        "path": str(path),
        "chunk": chunk_idx,
        "summary": summary,
        "content_path": relpath,
        "content_bytes": content_bytes,
        "stored_content_bytes": content_bytes,
        "content_sha256": content_digest,
        "summary_artifact": artifact_provenance(
            "chunk-summary",
            CHUNK_SUMMARY_SCHEMA_VERSION,
            route=MODEL_ROUTE_INDEX_CHUNK,
            prompt_version=CHUNK_SUMMARY_SCHEMA_VERSION,
            source_sha256=content_digest,
        ),
    }
    signals = extract_document_signals(path, content)
    if signals or path_supports_structured_signals(path):
        item["signals"] = signals
    return item


def stream_index_file(
    path: pathlib.Path,
    index_id: str,
    ordinal: int,
    budget: dict,
    existing_chunks: dict[str, str] | None = None,
    progress: dict | None = None,
    progress_callback=None,
    model_timeout: float = MODEL_TIMEOUT_SECONDS,
    cancel_event=None,
) -> tuple[dict, list[dict], int]:
    raise_if_work_cancelled(cancel_event, "indexing interrupted by request", work_kind="index")
    stat = path.stat()
    digest = hashlib.sha256()
    decoder = codecs.getincrementaldecoder("utf-8")(errors="replace")
    buffer = ""
    indexed_chunks = []
    chunk_idx = 0
    derived_content_bytes = 0

    def emit(text: str) -> None:
        nonlocal chunk_idx, derived_content_bytes
        raise_if_work_cancelled(cancel_event, "indexing interrupted by request", work_kind="index")
        chunk = text.strip()
        if not chunk:
            return
        chunk_idx += 1
        item = summarize_and_store_chunk(
            path,
            index_id,
            ordinal,
            chunk_idx,
            chunk,
            budget,
            existing_chunks,
            progress,
            progress_callback,
            model_timeout,
            cancel_event,
        )
        if item is not None:
            derived_content_bytes += item.get("stored_content_bytes", item.get("content_bytes", 0))
            indexed_chunks.append(item)

    with path.open("rb") as fh:
        for raw in iter(lambda: fh.read(1024 * 1024), b""):
            raise_if_work_cancelled(cancel_event, "indexing interrupted by request", work_kind="index")
            digest.update(raw)
            buffer += decoder.decode(raw)
            while len(buffer) >= INDEX_CHUNK_CHARS:
                end = INDEX_CHUNK_CHARS
                boundary = buffer.rfind("\n\n", 0, end)
                if boundary > INDEX_CHUNK_CHARS // 2:
                    end = boundary + 2
                if end <= 0:
                    end = INDEX_CHUNK_CHARS
                emit(buffer[:end])
                buffer = buffer[end:]
    buffer += decoder.decode(b"", final=True)
    emit(buffer)

    fingerprint = {
        "size": stat.st_size,
        "mtime_ns": stat.st_mtime_ns,
        "sha256": digest.hexdigest(),
    }
    return fingerprint, indexed_chunks, derived_content_bytes


def chunk_blocks_by_chars(blocks: list[str], max_chars: int) -> list[list[str]]:
    batches = []
    current = []
    current_len = 0
    for block in blocks:
        block = block.strip()
        if not block:
            continue
        if len(block) > max_chars:
            block = block[:max_chars]
        next_len = current_len + len(block) + (2 if current else 0)
        if current and next_len > max_chars:
            batches.append(current)
            current = []
            current_len = 0
        current.append(block)
        current_len += len(block) + (2 if current_len else 0)
    if current:
        batches.append(current)
    return batches


def route_parallel_limit(route: str) -> int:
    route = normalize_model_route(route)
    raw = os.environ.get(model_route_env_key(route, "parallel"))
    if raw:
        try:
            return max(1, int(raw))
        except ValueError:
            return 1
    info = model_route(route)
    try:
        return max(1, int(info.get("max_parallel") or 1))
    except (TypeError, ValueError):
        return 1


def parse_route_list(raw: str) -> list[str]:
    routes = []
    for part in re.split(r"[,:\s]+", raw.strip()):
        if not part:
            continue
        routes.append(normalize_model_route(part))
    return routes


def summary_reduction_route_names(final_route: str) -> list[str]:
    final_route = normalize_model_route(final_route)
    route_key = model_route_env_key(final_route, "reduce_routes")
    raw = os.environ.get(route_key) or os.environ.get("MOTOKO_SUMMARY_REDUCE_ROUTES")
    if raw:
        candidates = parse_route_list(raw)
    else:
        candidates = list(SUMMARY_REDUCTION_ROUTE_PREFERENCES.get(final_route, (final_route,)))
    if final_route not in candidates and final_route not in SUMMARY_REDUCTION_ROUTE_PREFERENCES:
        candidates.append(final_route)

    seen = set()
    routes = []
    for route in candidates:
        info = model_route(route)
        key = (info.get("endpoint", ""), info.get("model", ""))
        if key in seen:
            continue
        seen.add(key)
        routes.append(route)
    return routes or [final_route]


def summary_reduction_worker_slots(final_route: str) -> list[str]:
    if not env_flag("MOTOKO_SUMMARY_PARALLEL", True):
        return [normalize_model_route(final_route)]
    slots = []
    for route in summary_reduction_route_names(final_route):
        slots.extend([route] * route_parallel_limit(route))
    max_slots = env_int("MOTOKO_SUMMARY_MAX_PARALLEL", len(slots) or 1, minimum=1)
    return (slots or [normalize_model_route(final_route)])[:max_slots]


def format_summary_worker_slots(slots: list[str]) -> str:
    counts = collections.Counter(slots)
    labels = []
    for route, count in counts.items():
        label = f"{route}={model_route_badge(route)}"
        if count > 1:
            label += f"x{count}"
        labels.append(label)
    return ", ".join(labels)


def summarize_blocks(
    label: str,
    blocks: list[str],
    instruction: str,
    progress: dict | None = None,
    progress_callback=None,
    phase: str = "summarizing",
    timeout: float = MODEL_TIMEOUT_SECONDS,
    route: str = MODEL_ROUTE_CHAT,
    prompt_version: str = "summary-v1",
    preplanned_calls: int = 1,
    cancel_event=None,
) -> str:
    raise_if_work_cancelled(cancel_event, f"{phase} interrupted by request", work_kind=phase)
    pending = [block.strip() for block in blocks if block.strip()]
    estimated_calls = estimate_summary_block_calls(pending)
    show_foreground_progress = progress is None and sys.stdout.isatty()
    if show_foreground_progress:
        info = model_route(route)
        print(
            f"  model route {info['route']} -> {info['model']} "
            f"({model_endpoint_suffix(info['endpoint']) or info['endpoint']}); "
            f"estimated {estimated_calls} model call(s)",
            flush=True,
        )
        if endpoint_is_unix(info["endpoint"]):
            status = compact_local_model_status(local_model_status_text(info))
            if status:
                print(f"  worker status: {status}", flush=True)
        print("  pause with: motoko pause  (takes effect before the next model call)", flush=True)
    index_progress_reserve_model_calls(
        progress,
        f"{phase}:{label}",
        estimated_calls,
        preplanned_calls=preplanned_calls,
        callback=progress_callback,
    )
    if not pending:
        raise_if_work_cancelled(cancel_event, f"{phase} interrupted by request", work_kind=phase)
        index_progress_begin_model(progress, phase, label, progress_callback, route=route)
        try:
            result = summarize_text(
                label,
                "",
                instruction,
                timeout=timeout,
                route=route,
                prompt_version=prompt_version,
                cancel_event=cancel_event,
            )
        except RuntimeError as exc:
            paused = work_cancelled_from_model(exc, f"{phase} interrupted by request", work_kind=phase)
            if paused is not None:
                raise paused
            raise
        index_progress_finish_model(progress, progress_callback)
        return result

    def summarize_with_progress(model_label: str, text: str, model_instruction: str, call_route: str = route) -> str:
        raise_if_work_cancelled(cancel_event, f"{phase} interrupted by request", work_kind=phase)
        if work_pause_requested():
            clear_work_pause_request()
            raise WorkPaused(f"{phase} paused by request", work_kind=phase)
        index_progress_begin_model(progress, phase, model_label, progress_callback, route=call_route)
        if show_foreground_progress:
            suffix = f" via {model_route_badge(call_route)}" if call_route != route else ""
            print(f"  starting {model_label}{suffix}", flush=True)
        spinner = ThinkingSpinner(enabled=show_foreground_progress)
        try:
            spinner.start()
            try:
                result = summarize_text(
                    model_label,
                    text,
                    model_instruction,
                    timeout=timeout,
                    route=call_route,
                    prompt_version=prompt_version,
                    cancel_event=cancel_event,
                )
            except RuntimeError as exc:
                paused = work_cancelled_from_model(exc, f"{phase} interrupted by request", work_kind=phase)
                if paused is not None:
                    raise paused
                raise
        finally:
            spinner.stop()
        index_progress_finish_model(progress, progress_callback)
        if show_foreground_progress:
            print(f"  finished {model_label}", flush=True)
        return result

    def summarize_reduction_batches(batches: list[list[str]], round_no: int) -> list[str]:
        jobs = [
            (
                idx,
                f"{label} summary batch {idx}/{len(batches)} round {round_no}",
                "\n\n".join(batch),
            )
            for idx, batch in enumerate(batches, 1)
        ]
        slots = summary_reduction_worker_slots(route)
        can_parallelize = (
            progress is None
            and len(jobs) > 1
            and len(slots) > 1
            and env_flag("MOTOKO_SUMMARY_PARALLEL", True)
        )
        if can_parallelize and show_foreground_progress:
            print(
                f"  parallel reduction: {len(jobs)} batch(es) across {format_summary_worker_slots(slots)}",
                flush=True,
            )
        if not can_parallelize:
            reduced = []
            for idx, model_label, text in jobs:
                raise_if_work_cancelled(cancel_event, f"{phase} interrupted by request", work_kind=phase)
                call_route = slots[(idx - 1) % len(slots)] if slots else route
                print(f"  reducing {model_label}", flush=True)
                reduced.append(
                    summarize_with_progress(
                        model_label,
                        text,
                        "Summarize this batch faithfully for a higher-level retrieval summary. Preserve names, dates, decisions, obligations, and unusual details.",
                        call_route=call_route,
                    )
                )
            return reduced

        reduced: list[str | None] = [None] * len(jobs)
        max_workers = min(len(jobs), len(slots))
        with concurrent.futures.ThreadPoolExecutor(max_workers=max_workers) as executor:
            futures = {}
            for idx, model_label, text in jobs:
                call_route = slots[(idx - 1) % len(slots)]
                print(f"  reducing {model_label} via {model_route_badge(call_route)}", flush=True)
                future = executor.submit(
                    summarize_with_progress,
                    model_label,
                    text,
                    "Summarize this batch faithfully for a higher-level retrieval summary. Preserve names, dates, decisions, obligations, and unusual details.",
                    call_route,
                )
                futures[future] = (idx, model_label)
            while futures:
                if work_cancel_requested(cancel_event):
                    for future in futures:
                        future.cancel()
                    raise_if_work_cancelled(cancel_event, f"{phase} interrupted by request", work_kind=phase)
                done, _pending = concurrent.futures.wait(
                    futures,
                    timeout=0.1,
                    return_when=concurrent.futures.FIRST_COMPLETED,
                )
                if not done:
                    continue
                for future in done:
                    idx, model_label = futures.pop(future)
                    reduced[idx - 1] = future.result()
                    if show_foreground_progress:
                        print(f"  completed {model_label}", flush=True)
        return [item or "" for item in reduced]

    round_no = 1
    while True:
        raise_if_work_cancelled(cancel_event, f"{phase} interrupted by request", work_kind=phase)
        combined = "\n\n".join(pending)
        if len(combined) <= SUMMARY_INPUT_CHARS or len(pending) == 1 or round_no > 8:
            return summarize_with_progress(label, combined, instruction)

        batches = chunk_blocks_by_chars(pending, SUMMARY_INPUT_CHARS)
        reduced = summarize_reduction_batches(batches, round_no)
        if len(reduced) >= len(pending):
            return summarize_with_progress(label, "\n\n".join(reduced), instruction)
        pending = reduced
        round_no += 1


def index_file(
    path: pathlib.Path,
    index_id: str,
    ordinal: int,
    budget: dict,
    existing_chunks: dict[str, str] | None = None,
    progress: dict | None = None,
    progress_callback=None,
    model_timeout: float = MODEL_TIMEOUT_SECONDS,
    cancel_event=None,
) -> dict:
    raise_if_work_cancelled(cancel_event, "indexing interrupted by request", work_kind="index")
    fingerprint, indexed_chunks, derived_content_bytes = stream_index_file(
        path,
        index_id,
        ordinal,
        budget,
        existing_chunks,
        progress,
        progress_callback,
        model_timeout,
        cancel_event,
    )

    print(f"  summarizing file {path}", flush=True)
    file_summary = summarize_blocks(
        str(path),
        [f"Chunk {chunk['chunk']}:\n{chunk['summary']}" for chunk in indexed_chunks]
        or [""],
        "Create a file-level summary from these chunk summaries. Include what the file is about and when to retrieve it.",
        progress,
        progress_callback,
        "summarizing file",
        timeout=model_timeout,
        route=MODEL_ROUTE_INDEX_FILE,
        prompt_version=FILE_SUMMARY_SCHEMA_VERSION,
        preplanned_calls=(progress or {}).get("_file_summary_estimates", {}).get(str(path), 1),
        cancel_event=cancel_event,
    )
    index_progress_finish_file(progress, progress_callback)
    item = {
        "index_ordinal": ordinal,
        "path": str(path),
        "source_fingerprint": fingerprint,
        "indexed_sha256": fingerprint["sha256"],
        "bytes_indexed": fingerprint["size"],
        "bytes_omitted": 0,
        "truncated": False,
        "chunk_count": len(indexed_chunks),
        "duplicate_chunk_count": sum(
            1 for chunk in indexed_chunks if chunk.get("duplicate_of_existing_index")
        ),
        "content_storage": "motoko-state-chunks-v1",
        "derived_content_bytes": derived_content_bytes,
        "summary": file_summary,
        "summary_artifact": artifact_provenance(
            "file-summary",
            FILE_SUMMARY_SCHEMA_VERSION,
            route=MODEL_ROUTE_INDEX_FILE,
            prompt_version=FILE_SUMMARY_SCHEMA_VERSION,
            source_sha256=fingerprint["sha256"],
        ),
        "chunks": indexed_chunks,
    }
    signals = file_signals_from_chunks(indexed_chunks)
    if signals or path_supports_structured_signals(path):
        item["signals"] = signals
    return item


def document_index_record(
    *,
    index_id: str,
    root: pathlib.Path,
    pattern: str | None,
    name: str | None,
    created: str,
    budget: dict,
    files: list[dict],
    corpus_summary: str = "",
    candidates: list[pathlib.Path] | None = None,
    selection_policy: dict | None = None,
) -> dict:
    selection_policy = selection_policy or document_selection_policy(root, pattern)
    index = {
        "id": index_id,
        "name": name or root.name or str(root),
        "root": str(root),
        "glob": pattern or AUTO_INDEX_GLOB,
        "selection": selection_policy.get("mode", source_selection_mode(pattern)),
        "selection_policy": selection_policy,
        "created": created,
        "technique": "hierarchical retrieval-augmented generation",
        "content_storage": "motoko-state-chunks-v1",
        "derived_content_budget_bytes": budget["max_bytes"],
        "derived_content_bytes": sum(item.get("derived_content_bytes", 0) for item in files),
        "duplicate_chunk_count": sum(item.get("duplicate_chunk_count", 0) for item in files),
        "corpus_summary": corpus_summary,
        "signal_schema": SIGNAL_SCHEMA_VERSION,
        "signal_enriched": now(),
        "signal_artifact": artifact_provenance(
            "structured-signals",
            SIGNAL_SCHEMA_VERSION,
            deterministic=True,
        ),
        "files": files,
    }
    if corpus_summary:
        corpus_source = "\n\n".join(f"{item.get('path', '')}\n{item.get('summary', '')}" for item in files)
        index["corpus_summary_artifact"] = artifact_provenance(
            "corpus-summary",
            CORPUS_SUMMARY_SCHEMA_VERSION,
            route=MODEL_ROUTE_INDEX_CORPUS,
            prompt_version=CORPUS_SUMMARY_SCHEMA_VERSION,
            source_sha256=sha256_hex(corpus_source.encode("utf-8")),
        )
    if candidates is not None:
        index["candidate_files"] = [str(candidate) for candidate in candidates]
        index["total_files"] = len(candidates)
        index["completed_files"] = len(files)
    corpus_signals = corpus_signals_from_files(files)
    if corpus_signals:
        index["signals"] = corpus_signals
        index["signal_summary"] = format_signal_summary(corpus_signals, limit=SIGNAL_SUMMARY_TASK_LIMIT)
    profile = build_corpus_profile(index_id, root, files, created=created)
    index["corpus_profile_schema"] = CORPUS_PROFILE_SCHEMA_VERSION
    index["corpus_profile_enriched"] = profile.get("generated", now())
    index["corpus_profile"] = profile
    index["corpus_profile_artifact"] = profile.get("provenance", {})
    index["corpus_profile_text"] = profile.get("summary", "")
    return index


def pause_document_index_if_requested(
    *,
    index_id: str,
    root: pathlib.Path,
    pattern: str | None,
    name: str | None,
    created: str,
    budget: dict,
    files: list[dict],
    candidates: list[pathlib.Path],
    selection_policy: dict | None = None,
    progress: dict | None = None,
    progress_callback=None,
) -> None:
    request = read_work_pause_request()
    if request is None:
        return
    message = f"work paused at durable checkpoint; resume with motoko index-resume {index_id}"
    write_partial_index(
        document_index_record(
            index_id=index_id,
            root=root,
            pattern=pattern,
            name=name,
            created=created,
            budget=budget,
            files=files,
            candidates=candidates,
            selection_policy=selection_policy,
        ),
        status="paused",
        error=message,
    )
    finish_index_progress(progress, "paused", progress_callback)
    clear_work_pause_request()
    raise WorkPaused(message, work_id=index_id, work_kind="index")


def build_document_index(
    path: str,
    pattern: str | None = AUTO_INDEX_GLOB,
    name: str | None = None,
    max_derived_bytes: str | None = None,
    progress_callback=None,
    cancel_event=None,
) -> dict:
    require_permission("index")
    root = pathlib.Path(path).expanduser().resolve()
    require_allowed(root)
    if not root.exists():
        raise SystemExit(f"not a file or directory: {root}")
    candidate_report = index_candidate_report(root, pattern)
    candidates = apply_index_limits(candidate_report["candidates"])
    selection_policy = candidate_report.get("selection_policy", {})
    if not candidates:
        raise SystemExit(f"no ingestible text files matched {pattern or AUTO_INDEX_GLOB} under {root}")

    clear_work_pause_request()
    index_id = _dt.datetime.now().strftime("%Y%m%d-%H%M%S") + "-" + uuid.uuid4().hex[:6]
    created = now()
    budget = {
        "max_bytes": max_derived_index_bytes(max_derived_bytes),
        "used_bytes": 0,
    }
    files = []
    print(f"Building document index {index_id} from {len(candidates)} file(s).")
    print(f"Derived index text budget: {human_bytes(budget['max_bytes'])}.")
    progress = begin_index_progress(index_id, root, pattern, name, candidates, progress_callback)
    existing_chunks = existing_index_chunk_cache(root)
    if existing_chunks:
        print(f"Duplicate-aware indexing: {len(existing_chunks)} existing chunk(s) available for reuse.")
    try:
        for idx, candidate in enumerate(candidates, 1):
            raise_if_work_cancelled(
                cancel_event,
                f"indexing interrupted at durable checkpoint; resume with motoko index-resume {index_id}",
                work_id=index_id,
                work_kind="index",
            )
            try:
                print(f"[{idx}/{len(candidates)}] indexing {candidate}", flush=True)
                index_progress_begin_file(progress, candidate, idx, progress_callback)
                files.append(
                    index_file(
                        candidate,
                        index_id,
                        idx,
                        budget,
                        existing_chunks,
                        progress,
                        progress_callback,
                        INDEX_MODEL_TIMEOUT_SECONDS,
                        cancel_event,
                    )
                )
                write_partial_index(
                    document_index_record(
                        index_id=index_id,
                        root=root,
                        pattern=pattern,
                        name=name,
                        created=created,
                        budget=budget,
                        files=files,
                        candidates=candidates,
                        selection_policy=selection_policy,
                    ),
                    status="running",
                )
                pause_document_index_if_requested(
                    index_id=index_id,
                    root=root,
                    pattern=pattern,
                    name=name,
                    created=created,
                    budget=budget,
                    files=files,
                    candidates=candidates,
                    selection_policy=selection_policy,
                    progress=progress,
                    progress_callback=progress_callback,
                )
            except OSError as exc:
                print(f"  skipped {candidate}: {exc}", file=sys.stderr)

        pause_document_index_if_requested(
            index_id=index_id,
            root=root,
            pattern=pattern,
            name=name,
            created=created,
            budget=budget,
            files=files,
            candidates=candidates,
            selection_policy=selection_policy,
            progress=progress,
            progress_callback=progress_callback,
        )
        raise_if_work_cancelled(
            cancel_event,
            f"indexing interrupted at durable checkpoint; resume with motoko index-resume {index_id}",
            work_id=index_id,
            work_kind="index",
        )
        print("  summarizing corpus", flush=True)
        corpus_summary = summarize_blocks(
            str(root),
            [f"{item['path']}:\n{item['summary']}" for item in files],
            "Create a corpus-level map from these file summaries. Explain the main themes and which files matter for which questions.",
            progress,
            progress_callback,
            "summarizing corpus",
            timeout=INDEX_MODEL_TIMEOUT_SECONDS,
            route=MODEL_ROUTE_INDEX_CORPUS,
            prompt_version=CORPUS_SUMMARY_SCHEMA_VERSION,
            preplanned_calls=estimate_corpus_summary_calls(len(files)),
            cancel_event=cancel_event,
        )
        index = document_index_record(
            index_id=index_id,
            root=root,
            pattern=pattern,
            name=name,
            created=created,
            budget=budget,
            files=files,
            corpus_summary=corpus_summary,
            selection_policy=selection_policy,
        )
        atomic_write(index_path(index_id), json.dumps(index, ensure_ascii=False, indent=2) + "\n")
        try:
            index_partial_path(index_id).unlink()
        except OSError:
            pass
        finish_index_progress(progress, "completed", progress_callback)
        print(f"index saved: {index_id}")
        return index
    except WorkPaused as exc:
        write_partial_index(
            document_index_record(
                index_id=index_id,
                root=root,
                pattern=pattern,
                name=name,
                created=created,
                budget=budget,
                files=files,
                candidates=candidates,
                selection_policy=selection_policy,
            ),
            status="paused",
            error=str(exc),
        )
        finish_index_progress(progress, "paused", progress_callback, error=str(exc))
        raise
    except BaseException as exc:
        deferred = model_request_deferred_by_residency(exc)
        status = "deferred" if deferred else "failed"
        error = f"{type(exc).__name__}: {exc}"
        finish_index_progress(progress, status, progress_callback, error=error)
        write_partial_index(
            document_index_record(
                index_id=index_id,
                root=root,
                pattern=pattern,
                name=name,
                created=created,
                budget=budget,
                files=files,
                candidates=candidates,
                selection_policy=selection_policy,
            ),
            status=status,
            error=error,
        )
        raise


