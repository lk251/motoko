def scoped_context_selection(conv: dict, query: str, project_scope: dict) -> dict:
    raw_items = [item for item in conv.get("context_items", []) if isinstance(item, dict)]
    scoped_items = scoped_context_items(raw_items, project_scope_roots(project_scope))
    filtered_count = len(raw_items) - len(scoped_items)
    fallback_index = None
    fallback_added = False
    fallback_reason = ""
    scoped_index_ids = {
        str(item.get("id", ""))
        for item in scoped_items
        if item.get("kind") == "index" and item.get("id")
    }
    scoped_starved = filtered_count > 0 and (not scoped_items or filtered_count >= len(scoped_items))
    if scoped_starved:
        fallback_index = best_project_index_for_recovery(query, project_scope)
        if fallback_index and str(fallback_index.get("id", "")) not in scoped_index_ids:
            scoped_items.append(context_item_from_index(fallback_index))
            fallback_added = True
            fallback_reason = "current-project index selected after out-of-scope context filtering"
    return {
        "raw_items": raw_items,
        "scoped_items": scoped_items,
        "filtered_count": filtered_count,
        "fallback_index": fallback_index if fallback_added else None,
        "fallback_reason": fallback_reason,
        "scoped_starved": scoped_starved,
    }


