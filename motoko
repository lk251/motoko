def synthetic_messages_for_token_estimate(target_tokens: int) -> list[dict]:
    target_tokens = max(32, int(target_tokens or 0))
    unit = "benchmark-token "
    text = unit * max(1, target_tokens // max(1, estimate_text_tokens(unit)))
    return [
        {
            "role": "system",
            "content": "Synthetic content-free Motoko route benchmark. Reply with exactly OK.",
        },
        {"role": "user", "content": text},
    ]


def context_bench_targets(raw_targets: list[int] | None = None) -> list[int]:
    if raw_targets:
        return [max(32, int(value)) for value in raw_targets]
    return [8_000, 80_000, 160_000]


def run_context_bench(*, dry_run: bool = True, targets: list[int] | None = None) -> dict:
    rows = []
    for target in context_bench_targets(targets):
        messages = synthetic_messages_for_token_estimate(target)
        route_info, governor = select_chat_route(messages)
        row = {
            "target_tokens": target,
            "estimated_prompt_tokens": governor.get("prompt_tokens_estimate", 0),
            "route": route_info.get("route", ""),
            "catalog_route": route_info.get("catalog_route", ""),
            "tier": governor.get("selected_tier", ""),
            "model": route_info.get("model", ""),
            "ctx_size": route_context_limit(route_info),
            "governor_reason": governor.get("reason", ""),
            "dry_run": dry_run,
        }
        if not dry_run:
            started = time.monotonic()
            try:
                reply = call_model(messages, temperature=0.0, stream=False, echo=False, source_count=0)
            except SystemExit as exc:
                row["status"] = "failed"
                row["error"] = str(exc).splitlines()[0][:240]
            else:
                row["status"] = "completed"
                row["duration_seconds"] = round(time.monotonic() - started, 3)
                row["completion_tokens_estimate"] = estimate_text_tokens(reply)
        rows.append(row)
    return {
        "schema": "context-bench-v1",
        "created": now(),
        "dry_run": dry_run,
        "mode": chat_context_mode(),
        "rows": rows,
    }


def format_context_bench(report: dict) -> str:
    lines = [
        "context bench:",
        f"created: {report.get('created', '')}",
        f"mode: {report.get('mode', '')}",
        "status: dry-run, no model requests sent" if report.get("dry_run") else "status: model requests sent",
    ]
    for row in report.get("rows", []):
        route = row.get("catalog_route") or row.get("route", "")
        lines.append(
            f"- target={row.get('target_tokens', 0)}tok "
            f"estimated={row.get('estimated_prompt_tokens', 0)}tok "
            f"tier={row.get('tier', '')} route={route} ctx={row.get('ctx_size', 0)}"
        )
        lines.append(f"  model: {row.get('model', '')}")
        lines.append(f"  governor: {row.get('governor_reason', '')}")
        if row.get("status"):
            lines.append(
                f"  result: {row.get('status')} duration={row.get('duration_seconds', '-')}s "
                f"completion={row.get('completion_tokens_estimate', 0)}tok"
            )
        if row.get("error"):
            lines.append(f"  error: {row.get('error')}")
    return "\n".join(lines)


def model_badge() -> str:
