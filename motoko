def format_indexes_text() -> str:
    rows = list_indexes()
    jobs = active_index_progress()
    partials = list_resumable_partial_indexes()
    superseded_partials = list_superseded_partial_indexes()
    lines = []
    if not rows and not jobs and not partials and not superseded_partials:
        return "No document indexes yet."
    for job in jobs:
        lines.append(f"job  {format_index_progress_line(job)}")
    for partial in partials:
        completed = int(partial.get("completed_files", len(partial.get("files", []))) or 0)
        total = int(partial.get("total_files", completed) or completed)
        derived_bytes = int(partial.get("derived_content_bytes", 0) or 0)
        updated = relative_time(str(partial.get("updated", partial.get("created", ""))))
        lines.append(
            f"partial  {partial.get('id', '')}  {partial.get('status', 'unknown')}  "
            f"{completed}/{total} file(s)  {human_bytes(derived_bytes)}  "
            f"updated {updated}  {partial.get('name', '')}  {partial.get('root', '')}"
        )
        if partial.get("error"):
            lines.append(f"  error: {partial.get('error')}")
        lines.append(f"  resume: motoko index-resume {partial.get('id', '')}")
    if superseded_partials:
        lines.append(
            f"superseded partials: {len(superseded_partials)} "
            "(newer completed index exists for the same corpus)"
        )
    for index in rows:
        files = len(index.get("files", []))
        chunks = sum(len(file_item.get("chunks", [])) for file_item in index.get("files", []))
        derived_bytes = int(index.get("derived_content_bytes", 0) or 0)
        status, warnings = index_staleness(index)
        health = format_index_health(index_change_summary(index))
        signals = format_index_signal_state(index)
        lines.append(
            f"{index.get('created', '')}  {index.get('id')}  "
            f"{files} file(s)  {chunks} chunk(s)  {human_bytes(derived_bytes)}  "
            f"{status}  {health}  {signals}  {index.get('name', '')}  {index.get('root', '')}"
        )
        for warning in warnings[:3]:
            lines.append(f"  warning: {warning}")
    return "\n".join(lines)


