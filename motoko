def format_sources(sources: list[dict]) -> str:
    if not sources:
        return "No recorded sources for the last answer."
    lines = []
    for idx, source in enumerate(sources, 1):
        kind = source.get("kind", "source")
        if kind == "memory":
            detail = source.get("source", "unknown")
            if source.get("conversation_id"):
                detail += f"; conversation {source.get('conversation_id')}"
            lines.append(f"{idx:3d}  memory {source.get('id', '')}  {detail}")
        elif kind == "personality":
            lines.append(
                f"{idx:3d}  personality  {source.get('status', 'unknown')}  "
                f"{source.get('path', '')}"
            )
        elif kind == "conversation-summary":
            lines.append(f"{idx:3d}  compacted conversation summary")
        elif kind == "file":
            lines.append(f"{idx:3d}  file  {source.get('path', '')}  {source.get('bytes', 0)} bytes")
        elif kind == "index":
            lines.append(
                f"{idx:3d}  index {source.get('id', '')}  "
                f"{source.get('status', 'unknown')}  {source.get('name', '')}"
            )
            for warning in source.get("warnings", [])[:3]:
                lines.append(f"     warning: {warning}")
        elif kind == "file-summary":
            lines.append(
                f"{idx:3d}  file summary  {source.get('path', '')}  "
                f"index {source.get('index', '')}  {source.get('status', 'unknown')}"
            )
        elif kind == "chunk":
            lines.append(
                f"{idx:3d}  chunk  {source.get('path', '')} "
                f"chunk {source.get('chunk')}  index {source.get('index', '')}"
            )
        else:
            lines.append(f"{idx:3d}  {json.dumps(source, ensure_ascii=False)}")
    return "\n".join(lines)


def print_sources(conv: dict) -> None:
    print(format_sources(conv.get("last_sources", [])))


def maybe_set_title(conv: dict, text: str) -> None:
    if conv.get("title") == "Untitled":
        conv["title"] = slug_title(text)


def chat_loop(conv: dict) -> None:
    print(f"Motoko conversation: {conv['title']} [{conv['id']}]")
    print("Type /help for commands, /exit to save and leave.")
    while True:
        try:
            user_text = input("\nYou> ").strip()
        except (EOFError, KeyboardInterrupt):
            print()
            save_conversation(conv)
            return
        if not user_text:
            continue
        if user_text == "/exit":
            save_conversation(conv)
            return
        if user_text == "/help":
            print(format_help())
            continue
        if user_text.startswith("/title "):
            conv["title"] = user_text[len("/title ") :].strip() or conv["title"]
            save_conversation(conv)
            print(f"title: {conv['title']}")
            continue
        if user_text.startswith("/read "):
            item = context_item_from_file(user_text[len("/read ") :].strip())
            conv.setdefault("context_items", []).append(item)
            save_conversation(conv)
            print(f"attached: {item['path']}")
            continue
        if user_text.startswith("/index "):
            index = build_document_index(user_text[len("/index ") :].strip(), "*.txt")
            conv.setdefault("context_items", []).append(context_item_from_index(index))
            save_conversation(conv)
            print(f"attached index: {index['id']}")
            continue
        if user_text.startswith("/attach-index "):
            index = load_index(user_text[len("/attach-index ") :].strip())
            conv.setdefault("context_items", []).append(context_item_from_index(index))
            save_conversation(conv)
            print(f"attached index: {index['id']}")
            continue
        if user_text == "/compact":
            compact_conversation(conv)
            continue
        if user_text == "/sources":
            print_sources(conv)
            continue
        if user_text == "/personality":
            print_personality()
            continue
        if user_text.startswith("/remember "):
            add_memory(
                user_text[len("/remember ") :],
                source="manual-chat",
                conversation_id=conv["id"],
            )
            print("memory saved")
            continue
        if user_text == "/memories":
            print_memories()
            continue
        if user_text == "/memory review":
            print_memories(verbose=True)
            continue
        if user_text.startswith("/memory edit "):
            parts = user_text.split(maxsplit=3)
            if len(parts) != 4:
                print("usage: /memory edit ID TEXT")
                continue
            edit_memory(parts[2], parts[3])
            continue
        if user_text.startswith("/forget "):
            forget_memory(user_text[len("/forget ") :].strip())
            continue
        if user_text == "/memorize":
            memorize_conversation(conv)
            continue
        if user_text.startswith("/"):
            print("unknown command; type /help")
            continue

        maybe_set_title(conv, user_text)
        conv.setdefault("messages", []).append({"role": "user", "content": user_text})
        print("\nMotoko> ", end="", flush=True)
        messages, sources = build_messages(conv, user_text)
        reply = call_model(messages)
        conv["last_sources"] = sources
        conv["messages"].append({"role": "assistant", "content": reply})
        save_conversation(conv)


def compact_conversation(conv: dict) -> None:
    messages = conv.get("messages", [])
    if len(messages) <= COMPACT_KEEP_MESSAGES:
        print("conversation is already compact enough")
        return

    older = messages[:-COMPACT_KEEP_MESSAGES]
    recent = messages[-COMPACT_KEEP_MESSAGES:]
    transcript = []
    for msg in older:
        role = msg.get("role", "?")
        content = msg.get("content", "")
        transcript.append(f"{role}: {content}")
    older_text = "\n\n".join(transcript)
    prompt = textwrap.dedent(
        f"""
        Existing compacted summary:
        {conv.get('summary', '').strip() or '(none)'}

        Older transcript to merge:
        {older_text}

        Create a dense but readable conversation summary for future turns.
        Preserve Javier's durable preferences, commitments, open questions,
        named people/projects/files, and any conclusions already reached.
        Do not invent facts. Keep it under {MAX_CONVERSATION_SUMMARY_CHARS} characters.
        """
    ).strip()
    print("Compacting older conversation context...")
    summary = quiet_model(
        [
            {
                "role": "system",
                "content": "You summarize conversations into faithful compact context for later retrieval.",
            },
            {"role": "user", "content": prompt},
        ],
        temperature=0.2,
    )
    conv["summary"] = summary[:MAX_CONVERSATION_SUMMARY_CHARS]
    conv["messages"] = recent
    save_conversation(conv)
    print(f"compacted {len(older)} older message(s); kept {len(recent)} recent message(s)")


def memorize_conversation(conv: dict) -> None:
    if not conv.get("messages"):
        print("nothing to memorize yet")
        return
    prompt = textwrap.dedent(
        """
        Extract durable personal memories from this conversation.
        Return only short bullet points. Include only facts/preferences likely
        useful in future conversations. If there are no durable memories, say
        exactly: NO_MEMORY
        """
    ).strip()
    messages = [
        {"role": "system", "content": prompt},
        *conv.get("messages", [])[-MAX_RECENT_MESSAGES:],
    ]
    print("Motoko memory proposal:")
    proposal = call_model(messages, temperature=0.2).strip()
    if proposal == "NO_MEMORY":
        print("no memory saved")
        return
    print("\nSave these memories? Type yes to append: ", end="", flush=True)
    answer = input().strip().lower()
    if answer == "yes":
        for line in proposal.splitlines():
            text = line.strip().lstrip("-*").strip()
            if text:
                add_memory(
                    text,
                    source="model-proposed",
                    conversation_id=conv["id"],
                    derived_from="memorize",
                )
        print("memories saved")
    else:
        print("not saved")


