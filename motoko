def index_family_key(index: dict) -> str:
    raw = "\0".join(
        [
            str(index.get("root", "")),
            str(index.get("glob") or AUTO_INDEX_GLOB),
            str(index.get("name", "")),
        ]
    )
    return sha256_hex(raw.encode("utf-8"))[:16]


def latest_indexes_by_family(indexes: list[dict] | None = None) -> list[dict]:
    latest: dict[str, dict] = {}
    for index in indexes if indexes is not None else list_indexes():
        key = index_family_key(index)
        current = latest.get(key)
        if current is None or stored_record_sort_key(index) > stored_record_sort_key(current):
            latest[key] = index
    rows = list(latest.values())
    rows.sort(key=stored_record_sort_key, reverse=True)
    return rows


def latest_index_for_family(index: dict, indexes: list[dict] | None = None) -> dict | None:
    key = index_family_key(index)
    candidates = [
        candidate
        for candidate in (indexes if indexes is not None else list_indexes())
        if index_family_key(candidate) == key
    ]
    if not candidates:
        return None
    candidates.sort(key=stored_record_sort_key, reverse=True)
    return candidates[0]


