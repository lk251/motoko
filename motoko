class RouteResidencyBusy(RuntimeError):
    """A route should wait because another route currently owns useful GPU residency."""


MODEL_REQUEST_DEFERRED_PREFIXES = (
    "model request deferred:",
    "embedding request deferred:",
    "rerank request deferred:",
)


def model_request_deferred_by_residency(exc: BaseException) -> bool:
    if isinstance(exc, RouteResidencyBusy):
        return True
    text = str(exc).strip()
    return any(text.startswith(prefix) for prefix in MODEL_REQUEST_DEFERRED_PREFIXES)


def route_exclusive_lane(route_info: dict) -> str:
