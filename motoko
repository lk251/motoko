        self.messages = self.seed_messages(conv)
        self.append("system", startup_tips_text())
        for queued_text in list(self.pending_prompts):
            self.append("queued", queued_text)
        self.resume_maintenance_on_start, resume_note = resume_interrupted_maintenance(conv)
        if resume_note:
            self.append("system", resume_note)
        elif queued_memory_proposal_count():
            self.resume_maintenance_on_start = True
            self.append("system", f"resuming {queued_memory_proposal_count()} queued memory proposal(s)")
        self.maybe_offer_cwd_learning()
        if self.cwd_index_offer is None:
            note = unfinished_work_notice()
            if note:
                self.append("system", note)

    def seed_messages(self, conv: dict) -> list[dict]:
        rows = []
        if conv.get("summary"):
            rows.append({"role": "summary", "content": conv.get("summary", "")})
        for msg in conv.get("messages", []):
            rows.append({"role": msg.get("role", "?"), "content": msg.get("content", "")})
        return rows

    def seed_input_history(self, conv: dict) -> list[str]:
        history = seed_input_history_from_messages(conv.get("messages", []), limit=200)
        for text in queued_prompt_texts(conv):
            history = remember_input_history_entry(history, text, limit=200)
        return history

    def remember_input_history(self, text: str) -> None:
        self.history = remember_input_history_entry(self.history, text, limit=200)

    def clear_queued_prompts(self) -> int:
        count = len(self.pending_prompts)
        if count:
            self.pending_prompts.clear()
        persisted = 0
        conv = getattr(self, "conv", None)
        if isinstance(conv, dict):
            persisted = clear_queued_prompt_records(conv)
            if persisted:
                save_conversation(conv)
        return max(count, persisted)

    def queue_prompt(self, text: str, status: str) -> None:
        text = text.strip()
        if not text:
            return
        self.pending_prompts.append(text)
        append_queued_prompt_record(self.conv, text, created=now())
        save_conversation(self.conv)
        self.append("queued", text)
        self.status = status

    def pop_next_queued_prompt(self) -> str | None:
        text = self.pending_prompts.popleft() if self.pending_prompts else None
        persisted = pop_queued_prompt_record(self.conv, text)
        if persisted is not None or text is not None:
            save_conversation(self.conv)
        return text or persisted

    def set_active_model_connection(self, conn) -> None:
        lock = getattr(self, "active_model_lock", None)
        if lock is None:
            self.active_model_connection = conn
            return
        with lock:
            self.active_model_connection = conn

    def set_active_model_response(self, resp) -> None:
        lock = getattr(self, "active_model_lock", None)
        if lock is None:
            self.active_model_response = resp
            return
        with lock:
            self.active_model_response = resp

    def close_active_model_request(self) -> None:
        lock = getattr(self, "active_model_lock", None)
        if lock is None:
            items = [getattr(self, "active_model_response", None), getattr(self, "active_model_connection", None)]
            self.active_model_response = None
            self.active_model_connection = None
        else:
            with lock:
                items = [self.active_model_response, self.active_model_connection]
                self.active_model_response = None
                self.active_model_connection = None
        for item in items:
            if item is not None:
                with contextlib.suppress(Exception):
                    item.close()

    def show_kv_notice(self) -> None:
        now_value = time.monotonic()
        self.kv_notice_started_monotonic = now_value
        self.kv_notice_until_monotonic = now_value + KV_OFFLOAD_NOTICE_SECONDS
        self.dirty = True

    def kv_notice_active(self, now_value: float | None = None) -> bool:
        now_value = time.monotonic() if now_value is None else now_value
        return now_value < float(getattr(self, "kv_notice_until_monotonic", 0.0) or 0.0)

    def kv_notice_visible(self, now_value: float | None = None) -> bool:
        now_value = time.monotonic() if now_value is None else now_value
        if not self.kv_notice_active(now_value):
            return False
        started = float(getattr(self, "kv_notice_started_monotonic", 0.0) or now_value)
        return int((now_value - started) / 0.5) % 2 == 0

    def stop_active_answer(self) -> bool:
        discarded = self.clear_queued_prompts()
        stopped_work = 0
        if self.generating:
            jobs = getattr(self, "jobs", None)
            if jobs is not None:
                jobs.request_stop_by_kind("answer")
            self.cancel_event.set()
            self.close_active_model_request()
            self.answer_phase = "stopping"
            self.answer_phase_started_monotonic = time.monotonic()
            note = "stopping current answer"
            if discarded:
                note += f"; discarded {discarded} queued prompt(s)"
            self.status = note
            self.append("system", note)
            return True
        jobs = getattr(self, "jobs", None)
        if jobs is not None:
            stopped_work += jobs.request_stop_by_kind("report")
            stopped_work += jobs.request_stop_by_kind("cwd-index")
            stopped_work += jobs.request_stop_by_kind("maintenance")
        if stopped_work:
            request_work_pause("manual TUI stop command")
            note = f"stop requested for {stopped_work} active job(s)"
            if discarded:
                note += f"; discarded {discarded} queued prompt(s)"
            self.status = note
            self.append("system", note)
            return True
        if discarded:
            self.status = f"discarded {discarded} queued prompt(s)"
            self.append("system", self.status)
            return True
        return False

    def append(self, role: str, content: str) -> dict:
        row = {"role": role, "content": content}
        self.messages.append(row)
        self.scroll = 0
        self.dirty = True
        return row

    def run(self) -> None:
        old_winch = signal.getsignal(signal.SIGWINCH)

        def on_winch(_signum, _frame):
            self.dirty = True

        try:
            self.old_termios = termios.tcgetattr(self.stdin_fd)
            tty.setcbreak(self.stdin_fd)
            signal.signal(signal.SIGWINCH, on_winch)
            self.write("\033[?25l\033[?7l")
            self.render(force=True)
            self.start_study_loop()
            if self.resume_maintenance_on_start:
                self.resume_maintenance_on_start = False
                self.start_maintenance(resumed=True)
            elif self.pending_prompts:
                next_prompt = self.pop_next_queued_prompt()
                if next_prompt:
                    self.start_generation(next_prompt)
            while self.running:
                self.drain_events()
                now_ts = time.monotonic()
                active_work = (
                    self.generating
                    or self.maintaining
                    or self.study_running
                    or self.report_running
                    or self.kv_notice_active(now_ts)
                )
                timeout = 0.04 if active_work else 0.12
                readable, _writeable, _errors = select.select([self.stdin_fd], [], [], timeout)
                if readable:
                    self.last_input_at = time.monotonic()
                    self.handle_key(self.read_key())
                if self.dirty or (active_work and now_ts - self.last_render > 0.08):
                    self.render()
        finally:
            signal.signal(signal.SIGWINCH, old_winch)
            self.restore_terminal()

    def restore_terminal(self) -> None:
        try:
            if getattr(self, "overlay_screen_active", False):
                self.write("\033[?1049l")
                self.overlay_screen_active = False
            else:
                self.clear_bottom_area()
        except Exception:
            pass
        if self.old_termios is not None:
            termios.tcsetattr(self.stdin_fd, termios.TCSADRAIN, self.old_termios)
            self.old_termios = None
        self.write("\033[?7h\033[?25h\033[0m\n")

    def write(self, text: str) -> None:
        os.write(self.stdout_fd, text.encode("utf-8", errors="replace"))

    def read_key(self) -> str:
        first = os.read(self.stdin_fd, 1)
        if not first:
            return ""
        if first != b"\x1b":
            return utf8_key_from_first_byte(self.stdin_fd, first)
        seq = bytearray(first)
        while True:
            readable, _writeable, _errors = select.select([self.stdin_fd], [], [], 0.01)
            if not readable:
                break
            nxt = os.read(self.stdin_fd, 1)
            if not nxt:
                break
            seq.extend(nxt)
            if nxt.isalpha() or nxt == b"~":
                break
        text = bytes(seq).decode("utf-8", errors="replace")
        if re.match(r"^\x1b\[5(?:;\d+)*~$", text):
            return "pageup"
        if re.match(r"^\x1b\[6(?:;\d+)*~$", text):
            return "pagedown"
        keymap = {
            "\x1b[A": "up",
            "\x1b[B": "down",
            "\x1b[C": "right",
            "\x1b[D": "left",
            "\x1b[H": "home",
            "\x1b[F": "end",
            "\x1b[1~": "home",
            "\x1b[4~": "end",
            "\x1b[3~": "delete",
            "\x1b[5~": "pageup",
            "\x1b[6~": "pagedown",
            "\x1bb": "word-left",
            "\x1bf": "word-right",
            "\x1bB": "word-left",
            "\x1bF": "word-right",
            "\x1b\x7f": "word-backspace",
            "\x1b\b": "word-backspace",
        }
        return keymap.get(text, "escape")

    def handle_key(self, key: str) -> None:
        if key == "\x03":
            if self.generating or self.pending_prompts:
                self.stop_active_answer()
                return
            close_conversation(self.conv)
            self.running = False
            return
        if key == "\x04":  # Ctrl+D
            if self.input_buffer and self.cursor < len(self.input_buffer):
                self.input_buffer = self.input_buffer[: self.cursor] + self.input_buffer[self.cursor + 1 :]
                self.dropdown_index = 0
                self.dirty = True
            elif not self.input_buffer:
                close_conversation(self.conv)
                self.running = False
            return
        if self.overlay_lines is not None:
            if key in {"escape", "q", "Q", "\r", "\n"}:
                self.close_overlay()
                return
            if key == "up":
                self.overlay_scroll = max(0, self.overlay_scroll - 1)
                self.dirty = True
                return
            if key == "down":
                self.overlay_scroll += 1
                self.dirty = True
                return
            if key == "pageup":
                self.overlay_scroll = max(0, self.overlay_scroll - 8)
                self.dirty = True
                return
            if key == "pagedown":
                self.overlay_scroll += 8
                self.dirty = True
                return
            return
        if key in {"\r", "\n"}:
            self.handle_enter()
            return
        if key in {"\x7f", "\b"}:
            if self.cursor > 0:
                self.input_buffer = self.input_buffer[: self.cursor - 1] + self.input_buffer[self.cursor :]
                self.cursor -= 1
                self.dropdown_index = 0
                self.dirty = True
            return
        if key == "\x15":  # Ctrl+U
            self.kill_ring = self.input_buffer[: self.cursor]
            self.input_buffer = self.input_buffer[self.cursor :]
            self.cursor = 0
            self.dropdown_index = 0
            self.dirty = True
            return
        if key == "\x17":  # Ctrl+W
            self.delete_word_left()
            return
        if key == "\x0b":  # Ctrl+K
            self.kill_ring = self.input_buffer[self.cursor :]
            self.input_buffer = self.input_buffer[: self.cursor]
            self.dropdown_index = 0
            self.dirty = True
            return
        if key == "\x19":  # Ctrl+Y
            if self.kill_ring:
                self.input_buffer = (
                    self.input_buffer[: self.cursor]
                    + self.kill_ring
                    + self.input_buffer[self.cursor :]
                )
                self.cursor += len(self.kill_ring)
                self.dropdown_index = 0
                self.dirty = True
            return
        if key == "\x01":  # Ctrl+A
            self.cursor = 0
            self.dirty = True
            return
        if key == "\x05":  # Ctrl+E
            self.cursor = len(self.input_buffer)
            self.dirty = True
            return
        if key == "\x02":  # Ctrl+B
            self.cursor = max(0, self.cursor - 1)
            self.dirty = True
            return
        if key == "\x06":  # Ctrl+F
            self.cursor = min(len(self.input_buffer), self.cursor + 1)
            self.dirty = True
            return
        if key == "\x10":  # Ctrl+P
            if self.dropdown_options():
                self.dropdown_index = max(0, self.dropdown_index - 1)
            else:
                self.history_up()
            self.dirty = True
            return
        if key == "\x0e":  # Ctrl+N
            if self.dropdown_options():
                self.dropdown_index = min(len(self.dropdown_options()) - 1, self.dropdown_index + 1)
            else:
                self.history_down()
            self.dirty = True
            return
        if key == "\x0c":
            self.bottom_frame_key = None
            self.dirty = True
            return
        if key == "left":
            self.cursor = max(0, self.cursor - 1)
            self.dirty = True
            return
        if key == "right":
            self.cursor = min(len(self.input_buffer), self.cursor + 1)
            self.dirty = True
            return
        if key == "word-left":
            self.move_word_left()
            self.dirty = True
            return
        if key == "word-right":
            self.move_word_right()
            self.dirty = True
            return
        if key == "word-backspace":
            self.delete_word_left()
            return
        if key == "home":
            self.cursor = 0
            self.dirty = True
            return
        if key == "end":
            self.cursor = len(self.input_buffer)
            self.dirty = True
            return
        if key == "delete":
            if self.cursor < len(self.input_buffer):
                self.input_buffer = self.input_buffer[: self.cursor] + self.input_buffer[self.cursor + 1 :]
                self.dirty = True
            return
        if key == "up":
            if self.dropdown_options():
                self.dropdown_index = max(0, self.dropdown_index - 1)
            else:
                self.history_up()
            self.dirty = True
            return
        if key == "down":
            if self.dropdown_options():
                self.dropdown_index = min(len(self.dropdown_options()) - 1, self.dropdown_index + 1)
            else:
                self.history_down()
            self.dirty = True
            return
        if key == "pageup":
            self.scroll += 8
            self.dirty = True
            return
        if key == "pagedown":
            self.scroll = max(0, self.scroll - 8)
            self.dirty = True
            return
        if key == "escape":
            self.dropdown_index = 0
            self.dirty = True
            return
        if key == "\t":
            options = self.dropdown_options()
            if options:
                self.apply_dropdown(options[self.dropdown_index])
            return
        if len(key) == 1 and key >= " ":
            self.input_buffer = self.input_buffer[: self.cursor] + key + self.input_buffer[self.cursor :]
            self.cursor += 1
            self.dropdown_index = min(self.dropdown_index, max(0, len(self.dropdown_options()) - 1))
            self.dirty = True

    def move_word_left(self) -> None:
        self.cursor = edit_move_word_left(self.input_buffer, self.cursor)

    def move_word_right(self) -> None:
        self.cursor = edit_move_word_right(self.input_buffer, self.cursor)

    def delete_word_left(self) -> None:
        new_text, new_cursor, killed = edit_delete_word_left(self.input_buffer, self.cursor)
        if new_text == self.input_buffer and new_cursor == self.cursor:
            return
        self.kill_ring = killed
        self.input_buffer = new_text
        self.cursor = new_cursor
        self.dropdown_index = 0
        self.dirty = True

    def history_up(self) -> None:
        history_index, value = previous_history_entry(self.history, self.history_index)
        if value is None:
            return
        self.history_index = history_index
        self.input_buffer = value
        self.cursor = len(self.input_buffer)

    def history_down(self) -> None:
        history_index, value = next_history_entry(self.history, self.history_index)
        if value is None:
            return
        self.history_index = history_index
        self.input_buffer = value
        self.cursor = len(self.input_buffer)

    def handle_enter(self) -> None:
        options = self.dropdown_options()
        if options:
            self.apply_dropdown(options[self.dropdown_index])
            return
        text = self.input_buffer.strip()
        self.input_buffer = ""
        self.cursor = 0
        self.history_index = None
        self.dropdown_index = 0
        if not text:
            self.dirty = True
            return
        self.remember_input_history(text)
        self.submit_text(text)

    def submit_text(self, text: str) -> None:
        if text.startswith("/"):
            self.handle_command(text)
            return
        if is_feedback_command(text):
            self.handle_command(text)
            return
        if self.cwd_index_offer is not None and text.strip().lower() in {"y", "yes", "n", "no"}:
            self.handle_cwd_index_answer(text)
            return
        if self.cwd_indexing or (self.study_running and self.study_status.startswith("bg-heavy:")):
            self.queue_prompt(text, "prompt queued behind bg-heavy work")
            return
        if self.generating:
            self.queue_prompt(text, "prompt queued behind current answer")
            return
        self.start_generation(text)

    def handle_command(self, text: str) -> None:
        try:
            if text in {"/", "/commands"}:
                self.append("system", self.compact_command_menu())
            elif text == "/exit":
                close_conversation(self.conv)
                self.running = False
            elif text == "/new" or text.startswith("/new "):
                title = text[len("/new") :].strip() or None
                self.conv = start_new_conversation_from_current(self.conv, title)
                self.messages = self.seed_messages(self.conv)
                self.history = self.seed_input_history(self.conv)
                self.history_index = None
                self.status = "new conversation"
                self.append("system", f"new conversation: {self.conv.get('title', 'Untitled')} [{self.conv.get('id', '')}]")
            elif text == "/stop":
                if not self.stop_active_answer():
                    self.append("system", "Motoko is not currently answering.")
            elif text == "/clear-queue":
                discarded = self.clear_queued_prompts()
                if discarded:
                    self.status = f"discarded {discarded} queued prompt(s)"
                    self.append("system", self.status)
                else:
                    self.append("system", "no queued prompts")
            elif text == "/pause":
                self.request_pause()
            elif (command_request := shared_command_request(text, self.conv)) is not None:
                label, func = command_request
                self.start_report_command(label, func)
            elif text == "/delete" or text.startswith("/delete "):
                if self.generating or self.maintaining or self.study_running:
                    self.append("system", "finish or stop active work before deleting this conversation")
                    return
                answer = text[len("/delete") :].strip().lower()
                if answer not in {"yes", "confirm"}:
                    self.append(
                        "system",
                        f"delete this conversation and owned derived artifacts? type /delete yes to confirm ({self.conv.get('id', '')})",
                    )
                    return
                self.conv, report = delete_conversation_then_new(self.conv)
                self.messages = self.seed_messages(self.conv)
                self.history = self.seed_input_history(self.conv)
                self.history_index = None
                self.status = "conversation deleted"
                self.append("system", format_conversation_delete_report(report))
            elif text == "/resume" or text.startswith("/resume "):
                selector = text[len("/resume") :].strip() or None
                if selector is None:
                    self.input_buffer = "/resume "
                    self.cursor = len(self.input_buffer)
                    self.dropdown_index = 0
                    self.status = "choose a conversation"
                    self.dirty = True
                    return
                self.conv = resume_conversation_from_current(self.conv, selector)
                self.messages = self.seed_messages(self.conv)
                self.history = self.seed_input_history(self.conv)
                self.history_index = None
                message_count = len(self.conv.get("messages", []))
                self.status = "conversation resumed" if message_count else "conversation resumed (0 messages)"
            elif (blocking_request := blocking_command_request(text, self.conv)) is not None:
                label, func = blocking_request
                self.run_blocking_command(label, func)
            else:
                self.append("system", "unknown command; type /help")
        except SystemExit as exc:
            self.append("error", str(exc))
        except Exception as exc:  # Defensive: keep the TUI alive.
            self.append("error", f"{type(exc).__name__}: {exc}")
        self.dirty = True

    def maybe_offer_cwd_learning(self) -> None:
        if self.conv.get("context_items"):
            return
        plan = cwd_learning_plan()
        if plan is None:
            return
        existing = attach_best_cwd_index(self.conv, plan)
        if existing is not None:
            status, _warnings = index_staleness(existing)
            if status != "fresh":
                self.append(
                    "system",
                    f"attached corpus index for {plan['root']}: {existing.get('id')} ({status})",
                )
            return
        if cwd_learning_declined_recently(plan["root"], plan["glob"]):
            return
        self.cwd_index_offer = plan
        self.append("system", cwd_learning_offer_text(plan))

    def handle_cwd_index_answer(self, text: str) -> None:
        plan = self.cwd_index_offer
        self.cwd_index_offer = None
        if plan is None:
            return
        answer = text.strip().lower()
        if answer in {"n", "no"}:
            record_cwd_learning_decline(plan["root"], plan["glob"])
            self.append("system", f"not learning {plan['root']} now")
            return
        if plan.get("partials"):
            self.append("system", f"resuming corpus index: {plan['partials'][0].get('id', '')}")
        else:
            self.append("system", f"learning corpus: {plan['root']}")
        self.start_cwd_indexing(plan)

    def start_cwd_indexing(self, plan: dict) -> None:
        if self.study_running:
            self.append("system", "A background study job is already running.")
            return
        self.study_running = True
        self.cwd_indexing = True
        self.study_status = "bg-heavy: indexing(model)"
        self.study_phase_started = time.monotonic()
        self.study_phase_updated = self.study_phase_started
        self.index_progress = None
        cancel_event = threading.Event()

        def worker() -> None:
            try:
                index = build_cwd_learning_index(
                    plan,
                    progress_callback=lambda progress: self.put_event(("cwd_index_progress", progress)),
                    quiet=True,
                    cancel_event=cancel_event,
                )
                attach_context_item(self.conv, context_item_from_index(index))
                self.put_event(("cwd_index_done", index.get("id", "")))
            except WorkPaused as exc:
                self.put_event(("cwd_index_paused", exc.work_id or ""))
            except SystemExit as exc:
                self.put_event(("cwd_index_error", str(exc)))
            except Exception as exc:
                self.put_event(("cwd_index_error", f"{type(exc).__name__}: {exc}"))

        getattr(self, "jobs", LIVE_JOB_SUPERVISOR).start_thread(
            kind="cwd-index",
            lane="large-model",
            label="corpus learning",
            target=worker,
            cancel_event=cancel_event,
        )

    def request_pause(self) -> None:
        active = self.generating or self.maintaining or self.study_running or self.cwd_indexing
        if not active:
            self.append("system", "no active Motoko work to pause")
            return
        request_work_pause("manual TUI command")
        if self.generating:
            self.cancel_event.set()
        jobs = getattr(self, "jobs", None)
        if jobs is not None:
            for kind in ("answer", "report", "cwd-index", "maintenance"):
                for snapshot in jobs.snapshots(include_done=False):
                    if snapshot.get("kind") == kind:
                        jobs.request_pause(str(snapshot.get("job_id", "")))
        self.status = "pause requested; waiting for checkpoint"
        self.append(
            "system",
            "pause requested; active work will pause at the next durable checkpoint",
        )

    def start_report_command(self, label: str, func) -> None:
        token = getattr(self, "report_token", 0) + 1
        self.report_token = token
        self.active_report_token = token
        self.open_overlay(label, f"{label}: running...")
        self.report_running += 1
        self.report_status = label
        self.dirty = True
        cancel_event = threading.Event()

        def worker() -> None:
            try:
                text = run_command_callable(func, cancel_event=cancel_event)
                self.put_event(("report_done", token, label, str(text).strip() or "(no output)"))
            except WorkPaused as exc:
                self.put_event(("report_done", token, label, str(exc).strip() or "work paused"))
            except RuntimeError as exc:
                if model_call_cancelled(exc):
                    self.put_event(("report_done", token, label, "work stopped"))
                else:
                    self.put_event(("report_error", token, label, f"{type(exc).__name__}: {exc}"))
            except SystemExit as exc:
                self.put_event(("report_error", token, label, str(exc)))
            except Exception as exc:
                self.put_event(("report_error", token, label, f"{type(exc).__name__}: {exc}"))

        getattr(self, "jobs", LIVE_JOB_SUPERVISOR).start_thread(
            kind="report",
            lane="cpu",
            label=label,
            target=worker,
            cancel_event=cancel_event,
        )

    def run_blocking_command(self, label: str, func) -> None:
        if self.generating:
            self.append("system", "Finish or wait for the current answer before running this blocking command.")
            return
        post_message: tuple[str, str] | None = None
        cancel_event = threading.Event()
        job = getattr(self, "jobs", LIVE_JOB_SUPERVISOR).begin(
            kind="foreground",
            lane="cpu",
            label=label,
            cancel_event=cancel_event,
        )
        job_status = JOB_STATUS_COMPLETED
        job_error = ""
        old_sigint = None
        installed_sigint_handler = False
        self.restore_for_blocking()
        try:
            if threading.current_thread() is threading.main_thread():
                old_sigint = signal.getsignal(signal.SIGINT)

                def foreground_sigint(_signum, _frame):
                    cancel_event.set()
                    request_work_pause("keyboard interrupt during foreground command")
                    print()
                    print(
                        style(
                            "Interrupt requested; waiting for the next durable checkpoint...",
                            "yellow",
                        ),
                        flush=True,
                    )

                signal.signal(signal.SIGINT, foreground_sigint)
                installed_sigint_handler = True
            print()
            print(style(label, "turquoise", "bold"))
            result = run_command_callable(func, cancel_event=cancel_event)
            if result:
                print_report(str(result))
            print(style("Done. Returning to Motoko TUI.", "green"))
        except WorkPaused as exc:
            text = str(exc)
            print(style(text, "yellow"))
            post_message = ("system", text)
        except RuntimeError as exc:
            if not model_call_cancelled(exc):
                job_status = JOB_STATUS_FAILED
                job_error = type(exc).__name__
                text = f"{type(exc).__name__}: {exc}"
                print(style(text, "red"))
                post_message = ("error", text)
            else:
                text = "work interrupted by request"
                print(style(text, "yellow"))
                post_message = ("system", text)
        except SystemExit as exc:
            job_status = JOB_STATUS_FAILED
            job_error = "SystemExit"
            text = str(exc)
            print(style(text, "red"))
            post_message = ("error", text)
        except Exception as exc:
            job_status = JOB_STATUS_FAILED
            job_error = type(exc).__name__
            text = f"{type(exc).__name__}: {exc}"
            print(style(text, "red"))
            post_message = ("error", text)
        except KeyboardInterrupt:
            cancel_event.set()
            request_work_pause("keyboard interrupt during blocking command")
            text = "Interrupted. Pause requested; unfinished work can resume from the next durable checkpoint if one exists."
            print()
            print(style(text, "yellow"))
            post_message = ("system", text)
        finally:
            if installed_sigint_handler:
                signal.signal(signal.SIGINT, old_sigint)
            getattr(self, "jobs", LIVE_JOB_SUPERVISOR).finish(
                job.job_id,
                status=job_status,
                error_type=job_error,
            )
            self.reenter_after_blocking()
        self.messages = self.seed_messages(self.conv)
        if post_message:
            self.append(post_message[0], post_message[1])
        self.dirty = True

    def restore_for_blocking(self) -> None:
        self.clear_bottom_area()
        if getattr(self, "overlay_screen_active", False):
            self.write("\033[?1049l")
            self.overlay_screen_active = False
        if self.old_termios is not None:
            termios.tcsetattr(self.stdin_fd, termios.TCSADRAIN, self.old_termios)
        self.write("\033[?7h\033[?25h\033[0m\n")

    def reenter_after_blocking(self) -> None:
        tty.setcbreak(self.stdin_fd)
        self.write("\033[?25l\033[?7l")
        self.bottom_rows_rendered = 0
        self.bottom_cursor_row_offset = 0
        self.bottom_frame_key = None

    def open_overlay(self, title: str, text: str) -> None:
        self.overlay_title = title
        self.overlay_lines = text.splitlines() or [""]
        self.overlay_scroll = 0
        self.dirty = True

    def close_overlay(self) -> None:
        self.overlay_title = None
        self.overlay_lines = None
        self.overlay_scroll = 0
        self.active_report_token = 0
        if getattr(self, "overlay_screen_active", False):
            try:
                self.write("\033[?1049l")
            except Exception:
                pass
            self.overlay_screen_active = False
            self.bottom_rows_rendered = 0
            self.bottom_cursor_row_offset = 0
            self.bottom_frame_key = None
        self.dirty = True

    def start_generation(self, user_text: str) -> None:
        maybe_set_title(self.conv, user_text)
        self.conv.setdefault("messages", []).append({"role": "user", "content": user_text})
        save_conversation(self.conv)
        self.append("user", user_text)
        explicit_saved = save_explicit_user_memories(user_text, self.conv["id"])
        if explicit_saved:
            self.append("system", f"memory saved from this prompt ({explicit_saved})")
        self.answer_entry = self.append("assistant", "")
        now = time.monotonic()
        self.answer_started_monotonic = now
        self.answer_phase_started_monotonic = now
        self.answer_phase = "preparing"
        self.answer_reasoning = ""
        self.answer_stream_width = 0
        self.answer_stream_emitted_lines = 0
        chat_route = model_route(MODEL_ROUTE_CHAT)
        if endpoint_is_unix(chat_route.get("endpoint", "")):
            self.status = f"model queued/loading on {chat_route['route']} socket; you can type the next prompt below"
        else:
            self.status = "Motoko is thinking; you can type the next prompt below"
        self.generating = True
        self.cancel_event = threading.Event()
        cancel_event = self.cancel_event
        project_scope = project_scope_for_request(self.conv, user_text)

        def worker() -> None:
            try:
                raise_if_cancelled(cancel_event)
                topic = maybe_attach_relevant_existing_topic(self.conv, user_text, project_scope=project_scope)
                raise_if_cancelled(cancel_event)
                if topic:
                    self.put_event(
                        (
                            "system_note",
                            f"auto-attached topic dossier: {topic.get('id')} ({topic.get('name', '')})",
                        )
                    )
                dossier = maybe_attach_relevant_existing_dossier(self.conv, user_text, project_scope=project_scope)
                raise_if_cancelled(cancel_event)
                if dossier:
                    self.put_event(
                        (
                            "system_note",
                            f"auto-attached memory dossier: {dossier.get('id')} ({dossier.get('name', '')})",
                        )
                    )
                messages, sources = build_messages(self.conv, user_text, project_scope=project_scope)
                raise_if_cancelled(cancel_event)
                selected_route, _governor = model_route_for_request(MODEL_ROUTE_CHAT, messages)
                if route_kv_offload_disabled(selected_route):
                    self.put_event(("kv_notice",))
                self.put_event(("answer_phase", "answering"))
                raise_if_cancelled(cancel_event)

                def on_token(token: str) -> None:
                    raise_if_cancelled(cancel_event)
                    self.put_event(("token", token))

                def on_reasoning(token: str) -> None:
                    raise_if_cancelled(cancel_event)
                    self.put_event(("reasoning", token))

                reply = call_model_with_callback(
                    messages,
                    temperature=0.7,
                    on_token=on_token,
                    on_reasoning=on_reasoning,
                    route=MODEL_ROUTE_CHAT,
                    cancel_event=cancel_event,
                    on_connection=self.set_active_model_connection,
                    on_response=self.set_active_model_response,
                    source_count=len(sources),
                    slot_cache_context={
                        "conversation_id": self.conv.get("id", ""),
                        "client_namespace": CHAT_SLOT_CACHE_NAMESPACE_VERSION,
                    },
                )
                self.put_event(("done", reply, sources_with_answer_audit(user_text, reply, sources)))
            except RuntimeError as exc:
                if str(exc) == "__motoko_stopped__":
                    self.put_event(("stopped",))
                else:
                    self.put_event(("error", f"{type(exc).__name__}: {exc}"))
            except SystemExit as exc:
                self.put_event(("error", str(exc)))
            except Exception as exc:  # Defensive: preserve terminal session.
                self.put_event(("error", f"{type(exc).__name__}: {exc}"))

        getattr(self, "jobs", LIVE_JOB_SUPERVISOR).start_thread(
            kind="answer",
            lane="large-model",
            label="chat answer",
            target=worker,
            cancel_event=cancel_event,
        )

    def put_event(self, event: tuple) -> None:
        with self.events_lock:
            self.events.append(event)

    def drain_events(self) -> None:
        changed = False
        while True:
            with self.events_lock:
                if not self.events:
                    break
                event = self.events.popleft()
            kind = event[0]
            if kind == "token":
                if self.answer_entry is not None:
                    if self.answer_phase == "thinking":
                        self.answer_phase = "answering"
                        self.answer_phase_started_monotonic = time.monotonic()
                    self.answer_entry["content"] += event[1]
                    changed = True
            elif kind == "reasoning":
                if self.answer_phase != "thinking":
                    self.answer_phase = "thinking"
                    self.answer_phase_started_monotonic = time.monotonic()
                self.answer_reasoning = (self.answer_reasoning + event[1])[-REASONING_LIVE_MAX_CHARS:]
                changed = True
            elif kind == "answer_phase":
                new_phase = event[1]
                if new_phase != self.answer_phase:
                    self.answer_phase_started_monotonic = time.monotonic()
                self.answer_phase = new_phase
                changed = True
            elif kind == "kv_notice":
                self.show_kv_notice()
                changed = True
            elif kind == "done":
                reply, sources = event[1], event[2]
                self.conv["last_sources"] = sources
                self.conv["messages"].append({"role": "assistant", "content": reply})
                save_conversation(self.conv)
                self.flush_active_answer_transcript(reply)
                self.generating = False
                self.answer_phase = ""
                self.answer_reasoning = ""
                self.answer_entry = None
                self.status = "ready"
                if self.answer_started_monotonic:
                    self.append("worked", human_duration_words(int(time.monotonic() - self.answer_started_monotonic)))
                self.answer_started_monotonic = 0.0
                self.answer_phase_started_monotonic = 0.0
                changed = True
                if self.pending_prompts:
                    next_prompt = self.pop_next_queued_prompt()
                    if next_prompt:
                        self.start_generation(next_prompt)
                else:
                    self.start_maintenance()
            elif kind == "stopped":
                partial = ""
                if self.answer_entry is not None:
                    partial = self.answer_entry.get("content", "")
                    if partial:
                        self.answer_entry["content"] = partial.rstrip() + "\n\n[stopped]"
                    elif self.answer_entry in self.messages:
                        self.messages.remove(self.answer_entry)
                if partial:
                    self.flush_active_answer_transcript(partial.rstrip() + "\n\n[stopped]")
                    self.conv["messages"].append(
                        {"role": "assistant", "content": partial.rstrip() + "\n\n[stopped]"}
                    )
                save_conversation(self.conv)
                self.generating = False
                self.answer_phase = ""
                self.answer_reasoning = ""
                self.answer_entry = None
                self.answer_started_monotonic = 0.0
                self.answer_phase_started_monotonic = 0.0
                self.status = "answer stopped"
                changed = True
            elif kind == "error":
                failed_answer = self.answer_entry
                self.generating = False
                self.answer_phase = ""
                self.answer_reasoning = ""
                self.answer_entry = None
                self.answer_started_monotonic = 0.0
                self.answer_phase_started_monotonic = 0.0
                if failed_answer is not None and not failed_answer.get("content") and failed_answer in self.messages:
                    self.messages.remove(failed_answer)
                self.append("error", event[1])
                self.status = "ready"
                changed = True
            elif kind == "report_done":
                token, label, text = event[1], event[2], event[3]
                if token == getattr(self, "active_report_token", 0):
                    self.overlay_title = label
                    self.overlay_lines = text.splitlines() or ["(no output)"]
                    self.overlay_scroll = 0
                self.report_running = max(0, self.report_running - 1)
                if not self.report_running:
                    self.report_status = ""
                    if not self.generating and not self.maintaining:
                        self.status = "ready"
                changed = True
            elif kind == "report_error":
                token, label, text = event[1], event[2], event[3]
                if token == getattr(self, "active_report_token", 0):
                    self.overlay_title = label
                    self.overlay_lines = [f"error {text}"]
                    self.overlay_scroll = 0
                self.report_running = max(0, self.report_running - 1)
                if not self.report_running:
                    self.report_status = ""
                    if not self.generating and not self.maintaining:
                        self.status = "ready"
                changed = True
            elif kind == "maintenance_done":
                self.maintaining = False
                notes = event[1]
                self.status = "ready"
                self.maintenance_status = ""
                if notes:
                    self.append("system", "; ".join(notes))
                if self.pending_prompts and not self.generating:
                    next_prompt = self.pop_next_queued_prompt()
                    if next_prompt:
                        self.start_generation(next_prompt)
                changed = True
            elif kind == "maintenance_error":
                self.maintaining = False
                self.maintenance_status = ""
                self.status = "ready"
                self.append("system", f"memory maintenance failed: {event[1]}")
                changed = True
            elif kind == "maintenance_phase":
                self.maintenance_status = event[1]
                self.maintenance_phase_started = time.monotonic()
                self.status = event[1]
                changed = True
            elif kind == "study_phase":
                if self.cwd_indexing:
                    continue
                self.study_running = True
                new_phase = event[1]
                if phase_timer_key(new_phase) != phase_timer_key(self.study_status):
                    self.study_phase_started = time.monotonic()
                self.study_phase_updated = time.monotonic()
                self.study_status = new_phase
                changed = True
            elif kind == "study_done":
                if self.cwd_indexing:
                    continue
                self.study_running = False
                notes = event[1]
                self.study_last_note = "; ".join(notes) if notes else "catalog fresh"
                self.study_status = "study: idle"
                if self.pending_prompts and not self.generating and not self.maintaining:
                    next_prompt = self.pop_next_queued_prompt()
                    if next_prompt:
                        self.start_generation(next_prompt)
                changed = True
            elif kind == "study_error":
                if self.cwd_indexing:
                    continue
                self.study_running = False
                self.study_status = "study: idle"
                self.study_last_note = f"study failed: {event[1]}"
                changed = True
            elif kind == "cwd_index_progress":
                self.index_progress = event[1]
                self.study_running = True
                self.cwd_indexing = True
                self.study_status = format_index_progress_status(self.index_progress)
                self.study_phase_updated = time.monotonic()
                changed = True
            elif kind == "cwd_index_done":
                self.cwd_indexing = False
                self.study_running = False
                self.index_progress = None
                index_id = event[1]
                self.study_last_note = f"learned corpus index {index_id}"
                self.study_status = "study: idle"
                self.append("system", f"learned corpus index: {index_id}")
                if self.pending_prompts and not self.generating and not self.maintaining:
                    next_prompt = self.pop_next_queued_prompt()
                    if next_prompt:
                        self.start_generation(next_prompt)
                changed = True
            elif kind == "cwd_index_paused":
                self.cwd_indexing = False
                self.study_running = False
                self.index_progress = None
                index_id = event[1]
                self.study_last_note = f"corpus learning paused {index_id}".strip()
                self.study_status = "study: idle"
                self.append("system", f"corpus learning paused: {index_id}\nUse /resume-work {index_id} to continue.")
                changed = True
            elif kind == "cwd_index_error":
                self.cwd_indexing = False
                self.study_running = False
                self.index_progress = None
                self.study_status = "study: idle"
                self.study_last_note = f"corpus learning failed: {event[1]}"
                self.append("error", f"corpus learning failed: {event[1]}")
                changed = True
            elif kind == "system_note":
                self.append("system", event[1])
                changed = True
        if changed:
            self.dirty = True

    def start_study_loop(self) -> None:
        if not env_flag("MOTOKO_BACKGROUND_STUDY", True):
            self.study_status = "study: off"
            return
        interval = env_seconds("MOTOKO_BACKGROUND_STUDY_INTERVAL", BACKGROUND_STUDY_INTERVAL_SECONDS)
        idle_grace = env_seconds("MOTOKO_BACKGROUND_STUDY_IDLE_GRACE", BACKGROUND_STUDY_IDLE_GRACE_SECONDS)

        def worker() -> None:
            next_run = time.monotonic() + 1
            while self.running:
                time.sleep(1)
                now_ts = time.monotonic()
                if now_ts < next_run:
                    continue
                if self.generating or self.maintaining or self.study_running or self.pending_prompts:
                    next_run = now_ts + min(5, interval)
                    continue
                if now_ts - self.last_input_at < idle_grace:
                    next_run = now_ts + 1
                    continue
                next_run = now_ts + interval
                self.put_event(("study_phase", "study: scanning"))
                try:
                    notes = background_study_step(
                        self.conv,
                        phase_callback=lambda phase: self.put_event(("study_phase", phase)),
                    )
                except WorkPaused as exc:
                    self.put_event(("study_done", [str(exc)]))
                except Exception as exc:  # Background study must not break chat.
                    self.put_event(("study_error", f"{type(exc).__name__}: {exc}"))
                else:
                    self.put_event(("study_done", notes))

        getattr(self, "jobs", LIVE_JOB_SUPERVISOR).start_thread(
            kind="study-loop",
            lane="cpu",
            label="background study loop",
            target=worker,
        )

    def start_maintenance(self, *, resumed: bool = False) -> None:
        if self.maintaining or self.generating:
            return
        self.maintaining = True
        self.maintenance_status = "memory: checking"
        self.maintenance_phase_started = time.monotonic()
        self.status = self.maintenance_status
        state = begin_maintenance_state(self.conv, resumed=resumed)

        def worker() -> None:
            try:
                def on_phase(phase: str) -> None:
                    self.put_event(("maintenance_phase", phase))

                notes = auto_maintain_conversation(
                    self.conv,
                    phase_callback=on_phase,
                    state=state,
                )
                clear_maintenance_state(state.get("job_id"))
                self.put_event(("maintenance_done", notes))
            except WorkPaused as exc:
                self.put_event(("maintenance_done", [str(exc)]))
            except Exception as exc:  # Keep hidden maintenance from breaking chat.
                update_maintenance_state(
                    state,
                    "memory: failed",
                    status="failed",
                    error=f"{type(exc).__name__}: {exc}",
                )
                self.put_event(("maintenance_error", f"{type(exc).__name__}: {exc}"))

        getattr(self, "jobs", LIVE_JOB_SUPERVISOR).start_thread(
            kind="maintenance",
            lane="small-model",
            label="memory maintenance",
            target=worker,
        )

