def _agentic_eval_fixture_goal_interruption_resume(docs: pathlib.Path, tmp: pathlib.Path) -> dict:
    first = docs / "interrupt-first.org"
    second = docs / "interrupt-second.org"
    goal_file = tmp / "goal-interrupt.json"
    goal_file.write_text(
        json.dumps(
            {
                "schema": "motoko-goal-loop-v1",
                "objective": "Interrupt and resume explicit actions",
                "allowed_effects": ["write_allowed_project"],
                "budgets": {"max_steps": 2, "max_tool_calls": 2, "max_model_calls": 1, "max_minutes": 5},
                "actions": [
                    {
                        "schema": "motoko-action-v1",
                        "kind": "project_file_write",
                        "path": str(first),
                        "mode": "create",
                        "content": "* First\n",
                    },
                    {
                        "schema": "motoko-action-v1",
                        "kind": "project_file_write",
                        "path": str(second),
                        "mode": "create",
                        "content": "* Second\n",
                    },
                ],
            },
            ensure_ascii=False,
            indent=2,
        )
        + "\n",
        encoding="utf-8",
    )
    original_execute = globals()["execute_action_record"]
    cancel_event = threading.Event()
    calls = {"count": 0}

    def interrupt_after_first(action, *, yes: bool = False, cancel_event=None):
        validation, action_result = original_execute(action, yes=yes, cancel_event=cancel_event)
        calls["count"] += 1
        if calls["count"] == 1 and cancel_event is not None:
            cancel_event.set()
        return validation, action_result

    try:
        globals()["execute_action_record"] = interrupt_after_first
        interrupted = run_goal_text(str(goal_file), yes=True, cancel_event=cancel_event)
    finally:
        globals()["execute_action_record"] = original_execute
    run = next(
        (
            row
            for row in list_goal_run_records(limit=20)
            if row.get("objective") == "Interrupt and resume explicit actions"
        ),
        {},
    )
    resumed = resume_goal_run_text(str(run.get("id", "")), yes=True) if run.get("id") else ""
    ok = (
        "status: interrupted" in interrupted
        and "status: completed" in resumed
        and first.read_text(encoding="utf-8") == "* First\n"
        and second.read_text(encoding="utf-8") == "* Second\n"
        and calls["count"] == 1
    )
    return {
        "id": "goal_interruption_preserves_completed_actions",
        "status": "pass" if ok else "fail",
        "checks": {
            "interrupted": "status: interrupted" in interrupted,
            "resume_completed": "status: completed" in resumed,
            "first_completed_before_resume": first.exists(),
            "second_completed_after_resume": second.exists(),
            "completed_action_not_replayed": calls["count"] == 1,
        },
    }


def run_action_eval() -> dict:
    report = {
        "schema": ACTION_EVAL_SCHEMA_VERSION,
        "id": _dt.datetime.now().strftime("%Y%m%d-%H%M%S") + "-" + uuid.uuid4().hex[:6],
        "created": now(),
        "realm": identity_realm(),
        "fixtures": [],
    }
    with tempfile.TemporaryDirectory() as raw_tmp:
        tmp = pathlib.Path(raw_tmp)
        with temporary_motoko_state_env(tmp / "state", tmp / "config"):
            docs = tmp / "docs"
            docs.mkdir()
            (docs / ".motokoignore").write_text("ignored.org\narchive/\n", encoding="utf-8")
            (docs / "existing.org").write_text("* Existing\n", encoding="utf-8")
            (docs / "archive").mkdir()
            _agentic_eval_add_allowed(docs)
            fixtures = [
                lambda: _agentic_eval_fixture_project_write(docs, tmp),
                lambda: _agentic_eval_fixture_ignore_denial(docs, tmp),
                lambda: _agentic_eval_fixture_read_respects_ignore(docs, tmp),
                lambda: _agentic_eval_fixture_session_confirmation_scopes_arguments(docs, tmp),
                lambda: _agentic_eval_fixture_script_project_write_blocked(docs, tmp),
                lambda: _agentic_eval_fixture_project_write_proposal(docs, tmp),
                lambda: _agentic_eval_fixture_project_write_proposal_ignored(docs, tmp),
                lambda: _agentic_eval_fixture_goal_runner(docs, tmp),
                lambda: _agentic_eval_fixture_goal_budget(docs, tmp),
                lambda: _agentic_eval_fixture_action_interruption(docs, tmp),
                lambda: _agentic_eval_fixture_goal_interruption_resume(docs, tmp),
            ]
            for fixture in fixtures:
                started = time.monotonic()
                try:
                    row = fixture()
                except Exception as exc:  # noqa: BLE001 - evals should report unexpected failures
                    row = {"id": getattr(fixture, "__name__", "fixture"), "status": "fail", "error": str(exc)}
                row["duration_ms"] = int((time.monotonic() - started) * 1000)
                report["fixtures"].append(row)
    passed = sum(1 for row in report["fixtures"] if row.get("status") == "pass")
    report["summary"] = {
        "status": "pass" if passed == len(report["fixtures"]) else "fail",
        "passed": passed,
        "total": len(report["fixtures"]),
    }
    return report


def save_action_eval_report(report: dict) -> pathlib.Path:
    path = action_eval_path(str(report.get("id", "action-eval")))
    atomic_write(path, json.dumps(report, ensure_ascii=False, indent=2) + "\n")
    return path


def format_action_eval_report(report: dict) -> str:
    summary = report.get("summary", {})
    lines = [
        f"action eval: {report.get('id', '')}",
        f"status: {summary.get('status', '')}",
        f"fixtures: {summary.get('passed', 0)}/{summary.get('total', 0)} passed",
    ]
    for row in report.get("fixtures", []):
        lines.append(f"- {row.get('id', '')}: {row.get('status', '')} ({row.get('duration_ms', 0)} ms)")
        if row.get("error"):
            lines.append(f"  error: {row.get('error')}")
        checks = row.get("checks") if isinstance(row.get("checks"), dict) else {}
        failed_checks = [key for key, value in checks.items() if not value]
        if failed_checks:
            lines.append("  failed checks: " + ", ".join(failed_checks))
    return "\n".join(lines)


def approve_skill_tool_text(name: str, tool: str, *, yes: bool = False) -> str:
    if not yes:
        return f"refusing to approve without --yes: motoko skill approve-tool {name} {tool} --yes"
    row = core_load_skill(skills_dir(), name)
    tool_rows = [item for item in core_list_skill_tools(row) if item.get("valid") is True]
    matches = [
        item
        for item in tool_rows
        if tool in {item.get("name"), item.get("metadata_relpath"), item.get("script_relpath")}
    ]
    if not matches:
        raise SystemExit(f"tool not found: {tool}")
    if len(matches) > 1:
        raise SystemExit(f"ambiguous tool selector: {tool}")
    approval = core_approve_tool(tool_approvals_path(), matches[0], realm=identity_realm())
    return "\n".join(
        [
            f"tool approved: {matches[0].get('name', '')}",
            f"skill: {matches[0].get('skill', '')}",
            f"approval: {approval.get('id', '')}",
            f"effects: {', '.join(approval.get('allowed_effects', []))}",
            f"requires confirmation: {'yes' if approval.get('requires_confirmation') else 'no'}",
        ]
    )


def read_action_file(path_text: str) -> dict:
    if not path_text:
        raise SystemExit("usage: motoko action preview FILE")
    path = pathlib.Path(path_text).expanduser()
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except OSError as exc:
        raise SystemExit(f"cannot read action file: {path}") from exc
    except json.JSONDecodeError as exc:
        raise SystemExit(f"invalid action JSON: {path}: {exc}") from exc
    if not isinstance(data, dict):
        raise SystemExit("action file must contain a JSON object")
    return data


def allowed_root_for_path(path: pathlib.Path) -> pathlib.Path:
    resolved = path.expanduser().resolve(strict=False)
    directories = allowed_dirs()
    if not directories:
        raise AgenticValidationError(
            "Motoko has no allowed document directories yet; run 'motoko allow-dir DIR' first"
        )
    for directory in directories:
        root = directory.expanduser().resolve(strict=False)
        if resolved == root or is_under(resolved, root):
            return root
    raise AgenticValidationError(
        f"{resolved} is outside Motoko's allowed directories; run 'motoko allow-dir DIR' first"
    )


def git_worktree_registry_path() -> pathlib.Path:
    return state_root() / "git-worktrees.json"


def managed_git_worktrees_root() -> pathlib.Path:
    return ensure_private_dir(state_root() / "git-worktrees")


def read_git_worktree_registry() -> dict:
    data = safe_load_json(git_worktree_registry_path())
    if not isinstance(data, dict) or data.get("schema") != GIT_WORKTREE_REGISTRY_SCHEMA_VERSION:
        return {"schema": GIT_WORKTREE_REGISTRY_SCHEMA_VERSION, "worktrees": []}
    rows = data.get("worktrees")
    if not isinstance(rows, list):
        data["worktrees"] = []
    return data


def write_git_worktree_registry(data: dict) -> None:
    data = dict(data)
    data["schema"] = GIT_WORKTREE_REGISTRY_SCHEMA_VERSION
    data["updated"] = now()
    atomic_write(git_worktree_registry_path(), json.dumps(data, ensure_ascii=False, indent=2) + "\n")


def managed_git_worktree_records(*, include_removed: bool = False) -> list[dict]:
    rows = []
    for row in read_git_worktree_registry().get("worktrees", []):
        if not isinstance(row, dict):
            continue
        if not include_removed and row.get("status") == "removed":
            continue
        rows.append(row)
    return rows


def find_managed_git_worktree_for_path(path: pathlib.Path, *, active_only: bool = True) -> dict | None:
    resolved = path.expanduser().resolve(strict=False)
    for row in managed_git_worktree_records(include_removed=not active_only):
        if active_only and row.get("status") not in {"active", "merged"}:
            continue
        root_text = str(row.get("path") or "").strip()
        if not root_text:
            continue
        root = pathlib.Path(root_text).expanduser().resolve(strict=False)
        if resolved == root or is_under(resolved, root):
            return row
    return None


def managed_git_worktree_root_for_path(path: pathlib.Path) -> pathlib.Path | None:
    row = find_managed_git_worktree_for_path(path)
    if not row:
        return None
    return pathlib.Path(str(row.get("path") or "")).expanduser().resolve(strict=False)


def default_git_worktree_path(repo: pathlib.Path, branch: str) -> pathlib.Path:
    repo_root = repo.expanduser().resolve(strict=False)
    repo_slug = re.sub(r"[^A-Za-z0-9_.-]+", "-", repo_root.name).strip(".-") or "repo"
    branch_slug = re.sub(r"[^A-Za-z0-9_.-]+", "-", str(branch or "branch")).strip(".-") or "branch"
    suffix = hashlib.sha256(str(repo_root).encode("utf-8")).hexdigest()[:12]
    return managed_git_worktrees_root() / f"{repo_slug}-{suffix}" / branch_slug[:80]


def register_managed_git_worktree(*, repo: pathlib.Path, path: pathlib.Path, branch: str, base: str, status: str) -> dict:
    registry = read_git_worktree_registry()
    rows = [row for row in registry.get("worktrees", []) if isinstance(row, dict)]
    path_text = str(path.expanduser().resolve(strict=False))
    repo_text = str(repo.expanduser().resolve(strict=False))
    stamp = now()
    record = None
    for row in rows:
        if str(row.get("path") or "") == path_text:
            record = row
            break
    if record is None:
        record = {"id": "wt-" + uuid.uuid4().hex[:16], "created": stamp}
        rows.append(record)
    record.update(
        {
            "updated": stamp,
            "repo": repo_text,
            "path": path_text,
            "branch": branch,
            "base": base,
            "status": status,
            "repo_path_sha256": hashlib.sha256(repo_text.encode("utf-8")).hexdigest(),
            "worktree_path_sha256": hashlib.sha256(path_text.encode("utf-8")).hexdigest(),
        }
    )
    registry["worktrees"] = rows
    write_git_worktree_registry(registry)
    return record


def update_managed_git_worktree_status(path: pathlib.Path, *, status: str, **fields) -> dict:
    registry = read_git_worktree_registry()
    rows = [row for row in registry.get("worktrees", []) if isinstance(row, dict)]
    path_text = str(path.expanduser().resolve(strict=False))
    for row in rows:
        if str(row.get("path") or "") == path_text:
            row.update(fields)
            row["status"] = status
            row["updated"] = now()
            registry["worktrees"] = rows
            write_git_worktree_registry(registry)
            return row
    raise AgenticValidationError("git worktree is not managed by Motoko")


def require_project_write_allowed(path: pathlib.Path) -> pathlib.Path:
    target = path.expanduser()
    if not target.is_absolute():
        raise AgenticValidationError("project writes require an absolute path")
    raw = str(target).replace("\\", "/")
    if "\x00" in raw:
        raise AgenticValidationError("project write path contains NUL")
    if any(part in {"", ".."} for part in pathlib.PurePosixPath(raw).parts):
        raise AgenticValidationError("project write path must not contain traversal")
    require_not_cross_home(target)
    if target.name == MOTOKO_IGNORE_FILE:
        raise AgenticValidationError("project write actions may not modify .motokoignore")
    if any(part in SKIP_INDEX_DIR_NAMES for part in target.parts):
        raise AgenticValidationError("project write actions may not target cache/VCS directories")
    if target.exists() and target.is_dir():
        raise AgenticValidationError("project write actions may not target directories")
    if target.exists() and target.is_symlink():
        raise AgenticValidationError("project write actions may not target symlinks")
    parent = target.parent
    if not parent.exists() or not parent.is_dir():
        raise AgenticValidationError("project write parent directory must already exist")
    if parent.is_symlink():
        raise AgenticValidationError("project write parent directory must not be a symlink")
    resolved_target = parent.resolve(strict=True) / target.name
    root = managed_git_worktree_root_for_path(resolved_target)
    if root is None:
        root = allowed_root_for_path(resolved_target)
    rel = rel_posix(resolved_target, root)
    try:
        rules, _info = parse_motoko_ignore(root)
    except SystemExit as exc:
        raise AgenticValidationError(str(exc)) from None
    rule = motoko_ignore_matches(rules, rel, is_dir=False)
    if rule is not None:
        raise AgenticValidationError(
            f"project write target is ignored by {MOTOKO_IGNORE_FILE}: {rel}"
        )
    return resolved_target


def action_path_checker(_key: str, value: str, *, write: bool = False) -> None:
    raw = str(value or "").strip()
    if not raw:
        return
    candidate = pathlib.Path(raw).expanduser()
    if not candidate.is_absolute():
        candidate = pathlib.Path.cwd() / candidate
    require_not_cross_home(candidate)
    if write:
        require_project_write_allowed(candidate)
    else:
        try:
            require_allowed(candidate)
        except SystemExit as exc:
            managed_root = managed_git_worktree_root_for_path(candidate)
            if managed_root is None:
                raise AgenticValidationError(str(exc)) from None
            root = managed_root
        else:
            root = allowed_root_for_path(candidate)
        resolved_candidate = candidate.expanduser().resolve(strict=False)
        rel = rel_posix(resolved_candidate, root)
        try:
            rules, _info = parse_motoko_ignore(root)
        except SystemExit as exc:
            raise AgenticValidationError(str(exc)) from None
        is_dir = resolved_candidate.exists() and resolved_candidate.is_dir()
        rule = motoko_ignore_matches(rules, rel, is_dir=is_dir)
        if rule is not None:
            raise AgenticValidationError(
                f"read path is ignored by {MOTOKO_IGNORE_FILE}: {rel}"
            )


