    if not resolved.is_dir():
        raise SystemExit(f"not a directory: {resolved}")
    add_allowed_dir_entry(
        allowdirs_path(),
        resolved,
        nix_managed_message_provider=lambda allowlist_path: nix_managed_config_message(
