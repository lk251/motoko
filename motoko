def item_matches_selector(item: dict, selector: str) -> bool:
    fields = [
        item.get("id", ""),
        item.get("title", ""),
        item.get("name", ""),
        item.get("query", ""),
        item.get("root", ""),
    ]
    selector_lower = selector.lower()
    return any(
        field == selector
        or field.startswith(selector)
        or selector_lower in field.lower()
        for field in fields
        if field
    )


def resolve_stored_item(
    rows: list[dict],
    selector: str,
    *,
    kind: str,
) -> dict:
    selector = selector.strip()
    if not selector:
        raise SystemExit(f"{kind} id is required")
    if selector.isdigit():
        idx = int(selector) - 1
        if 0 <= idx < len(rows):
            return rows[idx]
    matches = [row for row in rows if item_matches_selector(row, selector)]
    if len(matches) != 1:
        raise SystemExit(f"{kind} selector must match exactly one {kind}; matched {len(matches)}")
    return matches[0]


def prompt_for_selection(
    rows: list[dict],
    *,
    kind: str,
    label_func,
    selector: str | None = None,
) -> dict:
    if selector:
        return resolve_stored_item(rows, selector, kind=kind)
    if not sys.stdin.isatty():
        raise SystemExit(f"{kind} id is required")
    if not rows:
        raise SystemExit(f"No {kind}s yet.")
    print(style(f"Select {kind}:", "bold"))
    for idx, row in enumerate(rows[:40], 1):
        print(f"{idx:3d}  {label_func(row)}")
    if len(rows) > 40:
        print(f"     ... {len(rows) - 40} older {kind}(s) omitted; type an ID prefix to select one.")
    answer = input(style(f"{kind} number or ID> ", "turquoise")).strip()
    return resolve_stored_item(rows, answer, kind=kind)


