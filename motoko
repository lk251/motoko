def partial_index_superseded(partial: dict, indexes: list[dict] | None = None) -> bool:
    partial_id = str(partial.get("id", "")).strip()
    partial_time = stored_record_timestamp(partial)
    if partial_time is None and not partial_id:
        return False
    key = index_family_key(partial)
    for index in indexes if indexes is not None else list_indexes():
        if index_family_key(index) != key:
            continue
        if partial_id and str(index.get("id", "")).strip() == partial_id:
            return True
        index_time = stored_record_timestamp(index)
        if index_time is not None and partial_time is not None and index_time >= partial_time:
            return True
    return False


def list_resumable_partial_indexes() -> list[dict]:
    partials = list_partial_indexes()
    indexes = list_indexes()
    return [partial for partial in partials if not partial_index_superseded(partial, indexes)]


