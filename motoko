    return {}


def format_last_model_call(record: dict | None = None) -> str:
    record = record if isinstance(record, dict) else read_last_model_call()
    if not record:
        return "last model call: none recorded yet"
    lines = [
        "last model call:",
        f"status: {record.get('status', 'unknown')}",
        f"created: {record.get('created', '')}",
        f"route: {record.get('route', '')}"
        + (f" -> {record.get('catalog_route', '')}" if record.get("catalog_route") else ""),
        f"tier: {record.get('tier', '')}  mode: {record.get('mode', '')}",
        f"model: {record.get('model', '')}",
    ]
    if record.get("quant"):
        lines.append(f"quant: {record.get('quant')}")
    if record.get("route_profile"):
        lines.append(f"profile: {record.get('route_profile')}")
    if record.get("kv_cache_location") or record.get("kv_offload") is not None:
        location = record.get("kv_cache_location") or "unknown"
        offload = record.get("kv_offload")
        lines.append(f"KV: {'GPU' if offload is True else location}")
    if record.get("reasoning_mode"):
        lines.append(
            f"reasoning: {record.get('reasoning_mode')} "
            f"budget={record.get('thinking_budget_tokens')}"
        )
    lines.extend(
        [
            (
                "context: "
                f"{record.get('prompt_tokens_estimate', 0)} estimated prompt tok / "
                f"{record.get('ctx_size', 0)} ctx "
                f"({record.get('context_percent', 0)}%)"
            ),
            f"completion: {record.get('completion_tokens_estimate', 0)} estimated tok",
        ]
    )
    if record.get("source_count") is not None:
        lines.append(f"sources: {record.get('source_count')}")
    policy_lines = []
    if record.get("sampling_preset"):
        policy_lines.append(f"sampling={record.get('sampling_preset')}")
    if record.get("reasoning_preset"):
        budget = (
            f":{record.get('thinking_budget_tokens')}tok"
            if record.get("thinking_budget_tokens") is not None
            else ""
        )
        policy_lines.append(f"reasoning={record.get('reasoning_preset')}{budget}")
    structured = []
    if record.get("structured_json_schema"):
        structured.append("json_schema")
    if record.get("structured_grammar"):
        structured.append("grammar")
    if structured:
        policy_lines.append("structured=" + "/".join(structured))
    if record.get("cache_measurement_supported"):
        policy_lines.append("cache-measurement=declared")
    if record.get("slot_cache_status"):
        detail = (
            f"{record.get('slot_cache_status')}"
            f" restore={record.get('slot_cache_restore', '-')}"
            f" save={record.get('slot_cache_save', '-')}"
        )
        if record.get("slot_cache_slot_id") is not None:
            detail += f" slot={record.get('slot_cache_slot_id')}"
        if record.get("slot_cache_namespace"):
            detail += f" namespace={record.get('slot_cache_namespace')}"
        if record.get("slot_cache_manifest"):
            detail += f" manifest={record.get('slot_cache_manifest')}"
        if record.get("slot_cache_budget"):
            detail += f" budget={record.get('slot_cache_budget')}"
        if record.get("slot_cache_budget_profile"):
            detail += f"/{record.get('slot_cache_budget_profile')}"
        if record.get("slot_cache_budget_service_gc_required"):
            detail += " service-gc-required"
        if record.get("slot_cache_budget_service_gc"):
            detail += f" service-gc={record.get('slot_cache_budget_service_gc')}"
        policy_lines.append(f"slot-cache={detail}")
    if policy_lines:
        lines.append("request policy: " + ", ".join(policy_lines))
    if record.get("route_idle_seconds") is not None or record.get("route_max_parallel") is not None:
        lines.append(
            "route policy: "
            f"idle={record.get('route_idle_seconds', '-')}s "
